.network-menu .unity-base-field {
    margin-top: 5px;
    margin-bottom: 5px;
    min-height: 30px;
    align-items: center;
}
.network-menu .unity-base-field__label {
    min-width: 100px;
    width: 100px;
    color: rgb(162,185,196);
    font-size: 13px;
}
.network-menu .unity-base-field__input {
    flex-grow: 1;
    min-width: 0;
    min-height: 28px;
    color: rgb(237,247,255);
    background-color: rgb(17,35,49);
    border-left-color: rgb(45,88,96);
    border-right-color: rgb(45,88,96);
    border-top-color: rgb(45,88,96);
    border-bottom-color: rgb(45,88,96);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    padding-left: 8px;
    padding-right: 8px;
}
.network-menu .unity-base-field__input .unity-text-element {
    color: rgb(237,247,255);
}
.network-menu .unity-button {
    min-height: 32px;
    margin-top: 4px;
    margin-bottom: 2px;
    color: rgb(237,247,255);
    background-color: rgb(23,51,61);
    border-left-color: rgb(45,88,96);
    border-right-color: rgb(45,88,96);
    border-top-color: rgb(45,88,96);
    border-bottom-color: rgb(45,88,96);
    font-size: 14px;
}
.network-menu .unity-button:hover { background-color: rgb(32,75,83); }
.network-menu .unity-button:disabled { opacity: 0.45; }
.network-menu .unity-toggle__input { background-color: transparent; padding-left: 0; }
.network-menu .unity-toggle__label { min-width: 150px; width: 150px; }
