/* Sizes here are for a screen 720 units tall: ArenaPanelSettings scales with
   the screen's height (1.5x on a 1080p screen, smaller in a small window).
   All text is white with a thin dark outline and soft shadow, so it
   reads on every chalk colour (the yellow buttons included). Both are inherited. */
.hud-root { position: absolute; left: 0; top: 0; right: 0; bottom: 0; color: rgb(255,255,255); -unity-font-style: normal; -unity-text-outline-width: 0.6px; -unity-text-outline-color: rgba(33,23,18,0.9); text-shadow: 1px 2px 2px rgba(0,0,0,0.45); }

/* Hand-drawn chalk art from Assets/Game/UI/Resources. The panel is 9-sliced
   so it stretches to any size; slice-scale sets how thick its edge is drawn. */
.bom-panel { background-color: rgba(0,0,0,0); background-image: url("Resources/BomPanel.png"); -unity-slice-left: 140; -unity-slice-right: 140; -unity-slice-top: 140; -unity-slice-bottom: 140; -unity-slice-scale: 0.25px; border-width: 0; }
.bom-chip { -unity-slice-scale: 0.12px; }

.timer { position: absolute; top: 14px; left: 50%; translate: -50% 0; padding: 8px 26px; font-size: 34px; -unity-font-style: bold; -unity-text-align: middle-center; }
/* The bomb counter and its bomb badge share a wrapper, placed a little in
   from the screen edge so the badge can sit over the panel's left end, half
   on and half off, with the panel running out from behind it. */
.bomb-counter-group { position: absolute; left: 46px; bottom: 12px; flex-direction: row; align-items: center; }
.bomb-counter { padding: 10px 24px 10px 40px; font-size: 24px; -unity-text-align: middle-left; }
/* The chalk bomb (BomIcon_bomb, from the menu art sheet). Added after the
   counter, so it draws on top; nudged up so the fuse pokes above the panel. */
.bomb-icon { position: absolute; left: -30px; top: 50%; width: 58px; height: 64px; translate: 0 -60%; background-image: url("Resources/BomIcon_bomb.png"); -unity-background-scale-mode: scale-to-fit; }
/* Lower right: how to pause (the full list is under Pause > Controls). */
.pause-corner { position: absolute; right: 14px; bottom: 12px; padding: 10px 22px; font-size: 22px; -unity-text-align: middle-center; }
.round-message { display: none; position: absolute; left: 50%; top: 38%; translate: -50% -50%; padding: 16px 34px; font-size: 38px; -unity-font-style: bold; -unity-text-align: middle-center; }

/* The 3-2-1 before each round. ArenaHudDocument sets the picture and the pop
   (on .countdown, so the number and its shadow move together). The shadow is
   a black copy of the number, a little larger and dropped down-right. */
.countdown { display: none; position: absolute; left: 50%; top: 42%; width: 240px; height: 240px; translate: -50% -50%; }
.countdown-number, .countdown-shadow { position: absolute; left: 0; top: 0; right: 0; bottom: 0; -unity-background-scale-mode: scale-to-fit; }
.countdown-shadow { -unity-background-image-tint-color: rgba(0,0,0,0.7); translate: 8px 10px; scale: 1.1 1.1; }
/* GO! is about 1.4x as wide as it is tall, so widen the box for it. */
.countdown.countdown-go { width: 340px; }

.death-panel { display: none; position: absolute; left: 50%; top: 50%; translate: -50% -50%; width: 460px; padding: 30px 40px; }
.death-title { margin-bottom: 10px; font-size: 44px; -unity-font-style: bold; -unity-text-align: middle-center; }
.result-buttons { flex-direction: row; justify-content: center; align-items: center; margin-top: 12px; }
/* Game Over buttons keep a button's natural shape rather than spanning the panel. */
.result-buttons .menu-button { width: 230px; min-height: 52px; margin: 0 12px; }

/* Chalk buttons: orange for main actions, yellow (.secondary) for leaving.
   They rest noticeably darker and light up to the full colour when the mouse,
   keyboard focus or the controller cursor is on them. */
.menu-button { width: 48%; min-height: 48px; margin: 0; padding: 4px 12px; border-width: 0; border-radius: 0; background-color: rgba(0,0,0,0); background-image: url("Resources/BomButton_orange.png"); -unity-slice-left: 55; -unity-slice-right: 55; -unity-slice-top: 55; -unity-slice-bottom: 55; -unity-slice-scale: 0.28px; -unity-background-image-tint-color: rgb(168,168,168); color: rgb(255,255,255); -unity-font-style: bold; font-size: 26px; transition-property: scale, -unity-background-image-tint-color; transition-duration: 80ms; }
.menu-button.secondary { background-image: url("Resources/BomButton_yellow.png"); }
/* Blue for options that open another panel (CONTROLS). */
.menu-button.option { background-image: url("Resources/BomButton_blue.png"); }
.menu-button:hover, .menu-button:focus, .menu-button.cursor-hover { background-color: rgba(0,0,0,0); -unity-background-image-tint-color: rgb(255,255,255); scale: 1.05 1.05; }
.menu-button:active { background-color: rgba(0,0,0,0); -unity-background-image-tint-color: rgb(140,140,140); scale: 0.98 0.98; }
/* Outranks the default theme's compound button states (e.g. .unity-button:hover:active)
   so its grey never shows behind the chalk art. */
.hud-root .menu-button:hover:active, .hud-root .menu-button:focus:hover, .hud-root .menu-button:checked:hover, .hud-root .menu-button:focus:active { background-color: rgba(0,0,0,0); border-width: 0; }
.pause-panel { width: 400px; }
.pause-button { width: 100%; margin: 8px 0 0 0; }
/* Controls panel (Pause > CONTROLS): a row per action, with keyboard and
   controller columns; ArenaHudDocument fills it for the match's input mode. */
.controls-panel { width: 660px; }
.controls-table { margin: 4px 0 6px 0; }
.controls-row { flex-direction: row; align-items: center; min-height: 46px; padding: 4px 6px; border-bottom-width: 2px; border-color: rgba(255,245,230,.18); }
.controls-row.controls-heading { min-height: 34px; border-bottom-width: 3px; border-color: rgba(255,245,230,.35); }
.controls-action { width: 30%; margin: 0; padding: 0; font-size: 25px; -unity-font-style: bold; }
.controls-key { flex-grow: 1; flex-basis: 0; margin: 0; padding: 0; font-size: 23px; -unity-text-align: middle-center; white-space: normal; }
.controls-heading .controls-key { font-size: 20px; opacity: .75; -unity-font-style: bold; }
.controls-note { margin: 12px 0 0 0; padding: 0; font-size: 23px; white-space: normal; -unity-text-align: middle-center; }
.controls-back { margin-top: 12px; }
.pause-hint { margin-top: 12px; opacity: .9; font-size: 20px; -unity-text-align: middle-center; }
.menu-cursor { display: none; position: absolute; width: 50px; height: 50px; translate: -50% -50%; border-width: 4px; border-radius: 25px; justify-content: center; align-items: center; }
.menu-cursor-label { color: rgb(255,255,255); font-size: 17px; -unity-font-style: bold; -unity-text-align: middle-center; padding: 0; margin: 0; }

/* Game Over panel: one card per player, a summary card, then a time line.
   A fixed width, so a single player's row isn't stretched across the screen. */
.results-panel { width: 820px; max-width: 94%; padding: 22px 40px 22px 40px; }
/* The long title-bar art (BomHeader_blue), drawn at the bar's height so its
   grain keeps its shape; padding leaves room for the chalk ends. */
.results-title { align-self: center; min-width: 300px; height: 56px; margin-bottom: 10px; padding: 0 56px; background-image: url("Resources/BomHeader_blue.png"); -unity-slice-left: 125; -unity-slice-right: 125; -unity-slice-top: 60; -unity-slice-bottom: 60; -unity-slice-scale: 0.252px; color: rgb(255,255,255); font-size: 36px; -unity-font-style: bold; -unity-text-align: middle-center; }
.result-cards { flex-direction: column; }
.result-card { flex-direction: row; align-items: center; height: 60px; padding: 2px 12px; border-width: 3px; border-radius: 10px; border-color: rgba(255,245,230,.35); overflow: hidden; opacity: 0; translate: -30px 0; transition-property: opacity, translate; transition-duration: 300ms; }
.result-card.shown { opacity: 1; translate: 0 0; }
.result-card.winner { border-color: rgb(255,199,82); }
.result-card.summary { border-color: rgb(255,199,82); background-color: rgba(255,199,82,.08); }
.result-fill { position: absolute; left: 0; top: 0; bottom: 0; width: 0; transition-property: width; transition-duration: 900ms; transition-timing-function: ease-out; }
/* Portrait then name, side by side (row-reverse: the name is added first). */
.result-who { width: 190px; flex-direction: row-reverse; justify-content: flex-end; align-items: center; }
.result-name { margin: 0; padding: 0; font-size: 22px; -unity-font-style: bold; }
.result-portrait { width: 46px; height: 46px; margin-right: 8px; -unity-background-scale-mode: scale-to-fit; }
.result-stats { flex-grow: 1; flex-direction: row; justify-content: space-around; align-items: center; }
.result-stat { flex-direction: row; align-items: center; }
.result-icon { width: 36px; height: 36px; margin-right: 4px; }
.result-value { margin: 0; padding: 0; font-size: 28px; -unity-font-style: bold; }
.result-total { width: 130px; flex-direction: row; justify-content: flex-end; align-items: center; }
.result-total-value { margin: 0; padding: 0; font-size: 30px; -unity-font-style: bold; }
.result-dots { flex-direction: row; justify-content: space-between; height: 3px; margin: 5px 6px; }
.result-dot { width: 4px; height: 3px; background-color: rgba(255,245,230,.5); }
.result-timeline { margin-top: 10px; }
.timeline-caption { margin: 0 0 2px 0; padding: 0; font-size: 19px; -unity-font-style: bold; }
.timeline-track { height: 30px; }
.timeline-line { position: absolute; left: 0; right: 0; top: 0; height: 3px; background-color: rgb(255,245,230); }
.timeline-tick { position: absolute; top: 0; width: 2px; height: 8px; background-color: rgb(255,245,230); }
.timeline-label { position: absolute; top: 8px; margin: 0; padding: 0; translate: -50% 0; font-size: 18px; -unity-font-style: bold; }
.result-wallet { margin-top: 4px; font-size: 22px; -unity-font-style: bold; -unity-text-align: middle-center; }
.result-waiting { display: none; width: 230px; margin: 0 12px; font-size: 22px; opacity: .9; -unity-text-align: middle-center; }
