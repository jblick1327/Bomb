<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="hud-root" class="hud-root">
        <ui:Label name="timer" text="00:00" class="timer bom-panel bom-chip" />
        <ui:Label name="bomb-counter" text="Bombs dropped: 0" class="bomb-counter bom-panel bom-chip" />
        <ui:Label name="pause-corner" text="PAUSE  P" class="pause-corner bom-panel bom-chip" />
        <ui:Label name="round-message" text="Waiting for players..." class="round-message bom-panel bom-chip" />
        <ui:VisualElement name="countdown" class="countdown" picking-mode="Ignore" />
        <ui:VisualElement name="pause-panel" class="death-panel pause-panel bom-panel">
            <ui:Label text="PAUSED" class="death-title" />
            <ui:Button name="resume-button" text="RESUME" class="menu-button pause-button" />
            <ui:Button name="controls-button" text="CONTROLS" class="menu-button pause-button option" />
            <ui:Button name="restart-button" text="RESTART" class="menu-button pause-button" />
            <ui:Button name="leave-button" text="LEAVE GAME" class="menu-button pause-button secondary" />
            <ui:Label name="pause-hint" text="P / Start: resume    A: select" class="pause-hint" />
        </ui:VisualElement>
        <ui:VisualElement name="controls-panel" class="death-panel controls-panel bom-panel">
            <ui:Label text="CONTROLS" class="results-title" />
            <ui:VisualElement name="controls-table" class="controls-table" />
            <ui:Button name="controls-back-button" text="BACK" class="menu-button pause-button secondary controls-back" />
            <ui:Label name="controls-hint" text="Esc / B: back" class="pause-hint" />
        </ui:VisualElement>
        <ui:VisualElement name="death-panel" class="death-panel results-panel bom-panel">
            <ui:Label name="winner" text="GAME OVER" class="results-title" />
            <ui:VisualElement name="result-cards" class="result-cards" />
            <ui:VisualElement name="result-timeline" class="result-timeline" />
            <ui:Label name="result-wallet" text="" class="result-wallet" />
            <ui:VisualElement class="result-buttons">
                <ui:Button name="replay-button" text="REPLAY" class="menu-button" />
                <ui:Label name="result-waiting" text="Waiting for the host..." class="result-waiting" />
                <ui:Button name="return-button" text="RETURN" class="menu-button secondary" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
