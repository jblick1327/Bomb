diff --git a/src/shared/prediction_static.odin b/src/shared/prediction_static.odin
new file mode 100644
index 0000000..931e27d
--- /dev/null
+++ b/src/shared/prediction_static.odin
@@ -0,0 +1,77 @@
+package shared
+import b2 "vendor:box2d"
+
+// First prediction fixture: only validated static terrain. Dynamic topology
+// history/proxies are a separate required M5 step; this is not the final gate.
+Prediction_Reason :: enum { None, Uninitialized, Dynamic_History_Required, Capacity, Wrong_Epoch, Wrong_Revision, Invalid_Owner, Missing_Command, Unsafe_Position }
+Static_Prediction :: struct {
+ active: bool,
+ scene: Scene,
+ player: Player,
+ epoch:u32,
+ revision,state_tick,last_jump_edge:u64,
+ identity:Input_Identity,
+ reason:Prediction_Reason,
+}
+prediction_static_destroy :: proc(p:^Static_Prediction) {
+ if p.active { scene_destroy(&p.scene) }
+ p^={}
+}
+prediction_static_build :: proc(p:^Static_Prediction,source:^Scene) -> bool {
+ prediction_static_destroy(p)
+ live:=0
+ for sub in source.subdivisions { if sub.live { live+=1 } }
+ if live>4096 { p.reason=.Capacity;return false }
+ for piece in source.pieces {
+  if piece.live && !piece_anchored(source,piece.id,source.anchor_y) { p.reason=.Dynamic_History_Required;return false }
+ }
+ p.scene=new_scene(0);p.epoch=source.epoch;p.revision=source.structure_revision
+ def:=b2.DefaultWorldDef();def.gravity={0,-9.8}
+ p.scene.physics={active=true,world=b2.CreateWorld(def)};p.active=true
+ append(&p.scene.materials,..source.materials[:])
+ bodies:=make(map[u64]b2.BodyId);defer delete(bodies)
+ for original in source.subdivisions {
+  if !original.live { continue }
+  sub:=Subdivision{id=original.id,owner=original.owner,material=original.material,rest_center=original.rest_center,live=true,outline=make_polygon(original.outline.points)}
+  p.scene.sub_rows[sub.id]=len(p.scene.subdivisions);append(&p.scene.subdivisions,sub)
+  rubber:=source.materials[sub.material].flexibility>0
+  body,exists:=bodies[sub.owner]
+  if rubber || !exists {
+   bd:=b2.DefaultBodyDef();if rubber { bd.position=to_b2(sub.rest_center) }
+   body=b2.CreateBody(p.scene.physics.world,bd)
+   if !rubber { bodies[sub.owner]=body }
+  }
+  p.scene.subdivisions[p.scene.sub_rows[sub.id]].body=body
+  // Exactly the authoritative decomposition, hull welding, fallback and filter.
+  physics_create_region_shapes(&p.scene,sub.id,body)
+ }
+ floor_def:=b2.DefaultBodyDef();floor_def.position={0.5,YARD_FLOOR_BOTTOM-YARD_BASE_DEPTH*0.5}
+ floor:=b2.CreateBody(p.scene.physics.world,floor_def)
+ shape:=b2.DefaultShapeDef();shape.material.friction=.65
+ _=b2.CreatePolygonShape(floor,shape,b2.MakeBox(10,YARD_BASE_DEPTH*.5))
+ p.player=player_create(p.scene.physics.world)
+ return true
+}
+prediction_static_replay :: proc(p:^Static_Prediction,owner:Owner_State,history:^Command_History) -> bool {
+ if !p.active { p.reason=.Uninitialized;return false }
+ if owner.identity.epoch!=p.epoch { p.reason=.Wrong_Epoch;return false }
+ if owner.topology_revision!=p.revision { p.reason=.Wrong_Revision;return false }
+ if !history.accepted || owner.identity!=history.identity || !owner_state_restore(p.scene.physics.world,&p.player,owner) { p.reason=.Invalid_Owner;return false }
+ p.identity=owner.identity;p.state_tick=owner.state_tick;p.last_jump_edge=owner.last_jump_edge
+ if history.next_tick<=owner.state_tick { p.reason=.Missing_Command;return false }
+ if history.next_tick-owner.state_tick>INPUT_HISTORY { p.reason=.Capacity;return false }
+ first:=true
+ for tick:=owner.state_tick+1;tick<history.next_tick;tick+=1 {
+  slot:=history.slots[tick%INPUT_HISTORY]
+  if !slot.occupied || slot.command.target_tick!=tick { p.reason=.Missing_Command;return false }
+  c:=slot.command;jump:=c.jump_edge!=0 && c.jump_edge>p.last_jump_edge
+  if jump { p.last_jump_edge=c.jump_edge }
+  if first { player_movement_from_support(&p.player,move_dequantize(c.move),jump,f32(NET_STEP_DT));first=false }
+  else { player_before_step(&p.player,move_dequantize(c.move),jump,f32(NET_STEP_DT)) }
+  b2.World_Step(p.scene.physics.world,f32(NET_STEP_DT),PHYSICS_SUBSTEPS)
+  player_after_movement_step(&p.player)
+  if player_out_of_bounds(&p.player) || !finite(p.player.pose.position.x) || !finite(p.player.pose.position.y) { p.reason=.Unsafe_Position;return false }
+  p.state_tick=tick
+ }
+ p.reason=.None;return true
+}
diff --git a/src/shared/prediction_static_test.odin b/src/shared/prediction_static_test.odin
new file mode 100644
index 0000000..1e25f2c
--- /dev/null
+++ b/src/shared/prediction_static_test.odin
@@ -0,0 +1,68 @@
+package shared
+import t "core:testing"
+import b2 "vendor:box2d"
+import log "core:log"
+
+test_prediction_static_scene :: proc() -> Scene {
+ s:=new_scene(0);s.epoch=1;s.structure_revision=1;s.anchor_y=-3
+ append(&s.materials,Material{})
+ points:=[4]Vec2{{-8,-3},{9,-3},{9,0},{-8,0}}
+ sub:=Subdivision{id=200,owner=100,material=0,outline=make_polygon(points[:]),rest_center={.5,-1.5},live=true}
+ s.sub_rows[200]=0;append(&s.subdivisions,sub)
+ piece:=Piece{id=100,material=0,live=true};append(&piece.subdivisions,u64(200));s.piece_rows[100]=0;append(&s.pieces,piece)
+ return s
+}
+
+@(test)
+static_prediction_replays_shared_run_jump_without_sandbox_respawn :: proc(test:^t.T) {
+ source:=test_prediction_static_scene();defer scene_destroy(&source)
+ predicted:Static_Prediction;defer prediction_static_destroy(&predicted)
+ t.expect(test,prediction_static_build(&predicted,&source))
+ def:=b2.DefaultWorldDef();def.gravity={0,-9.8};world:=b2.CreateWorld(def);defer b2.DestroyWorld(world)
+ bd:=b2.DefaultBodyDef();bd.position={.5,-1.5};ground:=b2.CreateBody(world,bd)
+ _=b2.CreatePolygonShape(ground,physics_shape_def(200),b2.MakeBox(8.5,1.5))
+ player:=player_create(world)
+ id:=Input_Identity{9007199254740999,1,9007199254741001}
+ history:Command_History;command_history_begin(&history,{id,1,9007199254742001})
+ schedule:=Input_Schedule{identity=id,synchronized=true}
+ owners:[256]Owner_State
+ future:[256]Vec2;future_valid:[256]bool
+ max_error:f32;compared:=0
+ for tick in u64(1)..=240 {
+  for history.next_tick<=tick+3 {
+   target:=history.next_tick;move:=target<120?i8(127):i8(-127)
+   edge:=target==30 || target==150?target:u64(0)
+   _,ok:=command_history_push(&history,move,edge);t.expect(test,ok)
+  }
+  command:=history.slots[tick%INPUT_HISTORY].command
+  player_before_step(&player,move_dequantize(command.move),command.jump_edge!=0,f32(NET_STEP_DT))
+  b2.World_Step(world,f32(NET_STEP_DT),PHYSICS_SUBSTEPS);player_after_movement_step(&player)
+  schedule.finalized_through=tick;schedule.last_applied_sequence=command.sequence
+  if command.jump_edge!=0 { schedule.last_jump_edge=command.jump_edge }
+  owners[tick%256]=owner_state_capture(&player,&schedule,tick,1)
+  if future_valid[tick%256] { max_error=max(max_error,vlen(vsub(future[tick%256],player.pose.position)));compared+=1 }
+  if tick>6 {
+   owner:=owners[(tick-6)%256]
+   t.expect(test,prediction_static_replay(&predicted,owner,&history))
+   t.expect(test,predicted.state_tick==tick+3 && predicted.reason==.None)
+   future[predicted.state_tick%256]=predicted.player.pose.position;future_valid[predicted.state_tick%256]=true
+   t.expect(test,command_history_finalize(&history,id,owner.finalized_through))
+  }
+ }
+ t.expect(test,compared>200 && max_error<.03)
+ log.infof("static shared-kernel replay comparisons=%d max_position_error=%.6f",compared,max_error)
+}
+
+@(test)
+static_prediction_rejects_dynamic_or_incompatible_history :: proc(test:^t.T) {
+ source:=test_prediction_static_scene();defer scene_destroy(&source)
+ predicted:Static_Prediction;defer prediction_static_destroy(&predicted)
+ source.anchor_y=-1e30
+ t.expect(test,!prediction_static_build(&predicted,&source) && predicted.reason==.Dynamic_History_Required)
+ source.anchor_y=-3;t.expect(test,prediction_static_build(&predicted,&source))
+ history:Command_History;command_history_begin(&history,{{1,1,1},1,1});_,_=command_history_push(&history,0,0)
+ owner:=Owner_State{identity={1,2,1},topology_revision=1}
+ t.expect(test,!prediction_static_replay(&predicted,owner,&history) && predicted.reason==.Wrong_Epoch)
+ owner.identity.epoch=1;owner.topology_revision=2
+ t.expect(test,!prediction_static_replay(&predicted,owner,&history) && predicted.reason==.Wrong_Revision)
+}
