diff --git a/src/shared/input_clock.odin b/src/shared/input_clock.odin
new file mode 100644
index 0000000..dcecdbf
--- /dev/null
+++ b/src/shared/input_clock.odin
@@ -0,0 +1,101 @@
+package shared
+
+import math "core:math"
+
+// Whole ticks never pass through f64. Only bounded differences and sub-ticks do.
+Server_Stamp :: struct { tick: u64, phase: f64 }
+Clock_Probe :: struct { active: bool, nonce: u64, sent: f64 }
+Clock_Sample :: struct { valid: bool, received,rtt: f64, stamp: Server_Stamp }
+Input_Clock :: struct {
+ probes: [32]Clock_Probe,
+ samples: [64]Clock_Sample,
+ sample_index: int,
+ next_nonce: u64,
+ valid,resync: bool,
+ estimate: Server_Stamp,
+ updated_at,rtt,jitter95,raw_error: f64,
+ lead: u32,
+ rejected,accepted: u64,
+}
+
+server_stamp_advance :: proc(s: Server_Stamp,seconds: f64) -> Server_Stamp {
+ if seconds<=0 || math.is_nan(seconds) || math.is_inf(seconds) { return s }
+ ticks:=min(seconds*60,3600.0*60)+s.phase
+ whole:=u64(math.floor(ticks))
+ if whole>max(u64)-s.tick { return {max(u64),0} }
+ return {s.tick+whole,ticks-f64(whole)}
+}
+server_stamp_error :: proc(a,b: Server_Stamp) -> f64 {
+ delta:f64
+ if a.tick>=b.tick { delta=f64(min(a.tick-b.tick,u64(1000000))) }
+ else { delta=-f64(min(b.tick-a.tick,u64(1000000))) }
+ return delta+a.phase-b.phase
+}
+server_stamp_adjust :: proc(s: Server_Stamp,delta: f64) -> Server_Stamp {
+ phase:=s.phase+clamp(delta,-0.05,0.05)
+ tick:=s.tick
+ if phase<0 { if tick==0 { return {} };tick-=1;phase+=1 }
+ if phase>=1 { if tick==max(u64) { return {tick,0} };tick+=1;phase-=1 }
+ return {tick,phase}
+}
+input_clock_probe :: proc(c: ^Input_Clock,now: f64) -> (u64,bool) {
+ if math.is_nan(now) || math.is_inf(now) || c.next_nonce==max(u64) { return 0,false }
+ // Reclaim only expired probes; never replace a live outstanding nonce.
+ for &p in c.probes {
+  if p.active && now-p.sent>1 { p={} }
+  if !p.active {
+   c.next_nonce+=1;p={true,c.next_nonce,now};return p.nonce,true
+  }
+ }
+ return 0,false
+}
+input_clock_now :: proc(c: ^Input_Clock,now: f64) -> (Server_Stamp,bool) {
+ if !c.valid || math.is_nan(now) || math.is_inf(now) { return {},false }
+ if now<c.updated_at { c.resync=true;return c.estimate,false }
+ if now-c.updated_at>0.25 { c.resync=true }
+ c.estimate=server_stamp_advance(c.estimate,now-c.updated_at);c.updated_at=now
+ return c.estimate,true
+}
+input_clock_echo :: proc(c: ^Input_Clock,nonce: u64,stamp: Server_Stamp,now: f64) -> bool {
+ if math.is_nan(now) || math.is_inf(now) || math.is_nan(stamp.phase) || math.is_inf(stamp.phase) || stamp.phase<0 || stamp.phase>=1 { c.rejected+=1;return false }
+ found: ^Clock_Probe
+ for &p in c.probes { if p.active && p.nonce==nonce { found=&p;break } }
+ if found==nil { c.rejected+=1;return false }
+ elapsed:=now-found.sent;found.active=false
+ if elapsed<0 || elapsed>1 || (c.accepted>=4 && elapsed>c.rtt*4+0.05) { c.rejected+=1;return false }
+ received_stamp:=server_stamp_advance(stamp,elapsed/2)
+ if c.accepted==0 { c.rtt=elapsed } else { c.rtt+=(elapsed-c.rtt)/8 }
+ c.samples[c.sample_index%len(c.samples)]={true,now,elapsed,received_stamp};c.sample_index=(c.sample_index+1)%len(c.samples)
+ // Positive one-way jitter distribution; insertion-sort a fixed bounded array.
+ positive:[64]f64;count:=0
+ best: ^Clock_Sample
+ for &sample in c.samples {
+  if !sample.valid || now-sample.received>8 { continue }
+  if best==nil || sample.rtt<best.rtt || (sample.rtt==best.rtt && sample.received>best.received) { best=&sample }
+  value:=max(0.0,(sample.rtt-c.rtt)/2);j:=count
+  for j>0 && positive[j-1]>value { positive[j]=positive[j-1];j-=1 }
+  positive[j]=value;count+=1
+ }
+ if count>0 { c.jitter95=positive[max(0,int(math.ceil(f64(count)*0.95))-1)] }
+ c.lead=u32(clamp(math.ceil((c.rtt/2+c.jitter95)*60)+2,2,15))
+ candidate:=server_stamp_advance(best.stamp,now-best.received)
+ if !c.valid { c.estimate=candidate;c.updated_at=now;c.valid=true }
+ else {
+  previous:=c.estimate
+  _,_=input_clock_now(c,now)
+  c.raw_error=server_stamp_error(candidate,c.estimate)
+  if math.abs(c.raw_error)>8 { c.resync=true }
+  adjusted:=server_stamp_adjust(c.estimate,c.raw_error)
+  // A negative correction can slow progress, but never reverse accepted time.
+  if server_stamp_error(adjusted,previous)>=0 { c.estimate=adjusted }
+ }
+ c.accepted+=1
+ return true
+}
+
+input_clock_target_origin :: proc(c: ^Input_Clock,now: f64) -> (u64,bool) {
+ stamp,valid:=input_clock_now(c,now)
+ if !valid || stamp.tick>max(u64)-u64(c.lead)-1 { return 0,false }
+ // Ceil phase then add the delivery margin, without converting the tick to float.
+ return stamp.tick+u64(stamp.phase>0)+u64(c.lead),true
+}
diff --git a/src/shared/input_clock_test.odin b/src/shared/input_clock_test.odin
new file mode 100644
index 0000000..697ce1e
--- /dev/null
+++ b/src/shared/input_clock_test.odin
@@ -0,0 +1,45 @@
+package shared
+import t "core:testing"
+import math "core:math"
+
+@(test)
+clock_exact_large_ticks_nonce_and_phase :: proc(test: ^t.T) {
+ c:Input_Clock;c.next_nonce=9007199254740993
+ nonce,ok:=input_clock_probe(&c,10);t.expect(test,ok && nonce==9007199254740994)
+ t.expect(test,input_clock_echo(&c,nonce,{9007199254742001,0.25},10.1))
+ stamp,valid:=input_clock_now(&c,10.1)
+ t.expect(test,valid && stamp.tick==9007199254742004 && math.abs(stamp.phase-0.25)<1e-6)
+ target,valid_target:=input_clock_target_origin(&c,10.1)
+ t.expect(test,valid_target && target==9007199254742004+1+u64(c.lead))
+ t.expect(test,!input_clock_echo(&c,nonce,{99,0},10.2))
+ t.expect(test,!input_clock_echo(&c,nonce+1,{99,0},10.2))
+}
+
+@(test)
+clock_bounded_probes_outliers_and_lead :: proc(test: ^t.T) {
+ c:Input_Clock
+ for i in 0..<32 { _,ok:=input_clock_probe(&c,f64(i)*0.001);t.expect(test,ok) }
+ _,overflow:=input_clock_probe(&c,0.05);t.expect(test,!overflow)
+ _,reclaimed:=input_clock_probe(&c,1.1);t.expect(test,reclaimed)
+ c={}
+ for i in 0..<20 {
+  now:=f64(i)*0.25;nonce,_:=input_clock_probe(&c,now)
+  t.expect(test,input_clock_echo(&c,nonce,{u64(i*15+3),0},now+0.1))
+ }
+ t.expect(test,c.lead>=5 && c.lead<=6 && c.accepted==20)
+ nonce,_:=input_clock_probe(&c,6)
+ t.expect(test,!input_clock_echo(&c,nonce,{600,0},6.9))
+ nonce,_=input_clock_probe(&c,7)
+ t.expect(test,!input_clock_echo(&c,nonce,{600,1},7.1))
+}
+
+@(test)
+clock_never_reverses_and_marks_discontinuity :: proc(test: ^t.T) {
+ c:Input_Clock;nonce,_:=input_clock_probe(&c,0)
+ _=input_clock_echo(&c,nonce,{1000,0},0.1)
+ old:=c.estimate
+ nonce,_=input_clock_probe(&c,0.11);_=input_clock_echo(&c,nonce,{1000,0},0.111)
+ t.expect(test,server_stamp_error(c.estimate,old)>=0)
+ _,valid:=input_clock_now(&c,0.05);t.expect(test,!valid && c.resync)
+ c.resync=false;_,valid=input_clock_now(&c,0.5);t.expect(test,valid && c.resync)
+}
diff --git a/src/shared/input_owner.odin b/src/shared/input_owner.odin
new file mode 100644
index 0000000..91bf774
--- /dev/null
+++ b/src/shared/input_owner.odin
@@ -0,0 +1,48 @@
+package shared
+import b2 "vendor:box2d"
+
+Owner_State :: struct {
+ identity: Input_Identity,
+ state_tick,topology_revision,finalized_through,last_applied_sequence,teleport_serial: u64,
+ position,velocity,support_velocity: Vec2,
+ coyote,buffered_jump: f32,
+ support_cell: u64,
+ grounded: bool,
+ support_kind: u8,
+ held: i8,
+ missing: u32,
+}
+owner_state_capture :: proc(player: ^Player,schedule: ^Input_Schedule,tick,revision: u64) -> Owner_State {
+ return {
+  identity=schedule.identity,state_tick=tick,topology_revision=revision,
+  finalized_through=schedule.finalized_through,last_applied_sequence=schedule.last_applied_sequence,
+  teleport_serial=player.teleport_serial,
+  position=from_b2(b2.Body_GetPosition(player.body)),velocity=from_b2(b2.Body_GetLinearVelocity(player.body)),
+  support_velocity=player.support_velocity,coyote=player.coyote,buffered_jump=player.buffered_jump,
+  support_cell=player.support_cell,grounded=player.grounded,support_kind=player.support_kind,
+  held=schedule.held,missing=schedule.missing,
+ }
+}
+owner_state_valid :: proc(o: Owner_State) -> bool {
+ return o.identity.incarnation!=0 && o.identity.generation!=0 && o.finalized_through<=o.state_tick &&
+  finite(o.position.x) && finite(o.position.y) && finite(o.velocity.x) && finite(o.velocity.y) &&
+  finite(o.support_velocity.x) && finite(o.support_velocity.y) && finite(o.coyote) && finite(o.buffered_jump) &&
+  o.coyote>=0 && o.coyote<=PLAYER_TUNING.coyote_time+0.00001 && o.buffered_jump>=0 && o.buffered_jump<=PLAYER_TUNING.jump_buffer+0.00001 &&
+  o.support_kind<=3 && o.held!=min(i8) && o.missing<=INPUT_HELD_GRACE+1 &&
+  (o.support_kind==1 || o.support_cell==0)
+}
+owner_state_restore :: proc(world: b2.WorldId,player: ^Player,o: Owner_State) -> bool {
+ if !owner_state_valid(o) { return false }
+ radius:=player.blast_radius
+ // Recreate only the prediction body: stale contact manifolds/warm starts may
+ // not survive an authoritative rewind. The server never calls this helper.
+ if player.active && b2.Body_IsValid(player.body) { b2.DestroyBody(player.body) }
+ player^=player_create(world,radius)
+ b2.Body_SetTransform(player.body,to_b2(o.position),b2.MakeRot(0))
+ b2.Body_SetLinearVelocity(player.body,to_b2(o.velocity))
+ player.grounded=o.grounded;player.coyote=o.coyote;player.buffered_jump=o.buffered_jump
+ player.support_velocity=o.support_velocity;player.support_cell=o.support_cell;player.support_kind=o.support_kind
+ player.teleport_serial=o.teleport_serial
+ player_refresh_pose(player)
+ return true
+}
diff --git a/src/shared/input_requests.odin b/src/shared/input_requests.odin
new file mode 100644
index 0000000..07264aa
--- /dev/null
+++ b/src/shared/input_requests.odin
@@ -0,0 +1,47 @@
+package shared
+
+REQUEST_RESULT_WINDOW :: 1024
+Request_Status :: enum u8 { Pending, Accepted, Rejected, Expired, Wrong_Epoch, Wrong_Connection, Too_Old, Conflict, Capacity }
+Request_Result :: struct { request_id,effect_tick,event_id: u64, status: Request_Status, reason: u16 }
+Request_Entry :: struct { occupied: bool, request_id,fingerprint: u64, result: Request_Result }
+Request_Cache :: struct {
+ incarnation: u64,
+ highest,low_watermark: u64,
+ entries: [REQUEST_RESULT_WINDOW]Request_Entry,
+}
+Request_Begin :: enum { New, Replay, Too_Old, Conflict, Capacity, Wrong_Connection }
+
+request_cache_begin :: proc(c: ^Request_Cache,incarnation,id,fingerprint: u64) -> (Request_Begin,Request_Result) {
+ if incarnation==0 || incarnation!=c.incarnation { return .Wrong_Connection,{request_id=id,status=.Wrong_Connection} }
+ if id==0 { return .Too_Old,{request_id=id,status=.Too_Old} }
+ slot:=&c.entries[id%REQUEST_RESULT_WINDOW]
+ if slot.occupied && slot.request_id==id {
+  if slot.fingerprint!=fingerprint { return .Conflict,{request_id=id,status=.Conflict} }
+  return .Replay,slot.result
+ }
+ if id<=c.low_watermark || id<=c.highest { return .Too_Old,{request_id=id,status=.Too_Old} }
+ if slot.occupied && slot.result.status==.Pending { return .Capacity,{request_id=id,status=.Capacity} }
+ if slot.occupied { c.low_watermark=max(c.low_watermark,slot.request_id) }
+ c.highest=id
+ slot^={occupied=true,request_id=id,fingerprint=fingerprint,result={request_id=id,status=.Pending}}
+ return .New,slot.result
+}
+request_cache_finish :: proc(c: ^Request_Cache,result: Request_Result) -> bool {
+ slot:=&c.entries[result.request_id%REQUEST_RESULT_WINDOW]
+ if !slot.occupied || slot.request_id!=result.request_id || slot.result.status!=.Pending || result.status==.Pending { return false }
+ slot.result=result;return true
+}
+request_cache_expire_epoch :: proc(c: ^Request_Cache,tick: u64) {
+ for &slot in c.entries {
+  if slot.occupied && slot.result.status==.Pending { slot.result={request_id=slot.request_id,effect_tick=tick,status=.Wrong_Epoch} }
+ }
+}
+// Exact tick age filter; bounds/rate/host/aim authorization remain separate.
+blast_intent_status :: proc(expected_incarnation,incarnation: u64,expected_epoch,epoch: u32,now_tick,created_tick,deadline_tick: u64) -> Request_Status {
+ if incarnation==0 || incarnation!=expected_incarnation { return .Wrong_Connection }
+ if epoch!=expected_epoch { return .Wrong_Epoch }
+ if created_tick>now_tick && created_tick-now_tick>2 { return .Rejected }
+ if deadline_tick<created_tick || deadline_tick-created_tick>30 { return .Rejected }
+ if now_tick>deadline_tick { return .Expired }
+ return .Accepted
+}
diff --git a/src/shared/input_requests_test.odin b/src/shared/input_requests_test.odin
new file mode 100644
index 0000000..5558dec
--- /dev/null
+++ b/src/shared/input_requests_test.odin
@@ -0,0 +1,45 @@
+package shared
+import t "core:testing"
+
+@(test)
+requests_terminal_replay_conflict_and_high_identifiers :: proc(test: ^t.T) {
+ c:=Request_Cache{incarnation=9007199254740999}
+ id:=u64(9007199254742001)
+ state,_:=request_cache_begin(&c,c.incarnation,id,77);t.expect_value(test,state,Request_Begin.New)
+ pending:Request_Result;state,pending=request_cache_begin(&c,c.incarnation,id,77)
+ t.expect(test,state==.Replay && pending.status==.Pending)
+ result:=Request_Result{id,9007199254743999,9007199254744001,.Accepted,0}
+ t.expect(test,request_cache_finish(&c,result))
+ replay:Request_Result;state,replay=request_cache_begin(&c,c.incarnation,id,77)
+ t.expect(test,state==.Replay && replay==result)
+ state,_=request_cache_begin(&c,c.incarnation,id,78);t.expect_value(test,state,Request_Begin.Conflict)
+ state,_=request_cache_begin(&c,c.incarnation+1,id,77);t.expect_value(test,state,Request_Begin.Wrong_Connection)
+ t.expect(test,!request_cache_finish(&c,result))
+}
+
+@(test)
+requests_eviction_watermark_never_reexecutes_old_or_unresolved :: proc(test: ^t.T) {
+ c:=Request_Cache{incarnation=1}
+ for id in u64(1)..=REQUEST_RESULT_WINDOW {
+  state,_:=request_cache_begin(&c,1,id,id);t.expect_value(test,state,Request_Begin.New)
+  if id!=1 { t.expect(test,request_cache_finish(&c,{request_id=id,status=.Rejected,reason=7})) }
+ }
+ state,_:=request_cache_begin(&c,1,REQUEST_RESULT_WINDOW+1,99);t.expect_value(test,state,Request_Begin.Capacity)
+ t.expect(test,request_cache_finish(&c,{request_id=1,status=.Accepted,effect_tick=60,event_id=90}))
+ state,_=request_cache_begin(&c,1,REQUEST_RESULT_WINDOW+1,99);t.expect_value(test,state,Request_Begin.New)
+ state,_=request_cache_begin(&c,1,1,1);t.expect_value(test,state,Request_Begin.Too_Old)
+ request_cache_expire_epoch(&c,100)
+ result:Request_Result;state,result=request_cache_begin(&c,1,REQUEST_RESULT_WINDOW+1,99)
+ t.expect(test,state==.Replay && result.status==.Wrong_Epoch && result.effect_tick==100)
+}
+
+@(test)
+requests_expiry_no_rewind_and_epoch_precondition :: proc(test: ^t.T) {
+ t.expect_value(test,blast_intent_status(1,1,4,4,100,75,105),Request_Status.Accepted)
+ t.expect_value(test,blast_intent_status(1,1,4,4,106,75,105),Request_Status.Expired)
+ t.expect_value(test,blast_intent_status(1,1,4,3,100,75,105),Request_Status.Wrong_Epoch)
+ t.expect_value(test,blast_intent_status(1,2,4,4,100,75,105),Request_Status.Wrong_Connection)
+ t.expect_value(test,blast_intent_status(1,1,4,4,100,103,130),Request_Status.Rejected)
+ t.expect_value(test,blast_intent_status(1,1,4,4,100,90,121),Request_Status.Rejected)
+ t.expect_value(test,blast_intent_status(1,1,4,4,100,100,99),Request_Status.Rejected)
+}
diff --git a/src/shared/input_schedule.odin b/src/shared/input_schedule.odin
new file mode 100644
index 0000000..811b0ea
--- /dev/null
+++ b/src/shared/input_schedule.odin
@@ -0,0 +1,117 @@
+package shared
+
+// M5 scheduling kernel. Integration into the v4 wire path follows separately.
+// All identities and target arithmetic remain integer; no presentation clock here.
+INPUT_FUTURE_WINDOW :: u64(32)
+INPUT_HELD_GRACE :: u32(6)
+INPUT_HISTORY :: 256
+
+Scheduled_Command :: struct {
+ sequence, target_tick: u64,
+ move: i8,
+ jump_edge: u64,
+}
+Input_Identity :: struct { incarnation: u64, epoch: u32, generation: u64 }
+Schedule_Proposal :: struct { identity: Input_Identity, first_tick, first_sequence: u64 }
+Schedule_Result :: enum { Accepted, Wrong_Connection, Wrong_Epoch, Old_Generation, Obsolete, Too_Far, Overflow }
+Command_Result :: enum { Accepted, Duplicate, Conflict, Too_Late, Too_Far, Wrong_Identity, Wrong_Slot, Invalid_Move, Not_Synchronized }
+Schedule_Slot :: struct { occupied: bool, command: Scheduled_Command }
+Input_Schedule :: struct {
+ identity: Input_Identity,
+ synchronized: bool,
+ first_tick,first_sequence,finalized_through,last_applied_sequence,last_jump_edge: u64,
+ slots: [32]Schedule_Slot,
+ held: i8,
+ missing: u32,
+ accepted,duplicates,conflicts,too_late,wrong_identity,starved,neutralized,duplicate_jumps: u64,
+}
+Scheduled_Step :: struct { command: Scheduled_Command, applied,carried,neutralized: bool }
+
+input_schedule_reset :: proc(s: ^Input_Schedule,incarnation: u64,epoch: u32,now_tick: u64,p: Schedule_Proposal) -> Schedule_Result {
+ if p.identity.incarnation!=incarnation || incarnation==0 { return .Wrong_Connection }
+ if p.identity.epoch!=epoch { return .Wrong_Epoch }
+ if p.identity.generation==0 || (s.synchronized && p.identity.incarnation==s.identity.incarnation && p.identity.generation<=s.identity.generation) { return .Old_Generation }
+ if now_tick>max(u64)-INPUT_FUTURE_WINDOW || p.first_sequence==0 || p.first_sequence>max(u64)-INPUT_FUTURE_WINDOW { return .Overflow }
+ if p.first_tick<now_tick+2 { return .Obsolete }
+ if p.first_tick>now_tick+INPUT_FUTURE_WINDOW { return .Too_Far }
+ // Rejection above leaves the previous schedule completely unchanged.
+ s^=Input_Schedule{identity=p.identity,synchronized=true,first_tick=p.first_tick,first_sequence=p.first_sequence,finalized_through=now_tick}
+ return .Accepted
+}
+
+input_schedule_insert :: proc(s: ^Input_Schedule,identity: Input_Identity,now_tick: u64,c: Scheduled_Command) -> Command_Result {
+ if !s.synchronized { return .Not_Synchronized }
+ if identity!=s.identity { s.wrong_identity+=1;return .Wrong_Identity }
+ if c.move==min(i8) { return .Invalid_Move }
+ if c.target_tick<=s.finalized_through || c.target_tick<=now_tick { s.too_late+=1;return .Too_Late }
+ if c.target_tick-now_tick>INPUT_FUTURE_WINDOW { return .Too_Far }
+ if c.target_tick<s.first_tick { return .Wrong_Slot }
+ offset:=c.target_tick-s.first_tick
+ if offset>max(u64)-s.first_sequence || c.sequence!=s.first_sequence+offset { return .Wrong_Slot }
+ slot:=&s.slots[c.target_tick%u64(len(s.slots))]
+ if slot.occupied && slot.command.target_tick>s.finalized_through {
+  if slot.command==c { s.duplicates+=1;return .Duplicate }
+  s.conflicts+=1;return .Conflict
+ }
+ slot^={occupied=true,command=c};s.accepted+=1
+ return .Accepted
+}
+
+input_schedule_consume :: proc(s: ^Input_Schedule,tick: u64) -> (step: Scheduled_Step) {
+ if !s.synchronized || tick<=s.finalized_through { return }
+ // A discontinuity cannot carry stale held movement across the skipped interval.
+ if tick!=s.finalized_through+1 { s.held=0;s.missing=INPUT_HELD_GRACE }
+ slot:=&s.slots[tick%u64(len(s.slots))]
+ if tick>=s.first_tick && slot.occupied && slot.command.target_tick==tick {
+  step.command=slot.command;step.applied=true;slot^={}
+  s.held=step.command.move;s.missing=0;s.last_applied_sequence=step.command.sequence
+  if step.command.jump_edge!=0 {
+   if step.command.jump_edge<=s.last_jump_edge { step.command.jump_edge=0;s.duplicate_jumps+=1 }
+   else { s.last_jump_edge=step.command.jump_edge }
+  }
+ } else {
+  s.missing=min(s.missing+1,INPUT_HELD_GRACE+1);s.starved+=1
+  step.command.target_tick=tick
+  if tick>=s.first_tick && s.missing<=INPUT_HELD_GRACE { step.command.move=s.held;step.carried=true }
+  else { s.held=0;step.neutralized=true;s.neutralized+=1 }
+ }
+ s.finalized_through=tick
+ return
+}
+
+Command_History :: struct {
+ identity: Input_Identity,
+ first_tick,first_sequence,next_tick,next_sequence,finalized_through: u64,
+ accepted: bool,
+ slots: [INPUT_HISTORY]Schedule_Slot,
+}
+command_history_begin :: proc(h: ^Command_History,p: Schedule_Proposal) {
+ h^={identity=p.identity,first_tick=p.first_tick,first_sequence=p.first_sequence,next_tick=p.first_tick,next_sequence=p.first_sequence,accepted=true}
+}
+command_history_push :: proc(h: ^Command_History,move: i8,jump_edge: u64) -> (Scheduled_Command,bool) {
+ if !h.accepted || move==min(i8) || h.next_tick==max(u64) || h.next_sequence==max(u64) { return {},false }
+ slot:=&h.slots[h.next_tick%INPUT_HISTORY]
+ if slot.occupied && slot.command.target_tick>h.finalized_through { return {},false }
+ c:=Scheduled_Command{sequence=h.next_sequence,target_tick=h.next_tick,move=move,jump_edge=jump_edge}
+ slot^={occupied=true,command=c};h.next_sequence+=1;h.next_tick+=1
+ return c,true
+}
+command_history_finalize :: proc(h: ^Command_History,identity: Input_Identity,tick: u64) -> bool {
+ if !h.accepted || identity!=h.identity || tick<h.finalized_through { return false }
+ // An owner may finalize missing slots; it may not ACK commands from the future.
+ if tick>=h.next_tick { return false }
+ h.finalized_through=tick
+ for &slot in h.slots { if slot.occupied && slot.command.target_tick<=tick { slot={} } }
+ return true
+}
+command_history_redundancy :: proc(h: ^Command_History) -> (out: [4]Scheduled_Command,count: int) {
+ if !h.accepted || h.next_tick<=h.first_tick { return }
+ tick:=h.next_tick-1
+ for count<4 && tick>=h.first_tick {
+  slot:=h.slots[tick%INPUT_HISTORY]
+  if !slot.occupied || slot.command.target_tick!=tick { break }
+  out[count]=slot.command;count+=1
+  if tick==0 { break };tick-=1
+ }
+ return
+}
diff --git a/src/shared/input_schedule_test.odin b/src/shared/input_schedule_test.odin
