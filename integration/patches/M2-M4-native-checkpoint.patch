diff --git a/src/shared/sim_geometry.odin b/src/shared/sim_geometry.odin
new file mode 100644
index 0000000..86b3976
--- /dev/null
+++ b/src/shared/sim_geometry.odin
@@ -0,0 +1,204 @@
+#+feature dynamic-literals
+package shared
+
+import time "core:time"
+import math "core:math"
+import slice "core:slice"
+
+Cut_Boundary :: struct { a,b: int, segment: Segment }
+
+convex_hull :: proc(points: []Vec2) -> [dynamic]Vec2 {
+	sorted: [dynamic]Vec2
+	defer delete(sorted)
+	for point in points { append(&sorted,point) }
+	slice.sort_by(sorted[:],proc(a,b: Vec2) -> bool { return a.x<b.x || a.x==b.x && a.y<b.y })
+
+	hull: [dynamic]Vec2
+	if len(sorted)<2 { for p in sorted { append(&hull,p) }; return hull }
+	for p in sorted {
+		for len(hull)>=2 && vcross(vsub(hull[len(hull)-1],hull[len(hull)-2]),vsub(p,hull[len(hull)-1]))<=0 { resize(&hull,len(hull)-1) }
+		append(&hull,p)
+	}
+	upper_start:=len(hull)+1
+	for i:=len(sorted)-2; i>=0; i-=1 {
+		p:=sorted[i]
+		for len(hull)>=upper_start && vcross(vsub(hull[len(hull)-1],hull[len(hull)-2]),vsub(p,hull[len(hull)-1]))<=0 { resize(&hull,len(hull)-1) }
+		append(&hull,p)
+	}
+	resize(&hull,len(hull)-1)
+	return hull
+}
+
+convex_hull_into :: proc(points,sorted_storage,hull:[]Vec2) -> []Vec2 {
+ sorted:=sorted_storage[:len(points)]; copy(sorted,points)
+ slice.sort_by(sorted,proc(a,b:Vec2)->bool { return a.x<b.x || a.x==b.x && a.y<b.y })
+ count:=0
+ if len(sorted)<2 { copy(hull,sorted); return hull[:len(sorted)] }
+ for p in sorted {
+  for count>=2 && vcross(vsub(hull[count-1],hull[count-2]),vsub(p,hull[count-1]))<=0 { count-=1 }
+  hull[count]=p; count+=1
+ }
+ upper:=count+1
+ for i:=len(sorted)-2; i>=0; i-=1 { p:=sorted[i]
+  for count>=upper && vcross(vsub(hull[count-1],hull[count-2]),vsub(p,hull[count-1]))<=0 { count-=1 }
+  hull[count]=p; count+=1
+ }
+ return hull[:count-1]
+}
+
+inherits_old_boundary :: proc(a,b,old_a,old_b: Polygon,known: []Segment = nil,known_current: []Segment = nil) -> bool {
+ when BOM_PROFILE { started:=time.tick_now(); defer profile_add(14,started); if blast_profile!=nil { blast_profile.counts[4]+=1 } }
+
+ current:=known_current
+ current_owned:[dynamic]Segment; defer delete(current_owned)
+ if current==nil { current_owned=shared_segments(a,b); current=current_owned[:] }
+	original := known
+ owned:[dynamic]Segment; defer delete(owned)
+ if original==nil { owned=shared_segments(old_a,old_b); original=owned[:] }
+	for x in current { for y in original { if _,ok := segment_overlap(x,y); ok { return true } } }
+	return false
+}
+
+insert_polygon_vertex :: proc(p: ^Polygon,index: int,point: Vec2) {
+	points:=make([]Vec2,len(p.points)+1)
+	copy(points[:index],p.points[:index]); points[index]=point
+	copy(points[index+1:],p.points[index:])
+	delete(p.points); p.points=points
+}
+
+insert_boundary_endpoint :: proc(p: ^Polygon,point: Vec2) {
+	for existing in p.points { if vlen(vsub(existing,point)) < 0.00001 { return } }
+	for i in 0..<len(p.points) {
+		a,b := p.points[i],p.points[(i+1)%len(p.points)]
+		edge := vsub(b,a)
+		length := vlen(edge)
+		if length < 0.00001 { continue }
+		t := vdot(vsub(point,a),edge)/(length*length)
+		if t > 0 && t < 1 && math.abs(vcross(edge,vsub(point,a))) < 0.00001*length { insert_polygon_vertex(p,i+1,point); return }
+	}
+}
+
+insert_shared_midpoint :: proc(p: ^Polygon,segment: Segment,point: Vec2) {
+	insert_boundary_endpoint(p,segment.a)
+	insert_boundary_endpoint(p,segment.b)
+	for i in 0..<len(p.points) {
+		a,b := p.points[i],p.points[(i+1)%len(p.points)]
+		if (vlen(vsub(a,segment.a)) < 0.00001 && vlen(vsub(b,segment.b)) < 0.00001) || (vlen(vsub(b,segment.a)) < 0.00001 && vlen(vsub(a,segment.b)) < 0.00001) {
+			insert_polygon_vertex(p,i+1,point)
+			return
+		}
+	}
+}
+
+displace_shared_boundaries :: proc(children: []Polygon,seed: u8,minimum_width: f32 = 0,grained: bool = false) {
+	boundaries: [dynamic]Cut_Boundary
+	defer delete(boundaries)
+	for i in 0..<len(children) {
+		for j in i+1..<len(children) {
+			segments := shared_segments(children[i],children[j])
+			for segment in segments { append(&boundaries,Cut_Boundary{i,j,segment}) }
+			delete(segments)
+		}
+	}
+	for boundary,index in boundaries {
+  if grained && displace_grained_seam(children,boundary,seed,index,minimum_width) { continue }
+		edge := vsub(boundary.segment.b,boundary.segment.a)
+		length := vlen(edge)
+		normal := Vec2{-edge.y/length,edge.x/length}
+		amplitude := min(length*0.04,min(polygon_area(children[boundary.a]),polygon_area(children[boundary.b]))/length*0.08)
+		base := vmul(vadd(boundary.segment.a,boundary.segment.b),0.5)
+		// The area cap alone can cross another edge in thin or concave children.
+		// Bound displacement by clearance, as in the reference partition generator.
+		neighbors := [2]int{boundary.a,boundary.b}
+		for index in neighbors {
+			polygon := children[index]
+			for a,i in polygon.points {
+				b := polygon.points[(i+1)%len(polygon.points)]
+				edge := vsub(b,a)
+				if vdot(edge,edge)<0.000000000001 { continue }
+				if _,shared := segment_overlap(Segment{a,b},boundary.segment); shared { continue }
+				t := clamp(vdot(vsub(base,a),edge)/vdot(edge,edge),f32(0),f32(1))
+				amplitude=min(amplitude,vlen(vsub(base,vadd(a,vmul(edge,t))))*0.2)
+			}
+		}
+		if derive_seed(seed,u64(index+1))%2 == 0 { amplitude = -amplitude }
+  // Test both complete outlines, including endpoint touches. Shallow bends
+  // may approach a concave edge; reduce only this seam before giving it up.
+  for attempt in 0..<4 {
+   mid:=vadd(base,vmul(normal,amplitude))
+   left,right:=make_polygon(children[boundary.a].points),make_polygon(children[boundary.b].points)
+   insert_shared_midpoint(&left,boundary.segment,mid); insert_shared_midpoint(&right,boundary.segment,mid)
+   valid:=simple_polygon(left) && simple_polygon(right) && outline_width(left.points)>=minimum_width && outline_width(right.points)>=minimum_width
+   if valid {
+    delete(children[boundary.a].points); delete(children[boundary.b].points)
+    children[boundary.a]=left; children[boundary.b]=right
+    break
+   }
+   delete(left.points); delete(right.points); amplitude*=0.5
+  }
+	}
+}
+
+convex_decomposition :: proc(outline: Polygon) -> [dynamic]Polygon {
+	parts:=triangulate_polygon(outline)
+	for {
+		merged:=false
+		for i in 0..<len(parts) {
+			for j in i+1..<len(parts) {
+				if !inheritance_bounds_overlap(parts[i],parts[j]) { continue }
+				if length,_:=shared_boundary(parts[i],parts[j]); length<=0 { continue }
+				points: [dynamic]Vec2
+				for point in parts[i].points { append(&points,point) }
+				for point in parts[j].points { append(&points,point) }
+				hull:=convex_hull(points[:]); delete(points)
+				combined:=make_polygon(hull[:]); delete(hull)
+				error:=math.abs(polygon_area(combined)-polygon_area(parts[i])-polygon_area(parts[j]))
+				if len(combined.points)<=8 && error<0.000001 {
+					delete(parts[i].points); delete(parts[j].points)
+					parts[i]=combined; ordered_remove(&parts,j); merged=true; break
+				}
+				delete(combined.points)
+			}
+			if merged { break }
+		}
+		if !merged { break }
+	}
+	return parts
+}
+
+polygon_turn :: proc(a,b,c: Vec2) -> f64 {
+ return (f64(b.x)-f64(a.x))*(f64(c.y)-f64(a.y))-(f64(b.y)-f64(a.y))*(f64(c.x)-f64(a.x))
+}
+
+segments_touch :: proc(a,b,c,d: Vec2,tolerance: f64) -> bool {
+ ab_c,ab_d:=polygon_turn(a,b,c),polygon_turn(a,b,d)
+ cd_a,cd_b:=polygon_turn(c,d,a),polygon_turn(c,d,b)
+ if (ab_c>0 && ab_d<0 || ab_c<0 && ab_d>0) && (cd_a>0 && cd_b<0 || cd_a<0 && cd_b>0) { return true }
+ pairs:=[4][3]Vec2{{a,b,c},{a,b,d},{c,d,a},{c,d,b}}
+ for pair in pairs {
+  x,y,p:=pair[0],pair[1],pair[2]
+  if math.abs(polygon_turn(x,y,p))<=tolerance*f64(vlen(vsub(y,x))) &&
+     f64(p.x)>=f64(min(x.x,y.x))-tolerance && f64(p.x)<=f64(max(x.x,y.x))+tolerance &&
+     f64(p.y)>=f64(min(x.y,y.y))-tolerance && f64(p.y)<=f64(max(x.y,y.y))+tolerance { return true }
+ }
+ return false
+}
+
+simple_polygon :: proc(p: Polygon) -> bool {
+ if active_cover!=nil && !blast_scratch_active && len(p.points)>=12 { return blast_cached_simple(p) }
+ return simple_polygon_uncached(p)
+}
+
+simple_polygon_uncached :: proc(p: Polygon) -> bool {
+ if len(p.points)<3 { return false }
+ tolerance:=f64(longest_dimension(p))*0.00000001
+ for a,i in p.points {
+  b:=p.points[(i+1)%len(p.points)]
+  if f64(vlen(vsub(b,a)))<=tolerance { return false }
+  for j in i+1..<len(p.points) {
+   if j==i+1 || i==0 && j==len(p.points)-1 { continue }
+   if segments_touch(a,b,p.points[j],p.points[(j+1)%len(p.points)],tolerance) { return false }
+  }
+ }
+ return true
+}
diff --git a/src/shared/sim_glass_shock.odin b/src/shared/sim_glass_shock.odin
new file mode 100644
index 0000000..8c9290b
--- /dev/null
+++ b/src/shared/sim_glass_shock.odin
@@ -0,0 +1,193 @@
+#+feature dynamic-literals
+package shared
+
+import time "core:time"
+
+Shock_Cell :: struct { group: int, direct,reached: bool, load: f32 }
+
+Shock_Source :: struct { group,material: int, point: Vec2, load: f32 }
+
+Shock_Transaction :: struct {
+ groups: map[u64]int,
+ cells: map[u64]Shock_Cell,
+ sources: [dynamic]Shock_Source,
+}
+
+shock_destroy :: proc(shock: ^Shock_Transaction) { delete(shock.groups); delete(shock.cells); delete(shock.sources); shock^={} }
+
+shock_group :: proc(shock: ^Shock_Transaction,s: ^Scene,piece: Piece) -> int {
+ if group,ok:=shock.groups[piece.id]; ok { return group }
+ if shock.groups==nil { shock.groups=make(map[u64]int); shock.cells=make(map[u64]Shock_Cell) }
+ group:=len(shock.groups); shock.groups[piece.id]=group
+ for id in piece.subdivisions { if is_live_subdivision(s,id) { shock.cells[id]={group=group} } }
+ return group
+}
+
+shock_rest_point :: proc(sub: Subdivision,point: Vec2) -> Vec2 { return vadd(sub.rest_center,vrotate(vsub(point,sub.pose.position),-sub.pose.angle)) }
+
+shock_nearest_segment :: proc(point,a,b: Vec2) -> Vec2 {
+ edge:=vsub(b,a); squared:=vdot(edge,edge)
+ if squared<=0 { return a }
+ return vadd(a,vmul(edge,clamp(vdot(vsub(point,a),edge)/squared,f32(0),f32(1))))
+}
+
+shock_rest_distance :: proc(point: Vec2,outline: Polygon) -> f32 {
+ inside:=false; distance:=f32(1e30)
+ for a,i in outline.points {
+  b:=outline.points[(i+1)%len(outline.points)]
+  distance=min(distance,vlen(vsub(point,shock_nearest_segment(point,a,b))))
+  if (a.y>point.y)!=(b.y>point.y) && point.x<(b.x-a.x)*(point.y-a.y)/(b.y-a.y)+a.x { inside=!inside }
+ }
+ if inside { return 0 }; return distance
+}
+
+shock_begin_blast :: proc(s: ^Scene,blast: Blast) -> Shock_Transaction {
+ when BOM_PROFILE { started:=time.tick_now(); defer profile_add(2,started) }
+
+ shock:=Shock_Transaction{}
+ owners:[dynamic]u64; defer delete(owners)
+ for p in s.pieces { if p.live && s.materials[p.material].shock_loss>0 { append(&owners,p.id) } }; sort_ids(owners[:])
+ for owner in owners {
+  piece:=s.pieces[s.piece_rows[owner]]; material:=s.materials[piece.material]
+  ids:=sorted_ids(piece.subdivisions[:])
+  distance:=f32(1e30); point,rest:Vec2
+  for id in ids {
+   sub:=s.subdivisions[s.sub_rows[id]]; if !sub.live { continue }
+   if point_in_subdivision(sub,blast.position) { point=blast.position; rest=shock_rest_point(sub,point); distance=0; break }
+   for a,i in sub.outline.points {
+    q:=shock_nearest_segment(blast.position,posed_point(sub,a),posed_point(sub,sub.outline.points[(i+1)%len(sub.outline.points)]))
+    d:=vlen(vsub(blast.position,q))
+    if d<distance { distance=d; point=q; rest=shock_rest_point(sub,q) }
+   }
+  }
+  delete(ids)
+  if blast_load(distance,blast.radius)<material.connection_strength || blast_load(distance,blast.radius)<=0 { continue }
+  load:=blast_load(cover_distance(point,blast.position,owner),blast.radius)
+  if load<material.connection_strength || load<=0 { continue }
+  group:=shock_group(&shock,s,piece)
+  append(&shock.sources,Shock_Source{group,piece.material,rest,load})
+ }
+ return shock
+}
+
+shock_begin_impact :: proc(s: ^Scene,failures: Failures) -> Shock_Transaction {
+ shock:=Shock_Transaction{}
+ if !failures.impact || len(failures.impact_sources)==0 { return shock }
+ ids:[dynamic]u64; defer delete(ids)
+ sources:=make(map[u64]Impact_Shock_Source); defer delete(sources)
+ for source in failures.impact_sources { sources[source.cell]=source; append(&ids,source.cell) }; sort_ids(ids[:])
+ for id in ids {
+  if !is_live_subdivision(s,id) { continue }
+  sub:=s.subdivisions[s.sub_rows[id]]; material:=s.materials[sub.material]; source:=sources[id]
+  if material.shock_loss<=0 || source.load<material.connection_strength { continue }
+  group:=shock_group(&shock,s,s.pieces[s.piece_rows[sub.owner]])
+  append(&shock.sources,Shock_Source{group,sub.material,shock_rest_point(sub,source.point),source.load})
+ }
+ return shock
+}
+
+shock_mark_direct :: proc(shock: ^Shock_Transaction,id: u64) {
+ if shock==nil { return }
+ if cell,ok:=shock.cells[id]; ok { cell.direct=true; shock.cells[id]=cell }
+}
+
+shock_inherit :: proc(shock: ^Shock_Transaction,parent,child: u64) {
+ if shock==nil { return }
+ // A new child has not itself failed directly. Only its ancestry and any
+ // already-computed shock travel with it; the shock failure pass is one wave.
+ if cell,ok:=shock.cells[parent]; ok { cell.direct=false; shock.cells[child]=cell }
+}
+
+Shock_Queue_Entry :: struct { cost: f32, id: u64 }
+
+shock_before :: proc(a,b: Shock_Queue_Entry) -> bool { return a.cost<b.cost || a.cost==b.cost && a.id<b.id }
+
+shock_queue_push :: proc(queue: ^[dynamic]Shock_Queue_Entry,item: Shock_Queue_Entry) {
+ append(queue,item); i:=len(queue^)-1
+ for i>0 { parent:=(i-1)/2; if !shock_before(queue^[i],queue^[parent]) { break }; queue^[i],queue^[parent]=queue^[parent],queue^[i]; i=parent }
+}
+
+shock_queue_pop :: proc(queue: ^[dynamic]Shock_Queue_Entry) -> Shock_Queue_Entry {
+ item:=queue^[0]; queue^[0]=queue^[len(queue^)-1]; resize(queue,len(queue^)-1); i:=0
+ for {
+  child:=i*2+1; if child>=len(queue^) { break }
+  if child+1<len(queue^) && shock_before(queue^[child+1],queue^[child]) { child+=1 }
+  if !shock_before(queue^[child],queue^[i]) { break }
+  queue^[i],queue^[child]=queue^[child],queue^[i]; i=child
+ }
+ return item
+}
+
+shock_travel :: proc(s: ^Scene,shock: ^Shock_Transaction,source: Shock_Source) {
+ when BOM_PROFILE { started:=time.tick_now(); defer profile_add(2,started) }
+
+ ids:[dynamic]u64; defer delete(ids)
+ distances:=make(map[u64]f32); defer delete(distances)
+ nearest:=f32(1e30)
+ for id,cell in shock.cells {
+  if cell.group!=source.group || !is_live_subdivision(s,id) { continue }
+  sub:=s.subdivisions[s.sub_rows[id]]; if sub.material!=source.material { continue }
+  distance:=shock_rest_distance(source.point,sub.outline); distances[id]=distance
+  append(&ids,id); nearest=min(nearest,distance)
+ }
+ sort_ids(ids[:])
+ costs:=make(map[u64]f32); defer delete(costs)
+ queue:[dynamic]Shock_Queue_Entry; defer delete(queue)
+ for id in ids {
+  sub:=s.subdivisions[s.sub_rows[id]]
+  if distances[id]<=nearest+0.5 {
+   cost:=vlen(vsub(source.point,sub.rest_center)); costs[id]=cost; shock_queue_push(&queue,Shock_Queue_Entry{cost,id})
+  }
+ }
+ for len(queue)>0 {
+  entry:=shock_queue_pop(&queue)
+  if costs[entry.id]!=entry.cost { continue }
+  sub:=s.subdivisions[s.sub_rows[entry.id]]
+  cell:=shock.cells[entry.id]; load:=source.load-s.materials[source.material].shock_loss*entry.cost
+  if !cell.reached || load>cell.load { cell.reached=true; cell.load=load; shock.cells[entry.id]=cell }
+  links:=sorted_ids(sub.incident_links[:])
+  for id in links {
+   link:=s.connections[s.conn_rows[id]]; if !link.live || link.mortar { continue }
+   other:=link.a; if other==sub.id { other=link.b }
+   next,ok:=shock.cells[other]
+   if !ok || next.group!=source.group || !is_live_subdivision(s,other) { continue }
+   neighbour:=s.subdivisions[s.sub_rows[other]]; if neighbour.material!=source.material { continue }
+   cost:=entry.cost+vlen(vsub(sub.rest_center,neighbour.rest_center))
+   if previous,seen:=costs[other]; !seen || cost<previous { costs[other]=cost; shock_queue_push(&queue,Shock_Queue_Entry{cost,other}) }
+  }
+  delete(links)
+ }
+}
+
+shock_apply :: proc(s: ^Scene,shock: ^Shock_Transaction,affected: ^map[u64]bool,impact: bool) -> bool {
+ if len(shock.sources)==0 { return false }
+ for source in shock.sources { shock_travel(s,shock,source) }
+ ids:[dynamic]u64; defer delete(ids)
+ for id in shock.cells { if is_live_subdivision(s,id) { append(&ids,id) } }; sort_ids(ids[:])
+ failures:=Failures{impact=impact,no_sibling_bonds=true}; defer free_failures(&failures)
+ for id in ids {
+  cell:=shock.cells[id]; sub:=s.subdivisions[s.sub_rows[id]]
+  if cell.reached && !cell.direct && fails(cell.load,s.materials[sub.material].subdivision_strength) { append(&failures.subdivisions,id) }
+ }
+ when BOM_PROFILE { if blast_profile!=nil { blast_profile.counts[1]+=len(failures.subdivisions) } }
+ changed:=len(failures.subdivisions)>0
+ // One wave only. Children inherit their parent's load and lineage, but are
+ // never submitted to a second shock failure or a direct-blast recursion.
+ when BOM_PROFILE { staging_start:=time.tick_now() }
+ stage_failures(s,failures,affected,false,0,shock)
+ when BOM_PROFILE { profile_add(3,staging_start); bond_start:=time.tick_now(); defer profile_add(4,bond_start) }
+ clear(&ids)
+ links:=make(map[u64]bool); defer delete(links)
+ for id,cell in shock.cells { if cell.reached && is_live_subdivision(s,id) { for link in s.subdivisions[s.sub_rows[id]].incident_links { links[link]=true } } }
+ for id in links { if s.connections[s.conn_rows[id]].live { append(&ids,id) } }; sort_ids(ids[:])
+ for id in ids {
+  c:=s.connections[s.conn_rows[id]]; if c.mortar { continue }; a,a_ok:=shock.cells[c.a]; b,b_ok:=shock.cells[c.b]
+  if !a_ok || !b_ok || !a.reached || !b.reached || a.group!=b.group { continue }
+  left,right:=s.subdivisions[s.sub_rows[c.a]],s.subdivisions[s.sub_rows[c.b]]
+  if !left.live || !right.live || left.material!=right.material || s.materials[left.material].shock_loss<=0 { continue }
+  if fails(min(a.load,b.load),s.materials[left.material].connection_strength) {
+   s.connections[s.conn_rows[id]].live=false; affected^[left.owner]=true; changed=true
+  }
+ }
+ return changed
+}
diff --git a/src/shared/sim_glue.odin b/src/shared/sim_glue.odin
new file mode 100644
index 0000000..965a128
--- /dev/null
+++ b/src/shared/sim_glue.odin
@@ -0,0 +1,114 @@
+#+feature dynamic-literals
+package shared
+
+import math "core:math"
+
+GLUE_CONTACT :: f32(0.001)
+
+GLUE_FILLET :: f32(0.2)
+
+GLUE_STEP :: f32(0.05)
+
+layout_object :: proc(l:^Layout,id:u64)->(Authored_Shape,bool) {
+ for object in l.objects { if object.identity==id { return object,true } };return {},false
+}
+
+layout_glue_problem :: proc(l:^Layout,link:Glue_Link)->string {
+ if link.a==0 || link.a==link.b || link.b!=0 && link.a>link.b { return "Invalid glue identities" }
+ a,ok:=layout_object(l,link.a);if !ok { return "Glue references a missing identity" }
+ b:=Authored_Shape{lo={YARD_LEFT,YARD_FLOOR_BOTTOM},hi={YARD_RIGHT,0}}
+ if link.b!=0 { exists:bool;b,exists=layout_object(l,link.b);if !exists { return "Glue references a missing identity" } }
+ for old in l.glue { if old==link { return "Duplicate glue" } }
+ pa,pb:=shape_polygon(a),shape_polygon(b);defer delete(pa.points);defer delete(pb.points)
+ if !glue_valid_contact(pa,pb,link.b==0) { return "Objects must touch to glue" };return ""
+}
+
+built_polygon :: proc(o:Built_Object)->Polygon {
+ if o.count>0 { vertices:=o.vertices; return make_polygon(vertices[:o.count]) };return shape_polygon(Authored_Shape{lo=o.lo,hi=o.hi})
+}
+
+built_on_ground :: proc(o:Built_Object)->bool {
+ if o.count==0 { return o.lo.y==0 };p:=built_polygon(o);defer delete(p.points)
+ for v,i in p.points { if math.abs(v.y)<1e-6 && math.abs(p.points[(i+1)%len(p.points)].y)<1e-6 { return true } };return false
+}
+
+glue_side :: proc(x,y:Polygon,ground:bool=false)->[dynamic]Glue_Sample {
+ samples:[dynamic]Glue_Sample
+ for a,i in x.points {
+  edge:=vsub(x.points[(i+1)%len(x.points)],a);length:=vlen(edge);if length<1e-7 { continue }
+  n:=int(math.ceil(length/GLUE_STEP));normal:=Vec2{edge.y/length,-edge.x/length}
+  for j in 0..<n {
+   p:=vadd(a,vmul(edge,(f32(j)+0.5)/f32(n)));q:=p;hit:=false;distance:=GLUE_FILLET+1e-6
+   if ground {
+    if math.abs(p.y)<=GLUE_CONTACT { q={p.x,0};hit=true } else if normal.y<0 { t:=-p.y/normal.y;if t>=0 && t<=GLUE_FILLET { q=vadd(p,vmul(normal,t));hit=true } }
+   } else {
+    nearest:=boundary_nearest(y,p)
+    if vlen(vsub(nearest,p))<=GLUE_CONTACT { q=nearest;hit=true } else {
+     for c,k in y.points { d:=vsub(y.points[(k+1)%len(y.points)],c);denom:=vcross(normal,d);if math.abs(denom)<1e-8 { continue }
+      t:=vcross(vsub(c,p),d)/denom;u:=vcross(vsub(c,p),normal)/denom
+      if t>=0 && t<=distance && u>=0 && u<=1 { distance=t;q=vadd(p,vmul(normal,t));hit=true }
+     }
+    }
+   }
+   if hit { append(&samples,Glue_Sample{p,q,length/f32(n)}) }
+  }
+ };return samples
+}
+
+glue_samples :: proc(a,b:Polygon,ground:bool=false)->[dynamic]Glue_Sample {
+ left:=glue_side(a,b,ground)
+ // The finite ground boundary is the yard floor; side(ground,A) uses upward normals.
+ right:=glue_side(b,a)
+ wl,wr:f32;for s in left { wl+=s.w };for s in right { wr+=s.w }
+ if wr<wl { delete(left);for &s in right { s.p,s.q=s.q,s.p };return right }
+ delete(right);return left
+}
+
+glue_valid_contact :: proc(a,b:Polygon,ground:bool)->bool {
+ if ground { low:=f32(1e30);for p in a.points { low=min(low,p.y) };return low<=GLUE_CONTACT }
+ distance,_:=polygon_contact(a,b);return distance<=GLUE_CONTACT
+}
+
+glue_add :: proc(s:^Scene,a,b:u64,samples:[]Glue_Sample,inherit:bool=false)->u64 {
+ if len(samples)==0 || a==0 || b==0 { return 0 }
+ if id,ok:=s.connection_pairs[pair_key(a,b)];ok && s.connections[s.conn_rows[id]].live {
+  c:=&s.connections[s.conn_rows[id]]
+  if inherit && len(c.glue)>0 { append(&c.glue,..samples);_,point:=seam_geometry(c^);c.rest_point=point;c.local_a=vsub(point,s.subdivisions[s.sub_rows[a]].rest_center);c.local_b=vsub(point,s.subdivisions[s.sub_rows[b]].rest_center);s.structure_revision+=1 };return id
+ }
+ c:=Connection{id=new_id(s),a=a,b=b,mortar=true,live=true};append(&c.glue,..samples)
+ _,point:=seam_geometry(c);c.rest_point=point
+ sa,sb:=s.subdivisions[s.sub_rows[a]],s.subdivisions[s.sub_rows[b]]
+ c.local_a=vsub(point,sa.rest_center);c.local_b=vsub(point,sb.rest_center)
+ s.conn_rows[c.id]=len(s.connections);append(&s.connections,c);s.connection_pairs[pair_key(a,b)]=c.id
+ append(&s.subdivisions[s.sub_rows[a]].incident_links,c.id);append(&s.subdivisions[s.sub_rows[b]].incident_links,c.id)
+ s.structure_revision+=1;return c.id
+}
+
+nearest_sample_cell :: proc(s:^Scene,ids:[]u64,p:Vec2)->u64 {
+ id:=u64(0);distance:=f32(1e30)
+ for candidate in ids { sub:=s.subdivisions[s.sub_rows[candidate]];if !sub.live { continue };d:=vlen(vsub(p,boundary_nearest(sub.outline,p)))
+  if d<distance-1e-7 || math.abs(d-distance)<=1e-7 && (id==0 || candidate<id) { id=candidate;distance=d }
+ };return id
+}
+
+assign_glue :: proc(s:^Scene,samples:[]Glue_Sample,left,right:[]u64,inherit:bool=false) {
+ groups:=make(map[Endpoint_Pair][dynamic]Glue_Sample);defer { for _,group in groups { delete(group) };delete(groups) }
+ order:[dynamic]Endpoint_Pair;defer delete(order)
+ for sample in samples {
+  a,b:=nearest_sample_cell(s,left,sample.p),nearest_sample_cell(s,right,sample.q);if a==0 || b==0 { continue }
+  key:=Endpoint_Pair{a,b};group,ok:=groups[key];if !ok { append(&order,key) };append(&group,sample);groups[key]=group
+ }
+ for key in order { glue_add(s,key.a,key.b,groups[key][:],inherit) }
+}
+
+inherit_glue :: proc(s:^Scene,c:Connection,left,right:[]u64) { assign_glue(s,c.glue[:],left,right,true) }
+
+build_glue :: proc(s:^Scene,links:[]Glue_Link,objects:[]Built_Object,ground:Built_Object) {
+ for link in links {
+  a,b:=Built_Object{},ground
+  for object in objects { if object.identity==link.a { a=object };if object.identity==link.b { b=object } }
+  pa,pb:=built_polygon(a),built_polygon(b);samples:=glue_samples(pa,pb,link.b==0)
+  left,right:=object_cells(s,a),object_cells(s,b);assign_glue(s,samples[:],left[:],right[:])
+  delete(left);delete(right);delete(samples);delete(pa.points);delete(pb.points)
+ }
+}
diff --git a/src/shared/sim_headless_world.odin b/src/shared/sim_headless_world.odin
new file mode 100644
index 0000000..45848ea
--- /dev/null
+++ b/src/shared/sim_headless_world.odin
@@ -0,0 +1,91 @@
+#+feature dynamic-literals
+package shared
+
+import math "core:math"
+import strings "core:strings"
+
+Headless_Game :: struct { world: World, layout: Layout }
+
+headless_game_destroy :: proc(game: ^Headless_Game) {
+ scene_destroy(&game.world.scene)
+ delete(game.world.bombs)
+ destroy_layout(&game.layout)
+ game^={}
+}
+
+headless_game_reset :: proc(game: ^Headless_Game) { world_rebuild_layout(&game.world,&game.layout,false) }
+
+headless_game_mode :: proc(game: ^Headless_Game,mode: Blast_Mode) {
+ if mode==game.world.settings.blast_mode { return }
+ game.world.settings.blast_mode=mode; bomb_rain_clear(&game.world)
+ game.world.rain.until_drop=bomb_drop_delay(&game.world.rain)
+}
+
+world_rebuild_layout :: proc(w: ^World,layout: ^Layout,editing: bool) {
+	revision:=w.scene.revision+1
+	epoch:=w.scene.epoch+1
+	scene_destroy(&w.scene)
+	s:=&w.scene
+	s^=new_scene(WOOD_MINIMUM_WIDTH)
+	s.revision=revision
+	s.epoch=epoch
+	material:=add_material(s,editor_material(.Stone))
+	seed:=w.settings.seed
+	objects: [dynamic]Built_Object; defer delete(objects)
+ layout_build_objects(w,layout,editing,&objects)
+ ground:=sandbox_add_ground(s,material,seed)
+ build_mortar(s,objects[:],ground)
+ build_glue(s,layout.glue[:],objects[:],ground)
+
+	world_start_physics(w)
+}
+
+layout_build_objects :: proc(w: ^World,layout: ^Layout,editing: bool, objects: ^[dynamic]Built_Object = nil) {
+	s:=&w.scene
+	materials: [8]int
+	for choice in Recipe { materials[int(choice)]=add_material(s,editor_material(choice)) }
+ for i in 4..<palette_count(layout) {
+  used:=false; for object in layout.objects { if int(object.material)==i { used=true; break } }
+  if used {
+   m:=layout_material(layout,Slot(i)); m.name=strings.clone(m.name); append(&s.owned_names,m.name)
+   materials[i]=add_material(s,m)
+  }
+ }
+	layout_build_rectangles(w,layout,editing,materials,objects)
+}
+
+layout_build_rectangles :: proc(w: ^World,layout: ^Layout,editing: bool,materials: [8]int, objects: ^[dynamic]Built_Object = nil) {
+	s:=&w.scene
+	if editing { return }
+	for object in layout.objects {
+		seed:=derive_seed(w.settings.seed,0x10000+object.identity)
+		if layout_base(layout,object.material)==.Rubber { seed=0 }
+		first_id:=s.next_id+1
+		owner:=add_piece(s,materials[int(object.material)],seed)
+  if object.angle!=0 || object.shape!=.Rect { build_shaped_object(s,object,owner); if objects!=nil { append(objects,built_object(object,first_id,s.next_id+1)) };continue }
+		nx,ny:=1,1
+		if layout_base(layout,object.material)==.Rubber {
+			nx=int(math.ceil((object.hi.x-object.lo.x)/RUBBER_CELL_SIZE-0.00001))
+			ny=int(math.ceil((object.hi.y-object.lo.y)/RUBBER_CELL_SIZE-0.00001))
+		}
+		// Uniform fitted cells: one target size, no tiny leftover edge strips.
+		dx,dy:=(object.hi.x-object.lo.x)/f32(nx),(object.hi.y-object.lo.y)/f32(ny)
+		ids:=make([]u64,nx*ny)
+		for row in 0..<ny {
+			for column in 0..<nx {
+				x0,x1:=object.lo.x+f32(column)*dx,object.lo.x+f32(column+1)*dx
+				y0,y1:=object.lo.y+f32(row)*dy,object.lo.y+f32(row+1)*dy
+				points:=[4]Vec2{{x0,y0},{x1,y0},{x1,y1},{x0,y1}}
+				outline:=Polygon{points=points[:]}
+				id:=add_subdivision(s,owner,outline,Pose{position=centroid(outline)})
+
+				index:=row*nx+column; ids[index]=id
+				if column>0 { connection:=add_connection(s,ids[index-1],id); assert(connection!=0); }
+				if row>0 { connection:=add_connection(s,ids[index-nx],id); assert(connection!=0); }
+			}
+		}
+		delete(ids)
+		if layout_base(layout,object.material)!=.Rubber { presplit_piece(s,owner) }
+  if objects!=nil { append(objects,Built_Object{identity=object.identity,mortar=object.mortar,lo=object.lo,hi=object.hi,first_id=first_id,end_id=s.next_id+1}) }
+	}
+}
diff --git a/src/shared/sim_inheritance_bounds.odin b/src/shared/sim_inheritance_bounds.odin
new file mode 100644
index 0000000..bfb63e5
--- /dev/null
+++ b/src/shared/sim_inheritance_bounds.odin
@@ -0,0 +1,11 @@
+#+feature dynamic-literals
+package shared
+
+
+
+inheritance_bounds_overlap :: proc(a,b: Polygon) -> bool {
+ alo,ahi:=Vec2{1e30,1e30},Vec2{-1e30,-1e30}; blo,bhi:=alo,ahi
+ for p in a.points { alo={min(alo.x,p.x),min(alo.y,p.y)}; ahi={max(ahi.x,p.x),max(ahi.y,p.y)} }
+ for p in b.points { blo={min(blo.x,p.x),min(blo.y,p.y)}; bhi={max(bhi.x,p.x),max(bhi.y,p.y)} }
+ return alo.x<=bhi.x+0.001 && blo.x<=ahi.x+0.001 && alo.y<=bhi.y+0.001 && blo.y<=ahi.y+0.001
+}
diff --git a/src/shared/sim_layout_state.odin b/src/shared/sim_layout_state.odin
new file mode 100644
index 0000000..6cb8276
--- /dev/null
+++ b/src/shared/sim_layout_state.odin
@@ -0,0 +1,65 @@
+#+feature dynamic-literals
+package shared
+
+import json "core:encoding/json"
+import strings "core:strings"
+
+Wire_Layout_Object :: struct { identity: u64, material: string, lo,hi: Vec2, angle:union { f32 } `json:"angle,omitempty"`, shape:union { string } `json:"shape,omitempty"`, mortar: union { bool } `json:"mortar,omitempty"` }
+
+Wire_Layout :: struct {
+	kind: string,
+	version: int,
+	seed: u64,
+	next_identity: u64,
+	objects: [dynamic]Wire_Layout_Object,
+ materials: [dynamic]Wire_Custom_Material,
+ glue:[dynamic]Glue_Link `json:"glue,omitempty"`,
+}
+
+decode_layout :: proc(data: []byte) -> (layout: Layout,seed: u8,ok: bool,problem: string) {
+	wire:=Wire_Layout{}
+	defer {
+		delete(wire.kind);delete(wire.glue)
+		for object in wire.objects { delete(object.material);if value,ok:=object.shape.(string);ok { delete(value) } }
+		delete(wire.objects)
+  for m in wire.materials { delete(m.name); delete(m.base) }; delete(wire.materials)
+		if !ok { destroy_layout(&layout) }
+	}
+	if json.unmarshal(data,&wire)!=nil { return {},0,false,"Invalid layout JSON" }
+	if wire.kind!="bom-layout" { return {},0,false,"Not a bom-layout file" }
+	if wire.version!=1 && wire.version!=2 && wire.version!=3 { return {},0,false,"Unsupported layout version" }
+	if wire.seed>255 { return {},0,false,"Seed must be between 0 and 255" }
+	if wire.version==1 && len(wire.materials)>0 { return {},0,false,"Version 1 has no custom materials" }
+ if len(wire.materials)>4 { return {},0,false,"Maximum 4 custom materials" }
+ for m in wire.materials {
+  base,known:=material_base_name(m.base)
+  if !known { return layout,0,false,"Unknown material base" }
+  if reason:=material_name_problem(&layout,m.name); reason!="" { return layout,0,false,reason }
+  custom:=custom_from_wire(m,base)
+  if reason:=custom_problem(custom); reason!="" { return layout,0,false,reason }
+  custom.name=strings.clone(m.name); append(&layout.materials,custom)
+ }
+ seen:=make(map[u64]bool); defer delete(seen)
+	maximum:=u64(0)
+	for object in wire.objects {
+		choice:=recipe_slot(.Wood); known:=false
+		for i in 0..<palette_count(&layout) { if object.material==layout_material(&layout,Slot(i)).name { choice=Slot(i); known=true; break } }
+		if !known { return layout,0,false,"Unknown material" }
+		if object.identity==0 { return layout,0,false,"Object identity must be nonzero" }
+		if seen[object.identity] { return layout,0,false,"Duplicate object identity" }
+		r:=Authored_Shape{identity=object.identity,material=choice,lo=object.lo,hi=object.hi}
+  if value,present:=object.angle.(f32);present { if wire.version<3 { return layout,0,false,"Angle requires version 3" };r.angle=value }
+  if value,present:=object.shape.(string);present { if wire.version<3 || value!="wedge" { return layout,0,false,"Unknown shape" };r.shape=.Wedge }
+		if value,exists:=object.mortar.(bool); exists { r.mortar=value }
+		if reason:=editor_rectangle_problem(&layout,r); reason!="" { return layout,0,false,reason }
+		append(&layout.objects,r)
+		seen[object.identity]=true; maximum=max(maximum,object.identity)
+	}
+	if wire.next_identity<=maximum { return layout,0,false,"next_identity must exceed every object identity" }
+	for link in wire.glue {
+  if wire.version<3 { return layout,0,false,"Glue requires version 3" }
+  if reason:=layout_glue_problem(&layout,link);reason!="" { return layout,0,false,reason };append(&layout.glue,link)
+ }
+ layout.next_identity=wire.next_identity
+	return layout,u8(wire.seed),true,""
+}
diff --git a/src/shared/sim_material_library.odin b/src/shared/sim_material_library.odin
new file mode 100644
index 0000000..a5df0de
--- /dev/null
+++ b/src/shared/sim_material_library.odin
@@ -0,0 +1,68 @@
+#+feature dynamic-literals
+package shared
+
+import fmt "core:fmt"
+import unicode "core:unicode"
+
+Custom_Material :: struct {
+ name: string,
+ base: Recipe,
+ toughness: f32,
+ blast_resistance: f32,
+ color: [3]u8,
+ strip_thickness,shock_loss,flexibility: f32,
+}
+
+palette_count :: proc(layout:^Layout)->int { return 4+len(layout.materials) }
+
+layout_material :: proc(layout:^Layout,choice:Slot)->Material {
+ index:=int(choice)
+ if index<4 { return editor_material(builtin_recipe(choice)) }
+ custom:=layout.materials[index-4]
+ m:=editor_material(custom.base); m.name=custom.name
+ m.subdivision_strength*=custom.toughness; m.connection_strength*=custom.toughness
+ m.blast_resistance=custom.blast_resistance; m.color=custom.color
+ switch custom.base {
+ case .Wood:m.strip_thickness=custom.strip_thickness
+ case .Glass:m.shock_loss=custom.shock_loss
+ case .Rubber:m.flexibility=custom.flexibility
+ case .Stone:
+ }
+ return m
+}
+
+layout_base :: proc(layout:^Layout,choice:Slot)->Recipe {
+ if int(choice)<4 { return builtin_recipe(choice) }; return layout.materials[int(choice)-4].base
+}
+
+custom_defaults :: proc(base:Recipe)->Custom_Material {
+ m:=editor_material(base)
+ strip:=STRIP_MIN; if base==.Wood { strip=m.strip_thickness }
+ return {base=base,toughness=1,blast_resistance=m.blast_resistance,color=m.color,strip_thickness=strip,shock_loss=4,flexibility=0.5}
+}
+
+destroy_layout :: proc(layout:^Layout) {
+ for m in layout.materials { delete(m.name) }; delete(layout.materials); delete(layout.objects); delete(layout.glue); layout^={}
+}
+
+material_name_problem :: proc(layout:^Layout,name:string,except:int = -1)->string {
+ count:=0
+ for r in name { if !unicode.is_print(r) { return "Name must use printable characters" }; count+=1 }
+ if count<1 || count>20 { return "Name must be 1-20 printable characters" }
+ for i in 0..<palette_count(layout) {
+  if i==except+4 { continue }
+  if layout_material(layout,Slot(i)).name==name { return "Duplicate material name" }
+ }
+ return ""
+}
+
+in_range :: proc(v,lo,hi:f32)->bool { return finite(v) && v>=lo && v<=hi }
+
+custom_problem :: proc(m:Custom_Material)->string {
+ if !in_range(m.toughness,0.25,4) { return "Toughness must be between 0.25 and 4" }
+ if !in_range(m.blast_resistance,0,6) { return "Blast resistance must be between 0 and 6" }
+ if !in_range(m.strip_thickness,STRIP_MIN,0.6) { return fmt.tprintf("Strip thickness must be between %.1f and 0.6",STRIP_MIN) }
+ if !in_range(m.shock_loss,1,12) { return "Shock loss must be between 1 and 12" }
+ if !in_range(m.flexibility,0.2,1) { return "Flexibility must be between 0.2 and 1" }
+ return ""
+}
diff --git a/src/shared/sim_material_wire.odin b/src/shared/sim_material_wire.odin
new file mode 100644
index 0000000..267197f
--- /dev/null
+++ b/src/shared/sim_material_wire.odin
@@ -0,0 +1,29 @@
+#+feature dynamic-literals
+package shared
+
+
+
+Wire_Custom_Material :: struct {
+ name,base: string,
+ toughness: union { f32 } `json:"toughness,omitempty"`,
+ blast_resistance: union { f32 } `json:"blast_resistance,omitempty"`,
+ color: union { [3]u8 } `json:"color,omitempty"`,
+ strip_thickness: union { f32 } `json:"strip_thickness,omitempty"`,
+ shock_loss: union { f32 } `json:"shock_loss,omitempty"`,
+ flexibility: union { f32 } `json:"flexibility,omitempty"`,
+}
+
+material_base_name :: proc(name:string)->(Recipe,bool) {
+ for p in Recipe { if editor_material(p).name==name { return p,true } }; return .Wood,false
+}
+
+custom_from_wire :: proc(w:Wire_Custom_Material,base:Recipe)->Custom_Material {
+ m:=custom_defaults(base); m.name=w.name
+ if v,ok:=w.toughness.(f32); ok { m.toughness=v }
+ if v,ok:=w.blast_resistance.(f32); ok { m.blast_resistance=v }
+ if v,ok:=w.color.([3]u8); ok { m.color=v }
+ if v,ok:=w.strip_thickness.(f32); ok { m.strip_thickness=v }
+ if v,ok:=w.shock_loss.(f32); ok { m.shock_loss=v }
+ if v,ok:=w.flexibility.(f32); ok { m.flexibility=v }
+ return m
+}
diff --git a/src/shared/sim_model.odin b/src/shared/sim_model.odin
new file mode 100644
index 0000000..ab7d3da
--- /dev/null
+++ b/src/shared/sim_model.odin
@@ -0,0 +1,288 @@
+#+feature dynamic-literals
+package shared
+
+import time "core:time"
+import math "core:math"
+import slice "core:slice"
+import b2 "vendor:box2d"
+
+Blast :: struct { position: Vec2, radius: f32 }
+
+Impact_Shock_Source :: struct { cell: u64, point: Vec2, load: f32 }
+
+Failures :: struct {
+ subdivisions, connections, discard_subdivisions: [dynamic]u64,
+ impact: bool,
+ no_sibling_bonds: bool,
+ impact_sources: [dynamic]Impact_Shock_Source,
+}
+
+vrotate :: proc(a: Vec2, angle: f32) -> Vec2 {
+	c, s := f32(math.cos(angle)), f32(math.sin(angle))
+	return {a.x*c-a.y*s,a.x*s+a.y*c}
+}
+
+centroid :: proc(p: Polygon) -> Vec2 {
+	area, x, y: f32
+	for i in 0..<len(p.points) {
+		a, b := p.points[i], p.points[(i+1)%len(p.points)]
+		cross := vcross(a,b)
+		area += cross
+		x += (a.x+b.x)*cross
+		y += (a.y+b.y)*cross
+	}
+	if math.abs(area) < 0.00001 {
+		for point in p.points { x += point.x; y += point.y }
+		return {x/f32(len(p.points)),y/f32(len(p.points))}
+	}
+	return {x/(3*area),y/(3*area)}
+}
+
+posed_point :: proc(sub: Subdivision, rest: Vec2) -> Vec2 {
+	return vadd(sub.pose.position,vrotate(vsub(rest,sub.rest_center),sub.pose.angle))
+}
+
+new_id :: proc(s: ^Scene) -> u64 { s.next_id += 1; return s.next_id }
+
+add_material :: proc(s: ^Scene, m: Material) -> int { append(&s.materials,m); s.structure_revision+=1; return len(s.materials)-1 }
+
+add_piece :: proc(s: ^Scene, material: int, seed: u8) -> u64 {
+	id := new_id(s)
+	s.piece_rows[id] = len(s.pieces)
+	append(&s.pieces,Piece{id=id,material=material,seed=seed,live=true})
+	s.structure_revision+=1
+	return id
+}
+
+add_subdivision :: proc(s: ^Scene, owner: u64, outline: Polygon, pose: Pose) -> u64 {
+	id := new_id(s)
+	piece := s.pieces[s.piece_rows[owner]]
+	retain_subdivision(s,Subdivision{id=id,owner=owner,material=piece.material,seed=piece.seed,outline=outline,pose=pose,live=true})
+	append(&s.pieces[s.piece_rows[owner]].subdivisions,id)
+	s.pieces[s.piece_rows[owner]].mass+=polygon_area(outline)
+	s.pieces[s.piece_rows[owner]].render_revision+=1
+	return id
+}
+
+frame_to_reference :: proc(frame: Pose,ref_rest: Vec2) -> Pose {
+ out:=frame; out.position=vadd(frame.position,vrotate(ref_rest,frame.angle)); return out
+}
+
+retain_subdivision :: proc(s: ^Scene,source: Subdivision) {
+	sub:=source
+	sub.outline=make_polygon(source.outline.points)
+	sub.rest_center=centroid(sub.outline)
+	sub.width=outline_width(sub.outline.points)
+	sub.body={}; sub.fixture_count=0; sub.shapes=nil; sub.incident_links=nil
+	s.sub_rows[sub.id]=len(s.subdivisions)
+	append(&s.subdivisions,sub)
+	append(&s.pending_regions,sub.id)
+	s.structure_revision+=1
+}
+
+add_connection :: proc(s: ^Scene, a, b: u64, mortar: bool = false, known_segments: []Segment=nil) -> u64 {
+	if a == b { return 0 }
+	if id,ok:=s.connection_pairs[pair_key(a,b)]; ok { if s.connections[s.conn_rows[id]].live { return id } }
+	sa, sb := s.subdivisions[s.sub_rows[a]],s.subdivisions[s.sub_rows[b]]
+	length, point := shared_boundary(sa.outline,sb.outline)
+	if length <= 0 { return 0 }
+	id := new_id(s)
+	s.conn_rows[id] = len(s.connections)
+ segments:[dynamic]Segment
+ if known_segments==nil { segments=shared_segments(sa.outline,sb.outline) } else { append(&segments,..known_segments) }
+	append(&s.connections,Connection{id=id,a=a,b=b,mortar=mortar,rest_point=point,local_a=vsub(point,sa.rest_center),local_b=vsub(point,sb.rest_center),rest_segments=segments,live=true})
+	s.connection_pairs[pair_key(a,b)]=id
+	append(&s.subdivisions[s.sub_rows[a]].incident_links,id)
+	append(&s.subdivisions[s.sub_rows[b]].incident_links,id)
+	if !mortar { append(&s.pieces[s.piece_rows[sa.owner]].connections,id) }
+	s.pieces[s.piece_rows[sa.owner]].render_revision+=1
+ if mortar { s.pieces[s.piece_rows[sb.owner]].render_revision+=1 }
+	s.structure_revision+=1
+	return id
+}
+
+connection_sample :: proc(s: ^Scene, c: Connection) -> Vec2 {
+	a,b := s.subdivisions[s.sub_rows[c.a]],s.subdivisions[s.sub_rows[c.b]]
+	return vmul(vadd(vadd(a.pose.position,vrotate(c.local_a,a.pose.angle)),vadd(b.pose.position,vrotate(c.local_b,b.pose.angle))),0.5)
+}
+
+subdivision_sample :: proc(sub: Subdivision) -> Vec2 { return sub.pose.position }
+
+sort_ids :: proc(ids: []u64) { slice.sort(ids) }
+
+sorted_ids :: proc(ids: []u64) -> [dynamic]u64 {
+	result: [dynamic]u64
+	for id in ids { append(&result,id) }
+	sort_ids(result[:])
+	count:=0
+	for id in result { if count==0 || id!=result[count-1] { result[count]=id; count+=1 } }
+	resize(&result,count)
+	return result
+}
+
+derive_seed :: proc(seed: u8, identity: u64) -> u8 {
+	if seed == 0 { return 0 }
+	x := identity ~ (u64(seed)*0x9e3779b97f4a7c15)
+	x ~= x >> 30; x *= 0xbf58476d1ce4e5b9
+	x ~= x >> 27; x *= 0x94d049bb133111eb
+	x ~= x >> 31
+	return u8(x%255+1)
+}
+
+piece_width :: proc(s: ^Scene, ids: []u64) -> f32 {
+	if len(ids) == 0 { return 0 }
+	points: [dynamic]Vec2
+	defer delete(points)
+	for id in ids { for point in s.subdivisions[s.sub_rows[id]].outline.points { append(&points,point) } }
+	return outline_width(points[:])
+}
+
+outline_width :: proc(points: []Vec2) -> f32 {
+ if active_cover!=nil && !blast_scratch_active && len(points)>32 { return blast_cached_width(points) }
+ return outline_width_uncached(points)
+}
+
+outline_width_uncached :: proc(points: []Vec2) -> f32 {
+	sorted_inline:[32]Vec2; hull_inline:[64]Vec2
+ hull:[]Vec2; heap:[dynamic]Vec2; defer delete(heap)
+ if len(points)<=len(sorted_inline) { hull=convex_hull_into(points,sorted_inline[:],hull_inline[:]) } else { heap=convex_hull(points); hull=heap[:] }
+ if len(hull)<3 { return 0 }
+	width := f32(1e30)
+	for i in 0..<len(hull) {
+		edge:=vsub(hull[(i+1)%len(hull)],hull[i]); length:=vlen(edge)
+		if length<0.00001 { continue }
+		normal:=Vec2{-edge.y/length,edge.x/length}
+		lo,hi:=f32(1e30),f32(-1e30)
+		for point in hull { projection:=vdot(point,normal); lo=min(lo,projection); hi=max(hi,projection) }
+		width=min(width,hi-lo)
+	}
+	return width
+}
+
+rebuild_piece :: proc(s: ^Scene, old_id: u64) {
+	old_row, ok := s.piece_rows[old_id]
+	if !ok || !s.pieces[old_row].live { return }
+	old:=s.pieces[old_row]
+	visited:=make(map[u64]bool)
+	adjacency:=make(map[u64][dynamic]u64)
+	defer delete(visited)
+	defer { for _,neighbors in adjacency { delete(neighbors) }; delete(adjacency) }
+	for id in old.connections {
+		c:=s.connections[s.conn_rows[id]]
+		if !c.live { continue }
+		a,b:=s.subdivisions[s.sub_rows[c.a]],s.subdivisions[s.sub_rows[c.b]]
+		if !a.live || !b.live { continue }
+		left,right:=adjacency[c.a],adjacency[c.b]
+		append(&left,c.b); append(&right,c.a)
+		adjacency[c.a]=left; adjacency[c.b]=right
+	}
+	ids:=sorted_ids(old.subdivisions[:]); defer delete(ids)
+	s.pieces[old_row].live=false
+	// Preserve the exact engine transform across multiple staged regroupings,
+    // including groups whose members are all newly generated and have no body.
+    frame,has_frame:=old.body_frame,old.has_body_frame
+    source_body:=old.source_body
+    if old.body!=b2.nullBodyId { frame=b2.Body_GetTransform(old.body); has_frame=true; source_body=old.body }
+	// Sorted starts preserve component IDs after swap-removal changes row order.
+	for start in ids {
+		if visited[start] || !s.subdivisions[s.sub_rows[start]].live { continue }
+		group:=[dynamic]u64{start}; visited[start]=true
+		for head:=0; head<len(group); head+=1 {
+			neighbors:=adjacency[group[head]]
+			for other in neighbors { if !visited[other] { visited[other]=true; append(&group,other) } }
+		}
+		sort_ids(group[:])
+		// The union cannot be narrower than a member it contains.
+		wide_member:=false
+		for id in group { if s.subdivisions[s.sub_rows[id]].width>=s.minimum_width { wide_member=true; break } }
+		if !wide_member && piece_width(s,group[:])<s.minimum_width {
+			for id in group { s.subdivisions[s.sub_rows[id]].live=false }
+			delete(group)
+			continue
+		}
+		seed:u8
+		for id in group { if child_seed:=s.subdivisions[s.sub_rows[id]].seed; child_seed!=0 { seed=child_seed; break } }
+		owner:=add_piece(s,old.material,seed)
+        s.pieces[s.piece_rows[owner]].source_body=source_body
+        s.pieces[s.piece_rows[owner]].body_frame=frame
+        s.pieces[s.piece_rows[owner]].has_body_frame=has_frame
+		for id in group {
+			s.subdivisions[s.sub_rows[id]].owner=owner
+			s.pieces[s.piece_rows[owner]].mass+=polygon_area(s.subdivisions[s.sub_rows[id]].outline)
+		}
+		s.pieces[s.piece_rows[owner]].subdivisions=group
+		piece_finish_reference(s,&s.pieces[s.piece_rows[owner]])
+	}
+	// Owner lookup is a set test for each endpoint, rather than linear group searches.
+	for id in old.connections {
+		c:=&s.connections[s.conn_rows[id]]
+		if !c.live { continue }
+		a,b:=s.subdivisions[s.sub_rows[c.a]],s.subdivisions[s.sub_rows[c.b]]
+		if !a.live || !b.live { c.live=false; continue }
+		assert(a.owner==b.owner)
+		append(&s.pieces[s.piece_rows[a.owner]].connections,id)
+	}
+	// Retain the old rigid body on the largest resulting group, ties by first ID.
+	keeper:=u64(0)
+	for id in ids {
+		sub:=s.subdivisions[s.sub_rows[id]]
+		if !sub.live { continue }
+		p:=s.pieces[s.piece_rows[sub.owner]]
+		if keeper==0 { keeper=p.id; continue }
+		k:=s.pieces[s.piece_rows[keeper]]
+		if len(p.subdivisions)>len(k.subdivisions) || len(p.subdivisions)==len(k.subdivisions) && p.subdivisions[0]<k.subdivisions[0] { keeper=p.id }
+	}
+	if keeper!=0 && old.body!=b2.nullBodyId {
+		s.pieces[s.piece_rows[keeper]].body=old.body
+		s.pieces[s.piece_rows[old_id]].body={}
+	}
+	owners:=make(map[u64]bool); defer delete(owners)
+	for id in ids { sub:=s.subdivisions[s.sub_rows[id]]; if sub.live { owners[sub.owner]=true } }
+	for owner in owners { sort_ids(s.pieces[s.piece_rows[owner]].connections[:]) }
+}
+
+commit_structure :: proc(s: ^Scene) {
+ when BOM_PROFILE { started:=time.tick_now(); defer profile_add(6,started) }
+
+ when ODIN_TEST { glass_commit_test_calls+=1 }
+	physics_remove_dead(s)
+	removed:=false
+	for i:=len(s.connections)-1; i>=0; i-=1 {
+		c:=s.connections[i]
+		if c.live { continue }
+		removed=true
+		key:=pair_key(c.a,c.b)
+		if s.connection_pairs[key]==c.id { delete_key(&s.connection_pairs,key) }
+		endpoints:=[2]u64{c.a,c.b}
+		for endpoint in endpoints {
+			links:=&s.subdivisions[s.sub_rows[endpoint]].incident_links
+			for id,j in links^ { if id==c.id { unordered_remove(links,j); break } }
+		}
+		delete_key(&s.conn_rows,c.id)
+  delete(c.rest_segments); delete(c.glue)
+		unordered_remove(&s.connections,i)
+		if i<len(s.connections) { s.conn_rows[s.connections[i].id]=i }
+	}
+	for i:=len(s.subdivisions)-1; i>=0; i-=1 {
+		sub:=s.subdivisions[i]
+		if sub.live { continue }
+		removed=true
+		delete(sub.outline.points); delete(sub.incident_links); delete(sub.shapes)
+		delete_key(&s.sub_rows,sub.id)
+		unordered_remove(&s.subdivisions,i)
+		if i<len(s.subdivisions) { s.sub_rows[s.subdivisions[i].id]=i }
+	}
+	for i:=len(s.pieces)-1; i>=0; i-=1 {
+		p:=s.pieces[i]
+		if p.live { continue }
+		removed=true
+		delete(p.subdivisions); delete(p.connections)
+		delete_key(&s.piece_rows,p.id)
+		unordered_remove(&s.pieces,i)
+		if i<len(s.pieces) { s.piece_rows[s.pieces[i].id]=i }
+	}
+	count:=0
+	for id in s.pending_regions { if _,ok:=s.sub_rows[id]; ok { s.pending_regions[count]=id; count+=1 } }
+	resize(&s.pending_regions,count)
+	if removed { s.structure_revision+=1 }
+}
diff --git a/src/shared/sim_mortar.odin b/src/shared/sim_mortar.odin
new file mode 100644
index 0000000..49b3655
--- /dev/null
+++ b/src/shared/sim_mortar.odin
@@ -0,0 +1,134 @@
+#+feature dynamic-literals
+package shared
+
+import math "core:math"
+import b2 "vendor:box2d"
+
+Built_Object :: struct { identity: u64, mortar: bool, vertices:[4]Vec2,count:int, lo,hi: Vec2, first_id,end_id: u64 }
+
+MORTAR_STRENGTH :: f32(280)
+
+SEAM_TOUGHNESS :: f32(#config(SEAM_TOUGHNESS,0.4))
+
+mortar_length :: proc(c: Connection) -> f32 {
+ length,_:=seam_geometry(c);return length
+}
+
+mortar_local_anchor :: proc(s: ^Scene,sub: Subdivision,rest_point: Vec2) -> Vec2 {
+ if s.materials[sub.material].flexibility==0 { return rest_point }
+ return vsub(rest_point,sub.rest_center)
+}
+
+object_cells :: proc(s: ^Scene,obj: Built_Object) -> [dynamic]u64 {
+ result:[dynamic]u64
+ for sub in s.subdivisions { if sub.live && obj.first_id<=sub.id && sub.id<obj.end_id { append(&result,sub.id) } }
+ sort_ids(result[:]); return result
+}
+
+mortar_touch :: proc(a,b: Built_Object) -> bool {
+ if a.count!=0 || b.count!=0 { pa,pb:=built_polygon(a),built_polygon(b);defer delete(pa.points);defer delete(pb.points);length,_:=shared_boundary(pa,pb);return length>0 }
+ return ((a.hi.x==b.lo.x || b.hi.x==a.lo.x) && min(a.hi.y,b.hi.y)-max(a.lo.y,b.lo.y)>0) ||
+        ((a.hi.y==b.lo.y || b.hi.y==a.lo.y) && min(a.hi.x,b.hi.x)-max(a.lo.x,b.lo.x)>0)
+}
+
+mortar_bounds :: proc(p: Polygon) -> (lo,hi: Vec2) {
+ lo={1e30,1e30}; hi={-1e30,-1e30}
+ for v in p.points { lo={min(lo.x,v.x),min(lo.y,v.y)}; hi={max(hi.x,v.x),max(hi.y,v.y)} }; return
+}
+
+mortar_cells :: proc(s: ^Scene,cells_a,cells_b: []u64) {
+ for a in cells_a { for b in cells_b {
+  sa,sb:=s.subdivisions[s.sub_rows[a]],s.subdivisions[s.sub_rows[b]]
+  alo,ahi:=mortar_bounds(sa.outline); blo,bhi:=mortar_bounds(sb.outline)
+  if ahi.x+1e-4<blo.x || bhi.x+1e-4<alo.x || ahi.y+1e-4<blo.y || bhi.y+1e-4<alo.y { continue }
+  if length,_:=shared_boundary(sa.outline,sb.outline); length>0 { add_connection(s,a,b,true) }
+ } }
+}
+
+build_mortar :: proc(s: ^Scene,objects: []Built_Object,ground: Built_Object) {
+ for i in 0..<len(objects) { for j in i+1..<len(objects) {
+  a,b:=objects[i],objects[j]
+  if (a.mortar || b.mortar) && mortar_touch(a,b) {
+   left,right:=object_cells(s,a),object_cells(s,b)
+   mortar_cells(s,left[:],right[:]); delete(left); delete(right)
+  }
+ } }
+ for a in objects { if a.mortar && built_on_ground(a) {
+  left,right:=object_cells(s,a),object_cells(s,ground)
+  mortar_cells(s,left[:],right[:]); delete(left); delete(right)
+ } }
+}
+
+Mortar_Seam :: struct {
+ bodies: [2]b2.BodyId,
+ members: [dynamic]u64,
+ length: f32,
+ center, force: Vec2,
+ torque: f32,
+ damage: f32,
+}
+
+mortar_seams :: proc(s: ^Scene) -> [dynamic]Mortar_Seam {
+ seams:[dynamic]Mortar_Seam
+ rows:=make(map[[2]b2.BodyId]int); defer delete(rows)
+ ids:[dynamic]u64; defer delete(ids)
+ for c in s.connections { if c.live && c.mortar && c.joint!=b2.nullJointId && b2.Joint_IsValid(c.joint) { append(&ids,c.id) } }
+ sort_ids(ids[:])
+ for id in ids {
+  c:=s.connections[s.conn_rows[id]]
+  bodies:=[2]b2.BodyId{b2.Joint_GetBodyA(c.joint),b2.Joint_GetBodyB(c.joint)}
+  row,ok:=rows[bodies]
+  if !ok { row,ok=rows[[2]b2.BodyId{bodies[1],bodies[0]}] }
+  if !ok { row=len(seams); rows[bodies]=row; append(&seams,Mortar_Seam{bodies=bodies}) }
+  seam:=&seams[row]; length:=mortar_length(c)
+  append(&seam.members,id)
+  seam.length+=length
+  seam.center=vadd(seam.center,vmul(connection_sample(s,c),length))
+  // New members / merged groups can have different histories: retain the
+  // largest surviving history, then write the group value to every member.
+  seam.damage=max(seam.damage,c.damage)
+ }
+ for &seam in seams {
+  seam.center=vmul(seam.center,1/seam.length)
+  for id in seam.members {
+   c:=s.connections[s.conn_rows[id]]
+   force:=from_b2(b2.Joint_GetConstraintForce(c.joint))
+   torque:=b2.Joint_GetConstraintTorque(c.joint)
+   body:=seam.bodies[1]
+   local:=b2.Joint_GetLocalAnchorB(c.joint)
+   if b2.Joint_GetBodyB(c.joint)!=body {
+    force=vmul(force,-1); torque=-torque; local=b2.Joint_GetLocalAnchorA(c.joint)
+   }
+   point:=from_b2(b2.Body_GetWorldPoint(body,local))
+   seam.force=vadd(seam.force,force)
+   seam.torque+=torque+vcross(vsub(point,seam.center),force)
+  }
+ }
+ return seams
+}
+
+mortar_free_seams :: proc(seams: [dynamic]Mortar_Seam) {
+ for seam in seams { delete(seam.members) }; delete(seams)
+}
+
+mortar_force_failures :: proc(s: ^Scene,failures: ^Failures,dt: f32) {
+ seams:=mortar_seams(s); defer mortar_free_seams(seams)
+ for seam in seams {
+  mortar_apply_seam(s,seam,failures,dt)
+ }
+}
+
+mortar_apply_seam :: proc(s: ^Scene,seam: Mortar_Seam,failures: ^Failures,dt: f32) {
+  r:=vlen(seam.force)/(MORTAR_STRENGTH*seam.length)+math.abs(seam.torque)/(0.5*MORTAR_STRENGTH*seam.length*seam.length)
+  damage:=f32(0); if r>=1 { damage=seam.damage+(r-1)*dt }
+  broken:=damage>=SEAM_TOUGHNESS
+  seam_diagnostic_force(s,seam,r,broken,damage)
+  if broken { damage=0 }
+  for id in seam.members {
+   s.connections[s.conn_rows[id]].damage=damage
+   if broken {
+    append(&failures.connections,id)
+    when BOM_MORTAR_MEASURE { mortar_measured_force_breaks+=1 }
+   }
+  }
+}
diff --git a/src/shared/sim_net_host.odin b/src/shared/sim_net_host.odin
new file mode 100644
index 0000000..cf18f58
--- /dev/null
+++ b/src/shared/sim_net_host.odin
@@ -0,0 +1,121 @@
+#+feature dynamic-literals
+package shared
+
+import nc "../netcode"
+import fmt "core:fmt"
+
+NET_APP_HOST_COMMAND :: u8(0xC6)
+
+NET_APP_LAYOUT_UPLOAD :: u8(0xC7)
+
+NET_APP_MAX_LAYOUT :: 200_000 // safely below netcode's reliable-message cap
+
+NET_HOST_RESET :: u8(1)
+
+NET_HOST_MODE :: u8(2)
+
+NET_HOST_BOMB_RADIUS :: u8(3)
+
+net_host_trim_players :: proc(ns: ^Net_Server) {
+ for i in 0..<nc.MAX_CLIENTS {
+  if !ns.clients[i].active { _=world_remove_player(&ns.game.world,i) }
+ }
+}
+
+net_host_apply_layout :: proc(ns: ^Net_Server,index: int,data: []u8) -> string {
+ if !ns.clients[index].active || !ns.clients[index].is_host { return "host only" }
+ if len(data)<2 || len(data)-1>NET_APP_MAX_LAYOUT || data[0]!=NET_APP_LAYOUT_UPLOAD { return "invalid layout upload size" }
+ layout,seed,ok,problem:=decode_layout(data[1:])
+ if !ok { return problem }
+ destroy_layout(&ns.game.layout)
+ ns.game.layout=layout
+ ns.game.world.settings.seed=seed
+ headless_game_reset(&ns.game)
+ net_host_trim_players(ns)
+ if ns.real_logging { fmt.printf("LAYOUT OK client=%d epoch=%d objects=%d\n",index,ns.game.world.scene.epoch,len(ns.game.layout.objects)) }
+ return ""
+}
+
+net_host_apply_command :: proc(ns: ^Net_Server,index: int,data: []u8) -> string {
+ if !ns.clients[index].active || !ns.clients[index].is_host { return "host only" }
+ if len(data)<2 || data[0]!=NET_APP_HOST_COMMAND { return "invalid host command" }
+ switch data[1] {
+ case NET_HOST_RESET:
+  if len(data)!=2 { return "invalid reset command" }
+  headless_game_reset(&ns.game)
+  net_host_trim_players(ns)
+ case NET_HOST_MODE:
+  if len(data)!=3 || data[2]>1 { return "invalid blast mode" }
+  headless_game_mode(&ns.game,Blast_Mode(data[2]))
+ case NET_HOST_BOMB_RADIUS:
+  if len(data)!=6 { return "invalid bomb radius" }
+  r:nc.Reader;nc.reader_init(&r,data)
+  _=nc.read_u8(&r);_=nc.read_u8(&r)
+  radius:=nc.read_f32(&r)
+  if !r.ok || !finite(radius) || radius<0.5 || radius>6 { return "invalid bomb radius" }
+  // In the real-process mode, client-provided blast radius fields are ignored.
+  // HOST's value controls both falling bombs and every player's manual blasts.
+  ns.game.world.settings.blast_radius=radius
+  for &client in ns.clients { if client.active { client.radius=radius } }
+  for &player in ns.game.world.players { if player.active { player.blast_radius=radius } }
+ case:
+  return "unknown host command"
+ }
+ for i in 0..<nc.MAX_CLIENTS { if ns.clients[i].active { net_host_send_settings(ns,i) } }
+ if ns.real_logging { fmt.printf("COMMAND OK client=%d op=%d epoch=%d\n",index,data[1],ns.game.world.scene.epoch) }
+ return ""
+}
+
+net_host_send_settings :: proc(ns:^Net_Server,index:int) {
+ w:nc.Writer;nc.writer_init(&w,8);defer nc.writer_destroy(&w)
+ nc.write_u8(&w,NET_APP_SETTINGS)
+ nc.write_u8(&w,u8(ns.game.world.settings.blast_mode))
+ nc.write_f32(&w,ns.game.world.settings.blast_radius)
+ _=nc.server_send_reliable(&ns.srv,index,w.data[:])
+}
+
+net_host_send_result :: proc(ns: ^Net_Server,index: int,kind: u8,reason: string) {
+ w:nc.Writer;nc.writer_init(&w,64);defer nc.writer_destroy(&w)
+ nc.write_u8(&w,NET_APP_COMMAND_RESULT)
+ nc.write_u8(&w,kind)
+ nc.write_bool(&w,reason=="")
+ nc.write_string(&w,reason)
+ _=nc.server_send_reliable(&ns.srv,index,w.data[:])
+}
+
+net_host_dispatch :: proc(ns: ^Net_Server,index: int,data: []u8) {
+ if len(data)==0 { return }
+ reason:=""
+ switch data[0] {
+ case NET_APP_LAYOUT_UPLOAD: reason=net_host_apply_layout(ns,index,data)
+ case NET_APP_HOST_COMMAND: reason=net_host_apply_command(ns,index,data)
+ case: return
+ }
+ if reason!="" && ns.real_logging {
+  if data[0]==NET_APP_LAYOUT_UPLOAD { fmt.printf("LAYOUT REJECT client=%d reason=%s\n",index,reason) }
+  else { fmt.printf("COMMAND REJECT client=%d reason=%s\n",index,reason) }
+ }
+ net_host_send_result(ns,index,data[0],reason)
+}
+
+net_host_client_send_layout :: proc(c: ^Net_Client,data: []u8) -> bool {
+ if !c.real_gate || !c.real_hello_ok || len(data)==0 || len(data)>NET_APP_MAX_LAYOUT { return false }
+ w:nc.Writer;nc.writer_init(&w,len(data)+8);defer nc.writer_destroy(&w)
+ nc.write_u8(&w,NET_APP_LAYOUT_UPLOAD)
+ nc.write_raw(&w,data)
+ return nc.client_send_reliable(&c.nc_client,w.data[:])
+}
+
+net_host_client_send_command :: proc(c: ^Net_Client,op: u8,mode: u8=0,radius: f32=0) -> bool {
+ if !c.real_gate || !c.real_hello_ok { return false }
+ w:nc.Writer;nc.writer_init(&w,8);defer nc.writer_destroy(&w)
+ nc.write_u8(&w,NET_APP_HOST_COMMAND)
+ nc.write_u8(&w,op)
+ switch op {
+ case NET_HOST_RESET:
+ case NET_HOST_MODE: nc.write_u8(&w,mode)
+ case NET_HOST_BOMB_RADIUS: nc.write_f32(&w,radius)
+ case: return false
+ }
+ return nc.client_send_reliable(&c.nc_client,w.data[:])
+}
diff --git a/src/shared/sim_net_real.odin b/src/shared/sim_net_real.odin
new file mode 100644
index 0000000..48166d6
--- /dev/null
+++ b/src/shared/sim_net_real.odin
@@ -0,0 +1,164 @@
+#+feature dynamic-literals
+package shared
+
+import nc "../netcode"
+import fmt "core:fmt"
+import os "core:os"
+import strconv "core:strconv"
+import time "core:time"
+
+NET_REAL_PORT :: u16(47380)
+
+NET_REAL_HASH_REPORT :: u8(0xC1)
+
+net_real_parse_target :: proc(input: string) -> (nc.Address, bool) {
+ ip: [4]u8
+ octet:=0
+ digits:=0
+ value:=0
+ i:=0
+ for i<len(input) && input[i]!=':' {
+  ch:=input[i]
+  if ch=='.' {
+   if digits==0 || octet>=3 { return 0,false }
+   ip[octet]=u8(value); octet+=1; digits=0; value=0
+  } else if ch>='0' && ch<='9' {
+   digits+=1; value=value*10+int(ch-'0')
+   if value>255 || digits>3 { return 0,false }
+  } else { return 0,false }
+  i+=1
+ }
+ if octet!=3 || digits==0 { return 0,false }
+ ip[3]=u8(value)
+ port:=NET_REAL_PORT
+ if i<len(input) {
+  i+=1
+  if i==len(input) { return 0,false }
+  p:=0
+  for i<len(input) {
+   ch:=input[i]; if ch<'0' || ch>'9' { return 0,false }
+   p=p*10+int(ch-'0'); if p>65535 { return 0,false }
+   i+=1
+  }
+  if p<1 { return 0,false }
+  port=u16(p)
+ }
+ return nc.address_make(ip,port),true
+}
+
+net_real_cli_port :: proc(input: string) -> (u16,bool) {
+ n,ok:=strconv.parse_int(input)
+ if !ok || n<1 || n>65535 { return 0,false }
+ return u16(n),true
+}
+
+net_real_create_server :: proc(layout_path: string) -> (ns: Net_Server,ok: bool) {
+ g:=Headless_Game{world=World{settings=DEFAULT_SANDBOX_SETTINGS},layout=Layout{next_identity=1}}
+ // Preserve the legacy empty Edit -> loaded Edit -> Test rebuild sequence.
+ world_rebuild_layout(&g.world,&g.layout,true)
+ data:[]u8
+ if layout_path!="" {
+  bytes,err:=os.read_entire_file(layout_path,context.allocator)
+  data=bytes
+  if err!=nil { fmt.eprintln("Cannot read server layout:",layout_path); headless_game_destroy(&g);return {},false }
+ } else { data=transmute([]u8)PRESET_LAYOUTS[0] }
+ layout,seed,valid,problem:=decode_layout(data)
+ if layout_path!="" { delete(data) }
+ if !valid { fmt.eprintln("Server layout invalid:",problem); headless_game_destroy(&g);return {},false }
+ destroy_layout(&g.layout);g.layout=layout;g.world.settings.seed=seed
+ world_rebuild_layout(&g.world,&g.layout,true)
+ headless_game_reset(&g)
+ _=world_remove_player(&g.world,0)
+ net_server_init_world(&ns,g,true)
+ ns.real_logging=true
+
+ return ns,true
+}
+
+net_real_run_server :: proc(port: u16,layout: string,seconds: f64 = 0,host_token: string = "") -> bool {
+ sock:nc.Socket
+ if !nc.socket_open(&sock,port,{127,0,0,1}) { fmt.eprintf("Could not bind UDP port %d\n",port);return false }
+ defer nc.socket_close(&sock)
+ ns,ok:=net_real_create_server(layout)
+ if !ok { return false }
+ ns.real_gate=true
+ ns.real_host_token=host_token
+ defer net_server_destroy(&ns)
+ fmt.printf("BOM staging server listening on 127.0.0.1:%d only; tick=60Hz\n",port)
+ start:=time.tick_now()
+ last:=f64(0)
+ accumulator:=f64(0)
+ report_at:=f64(10)
+ last_bytes:[nc.MAX_CLIENTS]u64
+ buf:[nc.MAX_PACKET+64]u8
+ overrun_count:=0
+ for {
+  now:=time.duration_seconds(time.tick_since(start))
+  if seconds>0 && now>=seconds { break }
+  if ns.real_host_seen && ns.real_host_left_at>=0 && now-ns.real_host_left_at>=5 {
+   fmt.println("SERVER host-left shutdown")
+   break
+  }
+  dt:=max(f64(0),min(now-last,0.25));last=now
+  accumulator+=dt
+  for {
+   packet,from,has:=nc.socket_receive(&sock,buf[:])
+   if !has { break }
+   nc.server_receive(&ns.srv,from,packet,now)
+  }
+  steps:=0
+  for accumulator+1e-9>=NET_STEP_DT && steps<5 {
+   net_server_tick(&ns,now)
+   accumulator-=NET_STEP_DT
+   steps+=1
+  }
+  if steps==5 && accumulator>=NET_STEP_DT {
+   overrun_count+=1
+   fmt.eprintf("server tick overrun at %.2fs: dropping %.1fms of accumulated time\n",now,accumulator*1000)
+   accumulator=0
+  }
+  packets:=nc.server_take_outgoing(&ns.srv)
+  for p in packets { _=nc.socket_send(&sock,p.to,p.data) }
+  nc.outgoing_free(&packets)
+  if now>=report_at {
+   fmt.printf("SERVER time=%.0fs tick=%d active=%d overruns=%d hashes=%d mismatches=%d unrecorded=%d\n",now,ns.tick,nc.server_client_count(&ns.srv),overrun_count,ns.real_hash_checks,ns.real_hash_mismatch,ns.real_hash_unrecorded)
+   for &c,i in ns.srv.clients {
+    if !c.active { continue }
+    bytes:=c.endpoint.stats.bytes_sent
+    fmt.printf("  client=%d addr=%v RTT=%.0fms tx=%.0f kbit/s\n",i,c.address,c.endpoint.stats.rtt*1000,f64(bytes-last_bytes[i])*8/10000)
+    last_bytes[i]=bytes
+   }
+   report_at+=10
+  }
+  time.sleep(time.Millisecond)
+ }
+ fmt.printf("SERVER final hashes=%d mismatches=%d unrecorded=%d\n",ns.real_hash_checks,ns.real_hash_mismatch,ns.real_hash_unrecorded)
+ return ns.real_hash_mismatch==0 && ns.real_hash_unrecorded==0
+}
+
+net_real_cli_server :: proc(args: []string) -> bool {
+ port:=NET_REAL_PORT
+ layout:=""
+ seconds:=f64(0)
+ host_token:=""
+ i:=0
+ for i<len(args) {
+  switch args[i] {
+  case "--port":
+   if i+1>=len(args) { fmt.eprintln("--port requires 1..65535");return false }
+   p,ok:=net_real_cli_port(args[i+1]);if !ok { fmt.eprintln("Invalid port");return false };port=p;i+=2
+  case "--layout":
+   if i+1>=len(args) { fmt.eprintln("--layout needs a path");return false };layout=args[i+1];i+=2
+  case "--seconds":
+   if i+1>=len(args) { return false }
+   n,ok:=strconv.parse_int(args[i+1]);if !ok || n<1 { return false };seconds=f64(n);i+=2
+  case "--host-token":
+   if i+1>=len(args) || len(args[i+1])<16 || len(args[i+1])>NET_APP_MAX_TOKEN {
+    fmt.eprintln("--host-token requires a random secret of 16..128 characters");return false
+   }
+   host_token=args[i+1];i+=2
+  case: fmt.eprintln("Unknown --server option:",args[i]);return false
+  }
+ }
+ return net_real_run_server(port,layout,seconds,host_token)
+}
diff --git a/src/shared/sim_net_server.odin b/src/shared/sim_net_server.odin
new file mode 100644
index 0000000..70be5bd
--- /dev/null
+++ b/src/shared/sim_net_server.odin
@@ -0,0 +1,397 @@
+#+feature dynamic-literals
+package shared
+
+import nc "../netcode"
+import b2 "vendor:box2d"
+import math "core:math"
+import fmt "core:fmt"
+import slice "core:slice"
+import time "core:time"
+
+Net_Entity :: struct { state: Pose_State, fx,fy,fa: f32, speed,area,angular_speed: f32 }
+
+Net_Server_Stats :: struct {
+ frame_bytes: [dynamic]i32, // payload bytes of this client's pose frame parts, per tick
+ frame_parts: [dynamic]i32,
+ build_ms: [dynamic]f64,
+ saturated_ticks,ticks: int, // ticks where some candidate did not fit the budget
+ staleness_max: u64,
+ staleness_samples: [dynamic]u16,
+ jumps_applied,jump_presses_seen: int,
+ blasts_applied,blasts_rejected,blast_duplicates: int,
+ rejected_rate,rejected_outside,rejected_solid: int,
+ inputs,inputs_stale,acks: int,
+ entries_sent,gone_sent,forced_sent,parts_sent: int,
+}
+
+Net_Server_Client :: struct {
+ active: bool,
+ is_host: bool, // validated only in the real-process app handshake
+ ring: [NET_SENT_RING]Pose_Table,
+ ring_tick: [NET_SENT_RING]u64,
+ ring_valid: [NET_SENT_RING]bool,
+ has_ack: bool, acked: u64,
+ priority: map[u64]f32,
+ last_sent: map[u64]Pose_State,
+ pending: map[u64]u64,
+ has_input: bool, input_seq: u16,
+ move: f32, radius: f32, jump_counter: u16, jump_pending: bool,
+ last_blast_seq: u16,
+ blast_queue: [dynamic]Net_Blast,
+ blast_ticks: [dynamic]u64,
+ recent_seqs: [16]u16, recent_count: int,
+ stats: Net_Server_Stats,
+}
+
+Net_Server :: struct {
+ game: Headless_Game,
+ srv: nc.Server,
+ repl: Repl_Server,
+ clients: [nc.MAX_CLIENTS]Net_Server_Client,
+ tick: u64,
+ frame_epoch: u32,
+ current: map[u64]Net_Entity,
+ keys: [dynamic]u64,
+ tick_ms,world_ms: [dynamic]f64,
+ record_hashes: bool,real_logging: bool,
+ real_gate: bool, // application Hello required before a World player is created
+ real_host_token: string, // CLI-owned for lifetime of process
+ real_host_index: int,
+ real_host_seen: bool,
+ real_host_left_at: f64,
+ real_reject_at: [nc.MAX_CLIENTS]f64,
+ real_hash_checks,real_hash_mismatch,real_hash_unrecorded: int,
+ hashes: map[u64]u64, // (epoch<<40 | revision) -> hash of the canonical structure
+ reliable_bytes: int,
+ explosions_emitted: int,
+ pre_events: Tick_Events,
+}
+
+net_hash_key :: proc(epoch: u32,revision: u64) -> u64 { return (u64(epoch)<<40)|(revision&((u64(1)<<40)-1)) }
+
+net_server_init_world :: proc(ns: ^Net_Server,game: Headless_Game,record_hashes: bool = false) {
+ ns^={}
+ ns.game=game
+ ns.real_host_index=-1
+ ns.real_host_left_at=-1
+ ns.record_hashes=record_hashes
+ nc.server_init(&ns.srv)
+ ns.current=make(map[u64]Net_Entity)
+ ns.hashes=make(map[u64]u64)
+ // Establish the shared structure index; joiners get a Baseline at the current revision.
+ first:=repl_server_update(&ns.repl,&ns.game.world.scene,0); repl_output_destroy(&first)
+ ns.frame_epoch=ns.game.world.scene.epoch
+ net_record_hash(ns)
+}
+
+net_client_state_clear :: proc(c: ^Net_Server_Client) {
+ for i in 0..<NET_SENT_RING { if c.ring_valid[i] { delete(c.ring[i]) }; c.ring[i]={}; c.ring_valid[i]=false }
+ c.has_ack=false; c.acked=0
+ clear(&c.priority); clear(&c.last_sent); clear(&c.pending)
+}
+
+net_server_destroy :: proc(ns: ^Net_Server) {
+ for &c in ns.clients {
+  net_client_state_clear(&c)
+  delete(c.priority); delete(c.last_sent); delete(c.pending); delete(c.blast_queue); delete(c.blast_ticks)
+  delete(c.stats.frame_bytes); delete(c.stats.frame_parts); delete(c.stats.build_ms); delete(c.stats.staleness_samples)
+ }
+ nc.server_destroy(&ns.srv)
+ repl_server_destroy(&ns.repl)
+ headless_game_destroy(&ns.game)
+ delete(ns.current); delete(ns.keys); delete(ns.tick_ms); delete(ns.world_ms); delete(ns.hashes)
+ delete(ns.pre_events.explosions)
+ ns^={}
+}
+
+net_send_reliable_parts :: proc(ns: ^Net_Server,client: int,out: ^Repl_Output) {
+ for part in out.parts { if nc.server_send_reliable(&ns.srv,client,part) { ns.reliable_bytes+=len(part) } }
+}
+
+net_record_hash :: proc(ns: ^Net_Server) {
+ if !ns.record_hashes { return }
+ s:=&ns.game.world.scene
+ data:=canonical_encode(s); defer delete(data)
+ ns.hashes[net_hash_key(s.epoch,s.structure_revision)]=repl_hash(data)
+}
+
+net_server_join :: proc(ns: ^Net_Server,index: int) {
+ c:=&ns.clients[index]
+ net_client_state_clear(c)
+ if c.priority==nil { c.priority=make(map[u64]f32) }
+ if c.last_sent==nil { c.last_sent=make(map[u64]Pose_State) }
+ if c.pending==nil { c.pending=make(map[u64]u64) }
+ c.has_input=false; c.input_seq=0; c.move=0; c.jump_counter=0; c.jump_pending=false
+ c.last_blast_seq=0; c.recent_count=0
+ clear(&c.blast_queue); clear(&c.blast_ticks)
+ c.active=true; c.is_host=false; c.radius=ns.game.world.settings.blast_radius
+ world_add_player(&ns.game.world,index)
+ out:=repl_server_baseline(&ns.repl,&ns.game.world.scene,ns.tick); defer repl_output_destroy(&out)
+ net_send_reliable_parts(ns,index,&out)
+}
+
+net_server_leave :: proc(ns: ^Net_Server,index: int) {
+ net_client_state_clear(&ns.clients[index])
+ ns.clients[index].active=false
+ ns.clients[index].is_host=false
+ world_remove_player(&ns.game.world,index)
+}
+
+net_server_ack :: proc(ns: ^Net_Server,c: ^Net_Server_Client,tick: u64) {
+ slot:=tick%NET_SENT_RING
+ if !c.ring_valid[slot] || c.ring_tick[slot]!=tick { return }
+ if c.has_ack && tick<=c.acked { return }
+ c.has_ack=true; c.acked=tick; c.stats.acks+=1
+}
+
+net_server_input :: proc(ns: ^Net_Server,index: int,in_: Net_Input) {
+ c:=&ns.clients[index]
+ if !c.active { return }
+ c.stats.inputs+=1
+ if in_.epoch==ns.game.world.scene.epoch && in_.has_ack { net_server_ack(ns,c,in_.ack) }
+ // The jump counter and blast sequence are cumulative: they survive lost and reordered inputs.
+ if seq16_newer(in_.jump_counter,c.jump_counter) { c.jump_counter=in_.jump_counter; c.jump_pending=true; c.stats.jumps_applied+=1 }
+ for k in 0..<in_.blast_count {
+  b:=in_.blasts[k]
+  if !seq16_newer(b.seq,c.last_blast_seq) { continue }
+  queued:=false
+  for q in c.blast_queue { if q.seq==b.seq { queued=true } }
+  if !queued { append(&c.blast_queue,b) }
+ }
+ if c.has_input && !seq16_newer(in_.seq,c.input_seq) { c.stats.inputs_stale+=1; return }
+ c.has_input=true; c.input_seq=in_.seq
+ c.move=move_dequantize(in_.move); if !ns.real_gate { c.radius=radius_dequantize(in_.radius_q) }
+}
+
+net_server_blast :: proc(ns: ^Net_Server,index: int,b: Net_Blast) {
+ c:=&ns.clients[index]; w:=&ns.game.world
+ c.last_blast_seq=b.seq
+ for i in 0..<min(c.recent_count,len(c.recent_seqs)) { if c.recent_seqs[i]==b.seq { c.stats.blast_duplicates+=1; return } }
+ c.recent_seqs[c.recent_count%len(c.recent_seqs)]=b.seq; c.recent_count+=1
+ point:=Vec2{nc.dequantize_pos(b.x),nc.dequantize_pos(b.y)}
+ radius:=c.radius; if !ns.real_gate { radius=radius_dequantize(b.radius_q) }
+ inside:=point.x>=YARD_LEFT && point.x<=YARD_RIGHT && point.y>YARD_FLOOR_BOTTOM && point.y<=NET_YARD_CEILING
+ recent:=0
+ for t in c.blast_ticks { if ns.tick+1-t<NET_BLAST_RATE_TICKS { recent+=1 } }
+ reason:=0
+ if !inside { reason=1 } else if recent>=NET_BLAST_RATE_COUNT { reason=2 } else if !sandbox_valid_aim(&w.scene,point) { reason=3 }
+ if reason!=0 {
+  c.stats.blasts_rejected+=1
+  switch reason { case 1: c.stats.rejected_outside+=1; case 2: c.stats.rejected_rate+=1; case 3: c.stats.rejected_solid+=1 }
+  ns.pre_events.blast_rejected[index]=true
+  wr:nc.Writer; nc.writer_init(&wr,16); defer nc.writer_destroy(&wr)
+  event_encode_rejected(&wr,ns.tick+1,b.seq)
+  nc.server_send_reliable(&ns.srv,index,wr.data[:])
+  return
+ }
+ world_explode(w,point,radius,&ns.pre_events)
+ c.stats.blasts_applied+=1
+ append(&c.blast_ticks,ns.tick+1)
+}
+
+net_collect :: proc(ns: ^Net_Server) {
+ clear(&ns.current)
+ w:=&ns.game.world; s:=&w.scene
+ for p in s.pieces {
+  if !p.live || p.body==b2.nullBodyId || s.materials[p.material].flexibility>0 { continue }
+  if b2.Body_GetType(p.body)!=.dynamicBody { continue }
+  pos,rot:=b2.Body_GetPosition(p.body),b2.Body_GetRotation(p.body)
+  angle:=f32(math.atan2(rot.s,rot.c))
+  reference:=frame_to_reference(Pose{position=from_b2(pos),angle=angle},p.ref_rest)
+  pos=to_b2(reference.position)
+  velocity:=b2.Body_GetLocalPointVelocity(p.body,to_b2(p.ref_rest))
+  ns.current[ent_key(.Piece,p.id)]=Net_Entity{state=pose_state_make(pos.x,pos.y,angle),fx=pos.x,fy=pos.y,fa=angle,speed=math.sqrt(velocity.x*velocity.x+velocity.y*velocity.y),area=p.mass,angular_speed=math.abs(b2.Body_GetAngularVelocity(p.body))}
+ }
+ for sub in s.subdivisions {
+  if !sub.live || sub.body==b2.nullBodyId || s.materials[sub.material].flexibility<=0 { continue }
+  if b2.Body_GetType(sub.body)!=.dynamicBody { continue }
+  pose:=sub.pose
+  ns.current[ent_key(.Rubber,sub.id)]=Net_Entity{state=pose_state_make(pose.position.x,pose.position.y,pose.angle),fx=pose.position.x,fy=pose.position.y,fa=pose.angle,speed=vlen(pose.velocity),area=polygon_area(sub.outline)}
+ }
+ for player,i in w.players {
+  if !player.active { continue }
+  pose:=player.pose
+  ns.current[ent_key(.Player,u64(i))]=Net_Entity{state=pose_state_make(pose.position.x,pose.position.y,pose.angle),fx=pose.position.x,fy=pose.position.y,fa=pose.angle}
+ }
+ for bomb in w.bombs {
+  pose:=bomb.pose
+  state:=pose_state_make(pose.position.x,pose.position.y,pose.angle)
+  state.landed=bomb.landed; state.fuse=pose_q_fuse(bomb.fuse)
+  ns.current[ent_key(.Bomb,bomb.id)]=Net_Entity{state=state,fx=pose.position.x,fy=pose.position.y,fa=pose.angle}
+ }
+ sorted_keys(&ns.current,&ns.keys)
+}
+
+Net_Candidate :: struct { entry: Frame_Entry, accumulator: f32, fresh: bool }
+
+net_build_frame :: proc(ns: ^Net_Server,index: int) {
+ c:=&ns.clients[index]; w:=&ns.game.world
+ started:=time.tick_now()
+ base:^Pose_Table; has_base:=false; base_tick:=u64(0)
+ if c.has_ack {
+  slot:=c.acked%NET_SENT_RING
+  if c.ring_valid[slot] && c.ring_tick[slot]==c.acked { base=&c.ring[slot]; has_base=true; base_tick=c.acked }
+ }
+ player_position:=Vec2{}; if w.players[index].active { player_position=w.players[index].pose.position }
+ candidates:[dynamic]Net_Candidate; defer delete(candidates)
+ forced:[dynamic]Frame_Entry; defer delete(forced)
+ for key in ns.keys {
+  entity:=ns.current[key]
+  row:Pose_State; has:=false
+  if base!=nil { row,has=base^[key] }
+  // Staleness: when did this state first differ from what was last sent?
+  last,sent_before:=c.last_sent[key]
+  matches_base:=has && row==entity.state
+  if matches_base { delete_key(&c.pending,key) } // the acked table already shows this state
+  else if !sent_before || last!=entity.state { if key not_in c.pending { c.pending[key]=ns.tick } }
+  if matches_base { delete_key(&c.priority,key); continue }
+  kind:=key_kind(key)
+  if kind==.Player || kind==.Bomb { append(&forced,Frame_Entry{key,entity.state}); continue }
+  near:=vlen(vsub(Vec2{entity.fx,entity.fy},player_position))<4
+  gain:=(1+entity.speed)*(0.5+min(entity.area,1))*(near?2:1)
+  accumulator:=c.priority[key]+gain
+  c.priority[key]=accumulator
+  append(&candidates,Net_Candidate{entry={key,entity.state},accumulator=accumulator,fresh=!has})
+ }
+ gone:[dynamic]u64; defer delete(gone)
+ if base!=nil { for key in base^ { if key not_in ns.current { append(&gone,key) } } }
+ slice.sort(gone[:])
+ // Budget: gone ids first, then candidates by priority (entities without a row go first).
+ slice.sort_by(candidates[:],proc(a,b: Net_Candidate) -> bool {
+  if a.fresh!=b.fresh { return a.fresh }
+  if a.accumulator!=b.accumulator { return a.accumulator>b.accumulator }
+  return a.entry.key<b.entry.key
+ })
+ budget:=FRAME_BUDGET
+ gone_count:=min(len(gone),budget/3)
+ budget-=gone_count*3
+ chosen:[dynamic]Frame_Entry; defer delete(chosen)
+ unsent:=0
+ for cand in candidates {
+  size:=frame_entry_estimate(cand.entry,base)
+  if size<=budget { append(&chosen,cand.entry); budget-=size } else { unsent+=1 }
+ }
+ c.stats.ticks+=1; if unsent>0 { c.stats.saturated_ticks+=1 }
+ c.stats.entries_sent+=len(chosen)+len(forced); c.stats.forced_sent+=len(forced); c.stats.gone_sent+=gone_count
+ entries:[dynamic]Frame_Entry; defer delete(entries)
+ append(&entries,..chosen[:]); append(&entries,..forced[:])
+ slice.sort_by(entries[:],proc(a,b: Frame_Entry) -> bool { return a.key<b.key })
+ parts:[dynamic][]u8; defer delete(parts)
+ frame_encode(w.scene.epoch,ns.tick,has_base,base_tick,c.last_blast_seq,base,entries[:],gone[:gone_count],&parts)
+ total:=0
+ for part in parts { total+=len(part); nc.server_send_unreliable(&ns.srv,index,part); delete(part) }
+ // The table the client will hold for this frame: base - gone + entries, bit for bit.
+ table:=table_clone(base)
+ for key in gone[:gone_count] { delete_key(&table,key) }
+ for e in entries { table[e.key]=e.state }
+ slot:=ns.tick%NET_SENT_RING
+ if c.ring_valid[slot] { delete(c.ring[slot]) }
+ c.ring[slot]=table; c.ring_tick[slot]=ns.tick; c.ring_valid[slot]=true
+ for e in entries {
+  if since,ok:=c.pending[e.key]; ok {
+   late:=ns.tick-since
+   c.stats.staleness_max=max(c.stats.staleness_max,late); append(&c.stats.staleness_samples,u16(min(late,65535)))
+   delete_key(&c.pending,e.key)
+  } else { append(&c.stats.staleness_samples,0) }
+  c.last_sent[e.key]=e.state
+  if e.key in c.priority { c.priority[e.key]=0 }
+ }
+ // Forget bookkeeping for entities that no longer exist.
+ stale:[dynamic]u64; defer delete(stale)
+ for key in c.last_sent { if key not_in ns.current { append(&stale,key) } }
+ for key in stale { delete_key(&c.last_sent,key); delete_key(&c.pending,key); delete_key(&c.priority,key) }
+ c.stats.parts_sent+=len(parts)
+ append(&c.stats.frame_bytes,i32(total)); append(&c.stats.frame_parts,i32(len(parts)))
+ append(&c.stats.build_ms,f64(time.tick_diff(started,time.tick_now()))/f64(time.Millisecond))
+}
+
+net_server_reset_frames :: proc(ns: ^Net_Server) {
+ for &c in ns.clients { net_client_state_clear(&c) }
+ ns.frame_epoch=ns.game.world.scene.epoch
+}
+
+net_server_tick :: proc(ns: ^Net_Server,now: f64) {
+ started:=time.tick_now()
+ w:=&ns.game.world
+ events:=nc.server_take_events(&ns.srv); defer nc.server_events_free(&events)
+ for ev in events {
+  switch ev.kind {
+  case .Connected:
+   if ns.real_logging { fmt.printf("CONNECT client=%d\n",ev.client) }
+   ns.real_reject_at[ev.client]=0
+   if !ns.real_gate { net_server_join(ns,ev.client) }
+  case .Disconnected:
+   if ns.real_logging { fmt.printf("DISCONNECT client=%d reason=%v\n",ev.client,ev.reason) }
+   net_app_server_disconnect(ns,ev.client,now)
+   ns.real_reject_at[ev.client]=0
+   net_server_leave(ns,ev.client)
+  case .Message:
+   if ns.real_gate && !ns.clients[ev.client].active {
+    if ev.channel==nc.CHANNEL_RELIABLE && len(ev.data)>0 && ev.data[0]==NET_APP_HELLO {
+     net_app_server_hello(ns,ev.client,ev.data,now)
+    }
+    continue // no input, hash or host command before authorization
+   }
+   if ev.channel==nc.CHANNEL_UNRELIABLE && len(ev.data)>0 && ev.data[0]==NET_MSG_INPUT {
+    if in_,ok:=input_decode(ev.data); ok { net_server_input(ns,ev.client,in_) }
+   } else if ns.real_gate && ev.channel==nc.CHANNEL_RELIABLE && len(ev.data)>0 && (ev.data[0]==NET_APP_LAYOUT_UPLOAD || ev.data[0]==NET_APP_HOST_COMMAND) {
+    net_host_dispatch(ns,ev.client,ev.data)
+   } else if ns.record_hashes && ev.channel==nc.CHANNEL_RELIABLE && len(ev.data)>0 && ev.data[0]==NET_REAL_HASH_REPORT {
+    r:nc.Reader;nc.reader_init(&r,ev.data)
+    _=nc.read_u8(&r)
+    epoch:=nc.read_u32(&r);revision:=nc.read_u64(&r);hash:=nc.read_u64(&r)
+    if !r.ok || r.pos!=len(ev.data) { continue }
+    ns.real_hash_checks+=1
+    if expected,found:=ns.hashes[net_hash_key(epoch,revision)]; found {
+     if expected!=hash { ns.real_hash_mismatch+=1 }
+    } else { ns.real_hash_unrecorded+=1 }
+   }
+  }
+ }
+ // Apply inputs: blasts in player order and sequence order, then the world tick.
+ commands:Tick_Commands
+ for i in 0..<nc.MAX_CLIENTS {
+  c:=&ns.clients[i]
+  if !c.active || !w.players[i].active { continue }
+  if c.has_input { w.players[i].blast_radius=c.radius }
+  commands.players[i].move=c.move; commands.players[i].jump=c.jump_pending; c.jump_pending=false
+  slice.sort_by(c.blast_queue[:],proc(a,b: Net_Blast) -> bool { return seq16_newer(b.seq,a.seq) })
+  for b in c.blast_queue { net_server_blast(ns,i,b) }
+  clear(&c.blast_queue)
+  for len(c.blast_ticks)>0 && ns.tick+1-c.blast_ticks[0]>=NET_BLAST_RATE_TICKS { ordered_remove(&c.blast_ticks,0) }
+ }
+ world_started:=time.tick_now()
+ post:=world_tick(w,commands,1.0/60.0)
+ append(&ns.world_ms,f64(time.tick_diff(world_started,time.tick_now()))/f64(time.Millisecond))
+ ns.tick+=1
+ // Structure and events, reliable, to every client.
+ out:=repl_server_update(&ns.repl,&w.scene,ns.tick); defer repl_output_destroy(&out)
+ if w.scene.epoch!=ns.frame_epoch { net_server_reset_frames(ns) }
+ if out.kind!=.None {
+  net_record_hash(ns)
+  for i in 0..<nc.MAX_CLIENTS { if ns.clients[i].active { net_send_reliable_parts(ns,i,&out) } }
+ }
+ for list in ([2][dynamic]Explosion_Event{ns.pre_events.explosions,post.explosions}) {
+  for e in list {
+   wr:nc.Writer; nc.writer_init(&wr,24)
+   event_encode_explosion(&wr,ns.tick,e.position,e.radius)
+   for i in 0..<nc.MAX_CLIENTS { if ns.clients[i].active { nc.server_send_reliable(&ns.srv,i,wr.data[:]) } }
+   nc.writer_destroy(&wr); ns.explosions_emitted+=1
+  }
+ }
+ delete(post.explosions); clear(&ns.pre_events.explosions); ns.pre_events.blast_rejected={}
+ // Pose frames, unreliable, one per client.
+ net_collect(ns)
+ for i in 0..<nc.MAX_CLIENTS { if ns.clients[i].active { net_build_frame(ns,i) } }
+ // Delay a rejected peer's removal long enough to deliver its reliable reason.
+ if ns.real_gate {
+  for i in 0..<nc.MAX_CLIENTS {
+   if ns.real_reject_at[i]>0 && now>=ns.real_reject_at[i] {
+    ns.real_reject_at[i]=0
+    nc.server_kick(&ns.srv,i)
+   }
+  }
+ }
+ nc.server_update(&ns.srv,now)
+ append(&ns.tick_ms,f64(time.tick_diff(started,time.tick_now()))/f64(time.Millisecond))
+}
diff --git a/src/shared/sim_net_session.odin b/src/shared/sim_net_session.odin
new file mode 100644
index 0000000..7aeab73
--- /dev/null
+++ b/src/shared/sim_net_session.odin
@@ -0,0 +1,82 @@
+#+feature dynamic-literals
+package shared
+
+import nc "../netcode"
+import fmt "core:fmt"
+
+NET_APP_MAX_BUILD :: 80
+
+NET_APP_MAX_TOKEN :: 128
+
+NET_APP_REJECT_GRACE :: 2.0
+
+Net_App_Hello :: struct {
+ version: u32,
+ build: string, // views into the packet; do not persist without cloning
+ token: string,
+}
+
+net_app_read_hello :: proc(data: []u8) -> (hello: Net_App_Hello, valid: bool) {
+ if len(data)<1 || data[0]!=NET_APP_HELLO || len(data)>256 { return {},false }
+ r:nc.Reader; nc.reader_init(&r,data)
+ _=nc.read_u8(&r)
+ hello.version=nc.read_u32(&r)
+ hello.build=nc.read_string(&r)
+ hello.token=nc.read_string(&r)
+ valid=r.ok && r.pos==len(data) && len(hello.build)>0 && len(hello.build)<=NET_APP_MAX_BUILD && len(hello.token)<=NET_APP_MAX_TOKEN
+ return
+}
+
+net_app_hello_error :: proc(h: Net_App_Hello) -> string {
+ if h.version!=GAME_PROTOCOL_VERSION || h.build!=GAME_BUILD_ID {
+  return fmt.tprintf("version mismatch (server %d/%s, you %d/%s)", GAME_PROTOCOL_VERSION, GAME_BUILD_ID, h.version, h.build)
+ }
+ return ""
+}
+
+net_app_send_reject :: proc(ns: ^Net_Server, index: int, reason: string, now: f64) {
+ if index<0 || index>=nc.MAX_CLIENTS || ns.real_reject_at[index]>0 { return }
+ w:nc.Writer;nc.writer_init(&w,64);defer nc.writer_destroy(&w)
+ nc.write_u8(&w,NET_APP_REJECT);nc.write_string(&w,reason)
+ _=nc.server_send_reliable(&ns.srv,index,w.data[:])
+ ns.real_reject_at[index]=now+NET_APP_REJECT_GRACE
+ if ns.real_logging { fmt.printf("HELLO REJECT client=%d reason=%s\n",index,reason) }
+}
+
+net_app_server_hello :: proc(ns: ^Net_Server,index: int,data: []u8,now: f64) {
+ if ns.clients[index].active || ns.real_reject_at[index]>0 { return }
+ hello,ok:=net_app_read_hello(data)
+ if !ok { net_app_send_reject(ns,index,"invalid hello",now);return }
+ if reason:=net_app_hello_error(hello);reason!="" { net_app_send_reject(ns,index,reason,now);return }
+ is_host:=false
+ if ns.real_host_token!="" && hello.token==ns.real_host_token {
+  if ns.real_host_index>=0 && ns.real_host_index!=index { net_app_send_reject(ns,index,"host already connected",now);return }
+  is_host=true
+ }
+ // No player is ever added before version/build validation.
+ net_server_join(ns,index)
+ ns.clients[index].is_host=is_host
+ if is_host {
+  ns.real_host_index=index
+  ns.real_host_seen=true
+  ns.real_host_left_at=-1
+ }
+ w:nc.Writer;nc.writer_init(&w,16);defer nc.writer_destroy(&w)
+ nc.write_u8(&w,NET_APP_WELCOME)
+ nc.write_u8(&w,u8(index))
+ nc.write_bool(&w,is_host)
+ _=nc.server_send_reliable(&ns.srv,index,w.data[:])
+ net_host_send_settings(ns,index)
+ if ns.real_logging { fmt.printf("HELLO OK client=%d role=%s\n",index,is_host?"HOST":"player") }
+}
+
+net_app_server_disconnect :: proc(ns: ^Net_Server,index: int,now: f64) {
+ if !ns.real_gate || ns.real_host_index!=index { return }
+ ns.real_host_index=-1
+ ns.real_host_left_at=now
+ for i in 0..<nc.MAX_CLIENTS {
+  if i==index || !ns.clients[i].active { continue }
+  _=nc.server_send_reliable(&ns.srv,i,[]u8{NET_APP_HOST_LEFT})
+ }
+ if ns.real_logging { fmt.println("HOST left; server will exit in 5s") }
+}
diff --git a/src/shared/sim_physics.odin b/src/shared/sim_physics.odin
new file mode 100644
index 0000000..50a7fbd
--- /dev/null
+++ b/src/shared/sim_physics.odin
@@ -0,0 +1,337 @@
+#+feature dynamic-literals
+package shared
+
+import time "core:time"
+import b2 "vendor:box2d"
+import math "core:math"
+
+PHYSICS_SUBSTEPS :: 4
+
+GLOBAL_DAMPING :: f32(0.7)
+
+to_b2 :: proc(v: Vec2) -> b2.Vec2 { return {v.x,v.y} }
+
+from_b2 :: proc(v: b2.Vec2) -> Vec2 { return {v.x,v.y} }
+
+physics_init :: proc(s: ^Scene, gravity: Vec2 = {}, anchor_y: f32 = -1e30) {
+ assert(!s.physics.active)
+ def := b2.DefaultWorldDef()
+ def.gravity = to_b2(gravity)
+ // Hit events are evaluated every step in Box2D 3.1.1, not just on begin.
+ def.hitEventThreshold = 0
+ s.anchor_y = anchor_y
+ s.physics = Physics{world=b2.CreateWorld(def),active=true,mortar_breaking=true}
+ physics_sync_structure(s)
+}
+
+physics_read_motion :: proc(s: ^Scene) {
+ if !s.physics.active { return }
+ for &sub in s.subdivisions {
+  body:=sub.body
+  if body==b2.nullBodyId { continue }
+  rotation := b2.Body_GetRotation(body)
+  position:=from_b2(b2.Body_GetPosition(body))
+  if s.materials[sub.material].flexibility==0 { position=from_b2(b2.Body_GetWorldPoint(body,to_b2(sub.rest_center))) }
+  sub.pose = Pose{position=position,angle=math.atan2(rotation.s,rotation.c),
+   velocity=from_b2(b2.Body_GetWorldPointVelocity(body,to_b2(position))),angular_velocity=b2.Body_GetAngularVelocity(body)}
+ }
+}
+
+physics_shape_def :: proc(id: u64) -> b2.ShapeDef {
+ def:=b2.DefaultShapeDef()
+ def.density=1; def.enableHitEvents=true; def.updateBodyMass=false
+ def.userData=rawptr(uintptr(id))
+ return def
+}
+
+physics_create_fixture :: proc(s: ^Scene, body: b2.BodyId, sub: Subdivision, outline: Polygon) -> bool {
+
+
+ points: [dynamic]b2.Vec2; defer delete(points)
+ offset:=Vec2{}
+ if s.materials[sub.material].flexibility>0 { offset=sub.rest_center }
+ for point in outline.points { append(&points,to_b2(vsub(point,offset))) }
+ hull:=b2.ComputeHull(points[:])
+ // Hull welding can collapse a thin ear below Box2D's collision tolerance.
+ if hull.count<3 { return false }
+ when BOM_PROFILE { if blast_profile!=nil { blast_profile.counts[3]+=1 } }
+ shape:=b2.CreatePolygonShape(body,physics_shape_def(sub.id),b2.MakePolygon(hull,0))
+ append(&s.subdivisions[s.sub_rows[sub.id]].shapes,shape)
+ s.subdivisions[s.sub_rows[sub.id]].fixture_count+=1
+ return true
+}
+
+physics_create_region_shapes :: proc(s: ^Scene,id: u64,body: b2.BodyId) {
+ sub:=s.subdivisions[s.sub_rows[id]]
+ if is_convex(sub.outline) && len(sub.outline.points)<=8 { physics_create_fixture(s,body,sub,sub.outline) }
+ else {
+  parts:=convex_decomposition(sub.outline)
+  for part in parts { physics_create_fixture(s,body,sub,part); delete(part.points) }
+  delete(parts)
+ }
+ if s.subdivisions[s.sub_rows[id]].fixture_count==0 {
+  // Preserve the existing microscopic-outline fallback, in the body's frame.
+  offset:=Vec2{}
+  if s.materials[sub.material].flexibility>0 { offset=sub.rest_center }
+  lo,hi:=Vec2{1e30,1e30},Vec2{-1e30,-1e30}
+  for rest in sub.outline.points { p:=vsub(rest,offset); lo={min(lo.x,p.x),min(lo.y,p.y)}; hi={max(hi.x,p.x),max(hi.y,p.y)} }
+  polygon:=b2.MakeOffsetBox(max(f32(0.0025),(hi.x-lo.x)*0.5),max(f32(0.0025),(hi.y-lo.y)*0.5),to_b2(vmul(vadd(lo,hi),0.5)),b2.MakeRot(0))
+  when BOM_PROFILE { if blast_profile!=nil { blast_profile.counts[3]+=1 } }
+ shape:=b2.CreatePolygonShape(body,physics_shape_def(id),polygon)
+  append(&s.subdivisions[s.sub_rows[id]].shapes,shape)
+  s.subdivisions[s.sub_rows[id]].fixture_count=1
+ }
+}
+
+physics_remove_region_shapes :: proc(sub: ^Subdivision) {
+ for shape in sub.shapes { b2.DestroyShape(shape,false) }
+ clear(&sub.shapes); sub.fixture_count=0
+}
+
+physics_remove_dead :: proc(s: ^Scene) {
+ if !s.physics.active { return }
+ ids: [dynamic]u64; defer delete(ids)
+ for c in s.connections { if !c.live { append(&ids,c.id) } }; sort_ids(ids[:])
+ for id in ids { c:=&s.connections[s.conn_rows[id]]; if c.joint!=b2.nullJointId { b2.DestroyJoint(c.joint); c.joint={} } }
+ clear(&ids)
+ for sub in s.subdivisions { if !sub.live { append(&ids,sub.id) } }; sort_ids(ids[:])
+ for id in ids {
+  sub:=&s.subdivisions[s.sub_rows[id]]
+  physics_remove_region_shapes(sub)
+  if sub.body!=b2.nullBodyId && s.materials[sub.material].flexibility>0 { b2.DestroyBody(sub.body) }
+  sub.body={}
+ }
+ clear(&ids)
+ for p in s.pieces { if !p.live && p.body!=b2.nullBodyId { append(&ids,p.id) } }; sort_ids(ids[:])
+ // Reach refinement can regroup before the damage pass. If its provisional
+ // keeper then vanishes, retain the body on the largest remaining descendant.
+ claims:=make(map[b2.BodyId]u64); defer delete(claims)
+ for p in s.pieces {
+  if !p.live || p.body!=b2.nullBodyId || p.source_body==b2.nullBodyId { continue }
+  current:=claims[p.source_body]
+  if current==0 { claims[p.source_body]=p.id; continue }
+  other:=s.pieces[s.piece_rows[current]]
+  if len(p.subdivisions)>len(other.subdivisions) || len(p.subdivisions)==len(other.subdivisions) && p.subdivisions[0]<other.subdivisions[0] { claims[p.source_body]=p.id }
+ }
+ for id in ids {
+  p:=&s.pieces[s.piece_rows[id]]
+  if keeper:=claims[p.body]; keeper!=0 { s.pieces[s.piece_rows[keeper]].body=p.body }
+  else { b2.DestroyBody(p.body) }
+  p.body={}
+ }
+}
+
+polygon_centred_inertia :: proc(sub: Subdivision) -> f32 {
+ inertia:f32
+ for a,i in sub.outline.points {
+  b:=sub.outline.points[(i+1)%len(sub.outline.points)]
+  x,y:=vsub(a,sub.rest_center),vsub(b,sub.rest_center)
+  inertia+=vcross(x,y)*(vdot(x,x)+vdot(x,y)+vdot(y,y))/12
+ }
+ return math.abs(inertia)
+}
+
+physics_finish_mass :: proc(s: ^Scene,body: b2.BodyId,sub: Subdivision) {
+ b2.Body_ApplyMassFromShapes(body) // Also refresh Box2D collision extents for CCD.
+ b2.Body_SetMassData(body,b2.MassData{mass=polygon_area(sub.outline),center={},rotationalInertia=polygon_centred_inertia(sub)})
+ b2.Body_SetLinearVelocity(body,to_b2(sub.pose.velocity)); b2.Body_SetAngularVelocity(body,sub.pose.angular_velocity)
+}
+
+physics_finish_piece_mass :: proc(s: ^Scene,p: ^Piece) {
+ mass,inertia:f32; center:=Vec2{}
+ for id in p.subdivisions {
+  sub:=s.subdivisions[s.sub_rows[id]]; area:=polygon_area(sub.outline)
+  mass+=area; center=vadd(center,vmul(sub.rest_center,area))
+ }
+ center=vmul(center,1/mass)
+ for id in p.subdivisions {
+  sub:=s.subdivisions[s.sub_rows[id]]; r:=vsub(sub.rest_center,center)
+  inertia+=polygon_centred_inertia(sub)+polygon_area(sub.outline)*vdot(r,r)
+ }
+ // Preserve the old rigid velocity field at this group's new centre of mass.
+ sub:=s.subdivisions[s.sub_rows[p.subdivisions[0]]]
+ world_center:=from_b2(b2.Body_GetWorldPoint(p.body,to_b2(center)))
+ r:=vsub(world_center,sub.pose.position)
+ velocity:=vadd(sub.pose.velocity,Vec2{-sub.pose.angular_velocity*r.y,sub.pose.angular_velocity*r.x})
+ // 3.1.1 SetMassData consumes COM inertia directly (the binding's
+ // local-origin comment is stale). Refresh extents before the exact override.
+ b2.Body_ApplyMassFromShapes(p.body)
+ b2.Body_SetMassData(p.body,b2.MassData{mass=mass,center=to_b2(center),rotationalInertia=inertia})
+ b2.Body_SetLinearVelocity(p.body,to_b2(velocity)); b2.Body_SetAngularVelocity(p.body,sub.pose.angular_velocity)
+ p.physics_revision=p.render_revision+1
+}
+
+physics_new_body :: proc(s: ^Scene,sub: Subdivision,kind: b2.BodyType,rigid: bool,frame: b2.Transform = {},has_frame: bool = false) -> b2.BodyId {
+ when BOM_PROFILE { if blast_profile!=nil { blast_profile.counts[2]+=1 } }
+
+ def:=b2.DefaultBodyDef(); def.type=kind
+ position:=sub.pose.position
+ if rigid { position=vsub(position,vrotate(sub.rest_center,sub.pose.angle)) }
+ def.position=to_b2(position); def.rotation=b2.MakeRot(sub.pose.angle)
+ if has_frame { def.position=frame.p; def.rotation=frame.q }
+ // Mass data below supplies COM velocity after fixtures have been assembled.
+ // Rigid contacts use the body mass. A retained body must not carry a region
+ // tag that could later belong to another group; shape tags identify regions.
+ if !rigid { def.userData=rawptr(uintptr(sub.id)) }
+ return b2.CreateBody(s.physics.world,def)
+}
+
+physics_sync_structure :: proc(s: ^Scene) {
+ when BOM_PROFILE { started:=time.tick_now(); defer profile_add(7,started) }
+
+ if !s.physics.active || (s.physics.synced && s.physics.synced_revision==s.structure_revision) { return }
+ scene_finish_references(s)
+ s.physics.synced=true; s.physics.synced_revision=s.structure_revision
+ clear(&s.pending_regions)
+ anchored:=make(map[u64]bool); defer delete(anchored)
+ if s.anchor_y>-1e30 {
+  for p in s.pieces { if p.live && piece_anchored(s,p.id,s.anchor_y) { anchored[p.id]=true } }
+ }
+ ids: [dynamic]u64; defer delete(ids)
+ for p in s.pieces { if p.live { append(&ids,p.id) } }; sort_ids(ids[:])
+ for id in ids {
+  p:=&s.pieces[s.piece_rows[id]]
+  if s.materials[p.material].flexibility>0 { continue }
+  kind:=b2.BodyType.dynamicBody; if anchored[id] { kind=.staticBody }
+  if p.body==b2.nullBodyId { p.body=physics_new_body(s,s.subdivisions[s.sub_rows[p.subdivisions[0]]],kind,true,p.body_frame,p.has_body_frame) }
+  else if b2.Body_GetType(p.body)!=kind { b2.Body_SetType(p.body,kind); p.physics_revision=0 }
+  p.has_body_frame=false; p.source_body={}
+ }
+ clear(&ids)
+ for sub in s.subdivisions { if sub.live { append(&ids,sub.id) } }; sort_ids(ids[:])
+ // Detach old shapes before adding any: a moved region cannot occupy both bodies.
+ for id in ids {
+  sub:=&s.subdivisions[s.sub_rows[id]]
+  if s.materials[sub.material].flexibility==0 && sub.body!=s.pieces[s.piece_rows[sub.owner]].body {
+   physics_remove_region_shapes(sub); sub.body={}
+  }
+ }
+ for id in ids {
+  sub:=s.subdivisions[s.sub_rows[id]]
+  rigid:=s.materials[sub.material].flexibility==0
+  kind:=b2.BodyType.dynamicBody; if anchored[sub.owner] { kind=.staticBody }
+  if rigid {
+   if sub.body==b2.nullBodyId {
+    body:=s.pieces[s.piece_rows[sub.owner]].body
+    s.subdivisions[s.sub_rows[id]].body=body; physics_create_region_shapes(s,id,body)
+   }
+  } else if sub.body==b2.nullBodyId {
+   body:=physics_new_body(s,sub,kind,false); s.subdivisions[s.sub_rows[id]].body=body
+   physics_create_region_shapes(s,id,body); physics_finish_mass(s,body,sub)
+  } else if b2.Body_GetType(sub.body)!=kind {
+   b2.Body_SetType(sub.body,kind); if kind==.dynamicBody { physics_finish_mass(s,sub.body,sub) }
+  }
+ }
+ clear(&ids)
+ for p in s.pieces { if p.live { append(&ids,p.id) } }; sort_ids(ids[:])
+ for id in ids {
+  p:=&s.pieces[s.piece_rows[id]]
+  if p.body!=b2.nullBodyId && p.physics_revision!=p.render_revision+1 { physics_finish_piece_mass(s,p) }
+ }
+ clear(&ids)
+ for c in s.connections { if c.live { append(&ids,c.id) } }; sort_ids(ids[:])
+ for id in ids {
+  c:=s.connections[s.conn_rows[id]]
+  a,b:=s.subdivisions[s.sub_rows[c.a]],s.subdivisions[s.sub_rows[c.b]]
+  if c.mortar {
+   static_pair:=b2.Body_GetType(a.body)==.staticBody && b2.Body_GetType(b.body)==.staticBody
+   valid:=c.joint!=b2.nullJointId && b2.Joint_IsValid(c.joint)
+   if static_pair { if valid { b2.DestroyJoint(c.joint) }; s.connections[s.conn_rows[id]].joint={}; continue }
+   if valid && b2.Joint_GetBodyA(c.joint)==a.body && b2.Joint_GetBodyB(c.joint)==b.body { continue }
+   if valid { b2.DestroyJoint(c.joint) }
+   def:=b2.DefaultWeldJointDef(); def.bodyIdA=a.body; def.bodyIdB=b.body
+   def.localAnchorA=to_b2(mortar_local_anchor(s,a,c.rest_point))
+   def.localAnchorB=to_b2(mortar_local_anchor(s,b,c.rest_point))
+   def.referenceAngle=0; def.linearHertz=0; def.angularHertz=0
+   s.connections[s.conn_rows[id]].joint=b2.CreateWeldJoint(s.physics.world,def)
+   continue
+  }
+  flexibility:=max(s.materials[a.material].flexibility,s.materials[b.material].flexibility)
+  static_pair:=b2.Body_GetType(a.body)==.staticBody && b2.Body_GetType(b.body)==.staticBody
+  if c.joint!=b2.nullJointId && (flexibility==0 || static_pair) { b2.DestroyJoint(c.joint); s.connections[s.conn_rows[id]].joint={}; continue }
+  if flexibility==0 || static_pair || c.joint!=b2.nullJointId { continue }
+  def:=b2.DefaultWeldJointDef(); def.bodyIdA=a.body; def.bodyIdB=b.body
+  def.localAnchorA=to_b2(c.local_a); def.localAnchorB=to_b2(c.local_b)
+  def.referenceAngle=0
+  def.linearHertz=1/max(flexibility,0.01); def.angularHertz=def.linearHertz
+  def.linearDampingRatio=GLOBAL_DAMPING; def.angularDampingRatio=GLOBAL_DAMPING
+  s.connections[s.conn_rows[id]].joint=b2.CreateWeldJoint(s.physics.world,def)
+ }
+ physics_read_motion(s)
+}
+
+apply_blast_motion :: proc(s: ^Scene, sub: ^Subdivision, direction: Vec2, load: f32) {
+ delta_v:=vmul(direction,load*BLAST_IMPULSE_SCALE)
+ if s.physics.active {
+  impulse:=vmul(delta_v,polygon_area(sub.outline))
+  if s.materials[sub.material].flexibility>0 { b2.Body_ApplyLinearImpulseToCenter(sub.body,to_b2(impulse),true) }
+  else { b2.Body_ApplyLinearImpulse(sub.body,to_b2(impulse),to_b2(sub.pose.position),true) }
+ } else { sub.pose.velocity=vadd(sub.pose.velocity,delta_v) }
+}
+
+interaction_mass :: proc(s: ^Scene,body: b2.BodyId) -> f32 {
+ if b2.Body_GetType(body)!=.dynamicBody { return math.inf_f32(1) }
+ id:=u64(uintptr(b2.Body_GetUserData(body)))
+ if row,ok:=s.sub_rows[id]; ok { return s.pieces[s.piece_rows[s.subdivisions[row].owner]].mass }
+ return b2.Body_GetMass(body)
+}
+
+contact_damage_load :: proc(s: ^Scene,body,other: b2.BodyId,approach_speed,impact_scale: f32) -> f32 {
+ if impact_scale==0 || b2.Body_GetType(body)!=.dynamicBody { return 0 }
+ own_mass,other_mass:=interaction_mass(s,body),interaction_mass(s,other)
+ dv:=max(f32(0),approach_speed)
+ if finite(other_mass) { dv*=other_mass/(own_mass+other_mass) }
+ return dv*impact_scale/BLAST_IMPULSE_SCALE
+}
+
+calculate_physics_loads :: proc(s: ^Scene, dt: f32) -> Failures {
+	assert(dt > 0)
+	failures := Failures{impact=true}
+	loads := make(map[u64]f32)
+	defer delete(loads)
+ points:map[u64]Vec2; defer delete(points)
+	events:=b2.World_GetContactEvents(s.physics.world)
+	for hit in events.hitEvents[:events.hitCount] {
+		a,b:=b2.Shape_GetBody(hit.shapeIdA),b2.Shape_GetBody(hit.shapeIdB)
+		bodies:=[2]b2.BodyId{a,b}
+		shapes:=[2]b2.ShapeId{hit.shapeIdA,hit.shapeIdB}
+		for body,i in bodies {
+			id:=u64(uintptr(b2.Shape_GetUserData(shapes[i])))
+			row,exists:=s.sub_rows[id]
+			if !exists || !s.subdivisions[row].live { continue }
+			sub:=s.subdivisions[row]
+			load:=contact_damage_load(s,body,bodies[1-i],hit.approachSpeed,s.materials[sub.material].impact_scale)
+   if s.materials[sub.material].shock_loss>0 {
+    if points==nil { points=make(map[u64]Vec2) }
+    point:=from_b2(hit.point); previous,has_point:=points[id]
+    if !has_point || load>loads[id] || load==loads[id] && (point.x<previous.x || point.x==previous.x && point.y<previous.y) { points[id]=point }
+   }
+			loads[id]=max(loads[id],load)
+		}
+	}
+ if s.physics.mortar_breaking { mortar_force_failures(s,&failures,dt) }
+
+	for sub in s.subdivisions {
+		if sub.seed==0 && sub.width>s.minimum_width { continue }
+		if sub.live && fails(loads[sub.id],s.materials[sub.material].subdivision_strength) {
+   append(&failures.subdivisions,sub.id)
+   if s.materials[sub.material].shock_loss>0 { append(&failures.impact_sources,Impact_Shock_Source{sub.id,points[sub.id],loads[sub.id]}) }
+  }
+	}
+	return failures
+}
+
+Load_Calculator :: #type proc(s: ^Scene,dt: f32) -> Failures
+
+physics_tick :: proc(s: ^Scene, dt: f32,calculate_loads: Load_Calculator = calculate_physics_loads) {
+ when BOM_FRAME_BENCH { frame_start:=time.tick_now(); defer { if frame_measuring { frame_physics_ms+=frame_ms(frame_start) } } }
+
+	assert(s.physics.active && dt > 0)
+	physics_sync_structure(s)
+	b2.World_Step(s.physics.world,dt,PHYSICS_SUBSTEPS)
+	physics_read_motion(s)
+	failures := calculate_loads(s,dt)
+	apply_failures(s,failures)
+	free_failures(&failures)
+	physics_sync_structure(s)
+}
diff --git a/src/shared/sim_player.odin b/src/shared/sim_player.odin
new file mode 100644
index 0000000..88aacca
--- /dev/null
+++ b/src/shared/sim_player.odin
@@ -0,0 +1,105 @@
+#+feature dynamic-literals
+package shared
+
+import b2 "vendor:box2d"
+import math "core:math"
+
+Player_Tuning :: struct {
+	speed, acceleration, jump_speed, coyote_time, jump_buffer: f32,
+}
+
+PLAYER_TUNING :: Player_Tuning{4,32,6.3,0.1,0.1}
+
+PLAYER_RADIUS :: f32(0.26)
+
+PLAYER_SEGMENT :: f32(0.30)
+
+PLAYER_HALF_HEIGHT :: PLAYER_RADIUS+PLAYER_SEGMENT
+
+PLAYER_SPAWN :: Vec2{-4.5,PLAYER_HALF_HEIGHT+0.005}
+
+MAX_PLAYERS :: 4
+
+player_refresh_pose :: proc(player: ^Player) {
+	if !player.active { return }
+	player.pose=read_body_state(player.body).pose
+}
+
+player_create :: proc(world: b2.WorldId,blast_radius: f32 = 0) -> Player {
+	def:=b2.DefaultBodyDef()
+	def.type=.dynamicBody
+	def.position=to_b2(PLAYER_SPAWN)
+	def.fixedRotation=true
+	def.enableSleep=false
+	body:=b2.CreateBody(world,def)
+	shape:=b2.DefaultShapeDef()
+	shape.density=0.65
+	shape.material.friction=0.15
+	// Players pass through each other (negative shared group) and collide with everything else.
+	shape.filter.groupIndex=-1
+	_ = b2.CreateCapsuleShape(body,shape,b2.Capsule{center1={0,-PLAYER_SEGMENT},center2={0,PLAYER_SEGMENT},radius=PLAYER_RADIUS})
+	player:=Player{active=true,body=body,blast_radius=blast_radius}
+	player_refresh_pose(&player)
+	return player
+}
+
+player_respawn :: proc(player: ^Player) {
+	body:=player.body
+	b2.Body_SetTransform(body,to_b2(PLAYER_SPAWN),b2.MakeRot(0))
+	b2.Body_SetLinearVelocity(body,{})
+	b2.Body_SetAngularVelocity(body,0)
+	player^=Player{active=true,body=body,blast_radius=player.blast_radius}
+	player_refresh_pose(player)
+}
+
+player_read_support :: proc(player: ^Player) {
+	player.grounded=false
+	player.support_velocity={}
+	position:=from_b2(b2.Body_GetPosition(player.body))
+	velocity:=from_b2(b2.Body_GetLinearVelocity(player.body))
+	buffer:=make([]b2.ContactData,int(b2.Body_GetContactCapacity(player.body)))
+	defer delete(buffer)
+	for contact in b2.Body_GetContactData(player.body,buffer) {
+		a,b:=b2.Shape_GetBody(contact.shapeIdA),b2.Shape_GetBody(contact.shapeIdB)
+		normal:=from_b2(contact.manifold.normal)
+		other:=a
+		if a==player.body { normal=vmul(normal,-1); other=b }
+		if normal.y<0.55 { continue }
+		for i in 0..<int(contact.manifold.pointCount) {
+			point:=contact.manifold.points[i]
+			support_velocity:=from_b2(b2.Body_GetWorldPointVelocity(other,point.point))
+			if point.separation<=0.025 && point.point.y<position.y-0.1 && vdot(vsub(velocity,support_velocity),normal)<0.8 {
+				player.grounded=true
+				player.support_velocity=support_velocity
+			}
+		}
+	}
+}
+
+player_before_step :: proc(player: ^Player,move: f32,jump_pressed: bool,dt: f32) {
+	player_read_support(player)
+	if player.grounded { player.coyote=PLAYER_TUNING.coyote_time } else { player.coyote=max(f32(0),player.coyote-dt) }
+	if jump_pressed { player.buffered_jump=PLAYER_TUNING.jump_buffer }
+	velocity:=from_b2(b2.Body_GetLinearVelocity(player.body))
+	target:=clamp(move,f32(-1),f32(1))*PLAYER_TUNING.speed
+	velocity.x+=clamp(target-velocity.x,-PLAYER_TUNING.acceleration*dt,PLAYER_TUNING.acceleration*dt)
+	if player.buffered_jump>0 && player.coyote>0 {
+		velocity.y=PLAYER_TUNING.jump_speed+max(f32(0),player.support_velocity.y)
+		player.grounded=false
+		player.coyote=0
+		player.buffered_jump=0
+	}
+	player.buffered_jump=max(f32(0),player.buffered_jump-dt)
+	b2.Body_SetLinearVelocity(player.body,to_b2(velocity))
+}
+
+player_after_step :: proc(player: ^Player) -> bool {
+	position:=from_b2(b2.Body_GetPosition(player.body))
+	if position.x < -8.5 || position.x > 9.5 || position.y < -3 || position.y > 12 || math.is_nan(position.y) {
+		player_respawn(player)
+		return true
+	}
+	player_read_support(player)
+	player_refresh_pose(player)
+	return false
+}
