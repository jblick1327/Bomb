-  for &burst in c.bursts { burst.age+=f32(NET_STEP_DT) }
-  count:=0
-  for burst in c.bursts { if burst.age<BOMB_BURST_TIME { c.bursts[count]=burst; count+=1 } }
-  resize(&c.bursts,count)
