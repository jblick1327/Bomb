diff --git a/src/shared/sim_blast_query.odin b/src/shared/sim_blast_query.odin
new file mode 100644
index 0000000..7397303
--- /dev/null
+++ b/src/shared/sim_blast_query.odin
@@ -0,0 +1,40 @@
+#+feature dynamic-literals
+package shared
+
+import runtime "base:runtime"
+import b2 "vendor:box2d"
+
+Blast_Query :: struct { ids: map[u64]bool }
+
+blast_query_shape :: proc "c" (shape: b2.ShapeId,data: rawptr) -> bool {
+	context=runtime.default_context()
+	query:=cast(^Blast_Query)data
+	id:=u64(uintptr(b2.Shape_GetUserData(shape)))
+	if id!=0 { query.ids[id]=true }
+	return true
+}
+
+blast_regions :: proc(s: ^Scene,blast: Blast) -> [dynamic]u64 {
+	result: [dynamic]u64
+	if !s.physics.active {
+		for sub in s.subdivisions { if sub.live { append(&result,sub.id) } }
+	} else {
+		query:=Blast_Query{ids=make(map[u64]bool)}; defer delete(query.ids)
+		extent:=max(f32(0),blast.radius)+0.05
+		box:=b2.AABB{lowerBound={blast.position.x-extent,blast.position.y-extent},upperBound={blast.position.x+extent,blast.position.y+extent}}
+		_ = b2.World_OverlapAABB(s.physics.world,box,b2.DefaultQueryFilter(),blast_query_shape,&query)
+		for id in s.pending_regions { query.ids[id]=true }
+		for id in query.ids { if is_live_subdivision(s,id) { append(&result,id) } }
+	}
+	sort_ids(result[:])
+	return result
+}
+
+blast_connections :: proc(s: ^Scene,regions: []u64) -> [dynamic]u64 {
+	set:=make(map[u64]bool); defer delete(set)
+	for id in regions { for connection in s.subdivisions[s.sub_rows[id]].incident_links { set[connection]=true } }
+	result: [dynamic]u64
+	for id in set { if s.connections[s.conn_rows[id]].live { append(&result,id) } }
+	sort_ids(result[:])
+	return result
+}
diff --git a/src/shared/sim_blast_shape_cache.odin b/src/shared/sim_blast_shape_cache.odin
new file mode 100644
index 0000000..d494e65
--- /dev/null
+++ b/src/shared/sim_blast_shape_cache.odin
@@ -0,0 +1,46 @@
+#+feature dynamic-literals
+package shared
+
+
+
+@(thread_local) blast_scratch_active:bool
+
+Blast_Shape_Query :: struct {
+ points:[]Vec2,
+ width:f32,
+ width_known,simple_known,simple:bool,
+}
+
+blast_shape_key :: proc(points:[]Vec2) -> u64 {
+ hash:=u64(14695981039346656037)
+ for p in points { hash=(hash~u64(transmute(u32)p.x))*1099511628211; hash=(hash~u64(transmute(u32)p.y))*1099511628211 }
+ return hash~u64(len(points))
+}
+
+blast_shape_entry :: proc(points:[]Vec2) -> (u64,Blast_Shape_Query) {
+ c:=active_cover
+ if c.shape_queries==nil { c.shape_queries=make(map[u64]Blast_Shape_Query) }
+ key:=blast_shape_key(points); entry,ok:=c.shape_queries[key]
+ if ok && len(entry.points)==len(points) {
+  equal:=true
+  for p,i in points { q:=entry.points[i]; if transmute(u32)p.x!=transmute(u32)q.x || transmute(u32)p.y!=transmute(u32)q.y { equal=false; break } }
+  if equal { return key,entry }
+ }
+ if ok { delete(entry.points) }
+ clone:=make([]Vec2,len(points)); copy(clone,points)
+ return key,Blast_Shape_Query{points=clone}
+}
+
+blast_cached_width :: proc(points:[]Vec2) -> f32 {
+ key,entry:=blast_shape_entry(points)
+ if entry.width_known { active_cover.shape_hits+=1; return entry.width }
+ active_cover.shape_misses+=1; entry.width=outline_width_uncached(points); entry.width_known=true
+ active_cover.shape_queries[key]=entry; return entry.width
+}
+
+blast_cached_simple :: proc(p:Polygon) -> bool {
+ key,entry:=blast_shape_entry(p.points)
+ if entry.simple_known { active_cover.shape_hits+=1; return entry.simple }
+ active_cover.shape_misses+=1; entry.simple=simple_polygon_uncached(p); entry.simple_known=true
+ active_cover.shape_queries[key]=entry; return entry.simple
+}
diff --git a/src/shared/sim_bombs.odin b/src/shared/sim_bombs.odin
new file mode 100644
index 0000000..1b41d32
--- /dev/null
+++ b/src/shared/sim_bombs.odin
@@ -0,0 +1,99 @@
+#+feature dynamic-literals
+package shared
+
+import b2 "vendor:box2d"
+import rand "core:math/rand"
+
+BOMB_RADIUS :: f32(0.18)
+
+BOMB_DROP_MIN :: f32(1)
+
+BOMB_DROP_MAX :: f32(2.5)
+
+BOMB_SKY_HEIGHT :: f32(7.3)
+
+Bomb_Rain :: struct {
+	random: rand.Default_Random_State,
+	until_drop: f32,
+}
+
+bomb_drop_delay :: proc(rain: ^Bomb_Rain) -> f32 {
+	return rand.float32_range(BOMB_DROP_MIN,BOMB_DROP_MAX,rand.default_random_generator(&rain.random))
+}
+
+bomb_rain_reset :: proc(rain: ^Bomb_Rain,seed: u8) {
+	// Reset the independent stream after rebuilding the physics world.
+	// A separate stream leaves procedural destruction seeds independent of drops.
+	rain.random=rand.create(u64(seed)+0x626f6d62)
+	rain.until_drop=bomb_drop_delay(rain)
+}
+
+bomb_rain_clear :: proc(w: ^World) {
+ for bomb in w.bombs { b2.DestroyBody(bomb.body) }
+ clear(&w.bombs)
+}
+
+world_bomb_spawn :: proc(game: ^World,position: Vec2) {
+	def:=b2.DefaultBodyDef()
+	def.type=.dynamicBody
+	def.position=to_b2(position)
+	def.isBullet=true
+	body:=b2.CreateBody(game.scene.physics.world,def)
+	shape:=b2.DefaultShapeDef()
+	shape.density=0.4
+	shape.material.friction=0.7
+	shape.material.restitution=0.05
+	_ = b2.CreateCircleShape(body,shape,b2.Circle{radius=BOMB_RADIUS})
+	game.next_bomb_id+=1
+	bomb:=Bomb{id=game.next_bomb_id,body=body,fuse=BOMB_FUSE}
+	bomb.pose=read_body_state(body).pose
+	append(&game.bombs,bomb)
+}
+
+bomb_has_landed :: proc(bomb: Bomb) -> bool {
+	position:=b2.Body_GetPosition(bomb.body)
+	buffer:=make([]b2.ContactData,int(b2.Body_GetContactCapacity(bomb.body)))
+	defer delete(buffer)
+	for contact in b2.Body_GetContactData(bomb.body,buffer) {
+		normal:=from_b2(contact.manifold.normal)
+		if b2.Shape_GetBody(contact.shapeIdA)==bomb.body { normal=vmul(normal,-1) }
+		if normal.y<0.55 { continue }
+		for i in 0..<int(contact.manifold.pointCount) {
+			point:=contact.manifold.points[i]
+			if point.separation<=0.025 && point.point.y<position.y { return true }
+		}
+	}
+	return false
+}
+
+bomb_rain_before_step :: proc(game: ^World,dt: f32) {
+	if game.settings.blast_mode!=.Falling_Bombs { return }
+	rain:=&game.rain
+	rain.until_drop-=dt
+	if rain.until_drop<=0 {
+		x:=rand.float32_range(-7,8,rand.default_random_generator(&rain.random))
+		world_bomb_spawn(game,{x,BOMB_SKY_HEIGHT})
+		rain.until_drop+=bomb_drop_delay(rain)
+	}
+}
+
+bomb_rain_after_step :: proc(game: ^World,dt: f32,events: ^Tick_Events) {
+	rain:=&game.rain
+	// Read landing contacts for all bombs before any blast changes the collision world.
+	for &bomb in game.bombs {
+		if bomb.landed { bomb.fuse=max(f32(0),bomb.fuse-dt) }
+		else if bomb_has_landed(bomb) { bomb.landed=true }
+	}
+	positions: [dynamic]Vec2; defer delete(positions)
+	bomb_count:=0
+	for bomb in game.bombs {
+		position:=from_b2(b2.Body_GetPosition(bomb.body))
+		explode:=bomb.landed && bomb.fuse<=0.000001
+		if explode { append(&positions,position) }
+		if explode || position.y < -3 || position.x < -9 || position.x > 10 {
+			b2.DestroyBody(bomb.body)
+		} else { game.bombs[bomb_count]=bomb; bomb_count+=1 }
+	}
+	resize(&game.bombs,bomb_count)
+	for position in positions { world_explode(game,position,game.settings.blast_radius,events) }
+}
diff --git a/src/shared/sim_cover.odin b/src/shared/sim_cover.odin
new file mode 100644
index 0000000..c84a58b
--- /dev/null
+++ b/src/shared/sim_cover.odin
@@ -0,0 +1,269 @@
+#+feature dynamic-literals
+package shared
+
+import slice "core:slice"
+import time "core:time"
+import math "core:math"
+import mem "core:mem"
+
+Cover_Edge :: struct { delta:Vec2, squared:f32 }
+
+Cover_Cell :: struct { id,owner:u64, resistance:f32, points:[]Vec2, edges:[]Cover_Edge, lo,hi:Vec2 }
+
+Cover_Cached :: struct { x,y,ox,oy:u32, owner:u64, distance:f32, used:bool }
+
+Cover_Group :: struct { owner:u64, indices:[]int }
+
+Cover_Grid_Entry :: struct { key:Cover_Key, owner:u64, index:int }
+
+Cover_Key :: struct { x,y:int }
+
+Cover :: struct {
+ point_storage:[]Vec2, edge_storage:[]Cover_Edge,
+ cells:[dynamic]Cover_Cell, owners:map[u64]u64,
+ shadow:map[u64]bool,
+ grid:map[Cover_Key][]Cover_Group,
+ grid_indices:[]int, grid_groups:[dynamic]Cover_Group,
+ seen:[]u32, epoch:u32,
+ candidates:[dynamic]int, cuts:[dynamic]f32,
+ shadow_points,shadow_hull:[dynamic]Vec2,
+ clip_a,clip_b:[dynamic]Vec2,
+ samples,fast_samples,cache_hits,upper_bound_skips:u64,
+ cache:[]Cover_Cached,
+ load_limit:f32,
+ generation_arena:mem.Dynamic_Arena,
+ unpartitionable:map[u64]bool, partition_cache_hits:u64,
+ shape_queries:map[u64]Blast_Shape_Query, shape_hits,shape_misses:u64,
+}
+
+cover_key :: proc(p:Vec2) -> Cover_Key { return {int(math.floor(p.x)),int(math.floor(p.y))} }
+
+cover_bounds_cross :: proc(a,b,lo,hi:Vec2) -> bool {
+ d:=vsub(b,a); enter,exit:=f32(0),f32(1)
+ for axis in 0..<2 {
+  av,dv,lv,hv:=a.x,d.x,lo.x,hi.x
+  if axis==1 { av=a.y; dv=d.y; lv=lo.y; hv=hi.y }
+  if dv==0 { if av<lv || av>hv { return false }; continue }
+  t,u:=(lv-av)/dv,(hv-av)/dv
+  enter=max(enter,min(t,u)); exit=min(exit,max(t,u))
+  if enter>exit { return false }
+ }; return true
+}
+
+cover_candidates :: proc(c:^Cover,lo,hi:Vec2,owner:u64=0,ray:bool=false,origin:Vec2={},point:Vec2={}) {
+ clear(&c.candidates)
+ if c.grid==nil { for cell,i in c.cells { if cell.owner!=owner { append(&c.candidates,i) } }; return }
+ c.epoch+=1
+ a,b:=cover_key(lo),cover_key(hi)
+ if !ray {
+  for x in a.x..=b.x { for y in a.y..=b.y { cover_bucket(c,{x,y},lo,hi,owner,ray,origin,point) } }
+ } else {
+  key,last:=cover_key(origin),cover_key(point)
+  dx,dy:=f64(point.x)-f64(origin.x),f64(point.y)-f64(origin.y)
+  sx,sy:=1,1; if dx<0 { sx=-1 }; if dy<0 { sy=-1 }
+  limit:=abs(last.x-key.x)+abs(last.y-key.y)+4
+  for _ in 0..<limit {
+   cover_bucket(c,key,lo,hi,owner,true,origin,point)
+   if key==last { break }
+   tx,ty:=f64(1e300),f64(1e300)
+   if dx!=0 { boundary:=key.x; if sx>0 { boundary+=1 }; tx=(f64(boundary)-f64(origin.x))/dx }
+   if dy!=0 { boundary:=key.y; if sy>0 { boundary+=1 }; ty=(f64(boundary)-f64(origin.y))/dy }
+   if tx<ty { key.x+=sx } else if ty<tx { key.y+=sy } else {
+    cover_bucket(c,{key.x+sx,key.y},lo,hi,owner,true,origin,point)
+    cover_bucket(c,{key.x,key.y+sy},lo,hi,owner,true,origin,point)
+    key.x+=sx; key.y+=sy
+   }
+  }
+ }
+ if ray { slice.sort(c.candidates[:]) }
+}
+
+cover_bucket :: proc(c:^Cover,key:Cover_Key,lo,hi:Vec2,owner:u64,ray:bool,origin,point:Vec2) {
+ bucket,exists:=c.grid[key]; if !exists { return }
+ for group in bucket {
+  if group.owner==owner { continue }
+  for index in group.indices {
+   if c.seen[index]==c.epoch { continue }; c.seen[index]=c.epoch
+   cell:=c.cells[index]
+   if hi.x<cell.lo.x || lo.x>cell.hi.x || hi.y<cell.lo.y || lo.y>cell.hi.y { continue }
+   if ray && !cover_bounds_cross(origin,point,cell.lo,cell.hi) { continue }
+   append(&c.candidates,index)
+  }
+ }
+}
+
+cover_polygons_overlap :: proc(a,b:[]Vec2) -> bool {
+ for p,i in a { e:=vsub(a[(i+1)%len(a)],p); any_inside:=false
+  for q in b { if vcross(e,vsub(q,p))>0 { any_inside=true; break } }
+  if !any_inside { return false }
+ }
+ left,right:[dynamic]Vec2
+ if active_cover!=nil { left=active_cover.clip_a; right=active_cover.clip_b }
+ defer { if active_cover!=nil { active_cover.clip_a=left; active_cover.clip_b=right } else { delete(left); delete(right) } }
+ clear(&left); append(&left,..b)
+ for p,i in a {
+  clear(&right); e:=vsub(a[(i+1)%len(a)],p)
+  for q,j in left {
+   r:=left[(j+1)%len(left)]; dq,dr:=vcross(e,vsub(q,p)),vcross(e,vsub(r,p))
+   if dq>=0 { append(&right,q) }
+   if (dq>0 && dr<0) || (dq<0 && dr>0) { append(&right,vadd(q,vmul(vsub(r,q),dq/(dq-dr)))) }
+  }
+  left,right=right,left
+  if len(left)<3 { return false }
+ }
+ area:f64
+ for p,i in left { q:=left[(i+1)%len(left)]; area+=f64(p.x)*f64(q.y)-f64(p.y)*f64(q.x) }
+ return area!=0
+}
+
+cover_shadow :: proc(sub:Subdivision,origin:Vec2) -> bool {
+ when BOM_PROFILE { started:=time.tick_now(); defer profile_add(16,started) }
+ c:=active_cover; if c==nil { return false }
+ if result,ok:=c.shadow[sub.id]; ok { return result }
+ points:=c.shadow_points; hull:=c.shadow_hull
+ clear(&points); clear(&hull); append(&points,origin)
+ lo,hi:=origin,origin
+ for p in sub.outline.points { q:=posed_point(sub,p); append(&points,q); lo={min(lo.x,q.x),min(lo.y,q.y)}; hi={max(hi.x,q.x),max(hi.y,q.y)} }
+ slice.sort_by(points[:],proc(a,b:Vec2)->bool { return a.x<b.x || a.x==b.x && a.y<b.y })
+ for p in points { for len(hull)>=2 && vcross(vsub(hull[len(hull)-1],hull[len(hull)-2]),vsub(p,hull[len(hull)-1]))<=0 { resize(&hull,len(hull)-1) }; append(&hull,p) }
+ upper:=len(hull)+1
+ for i:=len(points)-2; i>=0; i-=1 { p:=points[i]; for len(hull)>=upper && vcross(vsub(hull[len(hull)-1],hull[len(hull)-2]),vsub(p,hull[len(hull)-1]))<=0 { resize(&hull,len(hull)-1) }; append(&hull,p) }
+ if len(hull)>1 { resize(&hull,len(hull)-1) }
+ c.shadow_points=points; c.shadow_hull=hull
+ owner:=c.owners[sub.id]; cover_candidates(c,lo,hi,owner); result:=false
+ for index in c.candidates { cell:=c.cells[index]; if cell.owner!=owner && cover_polygons_overlap(hull[:],cell.points) { result=true; break } }
+ c.shadow[sub.id]=result
+ return result
+}
+
+@(thread_local) active_cover:^Cover
+
+cover_begin :: proc(s:^Scene,load_limit:f32=0) -> Cover {
+ when BOM_PROFILE { started:=time.tick_now(); defer profile_add(17,started) }
+ c:=Cover{unpartitionable=make(map[u64]bool),load_limit=load_limit,owners=make(map[u64]u64),shadow=make(map[u64]bool),grid=make(map[Cover_Key][]Cover_Group)}
+ ids:[dynamic]u64; defer delete(ids)
+ for sub in s.subdivisions { if sub.live { append(&ids,sub.id) } }; sort_ids(ids[:])
+ total_points:=0
+ for id in ids { sub:=s.subdivisions[s.sub_rows[id]]; if s.materials[sub.material].blast_resistance!=0 { total_points+=len(sub.outline.points) } }
+ c.point_storage=make([]Vec2,total_points); c.edge_storage=make([]Cover_Edge,total_points); cursor:=0
+ for id in ids {
+  sub:=s.subdivisions[s.sub_rows[id]]; c.owners[id]=sub.owner
+  resistance:=s.materials[sub.material].blast_resistance; if resistance==0 { continue }
+  cell:=Cover_Cell{id=id,owner=sub.owner,resistance=resistance,points=c.point_storage[cursor:cursor+len(sub.outline.points)],edges=c.edge_storage[cursor:cursor+len(sub.outline.points)],lo={1e30,1e30},hi={-1e30,-1e30}}
+  for p,i in sub.outline.points { q:=posed_point(sub,p); cell.points[i]=q; cell.lo={min(cell.lo.x,q.x),min(cell.lo.y,q.y)}; cell.hi={max(cell.hi.x,q.x),max(cell.hi.y,q.y)} }
+  for a,i in cell.points { edge:=vsub(cell.points[(i+1)%len(cell.points)],a); cell.edges[i]={edge,vdot(edge,edge)} }
+  cursor+=len(cell.points)
+  append(&c.cells,cell)
+ }
+ max_points:=0; for sub in s.subdivisions { if sub.live { max_points=max(max_points,len(sub.outline.points)) } }
+ c.candidates=make([dynamic]int,0,len(c.cells)); c.cuts=make([dynamic]f32,0,max_points+2)
+ c.shadow_points=make([dynamic]Vec2,0,max_points+1); c.shadow_hull=make([dynamic]Vec2,0,2*(max_points+1))
+ c.clip_a=make([dynamic]Vec2,0,2*max_points*(max_points+2)+16); c.clip_b=make([dynamic]Vec2,0,2*max_points*(max_points+2)+16)
+ c.cache=make([]Cover_Cached,8192)
+ c.seen=make([]u32,len(c.cells))
+ entries:[dynamic]Cover_Grid_Entry; defer delete(entries)
+ for cell,index in c.cells { a,b:=cover_key(cell.lo),cover_key(cell.hi)
+  for x in a.x..=b.x { for y in a.y..=b.y { append(&entries,Cover_Grid_Entry{{x,y},cell.owner,index}) } }
+ }
+ slice.sort_by(entries[:],proc(a,b:Cover_Grid_Entry)->bool {
+  if a.key.x!=b.key.x { return a.key.x<b.key.x }; if a.key.y!=b.key.y { return a.key.y<b.key.y }
+  if a.owner!=b.owner { return a.owner<b.owner }; return a.index<b.index
+ })
+ c.grid_indices=make([]int,len(entries)); c.grid_groups=make([dynamic]Cover_Group,0,len(entries))
+ for entry,i in entries { c.grid_indices[i]=entry.index }
+ start:=0
+ for start<len(entries) {
+  finish:=start+1
+  for finish<len(entries) && entries[finish].key==entries[start].key && entries[finish].owner==entries[start].owner { finish+=1 }
+  append(&c.grid_groups,Cover_Group{entries[start].owner,c.grid_indices[start:finish]}); start=finish
+ }
+ start=0; entry_row:=0
+ for start<len(c.grid_groups) {
+  key:=entries[entry_row].key; finish:=start
+  for finish<len(c.grid_groups) && entries[entry_row].key==key {
+   entry_row+=len(c.grid_groups[finish].indices); finish+=1
+   if entry_row==len(entries) { break }
+  }
+  c.grid[key]=c.grid_groups[start:finish]; start=finish
+ }
+
+ return c
+}
+
+cover_destroy :: proc(c:^Cover) { delete(c.point_storage); delete(c.edge_storage); delete(c.cells); delete(c.owners); delete(c.shadow); delete(c.grid_indices); delete(c.grid_groups); delete(c.grid); delete(c.seen); delete(c.candidates); delete(c.cuts); delete(c.shadow_points); delete(c.shadow_hull); delete(c.clip_a); delete(c.clip_b); delete(c.cache); for _,entry in c.shape_queries { delete(entry.points) }; delete(c.shape_queries); delete(c.unpartitionable); if c.generation_arena.block_allocator.procedure!=nil { mem.dynamic_arena_destroy(&c.generation_arena) } }
+
+cover_distance :: proc(point,origin:Vec2,owner:u64,count_sample:bool=true) -> f32 {
+ if count_sample && active_cover!=nil { active_cover.samples+=1 }
+ when BOM_PROFILE { started:=time.tick_now(); defer profile_add(15,started) }
+ delta:=vsub(point,origin); distance:=vlen(delta); ray_length:=distance
+ if active_cover==nil || distance==0 { return distance }
+ // All resistance is nonnegative. Further cover cannot change a zero load.
+ if active_cover.load_limit>0 && distance>=active_cover.load_limit { return distance }
+ lo:=Vec2{min(point.x,origin.x),min(point.y,origin.y)}; hi:=Vec2{max(point.x,origin.x),max(point.y,origin.y)}
+ c:=active_cover
+ cache_slot:=-1
+ if len(c.cache)>0 {
+  x,y,ox,oy:=transmute(u32)point.x,transmute(u32)point.y,transmute(u32)origin.x,transmute(u32)origin.y
+  hash:=u64(x)*0x9e3779b1+u64(y)*0x85ebca77+owner*0xc2b2ae3d+u64(ox)*0x27d4eb2f+u64(oy)
+  for probe in 0..<8 {
+   slot:=int((hash+u64(probe))&u64(len(c.cache)-1)); entry:=&c.cache[slot]
+   if !entry.used { cache_slot=slot; break }
+   if entry.x==x && entry.y==y && entry.ox==ox && entry.oy==oy && entry.owner==owner { c.cache_hits+=1; return entry.distance }
+  }
+ }
+ cover_candidates(c,lo,hi,owner,true,origin,point)
+ cuts:=c.cuts; defer { c.cuts=cuts }
+ for index in c.candidates {
+  cell:=c.cells[index]
+  if cell.owner==owner || hi.x<cell.lo.x || lo.x>cell.hi.x || hi.y<cell.lo.y || lo.y>cell.hi.y { continue }
+  clear(&cuts); append(&cuts,0,1)
+  for a,i in cell.points {
+   b:=cell.points[(i+1)%len(cell.points)]; edge:=vsub(b,a); if len(cell.edges)>0 { edge=cell.edges[i].delta }; den:=vcross(delta,edge)
+   if den==0 { continue }
+   t:=vcross(vsub(a,origin),edge)/den; u:=vcross(vsub(a,origin),delta)/den
+   if t>0 && t<1 && u>=0 && u<=1 { append(&cuts,t) }
+  }
+  for i in 1..<len(cuts) { value:=cuts[i]; j:=i; for j>0 && cuts[j-1]>value { cuts[j]=cuts[j-1]; j-=1 }; cuts[j]=value }
+  fraction:f32
+  for i in 0..<len(cuts)-1 {
+   mid:=vadd(origin,vmul(delta,(cuts[i]+cuts[i+1])*0.5)); inside:=false; boundary:=false
+   for a,j in cell.points { b:=cell.points[(j+1)%len(cell.points)]; e:=vsub(b,a); squared:=vdot(e,e); if len(cell.edges)>0 { e=cell.edges[j].delta; squared=cell.edges[j].squared }; m:=vsub(mid,a); if vcross(e,m)==0 && vdot(m,e)>=0 && vdot(m,e)<=squared { boundary=true }; if (a.y>mid.y)!=(b.y>mid.y) && mid.x<(b.x-a.x)*(mid.y-a.y)/(b.y-a.y)+a.x { inside=!inside } }
+   if inside && !boundary { fraction+=cuts[i+1]-cuts[i] }
+  }
+  distance+=cell.resistance*ray_length*fraction
+  if c.load_limit>0 && distance>=c.load_limit { break }
+ }
+ if cache_slot>=0 { c.cache[cache_slot]={transmute(u32)point.x,transmute(u32)point.y,transmute(u32)origin.x,transmute(u32)origin.y,owner,distance,true} }
+ return distance
+}
+
+cover_sample_distance :: proc(sub:Subdivision,point,origin:Vec2) -> f32 {
+ owner:=sub.owner
+ if active_cover!=nil {
+  active_cover.samples+=1
+  geometric:=vlen(vsub(point,origin))
+  if active_cover.load_limit>0 && geometric>=active_cover.load_limit { if !cover_shadow(sub,origin) { active_cover.fast_samples+=1 }; return geometric }
+  owner=active_cover.owners[sub.id]
+  if !cover_shadow(sub,origin) { active_cover.fast_samples+=1; return vlen(vsub(point,origin)) }
+ }
+ return cover_distance(point,origin,owner,false)
+}
+
+cover_external :: proc(sub:Subdivision,origin:Vec2) -> bool {
+ return cover_shadow(sub,origin)
+}
+
+cover_foreign_any :: proc(sub:Subdivision) -> bool {
+ if active_cover==nil { return false }
+ owner:=active_cover.owners[sub.id]
+ for cell in active_cover.cells { if cell.owner!=owner { return true } }; return false
+}
+
+cover_failure_distance :: proc(sub:Subdivision,point:Vec2,blast:Blast,strength:f32) -> f32 {
+ distance:=vlen(vsub(point,blast.position))
+ if !fails(blast_load(distance,blast.radius),strength) {
+  if active_cover!=nil { active_cover.samples+=1; active_cover.upper_bound_skips+=1; if !cover_shadow(sub,blast.position) { active_cover.fast_samples+=1 } }
+  return distance
+ }
+ return cover_sample_distance(sub,point,blast.position)
+}
diff --git a/src/shared/sim_destruction.odin b/src/shared/sim_destruction.odin
new file mode 100644
index 0000000..c6b4722
--- /dev/null
+++ b/src/shared/sim_destruction.odin
@@ -0,0 +1,519 @@
+#+feature dynamic-literals
+package shared
+
+import time "core:time"
+import fmt "core:fmt"
+import math "core:math"
+import mem "core:mem"
+
+polygon_area :: proc(p: Polygon) -> f32 {
+	a: f32
+	for i in 0..<len(p.points) { a += vcross(p.points[i],p.points[(i+1)%len(p.points)]) }
+	return math.abs(a)*0.5
+}
+
+clip_polygon :: proc(p: Polygon, axis: int, cut: f32, keep_low: bool) -> Polygon {
+	points: [dynamic]Vec2
+	defer delete(points)
+	for i in 0..<len(p.points) {
+		a,b := p.points[i],p.points[(i+1)%len(p.points)]
+		av,bv := a.x-cut,b.x-cut
+		if axis == 1 { av = a.y-cut; bv = b.y-cut }
+		if !keep_low { av = -av; bv = -bv }
+		inside_a, inside_b := av <= 0,bv <= 0
+		if inside_a { append(&points,a) }
+		if inside_a != inside_b {
+			t := av/(av-bv)
+			append(&points,vadd(a,vmul(vsub(b,a),t)))
+		}
+	}
+	return make_polygon(points[:])
+}
+
+is_convex :: proc(p: Polygon) -> bool {
+	if len(p.points) < 3 { return false }
+	sign: f32
+	for i in 0..<len(p.points) {
+		cross := vcross(vsub(p.points[(i+1)%len(p.points)],p.points[i]),vsub(p.points[(i+2)%len(p.points)],p.points[(i+1)%len(p.points)]))
+		if math.abs(cross) < 0.00001 { continue }
+		if sign == 0 { sign = cross } else if cross*sign < 0 { return false }
+	}
+	return true
+}
+
+triangulate_polygon :: proc(p: Polygon) -> [dynamic]Polygon {
+ result: [dynamic]Polygon
+ points: [dynamic]Vec2; indices: [dynamic]int
+ defer delete(points); defer delete(indices)
+ scale:=longest_dimension(p)
+ duplicate_tolerance:=scale*0.0000001
+ for point in p.points {
+  if len(points)==0 || vlen(vsub(point,points[len(points)-1]))>duplicate_tolerance { append(&points,point) }
+ }
+ if len(points)>1 && vlen(vsub(points[0],points[len(points)-1]))<=duplicate_tolerance { resize(&points,len(points)-1) }
+ if len(points)<3 { return result }
+ signed:f64
+ for point,i in points { signed+=polygon_turn(points[0],point,points[(i+1)%len(points)]) }
+ orientation:=f64(1); if signed<0 { orientation=-1 }
+ tolerance:=f64(scale)*f64(scale)*0.00000001
+ for i in 0..<len(points) { append(&indices,i) }
+ for len(indices)>3 {
+  ear:=-1; fallback:=-1; largest:=f64(-1e300)
+  for k in 0..<len(indices) {
+   i,j,l:=indices[(k+len(indices)-1)%len(indices)],indices[k],indices[(k+1)%len(indices)]
+   a,b,c:=points[i],points[j],points[l]
+   turn:=polygon_turn(a,b,c)*orientation
+   if turn>largest { largest=turn; fallback=k }
+   if turn<=tolerance { continue }
+   contains:=false
+   for n in indices {
+    if n==i || n==j || n==l { continue }
+    point:=points[n]
+    if polygon_turn(a,b,point)*orientation>= -tolerance && polygon_turn(b,c,point)*orientation>= -tolerance && polygon_turn(c,a,point)*orientation>= -tolerance { contains=true; break }
+   }
+   if !contains { ear=k; break }
+  }
+  // Roundoff or collinear boundary vertices must never truncate the fill.
+  if ear<0 { ear=fallback }
+  i,j,l:=indices[(ear+len(indices)-1)%len(indices)],indices[ear],indices[(ear+1)%len(indices)]
+  append(&result,make_polygon([]Vec2{points[i],points[j],points[l]}))
+  ordered_remove(&indices,ear)
+ }
+ append(&result,make_polygon([]Vec2{points[indices[0]],points[indices[1]],points[indices[2]]}))
+ return result
+}
+
+generate_children :: proc(parent: Polygon, recipe: Material, seed: u8, minimum_width: f32 = 0,creation: bool = false) -> [dynamic]Polygon {
+ when BOM_PROFILE { started:=time.tick_now(); defer profile_add(9,started) }
+ if active_cover==nil || seed==0 { return generate_children_impl(parent,recipe,seed,minimum_width,creation) }
+ arena:=&active_cover.generation_arena
+ if arena.block_allocator.procedure==nil { mem.dynamic_arena_init(arena,block_size=65536,out_band_size=32768,alignment=64) }
+ original_allocator:=context.allocator
+ context.allocator=mem.dynamic_arena_allocator(arena)
+ blast_scratch_active=true
+ temporary:=generate_children_impl(parent,recipe,seed,minimum_width,creation)
+ context.allocator=original_allocator
+ blast_scratch_active=false
+ result:[dynamic]Polygon
+ for polygon in temporary { append(&result,make_polygon(polygon.points)) }
+ mem.dynamic_arena_reset(arena)
+ return result
+}
+
+generate_children_impl :: proc(parent: Polygon, recipe: Material, seed: u8, minimum_width: f32 = 0,creation: bool = false) -> [dynamic]Polygon {
+
+ if recipe.aspect_ratio<1 { return generate_grained_children(parent,recipe,seed,minimum_width,creation) }
+ result: [dynamic]Polygon
+ if seed==0 { return result }
+ if recipe.triangulate { result=triangulate_polygon(parent) }
+ else { append(&result,make_polygon(parent.points)) }
+ for p in result {
+  if !simple_polygon(p) || outline_width(p.points)<minimum_width {
+   for child in result { delete(child.points) }; delete(result); return nil
+  }
+ }
+ target:=max(recipe.generation_count,len(result))
+ blocked_inline:[8]bool; blocked:=blocked_inline[:]
+ if target>len(blocked_inline) { blocked=make([]bool,target) }
+ defer { if target>len(blocked_inline) { delete(blocked) } }
+ for len(result)<target {
+  chosen:=-1; largest:f32
+  for p,i in result { area:=polygon_area(p); if !blocked[i] && area>largest { largest=area; chosen=i } }
+  if chosen<0 || largest<0.0001 { break }
+  p:=result[chosen]
+  lo,hi:=Vec2{1e30,1e30},Vec2{-1e30,-1e30}
+  for point in p.points { lo={min(lo.x,point.x),min(lo.y,point.y)}; hi={max(hi.x,point.x),max(hi.y,point.y)} }
+  axis:=0; width,height:=hi.x-lo.x,hi.y-lo.y
+  if width<height*recipe.aspect_ratio { axis=1 }
+  fraction:=0.4+0.2*f32(derive_seed(seed,u64(len(result))))/255
+  accepted:=false
+  for attempt in 0..<2 {
+   cut_axis:=(axis+attempt)%2
+   f:=fraction
+   cut:=lo.x+(hi.x-lo.x)*f; if cut_axis==1 { cut=lo.y+(hi.y-lo.y)*f }
+   low,high:=clip_polygon(p,cut_axis,cut,true),clip_polygon(p,cut_axis,cut,false)
+   valid:=valid_partition_half(low,minimum_width) && valid_partition_half(high,minimum_width)
+   valid=valid && math.abs(polygon_area(low)+polygon_area(high)-polygon_area(p))<=max(f32(0.0000002),polygon_area(p)*0.00002)
+   if valid && recipe.triangulate {
+    halves:=[2]Polygon{low,high}
+    for half in halves {
+     triangles:=triangulate_polygon(half)
+     for triangle in triangles { valid=valid && valid_partition_half(triangle,minimum_width); delete(triangle.points) }
+     delete(triangles)
+    }
+   }
+   if valid {
+    delete(p.points); result[chosen]=low; append(&result,high); accepted=true; break
+   }
+   delete(low.points); delete(high.points)
+  }
+  if !accepted { blocked[chosen]=true }
+ }
+ if !recipe.triangulate { displace_shared_boundaries(result[:],seed,minimum_width) }
+ if recipe.triangulate {
+  triangles: [dynamic]Polygon
+  for polygon in result {
+   parts:=triangulate_polygon(polygon)
+   for part in parts { append(&triangles,part) }; delete(parts); delete(polygon.points)
+  }
+  delete(result); result=triangles
+ }
+ area:f32; genuine:=len(result)>=2; parent_area:=polygon_area(parent)
+ for child in result {
+  child_area:=polygon_area(child)
+  genuine=genuine && valid_partition_half(child,minimum_width) && child_area<parent_area
+  area+=child_area
+ }
+ if !genuine || math.abs(area-parent_area)>max(f32(0.000002),parent_area*0.0002) {
+  for child in result { delete(child.points) }; delete(result); return nil
+ }
+ return result
+}
+
+valid_partition_half :: proc(p: Polygon,minimum_width: f32) -> bool {
+ return len(p.points)>=3 && polygon_area(p)>=0.0001 && simple_polygon(p) && outline_width(p.points)>=minimum_width
+}
+
+apply_failures :: proc(s: ^Scene, failures: Failures) {
+	if len(failures.subdivisions) == 0 && len(failures.connections) == 0 && len(failures.discard_subdivisions) == 0 { return }
+	s.revision+=1
+	affected := make(map[u64]bool)
+	defer delete(affected)
+ shock:=shock_begin_impact(s,failures); defer shock_destroy(&shock)
+	stage_failures(s,failures,&affected,false,0,&shock,true)
+ _=shock_apply(s,&shock,&affected,true)
+	rebuild_affected_pieces(s,affected)
+	commit_structure(s)
+}
+
+stage_failures :: proc(s: ^Scene, failures: Failures, affected: ^map[u64]bool, refine_only: bool = false, creation_size: f32 = 0,shock: ^Shock_Transaction = nil,direct: bool = false) {
+ if creation_size==0 { scene_finish_references(s) }
+	replacements := make(map[u64][dynamic]u64)
+	defer { for _,children in replacements { delete(children) }; delete(replacements) }
+	failed_subs := sorted_ids(failures.subdivisions[:])
+ failed_set:=make(map[u64]bool); defer delete(failed_set)
+ discard_set:=make(map[u64]bool); defer delete(discard_set)
+ for id in failed_subs { failed_set[id]=true }
+ for id in failures.discard_subdivisions { discard_set[id]=true }
+	for id in failures.discard_subdivisions { if !failed_set[id] { append(&failed_subs,id); failed_set[id]=true } }
+	sort_ids(failed_subs[:])
+	failed_conns := sorted_ids(failures.connections[:])
+	defer delete(failed_subs); defer delete(failed_conns)
+	// Only attachments incident to failed endpoints can need inheritance.
+	old_set:=make(map[u64]bool); defer delete(old_set)
+	for id in failed_subs {
+		if row,ok:=s.sub_rows[id]; ok { for connection in s.subdivisions[row].incident_links { old_set[connection]=true } }
+	}
+	old_connections: [dynamic]u64
+	defer delete(old_connections)
+	for id in old_set { append(&old_connections,id) }
+	sort_ids(old_connections[:])
+	for id in failed_subs {
+		row, ok := s.sub_rows[id]
+		if !ok || !s.subdivisions[row].live { continue }
+		parent := s.subdivisions[row]
+  if !refine_only && s.materials[parent.material].name=="wood" { cover_wood_failures+=1 }
+  if direct { shock_mark_direct(shock,id) }
+		seed := parent.seed
+		grained:=s.materials[parent.material].aspect_ratio<1
+		if !grained && parent.width<=s.minimum_width && (creation_size==0 || frame_longest(parent.outline,parent.frame)<=creation_size) || discard_set[id] { seed=0 }
+  when BOM_PROFILE { if blast_profile!=nil { if direct { blast_profile.counts[0]+=1 } } }
+		children: [dynamic]Polygon
+  cacheable:=active_cover!=nil && seed==parent.seed && seed!=0 && creation_size==0
+  if cacheable && active_cover.unpartitionable[id] {
+   active_cover.partition_cache_hits+=1
+  } else {
+   children=generate_framed(parent.outline,s.materials[parent.material],seed,s.minimum_width,creation_size>0,parent.frame)
+   // During a blast, this cell's rest outline, recipe and minimum width do
+   // not change. Do not repeat a failed partition during direct staging.
+   if cacheable && len(children)==0 { active_cover.unpartitionable[id]=true }
+  }
+		// Spatial refinement is not yet a centre-sampled failure. If the recipe
+		// cannot partition this outline, retain it for the actual blast decision.
+		if len(children)==0 {
+   if !refine_only { s.subdivisions[row].seed=0 }
+   discard:=discard_set[id]
+   if refine_only || failures.impact && parent.width>s.minimum_width && !discard { continue }
+  }
+		affected[parent.owner] = true
+		max_width,max_length: f32
+		for outline,ordinal in children {
+			center := centroid(outline)
+			world_center := posed_point(parent,center)
+			r := vsub(world_center,parent.pose.position)
+			pose := Pose{position=world_center,angle=parent.pose.angle,velocity=vadd(parent.pose.velocity,Vec2{-parent.pose.angular_velocity*r.y,parent.pose.angular_velocity*r.x}),angular_velocity=parent.pose.angular_velocity}
+			child := add_subdivision(s,parent.owner,outline,pose)
+   when BOM_PROFILE { if blast_profile!=nil { blast_profile.counts[7]+=1 } }
+			child_row := s.sub_rows[child]
+   s.subdivisions[child_row].frame=parent.frame
+   shock_inherit(shock,id,child)
+   if active_cover!=nil { active_cover.owners[child]=active_cover.owners[id]; if flag,ok:=active_cover.shadow[id]; ok { active_cover.shadow[child]=flag } }
+			// Parent context plus child ordinal is independent of other branches'
+			// allocations. A deletion shortcut cannot perturb their future seeds.
+			s.subdivisions[child_row].seed=derive_seed(parent.seed,u64(ordinal+1))
+			max_width=max(max_width,s.subdivisions[child_row].width)
+			max_length=max(max_length,frame_longest(outline,parent.frame))
+			delete(outline.points)
+			child_ids := replacements[id]
+			append(&child_ids,child)
+			replacements[id] = child_ids
+		}
+		delete(children)
+		// During creation, finish long thin cells before assigning the terminal batch.
+		if !grained && max_width<=s.minimum_width && (creation_size==0 || max_length<=creation_size) {
+			child_ids := replacements[id]
+			for child in child_ids { s.subdivisions[s.sub_rows[child]].seed=0 }
+		}
+		s.subdivisions[row].live = false
+	}
+	for id in failed_conns {
+		row, ok := s.conn_rows[id]
+		if ok && s.connections[row].live {
+			c := s.connections[row]
+   if c.mortar { path:=string("blast");if failures.impact { path="force" };seam_diagnostic_death(s,c,path);s.connections[row].live=false; continue }
+			affected[s.subdivisions[s.sub_rows[c.a]].owner] = true
+			affected[s.subdivisions[s.sub_rows[c.b]].owner] = true
+			s.connections[row].live = false
+		}
+	}
+ when BOM_PROFILE { inheritance_start:=time.tick_now() }
+	for old_id in old_connections {
+		i := s.conn_rows[old_id]
+		c := s.connections[i]
+		if !c.live { continue }
+		a_dead := !s.subdivisions[s.sub_rows[c.a]].live
+		b_dead := !s.subdivisions[s.sub_rows[c.b]].live
+		if !a_dead && !b_dead { continue }
+  if c.mortar { seam_diagnostic_death(s,c,"endpoint replacement/deletion") }
+		s.connections[i].live = false
+		left_default,right_default := [1]u64{c.a},[1]u64{c.b}
+		left,right := left_default[:],right_default[:]
+		if a_dead { left = replacements[c.a][:] }
+		if b_dead { right = replacements[c.b][:] }
+		if len(c.glue)>0 { inherit_glue(s,c,left,right);continue }
+  old_a,old_b := s.subdivisions[s.sub_rows[c.a]],s.subdivisions[s.sub_rows[c.b]]
+  // Rest outlines are immutable, and these cached boundaries remain owned
+  // by the old connection until commit. Reuse them during inheritance.
+  old_segments:=c.rest_segments[:]
+  old_owned:[dynamic]Segment
+  if old_segments==nil {
+   old_length,_:=shared_boundary(old_a.outline,old_b.outline)
+   if old_length<=0 { continue }
+   old_owned=shared_segments(old_a.outline,old_b.outline); old_segments=old_owned[:]
+  }
+  for a in left { for b in right {
+   sa,sb:=s.subdivisions[s.sub_rows[a]],s.subdivisions[s.sub_rows[b]]
+   if !inheritance_bounds_overlap(sa.outline,sb.outline) { continue }
+   current:=shared_segments(sa.outline,sb.outline)
+   if len(current)>0 && inherits_old_boundary(sa.outline,sb.outline,old_a.outline,old_b.outline,old_segments,current[:]) { add_connection(s,a,b,c.mortar,current[:]) }
+   delete(current)
+  } }
+  delete(old_owned)
+	}
+ when BOM_PROFILE { profile_add(10,inheritance_start) }
+	// Impacts inherit outside attachments, but leave new siblings disconnected.
+	if failures.impact || failures.no_sibling_bonds { return }
+ when BOM_PROFILE { sibling_start:=time.tick_now(); defer profile_add(11,sibling_start) }
+	for id in failed_subs {
+		children := replacements[id]
+		for i in 0..<len(children) { for j in i+1..<len(children) { add_connection(s,children[i],children[j]) } }
+	}
+}
+
+rebuild_affected_pieces :: proc(s: ^Scene, affected: map[u64]bool) {
+ when BOM_PROFILE { started:=time.tick_now(); defer profile_add(5,started) }
+
+	owners: [dynamic]u64
+	defer delete(owners)
+	for owner in affected { append(&owners,owner) }
+	sort_ids(owners[:])
+	for owner in owners { rebuild_piece(s,owner) }
+}
+
+BLAST_LOAD_MULTIPLIER :: f32(10)
+
+BLAST_IMPULSE_SCALE :: f32(0.2)
+
+blast_load :: proc(distance,radius: f32) -> f32 {
+	if radius <= 0 || distance >= radius { return 0 }
+	return BLAST_LOAD_MULTIPLIER*max(f32(0),radius-distance)
+}
+
+COVER_REACH_SHORTCUTS :: #config(COVER_REACH_SHORTCUTS,true)
+
+COVER_DELETE_SHORTCUTS :: #config(COVER_DELETE_SHORTCUTS,true)
+
+fails :: proc(load,strength: f32) -> bool { return load > 0 && load >= strength }
+
+evaluate_blast :: proc(s: ^Scene, blast: Blast, first_subdivision: int = 0, first_connection: int = 0) -> Failures {
+	f := Failures{}
+	regions,links: [dynamic]u64
+	defer delete(regions); defer delete(links)
+	if first_subdivision==0 && first_connection==0 {
+		regions=blast_regions(s,blast)
+		links=blast_connections(s,regions[:])
+	} else {
+		for i in first_subdivision..<len(s.subdivisions) { if s.subdivisions[i].live { append(&regions,s.subdivisions[i].id) } }
+		for i in first_connection..<len(s.connections) { if s.connections[i].live { append(&links,s.connections[i].id) } }
+	}
+	for id in regions {
+		sub:=s.subdivisions[s.sub_rows[id]]
+		load:=blast_load(cover_failure_distance(sub,subdivision_sample(sub),blast,s.materials[sub.material].subdivision_strength),blast.radius)
+		if fails(load,s.materials[sub.material].subdivision_strength) { append(&f.subdivisions,id) }
+	}
+	for id in links {
+		c:=s.connections[s.conn_rows[id]]
+		a:=s.subdivisions[s.sub_rows[c.a]]
+  strength:=s.materials[a.material].connection_strength
+  sample:=connection_blast_sample(s,c,blast.position)
+  if c.mortar {
+   b:=s.subdivisions[s.sub_rows[c.b]]
+   strength=min(strength,s.materials[b.material].connection_strength)
+   sample=connection_sample(s,c)
+  }
+  load:=blast_load(cover_failure_distance(a,sample,blast,strength),blast.radius)
+  if fails(load,strength) { append(&f.connections,id) }
+	}
+	return f
+}
+
+blast_erases_descendants :: proc(sub: Subdivision, blast: Blast, strength: f32) -> bool {
+ if cover_external(sub,blast.position) { return false }
+	if !finite(strength) || !finite(blast.radius) || !valid_vec(blast.position) { return false }
+	farthest: f32
+	for point in sub.outline.points {
+		distance := vlen(vsub(posed_point(sub,point),blast.position))
+		if !finite(distance) { return false }
+		farthest=max(farthest,distance)
+	}
+	farthest=math.nextafter(farthest,math.inf_f32(1))
+	return blast_load(farthest,blast.radius)>strength+0.0001
+}
+
+refine_blast_reach :: proc(s: ^Scene,blast: Blast,shock: ^Shock_Transaction = nil) -> bool {
+ when BOM_PROFILE { started:=time.tick_now(); defer profile_add(0,started) }
+
+ // Reach-only attempts are not failures; retain their local skip set.
+ unrefinable:=make(map[u64]bool); defer delete(unrefinable)
+	affected:=make(map[u64]bool)
+	defer delete(affected)
+	changed:=false
+	candidates:=blast_regions(s,blast); defer delete(candidates)
+	for {
+		failures:=Failures{}
+		for id in candidates {
+			sub:=s.subdivisions[s.sub_rows[id]]
+			if !sub.live || sub.seed==0 || sub.width<=s.minimum_width && s.materials[sub.material].aspect_ratio>=1 || unrefinable[sub.id] { continue }
+			strength:=s.materials[sub.material].subdivision_strength
+			if (COVER_REACH_SHORTCUTS || !cover_foreign_any(sub)) && fails(blast_load(cover_failure_distance(sub,sub.pose.position,blast,strength),blast.radius),strength) {
+				extent:=f32(0)
+				for point in sub.outline.points { extent=max(extent,vlen(vsub(point,sub.rest_center))) }
+				// Extent alone is a legacy reach heuristic, not a whole-core proof.
+    // Newly enabled cases require the farthest-point proof below.
+    if !cover_external(sub,blast.position) && !cover_foreign_any(sub) && extent<=blast.radius-strength/BLAST_LOAD_MULTIPLIER || blast_erases_descendants(sub,blast,strength) { continue }
+			}
+			distance:=f32(1e30)
+			if point_in_subdivision(sub,blast.position) { distance=0 }
+			else {
+				for rest,i in sub.outline.points {
+					a,b:=posed_point(sub,rest),posed_point(sub,sub.outline.points[(i+1)%len(sub.outline.points)])
+					edge:=vsub(b,a); squared:=vdot(edge,edge)
+					if squared<=0 { continue }
+					t:=clamp(vdot(vsub(blast.position,a),edge)/squared,f32(0),f32(1))
+					distance=min(distance,cover_failure_distance(sub,vadd(a,vmul(edge,t)),blast,strength))
+				}
+			}
+			if fails(blast_load(distance,blast.radius),strength) { append(&failures.subdivisions,sub.id) }
+		}
+		if len(failures.subdivisions)==0 { break }
+		first_child:=len(s.subdivisions)
+		stage_failures(s,failures,&affected,true,0,shock)
+		for id in failures.subdivisions {
+			if s.subdivisions[s.sub_rows[id]].live { unrefinable[id]=true } else { changed=true }
+		}
+		delete(failures.subdivisions)
+		clear(&candidates)
+		for i in first_child..<len(s.subdivisions) { if s.subdivisions[i].live { append(&candidates,s.subdivisions[i].id) } }
+	}
+	if changed { rebuild_affected_pieces(s,affected) }
+	return changed
+}
+
+blast_pass :: proc(s: ^Scene, blast: Blast, deletion_shortcut: bool = true) {
+ when BOM_PROFILE {
+  profile:=Profile{start=time.tick_now(),before={len(s.subdivisions),len(s.connections)}}; blast_profile=&profile
+  defer { fmt.printf("PROFILE,%d,%.6f,%v,%v,%v,%d,%d\n",profile_tick,f64(time.tick_diff(profile.start,time.tick_now()))/f64(time.Millisecond),profile.ms,profile.counts,profile.before,len(s.subdivisions),len(s.connections)); blast_profile=nil }
+ }
+	physics_read_motion(s)
+ cover:=cover_begin(s,blast.radius); active_cover=&cover; defer { when BOM_PROFILE { fmt.printf("COVER,%d,%d,%d,%d,%d,%d,%d,%d\n",profile_tick,cover.samples,cover.fast_samples,cover.cache_hits,cover.upper_bound_skips,cover.shape_hits,cover.shape_misses,cover.partition_cache_hits) }; active_cover=nil; cover_destroy(&cover) }
+ shock:=shock_begin_blast(s,blast); defer shock_destroy(&shock)
+	revision:=s.revision
+	refined:=refine_blast_reach(s,blast,&shock)
+	physics_read_motion(s)
+	affected := make(map[u64]bool)
+	defer delete(affected)
+ when BOM_PROFILE { direct_start:=time.tick_now() }
+	f := evaluate_blast(s,blast)
+	changed := false
+	for len(f.subdivisions)>0 || len(f.connections)>0 {
+		changed=true
+		if deletion_shortcut {
+			for id in f.subdivisions {
+				sub := s.subdivisions[s.sub_rows[id]]
+				if (COVER_DELETE_SHORTCUTS || !cover_foreign_any(sub)) && sub.seed!=0 && sub.width>s.minimum_width && blast_erases_descendants(sub,blast,s.materials[sub.material].subdivision_strength) { append(&f.discard_subdivisions,id) }
+			}
+		}
+		first_subdivision,first_connection := len(s.subdivisions),len(s.connections)
+		stage_failures(s,f,&affected,false,0,&shock,true)
+		delete(f.subdivisions); delete(f.connections); delete(f.discard_subdivisions)
+		// Earlier survivors have unchanged samples. Only children and new links
+		// need this blast again; failed old links are already excluded from inheritance.
+		f=evaluate_blast(s,blast,first_subdivision,first_connection)
+	}
+	delete(f.subdivisions); delete(f.connections); delete(f.discard_subdivisions)
+ when BOM_PROFILE { profile_add(1,direct_start) }
+ if shock_apply(s,&shock,&affected,false) { changed=true }
+	if changed { s.revision+=1; rebuild_affected_pieces(s,affected) }
+	commit_structure(s)
+	physics_sync_structure(s)
+ when BOM_PROFILE { impulse_start:=time.tick_now(); defer profile_add(8,impulse_start) }
+	final_regions:=blast_regions(s,blast); defer delete(final_regions)
+	for id in final_regions {
+		sub := &s.subdivisions[s.sub_rows[id]]
+		offset := vsub(subdivision_sample(sub^),blast.position)
+		distance := vlen(offset)
+		load := blast_load(cover_sample_distance(sub^,subdivision_sample(sub^),blast.position),blast.radius)
+		if load>0 && distance>0.00001 { apply_blast_motion(s,sub,vmul(offset,1/distance),load) }
+	}
+	physics_read_motion(s)
+	if refined && s.revision==revision { s.revision+=1 }
+}
+
+PRESPLIT_SIZE :: f32(1)
+
+longest_dimension :: proc(p: Polygon) -> f32 {
+ lo,hi:=Vec2{1e30,1e30},Vec2{-1e30,-1e30}
+ for v in p.points { lo={min(lo.x,v.x),min(lo.y,v.y)}; hi={max(hi.x,v.x),max(hi.y,v.y)} }
+ return max(hi.x-lo.x,hi.y-lo.y)
+}
+
+presplit_piece :: proc(s: ^Scene,owner: u64,size: f32 = PRESPLIT_SIZE) {
+ affected:=make(map[u64]bool); defer delete(affected)
+ candidates:=sorted_ids(s.pieces[s.piece_rows[owner]].subdivisions[:]); defer delete(candidates)
+ for len(candidates)>0 {
+  f:=Failures{}
+  for id in candidates {
+   sub:=s.subdivisions[s.sub_rows[id]]
+   needed:=frame_longest(sub.outline,sub.frame)>size+0.00001
+   if s.materials[sub.material].aspect_ratio<1 { local:=frame_polygon(sub.outline,sub.frame); needed,_=grain_cut_kind(local,s.minimum_width,true,s.materials[sub.material].strip_thickness);delete(local.points) }
+   if sub.live && sub.seed!=0 && needed { append(&f.subdivisions,id) }
+  }
+  if len(f.subdivisions)==0 { delete(f.subdivisions); break }
+  first:=len(s.subdivisions)
+  stage_failures(s,f,&affected,true,size); delete(f.subdivisions)
+  clear(&candidates)
+  for i in first..<len(s.subdivisions) { if s.subdivisions[i].live { append(&candidates,s.subdivisions[i].id) } }
+ }
+ rebuild_affected_pieces(s,affected)
+ commit_structure(s)
+}
diff --git a/src/shared/sim_diagnostic_hooks.odin b/src/shared/sim_diagnostic_hooks.odin
new file mode 100644
index 0000000..02dc0eb
--- /dev/null
+++ b/src/shared/sim_diagnostic_hooks.odin
@@ -0,0 +1,38 @@
+package shared
+import "core:fmt"
+import "core:time"
+// Shared instrumentation state, independent of diagnostic rendering entry points.
+BOM_MORTAR_MEASURE :: #config(BOM_MORTAR_MEASURE,false)
+BOM_FRAME_BENCH :: #config(BOM_FRAME_BENCH,false)
+@(thread_local) cover_wood_failures:int
+when BOM_MORTAR_MEASURE { @(thread_local) mortar_measured_force_breaks: int }
+when BOM_FRAME_BENCH {
+ frame_measuring: bool
+ frame_cache_ms,frame_physics_ms: f64
+ frame_ms :: proc(start:time.Tick)->f64 { return f64(time.tick_diff(start,time.tick_now()))/f64(time.Millisecond) }
+}
+seam_diagnostic_scene:^Scene
+seam_diagnostic_layout:^Layout
+seam_diagnostic_tick:int
+seam_diagnostic_run:string
+seam_diagnostic_phase:string
+seam_object :: proc(sub:Subdivision)->u64 {
+ if seam_diagnostic_layout==nil { return 0 }
+ for object in seam_diagnostic_layout.objects { p:=shape_polygon(object);inside:=convex_contains(p,sub.rest_center);delete(p.points);if inside { return object.identity } };return 0
+}
+seam_diagnostic_death :: proc(s:^Scene,c:Connection,path:string) {
+ if s!=seam_diagnostic_scene { return }
+ a,b:=s.subdivisions[s.sub_rows[c.a]],s.subdivisions[s.sub_rows[c.b]]
+ fmt.printf("DEATH run=%s tick=%d phase=%s path=%s id=%d objects=%d/%d glue=%v endpoints_live=%v/%v\n",seam_diagnostic_run,seam_diagnostic_tick,seam_diagnostic_phase,path,c.id,seam_object(a),seam_object(b),len(c.glue)>0,a.live,b.live)
+}
+// Peak damage per connection id, recorded for one scene while seam_damage_scene is set (a break tick's
+// value includes the excess that broke it).
+seam_damage_scene:^Scene
+seam_damage_peak:map[u64]f32
+seam_diagnostic_force :: proc(s:^Scene,seam:Mortar_Seam,r:f32,broken:bool,damage:f32) {
+ if s==seam_damage_scene && s!=nil { for id in seam.members { seam_damage_peak[id]=max(seam_damage_peak[id],damage) } }
+ if s!=seam_diagnostic_scene { return }
+ fmt.printf("FORCE run=%s tick=%d bodies=%v/%v r=%.9f damage_before=%.9f damage_after=%.9f broken=%v ids=%v\n",seam_diagnostic_run,seam_diagnostic_tick,seam.bodies[0],seam.bodies[1],r,seam.damage,damage,broken,seam.members[:])
+}
+
+when ODIN_TEST { @(thread_local) glass_commit_test_calls: int }
diff --git a/src/shared/sim_editor.odin b/src/shared/sim_editor.odin
new file mode 100644
index 0000000..f7e4a2a
--- /dev/null
+++ b/src/shared/sim_editor.odin
@@ -0,0 +1,52 @@
+#+feature dynamic-literals
+package shared
+
+
+
+Recipe :: enum { Wood, Glass, Rubber, Stone }
+
+Slot :: distinct int
+
+recipe_slot :: proc(recipe:Recipe)->Slot { return Slot(int(recipe)) }
+
+builtin_recipe :: proc(slot:Slot)->Recipe {
+ for recipe in Recipe { if recipe_slot(recipe)==slot { return recipe } }
+ panic("Expected a built-in palette slot")
+}
+
+RUBBER_CELL_SIZE :: f32(0.4)
+
+Shape_Kind :: enum { Rect, Wedge }
+
+Glue_Link :: struct { a,b:u64 }
+
+Authored_Shape :: struct { angle:f32, shape:Shape_Kind, lo,hi: Vec2, material: Slot, identity: u64, mortar: bool }
+
+Layout :: struct { next_identity: u64, objects: [dynamic]Authored_Shape, materials: [dynamic]Custom_Material, glue:[dynamic]Glue_Link }
+
+PALETTE_MATERIALS :: [Recipe]Material{
+ .Wood = {name="wood",color={180,136,82},strip_thickness=0.2,blast_resistance=1.5,subdivision_strength=28,connection_strength=22,flexibility=0,impact_scale=1,generation_count=5,aspect_ratio=0.2},
+ .Glass = {name="glass",color={86,153,174},blast_resistance=0.5,subdivision_strength=16,connection_strength=12,flexibility=0,impact_scale=1,generation_count=6,aspect_ratio=1,triangulate=true,shock_loss=4},
+ .Rubber = {name="rubber",color={162,112,184},blast_resistance=3,subdivision_strength=45,connection_strength=90,flexibility=0.5,impact_scale=0,generation_count=3,aspect_ratio=1},
+ .Stone = {name="stone",color={131,145,152},blast_resistance=3,subdivision_strength=35,connection_strength=20,flexibility=0,impact_scale=1.6,generation_count=3,aspect_ratio=1},
+}
+
+editor_material :: proc(choice: Recipe) -> Material { table:=PALETTE_MATERIALS; return table[choice] }
+
+editor_overlaps :: proc(a,b: Authored_Shape) -> bool {
+ if a.angle==0 && b.angle==0 && a.shape==.Rect && b.shape==.Rect { return max(f32(0),min(a.hi.x,b.hi.x)-max(a.lo.x,b.lo.x))*max(f32(0),min(a.hi.y,b.hi.y)-max(a.lo.y,b.lo.y))>1e-6 }
+ return shape_overlap(a,b)
+}
+
+editor_rectangle_problem :: proc(editor: ^Layout,r: Authored_Shape) -> string {
+	if !finite(r.angle) || r.angle<0 || r.angle>=360 { return "Angle must be between 0 and 360" }
+ if !valid_vec(r.lo) || !valid_vec(r.hi) { return "Outside the build area" }
+	if r.hi.x-r.lo.x<0.2 || r.hi.y-r.lo.y<0.2 { return "Too small (min 0.2)" }
+	polygon:=shape_polygon(r);defer delete(polygon.points)
+ for v in polygon.points { if v.x< -7.5 || v.x>8.5 || v.y< -1e-6 || v.y>4.8 { return "Outside the build area" } }
+	// Reserve the initial player's footprint, too; no body starts inside a solid.
+	spawn:=Authored_Shape{lo={PLAYER_SPAWN.x-PLAYER_RADIUS,0},hi={PLAYER_SPAWN.x+PLAYER_RADIUS,PLAYER_SPAWN.y+PLAYER_HALF_HEIGHT}}
+	if editor_overlaps(r,spawn) { return "Overlaps the spawn" }
+	for object in editor.objects { if editor_overlaps(r,object) { return "Overlaps an object" } }
+	return ""
+}
