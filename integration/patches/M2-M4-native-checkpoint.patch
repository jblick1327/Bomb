index 0000000..a34a3cb
--- /dev/null
+++ b/src/shared/model.odin
@@ -0,0 +1,185 @@
+#+feature dynamic-literals
+package shared
+
+import time "core:time"
+import math "core:math"
+import b2 "vendor:box2d"
+
+Vec2 :: struct { x, y: f32 }
+
+Polygon :: struct { points: []Vec2 }
+
+Pose :: struct { position: Vec2, angle: f32, velocity: Vec2, angular_velocity: f32 }
+
+Material :: struct {
+	name: string,
+	subdivision_strength, connection_strength: f32,
+	flexibility: f32,
+	impact_scale: f32, // Constructors use 1; zero explicitly disables physical damage.
+	generation_count: int,
+	aspect_ratio: f32,
+	triangulate: bool,
+ shock_loss: f32,
+ blast_resistance: f32,
+ strip_thickness: f32, // Explicit for grained recipes; zero when unused.
+ color: [3]u8,
+}
+
+Subdivision :: struct {
+ frame:f32 `json:"frame,omitempty"`,
+	id, owner: u64,
+	material: int,
+	seed: u8,
+	outline: Polygon,
+	body: b2.BodyId `json:"-"`,
+	fixture_count: int `json:"-"`,
+	shapes: [dynamic]b2.ShapeId `json:"-"`,
+	incident_links: [dynamic]u64 `json:"-"`,
+	width: f32 `json:"-"`,
+	rest_center: Vec2,
+	pose: Pose,
+	live: bool,
+}
+
+Glue_Sample :: struct { p,q:Vec2, w:f32 }
+
+Connection :: struct {
+ glue:[dynamic]Glue_Sample `json:"-"`,
+	id, a, b: u64,
+	rest_point, local_a, local_b: Vec2,
+ rest_segments: [dynamic]Segment `json:"-"`,
+	joint: b2.JointId `json:"-"`,
+	live: bool,
+ mortar: bool,
+ damage: f32, // seconds of excess capacity absorbed by this mortar/glue seam (shared by its members)
+}
+
+Piece :: struct {
+	id: u64,
+	ref_rest: Vec2 `json:"-"`, // Immutable after construction; network structure, not the solo snapshot format.
+	has_ref_rest: bool `json:"-"`,
+	material: int,
+	seed: u8,
+	subdivisions, connections: [dynamic]u64,
+	render_revision: u64 `json:"-"`,
+	mass: f32 `json:"-"`,
+	body: b2.BodyId `json:"-"`, // Owned here for rigid pieces; regions alias it.
+	physics_revision: u64 `json:"-"`,
+	body_frame: b2.Transform `json:"-"`,
+	source_body: b2.BodyId `json:"-"`,
+	has_body_frame: bool `json:"-"`,
+	live: bool,
+}
+
+Endpoint_Pair :: struct { a,b: u64 }
+
+pair_key :: proc(a,b: u64) -> Endpoint_Pair { return {min(a,b),max(a,b)} }
+
+Scene :: struct {
+	physics: Physics,
+	materials: [dynamic]Material,
+	owned_names: [dynamic]string,
+	subdivisions: [dynamic]Subdivision,
+	connections: [dynamic]Connection,
+	pieces: [dynamic]Piece,
+	sub_rows, conn_rows, piece_rows: map[u64]int,
+	connection_pairs: map[Endpoint_Pair]u64,
+	structure_revision: u64,
+	anchor_y: f32, // Structural: pieces with a live cell edge on this height are static. Replicated.
+	epoch: u32, // Replication epoch; bumped whenever the world is rebuilt.
+	pending_regions: [dynamic]u64,
+	next_id: u64,
+	revision: u64,
+	minimum_width: f32,
+}
+
+vadd :: proc(a, b: Vec2) -> Vec2 { return {a.x+b.x, a.y+b.y} }
+
+vsub :: proc(a, b: Vec2) -> Vec2 { return {a.x-b.x, a.y-b.y} }
+
+vmul :: proc(a: Vec2, s: f32) -> Vec2 { return {a.x*s, a.y*s} }
+
+vdot :: proc(a, b: Vec2) -> f32 { return a.x*b.x+a.y*b.y }
+
+vcross :: proc(a, b: Vec2) -> f32 { return a.x*b.y-a.y*b.x }
+
+vlen :: proc(a: Vec2) -> f32 { return math.sqrt(vdot(a,a)) }
+
+make_polygon :: proc(points: []Vec2) -> Polygon {
+	result:=Polygon{points=make([]Vec2,len(points))}
+	copy(result.points,points)
+	return result
+}
+
+shared_boundary :: proc(a, b: Polygon) -> (f32, Vec2) {
+ when BOM_PROFILE { started:=time.tick_now(); defer profile_add(13,started); if blast_profile!=nil { blast_profile.counts[5]+=1 } }
+
+	total: f32
+	weighted := Vec2{}
+	for i in 0..<len(a.points) {
+		p, q := a.points[i], a.points[(i+1)%len(a.points)]
+		d := vsub(q,p)
+		length := vlen(d)
+		if length < 0.00001 { continue }
+		unit := vmul(d,1/length)
+		for j in 0..<len(b.points) {
+			r, s := b.points[j], b.points[(j+1)%len(b.points)]
+			if math.abs(vcross(d,vsub(r,p))) > 0.0001*length || math.abs(vcross(d,vsub(s,p))) > 0.0001*length { continue }
+			t0, t1 := vdot(vsub(r,p),unit), vdot(vsub(s,p),unit)
+			lo := max(f32(0),min(t0,t1))
+			hi := min(length,max(t0,t1))
+			if hi-lo > 0.0001 {
+				span := hi-lo
+				total += span
+				weighted = vadd(weighted,vmul(vadd(p,vmul(unit,(lo+hi)*0.5)),span))
+			}
+		}
+	}
+	if total == 0 { return 0, {} }
+	return total,vmul(weighted,1/total)
+}
+
+new_scene :: proc(minimum_width: f32) -> Scene {
+	return Scene{sub_rows=make(map[u64]int),conn_rows=make(map[u64]int),piece_rows=make(map[u64]int),connection_pairs=make(map[Endpoint_Pair]u64),minimum_width=minimum_width,anchor_y=-1e30}
+}
+
+piece_finish_reference :: proc(s: ^Scene,p: ^Piece) {
+ if p.has_ref_rest || !p.live || len(p.subdivisions)==0 { return }
+ area,x,y: f64
+ for id in p.subdivisions {
+  sub:=s.subdivisions[s.sub_rows[id]]
+  if !sub.live { continue }
+  // Fan around a nearby vertex avoids cancellation in far-from-origin debris.
+  pts:=sub.outline.points
+  if len(pts)<3 { continue }
+  a:=pts[0]; signed,cx,cy:f64
+  for i in 1..<len(pts)-1 {
+   b,c:=pts[i],pts[i+1]
+   cross:=(f64(b.x)-f64(a.x))*(f64(c.y)-f64(a.y))-(f64(b.y)-f64(a.y))*(f64(c.x)-f64(a.x))
+   signed+=cross; cx+=(f64(a.x)+f64(b.x)+f64(c.x))*cross; cy+=(f64(a.y)+f64(b.y)+f64(c.y))*cross
+  }
+  if signed==0 { continue }
+  weight:=math.abs(signed)
+  area+=weight; x+=cx/signed/3*weight; y+=cy/signed/3*weight
+ }
+ if area>0 { p.ref_rest={f32(x/area),f32(y/area)}; p.has_ref_rest=true }
+}
+
+scene_finish_references :: proc(s: ^Scene) { for &p in s.pieces { piece_finish_reference(s,&p) } }
+
+is_live_subdivision :: proc(s: ^Scene,id: u64) -> bool {
+	if row,ok:=s.sub_rows[id]; ok { return s.subdivisions[row].live }; return false
+}
+
+scene_destroy :: proc(s: ^Scene) {
+	physics_destroy(s)
+ for c in s.connections { delete(c.rest_segments); delete(c.glue) }
+	for &sub in s.subdivisions { delete(sub.outline.points); delete(sub.incident_links); delete(sub.shapes) }
+	for p in s.pieces { delete(p.subdivisions); delete(p.connections) }
+	delete(s.subdivisions); delete(s.connections); delete(s.pieces)
+	delete(s.materials)
+	for name in s.owned_names { delete(name) }
+	delete(s.owned_names)
+	delete(s.sub_rows); delete(s.conn_rows); delete(s.piece_rows); delete(s.connection_pairs); delete(s.pending_regions)
+	s^ = {}
+}
diff --git a/src/shared/net_client.odin b/src/shared/net_client.odin
new file mode 100644
index 0000000..da64f9e
--- /dev/null
+++ b/src/shared/net_client.odin
@@ -0,0 +1,433 @@
+#+feature dynamic-literals
+package shared
+
+import nc "../netcode"
+import math "core:math"
+import slice "core:slice"
+import "core:strings"
+
+NET_STEP_DT :: f64(1.0/60.0)
+
+NET_CLOCK_GAIN :: 0.02 // fraction of a tick of rate change per tick of clock error
+
+NET_CLOCK_MAX_ADJUST :: 0.05
+
+NET_CLOCK_SNAP_TICKS :: 30.0 // 0.5 s
+
+NET_DELAY_MIN :: 2
+
+NET_DELAY_MAX :: 12
+
+NET_JITTER_WINDOW :: 2.0 // seconds
+
+NET_LOSS_TICKS :: 8 // a frame still missing once a frame this much newer completed is lost
+
+NET_PENDING_FRAMES :: 16
+
+NET_HIDDEN :: f32(10000)
+
+Net_Queued :: struct { tick: u64, event: bool, data: []u8 }
+NET_MAX_QUEUED_MESSAGES :: 128
+NET_MAX_QUEUED_BYTES :: 32*1024*1024
+// Takes ownership on both success and failure. Overflow is an explicit session error.
+net_client_queue_owned :: proc(c:^Net_Client,q:Net_Queued) -> bool {
+ bytes:=len(q.data)
+ for existing in c.queue { bytes+=len(existing.data) }
+ if len(c.queue)>=NET_MAX_QUEUED_MESSAGES || bytes>NET_MAX_QUEUED_BYTES {
+  delete(q.data);c.stats.structure_errors+=1
+  if c.real_reason=="" { c.real_reason=strings.clone("presentation queue overflow; reconnect required") }
+  return false
+ }
+ append(&c.queue,q);return true
+}
+
+Frame_Asm :: struct {
+ tick: u64, has_base: bool, base_tick: u64, count: int,
+ have: [NET_MAX_PARTS]bool, got: int,
+ gone: [dynamic]u64, entries: [dynamic]Frame_Entry,
+}
+
+Complete_Frame :: struct { valid: bool, tick: u64, table: Pose_Table }
+
+Arrival :: struct { time: f64, tick: u64 }
+
+Net_Drawn :: struct { x,y,angle: f32, landed: bool, fuse: f32 }
+
+Applied_Struct :: struct { epoch: u32, revision: u64, hash: u64 }
+
+Net_Client_Stats :: struct {
+ frames_complete,frame_parts,frame_parts_duplicate,frame_parts_old,frames_wrong_epoch,frames_undecodable,frames_malformed: int,
+ structure_applied,structure_errors,events_played: int,
+ late_messages,late_structure,late_events: int, late_max_ticks: f64,
+ snaps,clock_ticks,clock_saturated: int, adjust_sum,adjust_abs_max: f64,
+ resets: int,
+ jumps_pressed,blasts_issued,blasts_dropped,blast_rejections_seen: int,
+ delay_history: [dynamic]u8,
+ frames_lost: int,
+ input_bytes,input_count,input_max: int,
+}
+
+Net_Client :: struct {
+ nc_client: nc.Client,
+ real_gate: bool,real_hello_sent: bool,real_hello_ok: bool,
+ real_is_host: bool,real_host_left: bool,
+ real_has_settings: bool,real_settings: Sandbox_Settings,
+ real_protocol: u32,real_build: string,real_host_token: string,
+ real_reason: string,
+ control_serial: u64, control_kind: u8, control_ok: bool, control_reason: string,
+ rep: Replica,
+ epoch: u32, has_epoch: bool,
+ queue: [dynamic]Net_Queued,
+ pending: [dynamic]^Frame_Asm,
+ ring: [NET_CLIENT_RING]Complete_Frame,
+ newest_complete: u64, has_complete: bool,
+ newest_seen: u64, has_seen: bool, confirmed_blast: u16,
+ clock: f64, has_clock: bool, delay: int,
+ arrivals: [dynamic]Arrival,
+ missing: [dynamic]u64,
+ loss_times: [dynamic]f64,
+ // inputs
+ idle: bool,
+ human_move: f32, human_jump_pending: bool,
+ input_seq,jump_counter,blast_seq: u16,
+ radius_q: u8,
+ blasts: [dynamic]Net_Blast,
+ last_ack_sent: u64, has_ack_sent: bool, acks_to_check: [dynamic]u64,
+ // presentation
+ drawn: map[u64]Net_Drawn,
+ anchored: map[u64]bool, anchored_valid: bool,
+ presentation_reset_serial: u64, // Incremented when frontend caches must be invalidated.
+ events: [dynamic]Net_Event, // Due immutable events, consumed by the caller before the next fixed step.
+ verify: bool, applied: [dynamic]Applied_Struct,
+ stats: Net_Client_Stats,
+ dbg_lower,dbg_upper: u64, // the frame ticks that bracketed the last draw
+}
+
+net_client_init :: proc(c: ^Net_Client,salt: u32,now: f64) {
+ c^={}
+ nc.client_init(&c.nc_client)
+ nc.client_connect(&c.nc_client,salt,now)
+ c.real_protocol=GAME_PROTOCOL_VERSION
+ c.real_build=GAME_BUILD_ID
+ replica_init(&c.rep)
+ c.delay=NET_DELAY_MIN
+ c.drawn=make(map[u64]Net_Drawn); c.anchored=make(map[u64]bool)
+ c.radius_q=radius_quantize(DEFAULT_SANDBOX_SETTINGS.blast_radius)
+ c.real_settings=DEFAULT_SANDBOX_SETTINGS
+}
+
+net_frame_asm_free :: proc(a: ^Frame_Asm) { delete(a.gone); delete(a.entries); free(a) }
+
+net_client_clear_state :: proc(c: ^Net_Client) {
+ for q in c.queue { delete(q.data) }; clear(&c.queue)
+ for a in c.pending { net_frame_asm_free(a) }; clear(&c.pending)
+ for i in 0..<NET_CLIENT_RING { if c.ring[i].valid { delete(c.ring[i].table) }; c.ring[i]={} }
+ c.has_complete=false; c.newest_complete=0; c.has_seen=false; c.confirmed_blast=0
+ c.has_clock=false; c.clock=0; c.delay=NET_DELAY_MIN
+ clear(&c.arrivals); clear(&c.missing); clear(&c.loss_times)
+ clear(&c.blasts); clear(&c.drawn); clear(&c.acks_to_check); c.has_ack_sent=false
+ clear(&c.anchored); c.anchored_valid=false
+ clear(&c.events)
+}
+
+net_client_destroy :: proc(c: ^Net_Client) {
+ net_client_clear_state(c)
+ nc.client_destroy(&c.nc_client)
+ delete(c.real_reason)
+ delete(c.control_reason)
+ replica_destroy(&c.rep)
+ c.presentation_reset_serial+=1
+ delete(c.queue); delete(c.pending); delete(c.arrivals); delete(c.missing); delete(c.loss_times)
+ delete(c.blasts); delete(c.acks_to_check); delete(c.drawn); delete(c.anchored); delete(c.events); delete(c.applied)
+ delete(c.stats.delay_history)
+ c^={}
+}
+
+net_client_record_applied :: proc(c: ^Net_Client) {
+ c.stats.structure_applied+=1
+ c.anchored_valid=false
+ if c.rep.rebuilt { c.presentation_reset_serial+=1 }
+ if c.verify {
+  data:=canonical_encode(&c.rep.scene); defer delete(data)
+  append(&c.applied,Applied_Struct{c.rep.scene.epoch,c.rep.scene.structure_revision,repl_hash(data)})
+ }
+}
+
+net_client_note_late :: proc(c: ^Net_Client,tick: u64,event: bool) {
+ if !c.has_clock || c.clock<=f64(tick) { return }
+ late:=c.clock-f64(tick)
+ c.stats.late_messages+=1; c.stats.late_max_ticks=max(c.stats.late_max_ticks,late)
+ if event { c.stats.late_events+=1 } else { c.stats.late_structure+=1 }
+}
+
+net_client_reset :: proc(c: ^Net_Client) {
+ c.stats.resets+=1
+ net_client_clear_state(c)
+ c.presentation_reset_serial+=1
+}
+
+net_client_on_structure :: proc(c: ^Net_Client,message: []u8) {
+ kind,tick,epoch,ok:=repl_peek(message)
+ if !ok { delete(message); c.stats.structure_errors+=1; return }
+ if kind==.Baseline && (!c.has_epoch || epoch!=u64(c.epoch)) {
+  net_client_reset(c)
+  if err:=replica_apply_message(&c.rep,message); err!="" { c.stats.structure_errors+=1 }
+  else { c.epoch=u32(epoch); c.has_epoch=true; net_client_record_applied(c) }
+  delete(message); return
+ }
+ if !c.has_epoch { delete(message); return }
+ net_client_note_late(c,tick,false)
+ net_client_queue_owned(c,Net_Queued{tick=tick,data=message})
+}
+
+net_client_on_reliable :: proc(c: ^Net_Client,data: []u8) {
+ if len(data)==0 { return }
+ switch data[0] {
+ case REPL_PART_MARK:
+  message,complete,err:=replica_collect(&c.rep,data)
+  if err!="" { c.stats.structure_errors+=1; return }
+  if complete { net_client_on_structure(c,message) }
+ case NET_MSG_EVENT:
+  e,ok:=event_decode(data)
+  if !ok { return }
+  net_client_note_late(c,e.tick,true)
+  net_client_queue_owned(c,Net_Queued{tick=e.tick,event=true,data=slice.clone(data)})
+ }
+}
+
+net_client_complete_frame :: proc(c: ^Net_Client,a: ^Frame_Asm,now: f64) {
+ base:^Pose_Table
+ if a.has_base {
+  slot:=a.base_tick%NET_CLIENT_RING
+  if !c.ring[slot].valid || c.ring[slot].tick!=a.base_tick { c.stats.frames_undecodable+=1; return }
+  base=&c.ring[slot].table
+ }
+ table:=table_clone(base)
+ for key in a.gone { delete_key(&table,key) }
+ for e in a.entries { table[e.key]=e.state }
+ slot:=a.tick%NET_CLIENT_RING
+ if c.ring[slot].valid { delete(c.ring[slot].table) }
+ c.ring[slot]=Complete_Frame{valid=true,tick=a.tick,table=table}
+ c.stats.frames_complete+=1
+ append(&c.arrivals,Arrival{now,a.tick})
+ if c.has_complete {
+  if a.tick>c.newest_complete {
+   if a.tick-c.newest_complete<600 { for m in c.newest_complete+1..<a.tick { append(&c.missing,m) } }
+   c.newest_complete=a.tick
+  } else if index,found:=slice.linear_search(c.missing[:],a.tick); found { unordered_remove(&c.missing,index) }
+ } else { c.has_complete=true; c.newest_complete=a.tick }
+}
+
+net_client_on_frame :: proc(c: ^Net_Client,data: []u8,now: f64) {
+ r:nc.Reader; nc.reader_init(&r,data)
+ part:Frame_Part; defer frame_part_destroy(&part)
+ if !frame_read_header(&r,&part) { c.stats.frames_malformed+=1; return }
+ if !c.has_epoch || part.epoch!=c.epoch { c.stats.frames_wrong_epoch+=1; return }
+ c.stats.frame_parts+=1
+ slot:=part.tick%NET_CLIENT_RING
+ if c.ring[slot].valid && c.ring[slot].tick==part.tick { c.stats.frame_parts_duplicate+=1; return }
+ if c.has_complete && part.tick+NET_CLIENT_RING<=c.newest_complete { c.stats.frame_parts_old+=1; return }
+ var:^Frame_Asm
+ for a in c.pending { if a.tick==part.tick { var=a } }
+ if var==nil {
+  if len(c.pending)>=NET_PENDING_FRAMES { net_frame_asm_free(c.pending[0]); ordered_remove(&c.pending,0) }
+  var=new(Frame_Asm); var.tick=part.tick; var.count=part.count; var.has_base=part.has_base; var.base_tick=part.base_tick
+  append(&c.pending,var)
+ }
+ if var.count!=part.count || var.has_base!=part.has_base || var.base_tick!=part.base_tick { c.stats.frames_malformed+=1; return }
+ if var.have[part.index] { c.stats.frame_parts_duplicate+=1; return }
+ base:^Pose_Table
+ if part.has_base {
+  bslot:=part.base_tick%NET_CLIENT_RING
+  if !c.ring[bslot].valid || c.ring[bslot].tick!=part.base_tick { c.stats.frames_undecodable+=1; return }
+  base=&c.ring[bslot].table
+ }
+ if !frame_read_body(&r,&part,base) { c.stats.frames_malformed+=1; return }
+ var.have[part.index]=true; var.got+=1
+ append(&var.gone,..part.gone[:]); append(&var.entries,..part.entries[:])
+ if !c.has_seen || part.tick>=c.newest_seen {
+  c.has_seen=true; c.newest_seen=part.tick; c.confirmed_blast=part.blast_seq
+  for len(c.blasts)>0 && !seq16_newer(c.blasts[0].seq,part.blast_seq) { ordered_remove(&c.blasts,0) }
+ }
+ if var.got==var.count {
+  net_client_complete_frame(c,var,now)
+  for a,i in c.pending { if a==var { ordered_remove(&c.pending,i); break } }
+  net_frame_asm_free(var)
+ }
+}
+
+net_client_update_delay :: proc(c: ^Net_Client,now: f64) {
+ for len(c.arrivals)>0 && now-c.arrivals[0].time>NET_JITTER_WINDOW { ordered_remove(&c.arrivals,0) }
+ for len(c.loss_times)>0 && now-c.loss_times[0]>NET_JITTER_WINDOW { ordered_remove(&c.loss_times,0) }
+ // Frames still missing once a much newer frame completed are lost.
+ i:=0
+ for i<len(c.missing) {
+  if c.has_complete && c.newest_complete>=c.missing[i]+NET_LOSS_TICKS {
+   append(&c.loss_times,now); c.stats.frames_lost+=1; unordered_remove(&c.missing,i)
+  } else { i+=1 }
+ }
+ if len(c.arrivals)==0 { c.delay=clamp(1+(len(c.loss_times)>0 ? 2 : 0),NET_DELAY_MIN,NET_DELAY_MAX); return }
+ offsets:[256]f64
+ count:=min(len(c.arrivals),len(offsets))
+ lowest:=f64(1e30)
+ for k in 0..<count {
+  a:=c.arrivals[len(c.arrivals)-count+k]
+  offsets[k]=a.time-f64(a.tick)*NET_STEP_DT
+  lowest=min(lowest,offsets[k])
+ }
+ for k in 0..<count { offsets[k]-=lowest }
+ slice.sort(offsets[:count])
+ p95:=offsets[min(count-1,int(math.ceil(0.95*f64(count)))-1)]
+ jitter_ticks:=int(math.ceil(p95/NET_STEP_DT-0.001))
+ delay:=1+jitter_ticks
+ if len(c.loss_times)>0 { delay+=2 }
+ c.delay=clamp(delay,NET_DELAY_MIN,NET_DELAY_MAX)
+}
+
+net_client_update_clock :: proc(c: ^Net_Client) {
+ if !c.has_complete { return }
+ target:=f64(c.newest_complete)-f64(c.delay)
+ if !c.has_clock { c.clock=target; c.has_clock=true; c.stats.snaps+=1; return }
+ err:=target-c.clock
+ if math.abs(err)>NET_CLOCK_SNAP_TICKS { c.clock=target; c.stats.snaps+=1; return }
+ adjust:=clamp(err*NET_CLOCK_GAIN,-NET_CLOCK_MAX_ADJUST,NET_CLOCK_MAX_ADJUST)
+ c.clock+=1+adjust
+ c.stats.clock_ticks+=1; c.stats.adjust_sum+=adjust; c.stats.adjust_abs_max=max(c.stats.adjust_abs_max,math.abs(adjust))
+ if math.abs(adjust)>=NET_CLOCK_MAX_ADJUST-1e-12 { c.stats.clock_saturated+=1 }
+}
+
+net_client_apply_queue :: proc(c: ^Net_Client) {
+ slice.stable_sort_by(c.queue[:],proc(a,b:Net_Queued)->bool {
+  if a.tick!=b.tick { return a.tick<b.tick }
+  return !a.event && b.event
+ })
+ for len(c.queue)>0 {
+  q:=c.queue[0]
+  if !c.has_clock || f64(q.tick)>c.clock { break }
+  ordered_remove(&c.queue,0)
+  if q.event {
+   if e,ok:=event_decode(q.data); ok {
+    switch e.kind {
+    case NET_EVENT_EXPLOSION: append(&c.events,e); c.stats.events_played+=1
+    case NET_EVENT_BLAST_REJECTED: c.stats.blast_rejections_seen+=1
+    }
+   }
+  } else {
+   if err:=replica_apply_message(&c.rep,q.data); err!="" { c.stats.structure_errors+=1 } else { net_client_record_applied(c) }
+  }
+  delete(q.data)
+ }
+}
+
+net_lerp :: proc(a,b: f32,t: f32) -> f32 { return a+(b-a)*t }
+
+net_drawn_from :: proc(s0,s1: Pose_State,alpha: f32) -> Net_Drawn {
+ a0,a1:=pose_dq_angle(s0.a),pose_dq_angle(s1.a)
+ landed:=s0.landed; if alpha>=0.5 { landed=s1.landed }
+ return {x=net_lerp(pose_dq_pos(s0.x),pose_dq_pos(s1.x),alpha),y=net_lerp(pose_dq_pos(s0.y),pose_dq_pos(s1.y),alpha),angle=a0+radians_delta(a1,a0)*alpha,landed=landed,fuse=net_lerp(pose_dq_fuse(s0.fuse),pose_dq_fuse(s1.fuse),alpha)}
+}
+
+net_drawn_single :: proc(s: Pose_State) -> Net_Drawn {
+ return {x=pose_dq_pos(s.x),y=pose_dq_pos(s.y),angle=pose_dq_angle(s.a),landed=s.landed,fuse=pose_dq_fuse(s.fuse)}
+}
+
+net_in_structure :: proc(c: ^Net_Client,key: u64) -> bool {
+ switch key_kind(key) {
+ case .Piece: row,ok:=c.rep.scene.piece_rows[key_id(key)]; return ok && c.rep.scene.pieces[row].live
+ case .Rubber: row,ok:=c.rep.scene.sub_rows[key_id(key)]; return ok && c.rep.scene.subdivisions[row].live
+ case .Player,.Bomb: return true
+ }
+ return false
+}
+
+net_client_compute_drawn :: proc(c: ^Net_Client) {
+ clear(&c.drawn)
+ if !c.has_clock || !c.has_complete || !c.has_epoch { return }
+ floor_tick:=u64(max(math.floor(c.clock),0))
+ lower,upper:^Complete_Frame
+ start:=min(floor_tick,c.newest_complete)
+ for step in 0..<u64(NET_CLIENT_RING) {
+  if step>start { break }
+  f:=&c.ring[(start-step)%NET_CLIENT_RING]
+  if f.valid && f.tick==start-step { lower=f; break }
+ }
+ for t:=floor_tick+1; t<=c.newest_complete && t<=floor_tick+NET_CLIENT_RING; t+=1 {
+  f:=&c.ring[t%NET_CLIENT_RING]
+  if f.valid && f.tick==t { upper=f; break }
+ }
+ c.dbg_lower=0; c.dbg_upper=0
+ if lower!=nil { c.dbg_lower=lower.tick }; if upper!=nil { c.dbg_upper=upper.tick }
+ if lower==nil && upper==nil { return }
+ if lower==nil {
+  for key,s in upper.table { if net_in_structure(c,key) { c.drawn[key]=net_drawn_single(s) } }
+  return
+ }
+ if upper==nil || upper.tick<=lower.tick {
+  for key,s in lower.table { if net_in_structure(c,key) { c.drawn[key]=net_drawn_single(s) } }
+  return
+ }
+ alpha:=f32((c.clock-f64(lower.tick))/f64(upper.tick-lower.tick))
+ alpha=clamp(alpha,0,1)
+ for key,s0 in lower.table {
+  if !net_in_structure(c,key) { continue }
+  if s1,ok:=upper.table[key]; ok { c.drawn[key]=net_drawn_from(s0,s1,alpha) }
+  else { c.drawn[key]=net_drawn_single(s0) } // gone at the upper frame: drawn until the clock reaches it
+ }
+ // Rows only in the upper table are new there and show from that frame on.
+}
+
+net_client_ensure_anchored :: proc(c: ^Net_Client) {
+ if c.anchored_valid { return }
+ clear(&c.anchored)
+ s:=&c.rep.scene
+ for p in s.pieces { if p.live && piece_anchored(s,p.id,s.anchor_y) { c.anchored[p.id]=true } }
+ c.anchored_valid=true
+}
+
+net_client_make_input :: proc(c: ^Net_Client) {
+ move:f32
+ index:=c.nc_client.client_index
+ move=c.human_move
+ if c.human_jump_pending {
+  c.jump_counter+=1
+  c.stats.jumps_pressed+=1
+  c.human_jump_pending=false
+ }
+ c.input_seq+=1
+ in_:=Net_Input{seq=c.input_seq,move=move_quantize(move),radius_q=c.radius_q,jump_counter=c.jump_counter}
+ if c.has_epoch { in_.epoch=c.epoch }
+ if c.has_complete {
+  in_.has_ack=true; in_.ack=c.newest_complete
+  if !c.has_ack_sent || c.last_ack_sent!=c.newest_complete { c.last_ack_sent=c.newest_complete; c.has_ack_sent=true; append(&c.acks_to_check,c.newest_complete) }
+ }
+ in_.blast_count=len(c.blasts)
+ for b,i in c.blasts { in_.blasts[i]=b }
+ w:nc.Writer; nc.writer_init(&w,64); defer nc.writer_destroy(&w)
+ input_encode(in_,&w)
+ c.stats.input_bytes+=len(w.data); c.stats.input_count+=1; c.stats.input_max=max(c.stats.input_max,len(w.data))
+ nc.client_send_unreliable(&c.nc_client,w.data[:])
+}
+
+net_client_step :: proc(c: ^Net_Client,now: f64,input_source: proc(c: ^Net_Client,data: rawptr)=nil,source_data: rawptr=nil) {
+ clear(&c.events)
+ if c.nc_client.state==.Connected {
+  net_app_client_send_hello(c)
+  msgs:=nc.client_take_messages(&c.nc_client); defer nc.messages_free(&msgs)
+  for m in msgs {
+   if m.channel==nc.CHANNEL_RELIABLE {
+    if !net_app_client_control(c,m.data) { net_client_on_reliable(c,m.data) }
+   }
+   else if len(m.data)>0 && m.data[0]==NET_MSG_FRAME { net_client_on_frame(c,m.data,now) }
+  }
+  net_client_update_delay(c,now)
+  net_client_update_clock(c)
+  net_client_apply_queue(c)
+  net_client_compute_drawn(c)
+  append(&c.stats.delay_history,u8(c.delay))
+  if !c.real_gate || c.real_hello_ok {
+   if input_source!=nil { input_source(c,source_data) }
+   net_client_make_input(c)
+  }
+ }
+ nc.client_update(&c.nc_client,now)
+}
diff --git a/src/shared/net_frame.odin b/src/shared/net_frame.odin
new file mode 100644
index 0000000..5764050
--- /dev/null
+++ b/src/shared/net_frame.odin
@@ -0,0 +1,343 @@
+#+feature dynamic-literals
+package shared
+
+import nc "../netcode"
+import math "core:math"
+import slice "core:slice"
+
+POSE_POS_STEP :: f64(1.0/256)
+
+POSE_ANGLE_STEPS :: 4096
+
+FRAME_PART_MAX :: 1150
+
+FRAME_BUDGET :: 2*FRAME_PART_MAX
+
+FRAME_HEADER_RESERVE :: 24
+
+NET_SENT_RING :: 64
+
+NET_CLIENT_RING :: 128
+
+NET_MAX_PARTS :: 32
+
+NET_MSG_FRAME :: u8(0xA1)
+
+NET_MSG_INPUT :: u8(0xA2)
+
+NET_MSG_EVENT :: u8(0xB6)
+
+NET_EVENT_EXPLOSION :: u8(1)
+
+NET_EVENT_BLAST_REJECTED :: u8(2)
+
+NET_MAX_BLASTS :: 8
+
+NET_BLAST_RATE_TICKS :: 60 // 4 accepted blasts per second per player
+
+NET_BLAST_RATE_COUNT :: 4
+
+NET_YARD_CEILING :: f32(12)
+
+Ent_Kind :: enum u8 { Piece, Rubber, Player, Bomb }
+
+ent_key :: proc(kind: Ent_Kind,id: u64) -> u64 { return (u64(kind)<<62)|id }
+
+key_kind :: proc(key: u64) -> Ent_Kind { return Ent_Kind(key>>62) }
+
+key_id :: proc(key: u64) -> u64 { return key&((u64(1)<<62)-1) }
+
+Pose_State :: struct { x,y: i32, a: u16, landed: bool, fuse: u8 }
+
+Pose_Table :: map[u64]Pose_State
+
+pose_q_pos :: proc(v: f32) -> i32 {
+ f:=f64(v); if f!=f { return 0 }
+ s:=math.round(f/POSE_POS_STEP)
+ if s>=f64(max(i32)) { return max(i32) }
+ if s<=f64(min(i32)) { return min(i32) }
+ return i32(s)
+}
+
+pose_dq_pos :: proc(q: i32) -> f32 { return f32(f64(q)*POSE_POS_STEP) }
+
+pose_q_angle :: proc(radians: f32) -> u16 {
+ f:=f64(radians); if f!=f || math.is_inf(f) { return 0 }
+ a:=math.mod(f,2*math.PI); if a<0 { a+=2*math.PI }
+ return u16(i64(math.round(a/(2*math.PI)*f64(POSE_ANGLE_STEPS)))%i64(POSE_ANGLE_STEPS))
+}
+
+pose_dq_angle :: proc(q: u16) -> f32 { return f32(f64(q)*2*math.PI/f64(POSE_ANGLE_STEPS)) }
+
+pose_q_fuse :: proc(fuse: f32) -> u8 {
+ f:=f64(fuse); if f!=f { return 0 }
+ return u8(clamp(math.round(f/f64(BOMB_FUSE)*255),0,255))
+}
+
+pose_dq_fuse :: proc(q: u8) -> f32 { return f32(f64(q)/255*f64(BOMB_FUSE)) }
+
+pose_state_make :: proc(x,y,angle: f32) -> Pose_State { return {x=pose_q_pos(x),y=pose_q_pos(y),a=pose_q_angle(angle)} }
+
+angle_delta :: proc(current,base: u16) -> i64 {
+ n:=i64(POSE_ANGLE_STEPS); half:=n/2
+ return ((i64(current)-i64(base)+half)%n+n)%n-half
+}
+
+angle_apply :: proc(base: u16,delta: i64) -> u16 {
+ n:=i64(POSE_ANGLE_STEPS)
+ return u16(((i64(base)%n+delta%n)%n+n)%n)
+}
+
+radians_delta :: proc(to,from: f32) -> f32 {
+ d:=math.mod(f64(to)-f64(from),2*math.PI)
+ if d>math.PI { d-=2*math.PI } else if d<-math.PI { d+=2*math.PI }
+ return f32(d)
+}
+
+table_clone :: proc(t: ^Pose_Table) -> Pose_Table {
+ n:=8; if t!=nil { n=max(len(t^),8) }
+ out:=make(Pose_Table,n)
+ if t!=nil { for key,state in t^ { out[key]=state } }
+ return out
+}
+
+tables_equal :: proc(a,b: ^Pose_Table) -> bool {
+ if len(a^)!=len(b^) { return false }
+ for key,state in a^ { other,ok:=b^[key]; if !ok || other!=state { return false } }
+ return true
+}
+
+Frame_Entry :: struct { key: u64, state: Pose_State }
+
+Frame_Part :: struct {
+ epoch: u32, tick: u64, has_base: bool, base_tick: u64,
+ index,count: int, blast_seq: u16,
+ gone: [dynamic]u64, entries: [dynamic]Frame_Entry,
+}
+
+frame_part_destroy :: proc(p: ^Frame_Part) { delete(p.gone); delete(p.entries); p^={} }
+
+frame_write_header :: proc(w: ^nc.Writer,epoch: u32,tick: u64,has_base: bool,base_tick: u64,index,count: int,blast_seq: u16) {
+ nc.write_u8(w,NET_MSG_FRAME); nc.write_varint(w,u64(epoch)); nc.write_varint(w,tick)
+ if has_base { nc.write_varint(w,base_tick+1) } else { nc.write_varint(w,0) }
+ nc.write_varint(w,u64(index)); nc.write_varint(w,u64(count)); nc.write_u16(w,blast_seq)
+}
+
+frame_read_header :: proc(r: ^nc.Reader,p: ^Frame_Part) -> bool {
+ if nc.read_u8(r)!=NET_MSG_FRAME { return false }
+ epoch:=nc.read_varint(r); p.tick=nc.read_varint(r)
+ base:=nc.read_varint(r)
+ p.index=int(min(nc.read_varint(r),u64(1<<20))); p.count=int(min(nc.read_varint(r),u64(1<<20)))
+ p.blast_seq=nc.read_u16(r)
+ if !r.ok || epoch>u64(max(u32)) || p.count<1 || p.count>NET_MAX_PARTS || p.index>=p.count { return false }
+ p.epoch=u32(epoch)
+ if base>0 { p.has_base=true; p.base_tick=base-1 }
+ return true
+}
+
+frame_write_entry :: proc(w: ^nc.Writer,e: Frame_Entry,base: ^Pose_Table,previous: ^u64,have_previous: ^bool) {
+ kind:=key_kind(e.key); id:=key_id(e.key)
+ delta:=id
+ if have_previous^ && key_kind(previous^)==kind { delta=id-key_id(previous^) }
+ nc.write_varint(w,delta)
+ row:Pose_State; has:=false
+ if base!=nil { row,has=base^[e.key] }
+ flags:=u8(kind)
+ if !has { flags|=4 }
+ if e.state.landed { flags|=8 }
+ nc.write_u8(w,flags)
+ if has {
+  nc.write_zigzag(w,i64(e.state.x)-i64(row.x)); nc.write_zigzag(w,i64(e.state.y)-i64(row.y)); nc.write_zigzag(w,angle_delta(e.state.a,row.a))
+ } else {
+  nc.write_zigzag(w,i64(e.state.x)); nc.write_zigzag(w,i64(e.state.y)); nc.write_zigzag(w,i64(e.state.a))
+ }
+ if kind==.Bomb { nc.write_u8(w,e.state.fuse) }
+ previous^=e.key; have_previous^=true
+}
+
+frame_entry_size :: proc(scratch: ^nc.Writer,e: Frame_Entry,base: ^Pose_Table,previous: u64,have_previous: bool) -> int {
+ nc.writer_reset(scratch)
+ p,h:=previous,have_previous
+ frame_write_entry(scratch,e,base,&p,&h)
+ return len(scratch.data)
+}
+
+frame_entry_estimate :: proc(e: Frame_Entry,base: ^Pose_Table) -> int {
+ row:Pose_State; has:=false
+ if base!=nil { row,has=base^[e.key] }
+ size:=2+1
+ if has { size+=nc.varint_size(nc.zigzag_encode(i64(e.state.x)-i64(row.x)))+nc.varint_size(nc.zigzag_encode(i64(e.state.y)-i64(row.y)))+nc.varint_size(nc.zigzag_encode(angle_delta(e.state.a,row.a))) }
+ else { size+=nc.varint_size(nc.zigzag_encode(i64(e.state.x)))+nc.varint_size(nc.zigzag_encode(i64(e.state.y)))+nc.varint_size(nc.zigzag_encode(i64(e.state.a))) }
+ if key_kind(e.key)==.Bomb { size+=1 }
+ return size
+}
+
+Frame_Plan :: struct { gone_lo,gone_hi,entry_lo,entry_hi: int }
+
+frame_encode :: proc(epoch: u32,tick: u64,has_base: bool,base_tick: u64,blast_seq: u16,base: ^Pose_Table,entries: []Frame_Entry,gone: []u64,parts: ^[dynamic][]u8) {
+ plans:[dynamic]Frame_Plan; defer delete(plans)
+ scratch:nc.Writer; nc.writer_init(&scratch,64); defer nc.writer_destroy(&scratch)
+ gi,ei:=0,0
+ for {
+  plan:=Frame_Plan{gone_lo=gi,entry_lo=ei}
+  size:=FRAME_HEADER_RESERVE+4
+  previous_gone:=u64(0)
+  for gi<len(gone) {
+   need:=nc.varint_size(gone[gi]-previous_gone)
+   if size+need>FRAME_PART_MAX { break }
+   size+=need; previous_gone=gone[gi]; gi+=1
+  }
+  plan.gone_hi=gi
+  if gi==len(gone) {
+   previous,have_previous:=u64(0),false
+   for ei<len(entries) {
+    need:=frame_entry_size(&scratch,entries[ei],base,previous,have_previous)
+    if size+need>FRAME_PART_MAX { break }
+    size+=need; previous=entries[ei].key; have_previous=true; ei+=1
+   }
+  }
+  plan.entry_hi=ei
+  append(&plans,plan)
+  if (gi>=len(gone) && ei>=len(entries)) || (plan.gone_hi==plan.gone_lo && plan.entry_hi==plan.entry_lo) { break }
+ }
+ for plan,index in plans {
+  w:nc.Writer; nc.writer_init(&w,FRAME_PART_MAX)
+  frame_write_header(&w,epoch,tick,has_base,base_tick,index,len(plans),blast_seq)
+  nc.write_varint(&w,u64(plan.gone_hi-plan.gone_lo))
+  previous_gone:=u64(0)
+  for key in gone[plan.gone_lo:plan.gone_hi] { nc.write_varint(&w,key-previous_gone); previous_gone=key }
+  nc.write_varint(&w,u64(plan.entry_hi-plan.entry_lo))
+  previous,have_previous:=u64(0),false
+  for e in entries[plan.entry_lo:plan.entry_hi] { frame_write_entry(&w,e,base,&previous,&have_previous) }
+  assert(len(w.data)<=FRAME_PART_MAX,"frame part exceeds its limit")
+  append(parts,w.data[:])
+ }
+}
+
+frame_read_body :: proc(r: ^nc.Reader,p: ^Frame_Part,base: ^Pose_Table) -> bool {
+ gone_count:=nc.read_varint(r)
+ if !r.ok || gone_count>u64(nc.reader_remaining(r)) { return false }
+ key:=u64(0)
+ for _ in 0..<int(gone_count) { key+=nc.read_varint(r); append(&p.gone,key) }
+ entry_count:=nc.read_varint(r)
+ if !r.ok || entry_count>u64(nc.reader_remaining(r)) { return false }
+ previous:=u64(0); have_previous:=false
+ for _ in 0..<int(entry_count) {
+  delta:=nc.read_varint(r); flags:=nc.read_u8(r)
+  if !r.ok || flags&0xF0!=0 { return false }
+  kind:=Ent_Kind(flags&3)
+  id:=delta
+  if have_previous && key_kind(previous)==kind { id=key_id(previous)+delta }
+  if id>=(u64(1)<<62) { return false }
+  k:=ent_key(kind,id)
+  e:=Frame_Entry{key=k}
+  e.state.landed=flags&8!=0
+  if flags&4==0 {
+   if base==nil { return false }
+   row,has:=base^[k]
+   if !has { return false }
+   dx,dy,da:=nc.read_zigzag(r),nc.read_zigzag(r),nc.read_zigzag(r)
+   x,y:=i64(row.x)+dx,i64(row.y)+dy
+   if !r.ok || x<i64(min(i32)) || x>i64(max(i32)) || y<i64(min(i32)) || y>i64(max(i32)) { return false }
+   e.state.x=i32(x); e.state.y=i32(y); e.state.a=angle_apply(row.a,da)
+  } else {
+   x,y,a:=nc.read_zigzag(r),nc.read_zigzag(r),nc.read_zigzag(r)
+   if !r.ok || x<i64(min(i32)) || x>i64(max(i32)) || y<i64(min(i32)) || y>i64(max(i32)) || a<0 || a>=i64(POSE_ANGLE_STEPS) { return false }
+   e.state.x=i32(x); e.state.y=i32(y); e.state.a=u16(a)
+  }
+  if kind==.Bomb { e.state.fuse=nc.read_u8(r) }
+  if !r.ok { return false }
+  append(&p.entries,e); previous=k; have_previous=true
+ }
+ return r.ok && nc.reader_remaining(r)==0
+}
+
+frame_decode_part :: proc(data: []u8,base: ^Pose_Table) -> (p: Frame_Part,ok: bool) {
+ r:nc.Reader; nc.reader_init(&r,data)
+ if !frame_read_header(&r,&p) { frame_part_destroy(&p); return {},false }
+ if !frame_read_body(&r,&p,base) { frame_part_destroy(&p); return {},false }
+ return p,true
+}
+
+Net_Blast :: struct { seq: u16, x,y: i32, radius_q: u8 }
+
+Net_Input :: struct {
+ epoch: u32, seq: u16,
+ has_ack: bool, ack: u64,
+ move: i8, radius_q: u8, jump_counter: u16,
+ blast_count: int, blasts: [NET_MAX_BLASTS]Net_Blast,
+}
+
+radius_quantize :: proc(r: f32) -> u8 {
+ f:=f64(r); if f!=f { return 0 }
+ return u8(clamp(math.round((clamp(f,0.5,6)-0.5)/5.5*255),0,255))
+}
+
+radius_dequantize :: proc(q: u8) -> f32 { return f32(0.5+f64(q)*5.5/255) }
+
+move_quantize :: proc(m: f32) -> i8 { return i8(clamp(math.round(f64(m)*127),-127,127)) }
+
+move_dequantize :: proc(q: i8) -> f32 { return f32(q)/127 }
+
+input_encode :: proc(in_: Net_Input,w: ^nc.Writer) {
+ nc.write_u8(w,NET_MSG_INPUT); nc.write_varint(w,u64(in_.epoch)); nc.write_u16(w,in_.seq)
+ if in_.has_ack { nc.write_varint(w,in_.ack+1) } else { nc.write_varint(w,0) }
+ nc.write_u8(w,u8(in_.move)); nc.write_u8(w,in_.radius_q); nc.write_u16(w,in_.jump_counter)
+ nc.write_u8(w,u8(in_.blast_count))
+ for i in 0..<in_.blast_count {
+  b:=in_.blasts[i]
+  nc.write_u16(w,b.seq); nc.write_zigzag(w,i64(b.x)); nc.write_zigzag(w,i64(b.y)); nc.write_u8(w,b.radius_q)
+ }
+}
+
+input_decode :: proc(data: []u8) -> (in_: Net_Input,ok: bool) {
+ r:nc.Reader; nc.reader_init(&r,data)
+ if nc.read_u8(&r)!=NET_MSG_INPUT { return {},false }
+ epoch:=nc.read_varint(&r); in_.seq=nc.read_u16(&r)
+ ack:=nc.read_varint(&r)
+ in_.move=i8(nc.read_u8(&r)); in_.radius_q=nc.read_u8(&r); in_.jump_counter=nc.read_u16(&r)
+ count:=int(nc.read_u8(&r))
+ if !r.ok || epoch>u64(max(u32)) || count>NET_MAX_BLASTS { return {},false }
+ in_.epoch=u32(epoch)
+ if ack>0 { in_.has_ack=true; in_.ack=ack-1 }
+ in_.blast_count=count
+ for i in 0..<count {
+  seq:=nc.read_u16(&r); x,y:=nc.read_zigzag(&r),nc.read_zigzag(&r); rq:=nc.read_u8(&r)
+  if !r.ok || x<i64(min(i32)) || x>i64(max(i32)) || y<i64(min(i32)) || y>i64(max(i32)) { return {},false }
+  in_.blasts[i]={seq=seq,x=i32(x),y=i32(y),radius_q=rq}
+ }
+ if !r.ok || nc.reader_remaining(&r)!=0 { return {},false }
+ return in_,true
+}
+
+seq16_newer :: proc(a,b: u16) -> bool { d:=a-b; return d!=0 && d<32768 }
+
+event_encode_explosion :: proc(w: ^nc.Writer,tick: u64,position: Vec2,radius: f32) {
+ nc.write_u8(w,NET_MSG_EVENT); nc.write_u8(w,NET_EVENT_EXPLOSION); nc.write_varint(w,tick)
+ nc.write_f32(w,position.x); nc.write_f32(w,position.y); nc.write_f32(w,radius)
+}
+
+event_encode_rejected :: proc(w: ^nc.Writer,tick: u64,seq: u16) {
+ nc.write_u8(w,NET_MSG_EVENT); nc.write_u8(w,NET_EVENT_BLAST_REJECTED); nc.write_varint(w,tick); nc.write_u16(w,seq)
+}
+
+Net_Event :: struct { kind: u8, tick: u64, position: Vec2, radius: f32, seq: u16 }
+
+event_decode :: proc(data: []u8) -> (e: Net_Event,ok: bool) {
+ r:nc.Reader; nc.reader_init(&r,data)
+ if nc.read_u8(&r)!=NET_MSG_EVENT { return {},false }
+ e.kind=nc.read_u8(&r); e.tick=nc.read_varint(&r)
+ switch e.kind {
+ case NET_EVENT_EXPLOSION: e.position={nc.read_f32(&r),nc.read_f32(&r)}; e.radius=nc.read_f32(&r)
+ case NET_EVENT_BLAST_REJECTED: e.seq=nc.read_u16(&r)
+ case: return {},false
+ }
+ if !r.ok || nc.reader_remaining(&r)!=0 { return {},false }
+ return e,true
+}
+
+sorted_keys :: proc(m: ^map[u64]$V,out: ^[dynamic]u64) {
+ clear(out)
+ for key in m^ { append(out,key) }
+ slice.sort(out[:])
+}
