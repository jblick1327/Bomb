+++ b/scripts/generate-client-abi.py
@@ -0,0 +1,29 @@
+"""Generate the native/C/.NET layouts from the single versioned ABI schema."""
+import json,pathlib
+r=pathlib.Path(__file__).resolve().parent.parent
+schema=json.loads((r/'bindings/bom-abi.json').read_text())
+scalar={'u32':('unsigned int','uint'),'u64':('unsigned long long','ulong'),'f32':('float','float'),'f64':('double','double'),'u8':('unsigned char','byte')}
+def odin(t):return '^'+t[1:] if t.startswith('*') else '[^]'+t[2:] if t.startswith('[]') else t
+def c(t):return c(t[1:])+'*' if t.startswith('*') else c(t[2:])+'*' if t.startswith('[]') else scalar.get(t,(t,t))[0]
+def cs(t):return 'ref '+cs(t[1:]) if t.startswith('*') else 'IntPtr' if t.startswith('[]') else scalar.get(t,(t,t))[1]
+native=['// Generated by scripts/generate-client-abi.py; edit bindings/bom-abi.json.','package ffi','']
+header=['/* Generated: Windows x64, natural alignment. */','#ifndef BOM_CLIENT_ABI_H','#define BOM_CLIENT_ABI_H']
+managed=['// Generated from bom-abi.json. No network codec exists in managed code.','using System;','using System.Runtime.InteropServices;','namespace Bom.Native {']
+for name,fields in schema['structs'].items():
+ native+= [name+' :: struct {']+[' '+n+': '+odin(t)+',' for n,t in fields]+['}','']
+ header+=['typedef struct '+name+' {']+[' '+c(t)+' '+n+';' for n,t in fields]+['} '+name+';']
+ managed+=['[StructLayout(LayoutKind.Sequential)] public struct '+name+' {']+[' public '+cs(t)+' '+n+';' for n,t in fields]+['}']
+native+=['@(export)','bom_debug_layout :: proc "c" (type_id,field_id: u32) -> u32 {',' switch type_id {']
+for i,(name,fields) in enumerate(schema['structs'].items()):
+ native+=[' case '+str(i)+':','  switch field_id {','  case 0: return u32(size_of('+name+'))','  case 1: return u32(align_of('+name+'))']+['  case '+str(j+2)+': return u32(offset_of('+name+','+n+'))' for j,(n,_) in enumerate(fields)]+['  }']
+native+=[' }',' return 0xffffffff','}']
+managed+=['public static class BomNative {',' public const uint AbiVersion = 1;']
+for name,(ret,args) in schema['functions'].items():
+ header+=['__declspec(dllimport) '+c(ret)+' __cdecl '+name+'('+(', '.join(c(t)+' '+n for n,t in args) or 'void')+');']
+ managed+=[' [DllImport("bomcore", CallingConvention=CallingConvention.Cdecl)] public static extern '+cs(ret)+' '+name+'('+', '.join(cs(t)+' '+n for n,t in args)+');']
+managed+=['}','}'];header+=['#endif']
+(r/'src/ffi').mkdir(exist_ok=True)
+(r/'src/ffi/abi.odin').write_text('\n'.join(native)+'\n',encoding='utf-8')
+(r/'bindings/bom_client.h').write_text('\n'.join(header)+'\n',encoding='utf-8')
+(r/'bindings/BomNative.cs').write_text('\n'.join(managed)+'\n',encoding='utf-8')
+print('Generated ABI: '+str(len(schema['structs']))+' layouts, '+str(len(schema['functions']))+' exports.')
