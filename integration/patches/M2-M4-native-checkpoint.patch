+}
+
+@(test)
+received_truth_does_not_advance_presented_topology :: proc(t:^testing.T) {
+ c:core.Net_Client;core.net_client_init(&c,1234,0);defer core.net_client_destroy(&c)
+ core.net_client_on_structure(&c,empty_baseline(100,10))
