diff --git a/src/shared/sim_shape_build.odin b/src/shared/sim_shape_build.odin
new file mode 100644
index 0000000..9b6a5ac
--- /dev/null
+++ b/src/shared/sim_shape_build.odin
@@ -0,0 +1,71 @@
+#+feature dynamic-literals
+package shared
+
+import math "core:math"
+
+built_object :: proc(r:Authored_Shape,first,last:u64)->Built_Object {
+ p:=shape_polygon(r);defer delete(p.points)
+ out:=Built_Object{identity=r.identity,mortar=r.mortar,lo=r.lo,hi=r.hi,first_id=first,end_id=last,count=len(p.points)}
+ copy(out.vertices[:],p.points);return out
+}
+
+build_shaped_object :: proc(s:^Scene,r:Authored_Shape,owner:u64) {
+ first:=s.next_id+1
+ frame:=r.angle*math.PI/180;local_shape:=r;local_shape.angle=0
+ outline:=shape_polygon(local_shape);defer delete(outline.points)
+ cells:[dynamic]Polygon;defer { for cell in cells { delete(cell.points) };delete(cells) }
+ if s.materials[s.pieces[s.piece_rows[owner]].material].flexibility==0 { append(&cells,make_polygon(outline.points)) } else {
+  nx:=int(math.ceil((r.hi.x-r.lo.x)/RUBBER_CELL_SIZE-0.00001));ny:=int(math.ceil((r.hi.y-r.lo.y)/RUBBER_CELL_SIZE-0.00001))
+  dx,dy:=(r.hi.x-r.lo.x)/f32(nx),(r.hi.y-r.lo.y)/f32(ny)
+  for row in 0..<ny { for col in 0..<nx {
+   box:=shape_polygon(Authored_Shape{lo={r.lo.x+f32(col)*dx,r.lo.y+f32(row)*dy},hi={r.lo.x+f32(col+1)*dx,r.lo.y+f32(row+1)*dy}})
+   clipped:=convex_intersection(box,outline);delete(box.points)
+   if len(clipped.points)>=3 && polygon_area(clipped)>1e-8 { append(&cells,clipped) } else { delete(clipped.points) }
+  } }
+  for i:=0;i<len(cells); {
+   if outline_width(cells[i].points)>=s.minimum_width && polygon_area(cells[i])>=dx*dy*0.2 { i+=1;continue }
+   best:=-1;length:=f32(0)
+   for cell,j in cells { if i==j { continue };l,_:=shared_boundary(cells[i],cell);if l>length { best=j;length=l } }
+   assert(best>=0)
+   merged:=polygon_union_touching(cells[i],cells[best]);delete(cells[best].points);cells[best]=merged;delete(cells[i].points);ordered_remove(&cells,i);i=0
+  }
+ }
+ ids:[dynamic]u64;defer delete(ids)
+ center:=vmul(vadd(r.lo,r.hi),0.5)
+ transformed:=make(map[Vec2]Vec2);defer delete(transformed)
+ for cell in cells {
+  world:=make_polygon(cell.points)
+ 
+  id:=add_subdivision(s,owner,world,Pose{position=centroid(world)});delete(world.points)
+  for other in ids { add_connection(s,other,id) };append(&ids,id)
+ }
+ if s.materials[s.pieces[s.piece_rows[owner]].material].flexibility==0 { presplit_piece(s,owner) }
+ if frame!=0 {
+  // The authored rotation is part of construction, before these ids are published.
+  for &p in s.pieces { if p.id>=owner && p.has_ref_rest { p.ref_rest=vadd(center,vrotate(vsub(p.ref_rest,center),frame)) } }
+  for &sub in s.subdivisions { if sub.id<first { continue }
+   for &v in sub.outline.points { p,ok:=transformed[v];if !ok { p=vadd(center,vrotate(vsub(v,center),frame));transformed[v]=p };v=p }
+   sub.rest_center=vadd(center,vrotate(vsub(sub.rest_center,center),frame));sub.pose.position=sub.rest_center;sub.frame=frame
+  }
+  for &c in s.connections { if c.a<first || c.b<first { continue };c.rest_point=vadd(center,vrotate(vsub(c.rest_point,center),frame))
+   c.local_a=vsub(c.rest_point,s.subdivisions[s.sub_rows[c.a]].rest_center);c.local_b=vsub(c.rest_point,s.subdivisions[s.sub_rows[c.b]].rest_center)
+   for &segment in c.rest_segments { segment.a=vadd(center,vrotate(vsub(segment.a,center),frame));segment.b=vadd(center,vrotate(vsub(segment.b,center),frame)) }
+  }
+ }
+}
+
+polygon_union_touching :: proc(a,b:Polygon)->Polygon {
+ aa,bb:=make_polygon(a.points),make_polygon(b.points);defer delete(aa.points);defer delete(bb.points)
+ for p in a.points { insert_boundary_endpoint(&bb,p) };for p in b.points { insert_boundary_endpoint(&aa,p) }
+ edges:[dynamic]Segment;defer delete(edges)
+ polys:=[2]Polygon{aa,bb}
+ for poly in polys { for p,i in poly.points {
+  q:=poly.points[(i+1)%len(poly.points)];shared:=false
+  for other in polys { if raw_data(other.points)==raw_data(poly.points) { continue };for v,j in other.points { w:=other.points[(j+1)%len(other.points)];if vlen(vsub(p,w))<1e-5 && vlen(vsub(q,v))<1e-5 { shared=true } } }
+  if !shared { append(&edges,Segment{p,q}) }
+ } }
+ points:[dynamic]Vec2;defer delete(points)
+ if len(edges)==0 { return {} };current:=edges[0].a
+ for len(edges)>0 { found:=-1;for edge,i in edges { if vlen(vsub(current,edge.a))<1e-5 { found=i;break } };assert(found>=0);append(&points,current);current=edges[found].b;ordered_remove(&edges,found) }
+ return make_polygon(points[:])
+}
diff --git a/src/shared/sim_shape_geometry.odin b/src/shared/sim_shape_geometry.odin
new file mode 100644
index 0000000..cc80ce5
--- /dev/null
+++ b/src/shared/sim_shape_geometry.odin
@@ -0,0 +1,78 @@
+#+feature dynamic-literals
+package shared
+
+import math "core:math"
+
+shape_polygon :: proc(r:Authored_Shape)->Polygon {
+ points:=[4]Vec2{r.lo,{r.hi.x,r.lo.y},r.hi,{r.lo.x,r.hi.y}}
+ count:=4
+ if r.shape==.Wedge { points[2]=points[3];count=3 }
+ result:=make_polygon(points[:count])
+ if r.angle!=0 { center:=vmul(vadd(r.lo,r.hi),0.5); for &p in result.points { p=vadd(center,vrotate(vsub(p,center),r.angle*math.PI/180)) } }
+ return result
+}
+
+boundary_nearest :: proc(poly:Polygon,p:Vec2)->Vec2 {
+ best:=Vec2{};distance:=f32(1e30)
+ for a,i in poly.points { b:=poly.points[(i+1)%len(poly.points)];d:=vsub(b,a);dd:=vdot(d,d);if dd==0 { continue }
+  q:=vadd(a,vmul(d,clamp(vdot(vsub(p,a),d)/dd,0,1)));dist:=vlen(vsub(p,q));if dist<distance { best=q;distance=dist }
+ };return best
+}
+
+polygon_contact :: proc(a,b:Polygon)->(distance:f32,translation:Vec2) {
+ distance=1e30
+ for p in a.points { q:=boundary_nearest(b,p);d:=vsub(q,p);if vlen(d)<distance { distance=vlen(d);translation=d } }
+ for q in b.points { p:=boundary_nearest(a,q);d:=vsub(q,p);if vlen(d)<distance { distance=vlen(d);translation=d } }
+ return
+}
+
+convex_contains :: proc(poly:Polygon,p:Vec2)->bool {
+ for a,i in poly.points { b:=poly.points[(i+1)%len(poly.points)];if vcross(vsub(b,a),vsub(p,a))< -1e-6 { return false } };return true
+}
+
+convex_intersection :: proc(a,b:Polygon)->Polygon {
+ result:=make_polygon(a.points)
+ for q,i in b.points {
+  edge:=vsub(b.points[(i+1)%len(b.points)],q);points:[dynamic]Vec2
+  for p,j in result.points { next:=result.points[(j+1)%len(result.points)];u,v:=vcross(edge,vsub(p,q)),vcross(edge,vsub(next,q))
+   if u>=0 { append(&points,p) };if (u>=0)!=(v>=0) { append(&points,vadd(p,vmul(vsub(next,p),u/(u-v)))) }
+  }
+  delete(result.points);result=make_polygon(points[:]);delete(points)
+ };return result
+}
+
+shape_overlap :: proc(a,b:Authored_Shape)->bool {
+ pa,pb:=shape_polygon(a),shape_polygon(b);defer delete(pa.points);defer delete(pb.points)
+ for source in ([2]Polygon{pa,pb}) { for v,i in source.points {
+  edge:=vsub(source.points[(i+1)%len(source.points)],v);axis:=Vec2{-edge.y,edge.x}
+  alo,ahi,blo,bhi:=f32(1e30),f32(-1e30),f32(1e30),f32(-1e30)
+  for point in pa.points { d:=vdot(point,axis);alo=min(alo,d);ahi=max(ahi,d) }
+  for point in pb.points { d:=vdot(point,axis);blo=min(blo,d);bhi=max(bhi,d) }
+  if ahi<=blo || bhi<=alo { return false }
+ } }
+ p:=convex_intersection(pa,pb);defer delete(p.points);return polygon_area(p)>1e-6
+}
+
+frame_polygon :: proc(p:Polygon,frame:f32)->Polygon {
+ out:=make_polygon(p.points);if frame!=0 { for &v in out.points { v=frame_unrotate(v,frame) } };return out
+}
+
+frame_longest :: proc(p:Polygon,frame:f32)->f32 {
+ if frame==0 { return longest_dimension(p) };local:=frame_polygon(p,frame);defer delete(local.points);return longest_dimension(local)
+}
+
+generate_framed :: proc(parent:Polygon,recipe:Material,seed:u8,minimum_width:f32,creation:bool,frame:f32)->[dynamic]Polygon {
+ if frame==0 { return generate_children(parent,recipe,seed,minimum_width,creation) }
+ local:=frame_polygon(parent,frame);defer delete(local.points)
+ children:=generate_children(local,recipe,seed,minimum_width,creation)
+ // Cache by exact local vertex bits: siblings transform a new cut only once.
+ restored:=make(map[Vec2]Vec2);defer delete(restored)
+ for v,i in local.points { restored[v]=parent.points[i] }
+ for &child in children { for &v in child.points { world,ok:=restored[v];if !ok { world=vrotate(v,frame);restored[v]=world };v=world } }
+ return children
+}
+
+frame_unrotate :: proc(v:Vec2,frame:f32)->Vec2 {
+ c,s:=f64(f32(math.cos(frame))),f64(f32(math.sin(frame)));det:=c*c+s*s
+ return {f32((f64(v.x)*c+f64(v.y)*s)/det),f32((-f64(v.x)*s+f64(v.y)*c)/det)}
+}
diff --git a/src/shared/sim_wood_generation.odin b/src/shared/sim_wood_generation.odin
new file mode 100644
index 0000000..3bca35b
--- /dev/null
+++ b/src/shared/sim_wood_generation.odin
@@ -0,0 +1,156 @@
+#+feature dynamic-literals
+package shared
+
+import math "core:math"
+
+WOOD_MINIMUM_WIDTH :: f32(0.1)
+
+STRIP_MIN :: 2*WOOD_MINIMUM_WIDTH
+
+WOOD_CELL_MAX :: f32(2)
+
+WOOD_SPLINTER_RATIO :: f32(4)
+
+grain_bounds :: proc(p: Polygon) -> (lo,hi: Vec2,axis: int,length,thickness: f32) {
+ lo,hi={1e30,1e30},{-1e30,-1e30}
+ for v in p.points { lo={min(lo.x,v.x),min(lo.y,v.y)}; hi={max(hi.x,v.x),max(hi.y,v.y)} }
+ width,height:=hi.x-lo.x,hi.y-lo.y
+ if width>=height { return lo,hi,0,width,height }; return lo,hi,1,height,width
+}
+
+grain_cut_kind :: proc(p: Polygon,minimum_width: f32,creation: bool,strip: f32) -> (needed,cross_cut: bool) {
+ _,_,_,length,thickness:=grain_bounds(p)
+ if creation {
+  if thickness>strip+0.00001 { return true,false }
+  return length>WOOD_CELL_MAX+0.00001,true
+ }
+ if thickness>=2*minimum_width { return true,false }
+ return length>=2*WOOD_SPLINTER_RATIO*thickness,true
+}
+
+clip_halfplane :: proc(p: Polygon,a,b: Vec2,keep_low: bool) -> Polygon {
+ points:[dynamic]Vec2; defer delete(points)
+ for v,i in p.points {
+  w:=p.points[(i+1)%len(p.points)]
+  side_v,side_w:=polygon_turn(a,b,v),polygon_turn(a,b,w)
+  if !keep_low { side_v=-side_v; side_w=-side_w }
+  inside_v,inside_w:=side_v<=0,side_w<=0
+  if inside_v { append(&points,v) }
+  if inside_v!=inside_w {
+   fraction:=side_v/(side_v-side_w)
+   point:=Vec2{f32(f64(v.x)+(f64(w.x)-f64(v.x))*fraction),f32(f64(v.y)+(f64(w.y)-f64(v.y))*fraction)}
+   append(&points,point)
+  }
+ }
+ return make_polygon(points[:])
+}
+
+generate_grained_children :: proc(parent: Polygon,recipe: Material,seed: u8,minimum_width: f32,creation: bool) -> [dynamic]Polygon {
+ if seed==0 || !valid_partition_half(parent,minimum_width) { return nil }
+ result:[dynamic]Polygon; append(&result,make_polygon(parent.points))
+ blocked:=make(map[int]bool); defer delete(blocked)
+ for len(result)<recipe.generation_count {
+  chosen:=-1; largest:=f32(0)
+  for p,i in result {
+   needed,_:=grain_cut_kind(p,minimum_width,creation,recipe.strip_thickness)
+   area:=polygon_area(p)
+   if needed && !blocked[i] && area>largest { chosen=i; largest=area }
+  }
+  if chosen<0 { break }
+  p:=result[chosen]; lo,hi,axis,length,thickness:=grain_bounds(p)
+  _,cross_cut:=grain_cut_kind(p,minimum_width,creation,recipe.strip_thickness)
+  fraction:=f32(0.4)+0.2*f32(derive_seed(seed,u64(len(result))))/255
+  low,high:Polygon
+  if !cross_cut {
+   low_fraction,high_fraction:=max(f32(0.4),minimum_width/thickness),min(f32(0.6),1-minimum_width/thickness)
+   if low_fraction>high_fraction { blocked[chosen]=true; continue }
+   fraction=clamp(fraction,low_fraction,high_fraction)
+   cut_axis:=1-axis; cut:=lo.y+(hi.y-lo.y)*fraction
+   if cut_axis==0 { cut=lo.x+(hi.x-lo.x)*fraction }
+   low,high=clip_polygon(p,cut_axis,cut,true),clip_polygon(p,cut_axis,cut,false)
+  } else {
+   slant:=f32(0.75)*thickness
+   if derive_seed(seed,u64(len(result))+0x1000)%2==0 { slant=-slant }
+   a,b:=Vec2{lo.x+length*fraction-slant,lo.y},Vec2{lo.x+length*fraction+slant,hi.y}
+   if axis==1 { a,b={lo.x,lo.y+length*fraction-slant},{hi.x,lo.y+length*fraction+slant} }
+   low,high=clip_halfplane(p,a,b,true),clip_halfplane(p,a,b,false)
+  }
+  valid:=valid_partition_half(low,minimum_width) && valid_partition_half(high,minimum_width)
+  valid=valid && math.abs(polygon_area(low)+polygon_area(high)-polygon_area(p))<=max(f32(0.0000002),polygon_area(p)*0.00002)
+  if valid { delete(p.points); result[chosen]=low; append(&result,high) }
+  else { delete(low.points); delete(high.points); blocked[chosen]=true }
+ }
+ displace_shared_boundaries(result[:],seed,minimum_width,true)
+ area:=f32(0); parent_area:=polygon_area(parent); genuine:=len(result)>=2
+ for p in result { area+=polygon_area(p); genuine=genuine && valid_partition_half(p,minimum_width) && polygon_area(p)<parent_area }
+ if !genuine || math.abs(area-parent_area)>max(f32(0.000002),parent_area*0.0002) {
+  for p in result { delete(p.points) }; delete(result); return nil
+ }
+ return result
+}
+
+insert_shared_path :: proc(p: ^Polygon,segment: Segment,path: []Vec2) {
+ insert_boundary_endpoint(p,segment.a); insert_boundary_endpoint(p,segment.b)
+ for a,i in p.points {
+  b:=p.points[(i+1)%len(p.points)]
+  forward:=vlen(vsub(a,segment.a))<0.00001 && vlen(vsub(b,segment.b))<0.00001
+  reverse:=vlen(vsub(b,segment.a))<0.00001 && vlen(vsub(a,segment.b))<0.00001
+  if !forward && !reverse { continue }
+  for k in 0..<len(path) { j:=k; if reverse { j=len(path)-1-k }; insert_polygon_vertex(p,i+1+k,path[j]) }
+  return
+ }
+}
+
+displace_grained_seam :: proc(children: []Polygon,boundary: Cut_Boundary,seed: u8,index: int,minimum_width: f32) -> bool {
+ edge:=vsub(boundary.segment.b,boundary.segment.a); length:=vlen(edge)
+ _,_,axis,_,_:=grain_bounds(children[boundary.a])
+ parallel,across:=math.abs(edge.x),math.abs(edge.y); if axis==1 { parallel,across=across,parallel }
+ if across>parallel*0.25 { return false }
+ normal:=Vec2{-edge.y/length,edge.x/length}
+ amplitude:=min(f32(0.03),min(length*0.04,min(polygon_area(children[boundary.a]),polygon_area(children[boundary.b]))/length*0.08))
+ n:=max(2,int(math.ceil(length/0.25)))
+ bases:[dynamic]Vec2; defer delete(bases)
+ for k in 1..<n { append(&bases,vadd(boundary.segment.a,vmul(edge,f32(k)/f32(n)))) }
+ neighbours:=[2]int{boundary.a,boundary.b}
+ for base in bases { for row in neighbours { for a,i in children[row].points {
+  b:=children[row].points[(i+1)%len(children[row].points)]; e:=vsub(b,a)
+  if vdot(e,e)<1e-12 { continue }
+  if _,shared:=segment_overlap(Segment{a,b},boundary.segment); shared { continue }
+  t:=clamp(vdot(vsub(base,a),e)/vdot(e,e),f32(0),f32(1))
+  amplitude=min(amplitude,vlen(vsub(base,vadd(a,vmul(e,t))))*0.2)
+ } } }
+ if derive_seed(seed,u64(index+1))%2==0 { amplitude=-amplitude }
+ path:=make([]Vec2,len(bases)); defer delete(path)
+ for attempt in 0..<4 {
+  for base,k in bases {
+   jitter:=f32(0.6)+0.4*f32(derive_seed(seed,u64(index+1)*0x10000+u64(k+1)))/255
+   sign:=f32(1); if k%2==1 { sign=-1 }
+   path[k]=vadd(base,vmul(normal,amplitude*sign*jitter))
+  }
+  left,right:=make_polygon(children[boundary.a].points),make_polygon(children[boundary.b].points)
+  insert_shared_path(&left,boundary.segment,path); insert_shared_path(&right,boundary.segment,path)
+  valid:=simple_polygon(left) && simple_polygon(right) && outline_width(left.points)>=minimum_width && outline_width(right.points)>=minimum_width
+  if valid {
+   delete(children[boundary.a].points); delete(children[boundary.b].points); children[boundary.a]=left; children[boundary.b]=right; break
+  }
+  delete(left.points); delete(right.points); amplitude*=0.5
+ }
+ return true
+}
+
+connection_blast_sample :: proc(s: ^Scene,c: Connection,blast_position: Vec2) -> Vec2 {
+ a,b:=s.subdivisions[s.sub_rows[c.a]],s.subdivisions[s.sub_rows[c.b]]
+ if s.materials[a.material].aspect_ratio>=1 || s.materials[b.material].aspect_ratio>=1 { return connection_sample(s,c) }
+ closest:=connection_sample(s,c); distance:=f32(1e30)
+ for segment in c.rest_segments {
+  // Pose each shared endpoint exactly as the old midpoint sample: average
+  // the two cells' transforms (a single rigid frame for ordinary Wood).
+  p:=vmul(vadd(posed_point(a,segment.a),posed_point(b,segment.a)),0.5)
+  q:=vmul(vadd(posed_point(a,segment.b),posed_point(b,segment.b)),0.5)
+  edge:=vsub(q,p); squared:=vdot(edge,edge); if squared<=0 { continue }
+  t:=clamp(vdot(vsub(blast_position,p),edge)/squared,f32(0),f32(1))
+  point:=vadd(p,vmul(edge,t)); d:=vdot(vsub(blast_position,point),vsub(blast_position,point))
+  if d<distance { distance=d; closest=point }
+ }
+ return closest
+}
diff --git a/src/shared/sim_world_state.odin b/src/shared/sim_world_state.odin
