+package shared
+import t "core:testing"
+import math "core:math"
+import b2 "vendor:box2d"
+import nc "../netcode"
+
+@(test)
+unity_level_build_has_exact_provenance_area_explicit_spawns_and_no_implicit_floor :: proc(test:^t.T) {
+ layout,seed,ok,reason:=decode_layout(transmute([]u8)string(LEVEL_V4_TEST));t.expect(test,ok,reason);if !ok { return };defer destroy_layout(&layout)
+ w:=World{settings=DEFAULT_SANDBOX_SETTINGS};w.settings.seed=seed;defer scene_destroy(&w.scene);defer delete(w.bombs)
+ world_rebuild_layout(&w,&layout,false)
+ t.expect(test,w.scene.level_policy.active&&w.floor==b2.nullBodyId&&w.scene.anchor_y== -1e30)
+ area:f32;for sub in w.scene.subdivisions {
+  t.expect(test,sub.provenance.source_identity==9007199254741001&&sub.provenance.source_part_id==9007199254742001&&sub.provenance.motion==.Anchored&&sub.provenance.damage==.Indestructible)
+  area+=polygon_area(sub.outline)
+ };t.expect(test,math.abs(area-5)<.00001)
+ t.expect(test,w.players[0].pose.position==Vec2{-4,1});t.expect(test,world_add_player(&w,1)&&w.players[1].pose.position==Vec2{4,1})
+ before:=w.players[0].pose.position.y
+ for tick in 0..<20 { events:=world_tick(&w,Tick_Commands{},1.0/60);delete(events.explosions) }
+ t.expect(test,w.players[0].pose.position.y<before-.1,"empty space at a negative X must not acquire legacy ground")
+ // A complete reliable baseline carries matching metadata and every cell key.
+ server:Repl_Server;defer repl_server_destroy(&server)
+ baseline:=repl_server_baseline(&server,&w.scene,20);defer repl_output_destroy(&baseline)
+ rep:Replica;replica_init(&rep);defer replica_destroy(&rep)
+ for part in baseline.parts { _,problem:=replica_receive(&rep,part);t.expect_value(test,problem,"") }
+ t.expect(test,rep.has_baseline&&rep.scene.level_json==w.scene.level_json&&rep.scene.level_policy.spawns[1]==Vec2{4,1})
+ original:=canonical_encode(&w.scene);copy:=canonical_encode(&rep.scene);defer delete(original);defer delete(copy)
+ t.expect(test,repl_hash(original)==repl_hash(copy))
+ for sub in rep.scene.subdivisions { t.expect(test,sub.provenance.source_identity==9007199254741001&&sub.provenance.source_part_id==9007199254742001) }
+ world_rebuild_layout(&w,&layout,false);t.expect(test,w.scene.epoch==2&&w.players[0].pose.position==Vec2{-4,1})
+}
+@(test)
+catalog_hash_and_source_policy_corruption_fail_before_presentation :: proc(test:^t.T) {
+ s,_,_,_:=test_policy_scene(.Fixed,.Indestructible);defer scene_destroy(&s)
+ w:nc.Writer;nc.writer_init(&w);defer nc.writer_destroy(&w);repl_write_catalog(&w,&s)
+ w.data[0]~=1
+ destination:=new_scene(0);defer scene_destroy(&destination)
+ r:nc.Reader;nc.reader_init(&r,w.data[:]);t.expect(test,repl_read_catalog(&r,&destination)!="")
+ _,valid:=cell_policy_decode(9007199254741001,9007199254742001,0xffffffff);t.expect(test,!valid)
+ _,valid=cell_policy_decode(1,1,u32(Motion_Policy.Fixed));t.expect(test,!valid,"fixed without pin must fail validation")
+}
diff --git a/src/shared/level_catalog.odin b/src/shared/level_catalog.odin
new file mode 100644
index 0000000..247f5ae
--- /dev/null
+++ b/src/shared/level_catalog.odin
@@ -0,0 +1,69 @@
+package shared
+import nc "../netcode"
+import sha2 "core:crypto/sha2"
+import strings "core:strings"
+
+level_catalog_parts_match :: proc(s:^Scene,level:^Level_Layout) -> bool {
+ count:=0;for source in level.sources { for part in source.parts {
+  count+=1;matched:=false
+  for record in s.source_parts {
+   if record.source_identity!=source.identity||record.source_part_id!=part.part_id { continue }
+   if len(record.segments)!=len(part.anchors) { return false }
+   for segment,i in record.segments { if segment!=part.anchors[i] { return false } };matched=true;break
+  };if !matched { return false }
+ } };return count==len(s.source_parts)
+}
+scene_restore_catalog_data :: proc(s:^Scene,text:string,parts:[]Source_Part_Anchors) -> bool {
+ if len(parts)>1024||len(text)>NET_APP_MAX_LAYOUT { return false }
+ seen:=make(map[Level_Part_Key]bool);defer delete(seen)
+ for part in parts {
+  key:=Level_Part_Key{part.source_identity,part.source_part_id}
+  if seen[key]||key.source_identity==0||key.part_id==0||len(part.segments)>128 { return false };seen[key]=true
+  for segment in part.segments { if !valid_vec(segment.a)||!valid_vec(segment.b)||vlen(vsub(segment.b,segment.a))<.001 { return false } }
+  copy:=Source_Part_Anchors{source_identity=part.source_identity,source_part_id=part.source_part_id};append(&copy.segments,..part.segments[:]);append(&s.source_parts,copy)
+ }
+ if text!="" {
+  level,ok,_:=decode_level_layout(transmute([]u8)text);if !ok { return false };defer destroy_level_layout(&level)
+  if !level_catalog_parts_match(s,&level) { return false };s.level_policy=level_resolve_policy(&level);s.gameplay_manifest=level_gameplay_hash(&level);s.config_hash=gameplay_config_hash(level.gameplay_config)
+  s.catalog=new(Level_Layout);s.catalog^=level;level={}
+ };s.level_json=strings.clone(text);return true
+}
+
+level_sha256 :: proc(data:[]u8) -> [32]u8 { ctx:sha2.Context_256;sha2.init_256(&ctx);sha2.update(&ctx,data);out:[32]u8;sha2.final(&ctx,out[:]);return out }
+repl_write_catalog :: proc(w:^nc.Writer,s:^Scene) {
+ hash:=level_sha256(transmute([]u8)s.level_json);nc.write_raw(w,hash[:]);nc.write_string(w,s.level_json)
+ nc.write_varint(w,u64(len(s.source_parts)))
+ for part in s.source_parts {
+  nc.write_u64(w,part.source_identity);nc.write_u64(w,part.source_part_id);nc.write_varint(w,u64(len(part.segments)))
+  for segment in part.segments { nc.write_f32(w,segment.a.x);nc.write_f32(w,segment.a.y);nc.write_f32(w,segment.b.x);nc.write_f32(w,segment.b.y) }
+ }
+}
+repl_read_catalog :: proc(r:^nc.Reader,s:^Scene) -> string {
+ expected:[32]u8;for &byte in expected { byte=nc.read_u8(r) }
+ text:=nc.read_string(r)
+ if !r.ok||len(text)>NET_APP_MAX_LAYOUT||level_sha256(transmute([]u8)text)!=expected { return "invalid catalog size/hash" }
+ level:Level_Layout;defer destroy_level_layout(&level)
+ if len(text)>0 {
+  decoded,ok,reason:=decode_level_layout(transmute([]u8)text);if !ok { return reason };level=decoded
+  s.level_policy=level_resolve_policy(&level)
+  s.gameplay_manifest=level_gameplay_hash(&level);s.config_hash=gameplay_config_hash(level.gameplay_config)
+ }
+ s.level_json=strings.clone(text)
+ count:=nc.read_varint(r);if !r.ok||count>1024 { return "too many source part bindings" }
+ seen:=make(map[Level_Part_Key]bool);defer delete(seen)
+ for _ in 0..<count {
+  part:=Source_Part_Anchors{source_identity=nc.read_u64(r),source_part_id=nc.read_u64(r)}
+  key:=Level_Part_Key{part.source_identity,part.source_part_id}
+  n:=nc.read_varint(r);if !r.ok||n>128||n>u64(nc.reader_remaining(r))/16||key.source_identity==0||key.part_id==0||seen[key] { return "invalid source part anchors" };seen[key]=true
+  for _ in 0..<n {
+   segment:=Segment{{nc.read_f32(r),nc.read_f32(r)},{nc.read_f32(r),nc.read_f32(r)}}
+   if !valid_vec(segment.a)||!valid_vec(segment.b)||vlen(vsub(segment.b,segment.a))<.001 { delete(part.segments);return "invalid source anchor geometry" }
+   append(&part.segments,segment)
+  };append(&s.source_parts,part)
+ }
+ if !r.ok { return "truncated catalog" }
+ if len(text)>0 {
+  if !level_catalog_parts_match(s,&level) { return "catalog/source-part metadata mismatch" }
+  s.catalog=new(Level_Layout);s.catalog^=level;level={}
+ };return ""
+}
diff --git a/src/shared/level_layout.odin b/src/shared/level_layout.odin
new file mode 100644
index 0000000..26fdd36
--- /dev/null
+++ b/src/shared/level_layout.odin
@@ -0,0 +1,183 @@
+package shared
+
+import json "core:encoding/json"
+import mem "core:mem"
+import math "core:math"
+import fmt "core:fmt"
+
+// Version 4 authoring data is separate from legacy editor rectangles. The
+// application loader will opt into it only with the coordinated wire change.
+SOURCE_RESERVED_START :: u64(0xffffffffffffff00)
+LEVEL_CONSTRUCTION_WORK_LIMIT :: 500000 // Conservative authoring work estimate, not a cell/upload cap.
+Level_Bounds :: struct { lo,hi:Vec2 }
+Level_Bomb_Settings :: struct { spawn_x:Vec2, spawn_height:f32, cleanup_bounds:Level_Bounds }
+Level_Part :: struct { part_id:u64, material:string, outline:[dynamic]Vec2, anchors:[dynamic]Segment }
+Level_Source :: struct {
+ identity:u64,
+ asset_key,visual_hash,cap_key:string,
+ group_to_rest:[16]f32,
+ depth:Vec2,
+ motion,damage:string,
+ parts:[dynamic]Level_Part,
+}
+Level_Part_Key :: struct { source_identity,part_id:u64 }
+Level_Glue :: struct { a,b:Level_Part_Key }
+Level_Allowed_Overlap :: struct {a,b:Level_Part_Key,reason:string}
+Level_Layout :: struct {
+ kind:string, version:int, seed:u64, next_identity:u64,
+ level_id,gameplay_config_id,catalog_id:string,
+ gameplay_config:Gameplay_Config,
+ simulation_bounds,kill_bounds,camera_bounds,aim_bounds,fragment_cull_bounds:Level_Bounds,
+ spawns:[dynamic]Vec2,
+ bombs:Level_Bomb_Settings,
+ materials:[dynamic]Wire_Custom_Material,
+ sources:[dynamic]Level_Source,
+ glue:[dynamic]Level_Glue,
+ allowed_overlaps:[dynamic]Level_Allowed_Overlap,
+}
+destroy_level_layout :: proc(level:^Level_Layout) {
+ delete(level.kind);delete(level.level_id);delete(level.gameplay_config_id);delete(level.catalog_id)
+ delete(level.spawns);delete(level.glue)
+ for overlap in level.allowed_overlaps {delete(overlap.reason)};delete(level.allowed_overlaps)
+ for m in level.materials { delete(m.name);delete(m.base) };delete(level.materials)
+ for source in level.sources {
+  delete(source.asset_key);delete(source.visual_hash);delete(source.cap_key);delete(source.motion);delete(source.damage)
+  for part in source.parts { delete(part.material);delete(part.outline);delete(part.anchors) };delete(source.parts)
+ };delete(level.sources);level^={}
+}
+level_bounds_valid :: proc(bounds:Level_Bounds) -> bool {
+ return valid_vec(bounds.lo)&&valid_vec(bounds.hi)&&bounds.hi.x-bounds.lo.x>=.01&&bounds.hi.y-bounds.lo.y>=.01&&
+  math.abs(bounds.lo.x)<=10000&&math.abs(bounds.lo.y)<=10000&&math.abs(bounds.hi.x)<=10000&&math.abs(bounds.hi.y)<=10000
+}
+level_bounds_contains :: proc(bounds:Level_Bounds,p:Vec2) -> bool { return valid_vec(p)&&p.x>=bounds.lo.x&&p.x<=bounds.hi.x&&p.y>=bounds.lo.y&&p.y<=bounds.hi.y }
+level_matrix_valid :: proc(m:[16]f32) -> bool {
+ for v in m { if !finite(v) { return false } }
+ if math.abs(m[3])>1e-6||math.abs(m[7])>1e-6||math.abs(m[11])>1e-6||math.abs(m[15]-1)>1e-6 { return false }
+ determinant:=f64(m[0])*(f64(m[5])*f64(m[10])-f64(m[9])*f64(m[6]))-
+  f64(m[4])*(f64(m[1])*f64(m[10])-f64(m[9])*f64(m[2]))+f64(m[8])*(f64(m[1])*f64(m[6])-f64(m[5])*f64(m[2]))
+ return math.abs(determinant)>=1e-8
+}
+level_matrix_point :: proc(m:[16]f32,p:[3]f32) -> [3]f32 {
+ return {m[0]*p[0]+m[4]*p[1]+m[8]*p[2]+m[12],m[1]*p[0]+m[5]*p[1]+m[9]*p[2]+m[13],m[2]*p[0]+m[6]*p[1]+m[10]*p[2]+m[14]}
+}
+level_polygon_problem :: proc(points:[]Vec2,bounds:Level_Bounds) -> string {
+ if len(points)<3||len(points)>128 { return "Part outlines require 3..128 vertices" }
+ signed:f64
+ for p,i in points {
+  if !level_bounds_contains(bounds,p) { return "Proxy vertex outside simulation bounds" }
+  q:=points[(i+1)%len(points)]
+  if vlen(vsub(p,q))<.001 { return "Proxy edges must be at least 0.001 units" }
+  signed+=f64(p.x)*f64(q.y)-f64(p.y)*f64(q.x)
+ }
+ if signed<.0002 { return "Proxy outlines must be CCW with area at least 0.0001" }
+ if !simple_polygon(Polygon{points=points}) { return "Proxy outline self-intersects" }
+ return ""
+}
+level_parts_overlap :: proc(a,b:[]Vec2) -> bool {
+ alo,ahi,blo,bhi:=Vec2{1e30,1e30},Vec2{-1e30,-1e30},Vec2{1e30,1e30},Vec2{-1e30,-1e30}
+ for p in a {alo={min(alo.x,p.x),min(alo.y,p.y)};ahi={max(ahi.x,p.x),max(ahi.y,p.y)}}
+ for p in b {blo={min(blo.x,p.x),min(blo.y,p.y)};bhi={max(bhi.x,p.x),max(bhi.y,p.y)}}
+ if min(ahi.x,bhi.x)-max(alo.x,blo.x)<=1e-6||min(ahi.y,bhi.y)-max(alo.y,blo.y)<=1e-6 {return false}
+ aa:=convex_decomposition(Polygon{points=a});bb:=convex_decomposition(Polygon{points=b})
+ defer { for p in aa { delete(p.points) };delete(aa);for p in bb { delete(p.points) };delete(bb) }
+ for x in aa { for y in bb { intersection:=convex_intersection(x,y);area:=polygon_area(intersection);delete(intersection.points);if area>1e-6 { return true } } }
+ return false
+}
+level_point_segment_distance :: proc(p,a,b:Vec2) -> f32 {d:=vsub(b,a);q:=vdot(d,d);if q<=0 {return vlen(vsub(p,a))};return vlen(vsub(p,vadd(a,vmul(d,clamp(vdot(vsub(p,a),d)/q,f32(0),f32(1))))))}
+level_spawn_overlaps :: proc(spawn:Vec2,points:[]Vec2) -> bool {
+ lo,hi:=Vec2{spawn.x,spawn.y-PLAYER_SEGMENT},Vec2{spawn.x,spawn.y+PLAYER_SEGMENT}
+ inside:=proc(p:Vec2,points:[]Vec2) -> bool {hit:=false;for a,i in points {b:=points[(i+1)%len(points)];if (a.y>p.y)!=(b.y>p.y)&&p.x<(b.x-a.x)*(p.y-a.y)/(b.y-a.y)+a.x {hit=!hit}};return hit}
+ if inside(lo,points)||inside(hi,points) {return true}
+ for a,i in points {b:=points[(i+1)%len(points)];if segments_touch(lo,hi,a,b,1e-8) {return true}
+  distance:=min(level_point_segment_distance(a,lo,hi),level_point_segment_distance(b,lo,hi),level_point_segment_distance(lo,a,b),level_point_segment_distance(hi,a,b))
+  if distance<PLAYER_RADIUS-.00001 {return true}
+ };return false
+}
+level_layout_problem :: proc(level:^Level_Layout) -> string {
+ if level.kind!="bom-layout"||level.version!=4 { return "Not a version 4 bom-layout" }
+ if len(level.level_id)<1||len(level.level_id)>128||len(level.gameplay_config_id)<1||len(level.gameplay_config_id)>128||len(level.catalog_id)<1||len(level.catalog_id)>128 { return "Level/config/catalog identifiers require 1..128 bytes" }
+ if level.seed>255 { return "Seed must be between 0 and 255" }
+ if !gameplay_config_valid(level.gameplay_config) { return "Invalid versioned gameplay configuration" }
+ for bounds in ([6]Level_Bounds{level.simulation_bounds,level.kill_bounds,level.camera_bounds,level.aim_bounds,level.fragment_cull_bounds,level.bombs.cleanup_bounds}) { if !level_bounds_valid(bounds) { return "Invalid level bounds" } }
+ if len(level.spawns)!=4 { return "Exactly four explicit spawn points are required" }
+ for spawn in level.spawns { if !level_bounds_contains(level.simulation_bounds,spawn)||!level_bounds_contains(level.kill_bounds,spawn) { return "Spawn outside simulation/kill bounds" } }
+ if !valid_vec(level.bombs.spawn_x)||!finite(level.bombs.spawn_height)||level.bombs.spawn_x.y<level.bombs.spawn_x.x||level.bombs.spawn_x.x<level.simulation_bounds.lo.x||level.bombs.spawn_x.y>level.simulation_bounds.hi.x||level.bombs.spawn_height<level.simulation_bounds.lo.y||level.bombs.spawn_height>level.simulation_bounds.hi.y { return "Invalid bomb spawn limits" }
+ if len(level.sources)>512||len(level.materials)>4||len(level.glue)>1024||len(level.allowed_overlaps)>1024 { return "Level record count exceeds limits" }
+ palette:Layout;defer { for &m in palette.materials { m.name="" };destroy_layout(&palette) }
+ for m in level.materials {
+  base,known:=material_base_name(m.base);if !known { return "Unknown custom material base" }
+  if problem:=material_name_problem(&palette,m.name);problem!="" { return problem }
+  custom:=custom_from_wire(m,base);if problem:=custom_problem(custom);problem!="" { return problem }
+  // The validation palette borrows names owned by the parsed level.
+  custom.name="";append(&palette.materials,custom)
+  palette.materials[len(palette.materials)-1].name=m.name
+ }
+
+ sources:=make(map[u64]bool);defer delete(sources)
+ parts:=make(map[Level_Part_Key]bool);defer delete(parts)
+ maximum:u64;count:=0;construction_budget:=f64(0)
+ for source in level.sources {
+  if source.identity==0||source.identity>=SOURCE_RESERVED_START||sources[source.identity] { return "Source identity is zero, duplicate or reserved" };sources[source.identity]=true;maximum=max(maximum,source.identity)
+  if len(source.asset_key)<1||len(source.asset_key)>256||len(source.visual_hash)!=64||len(source.cap_key)>256 { return "Invalid visual catalog binding" }
+  for c in source.visual_hash { if !(c>='0'&&c<='9'||c>='a'&&c<='f') { return "Visual content hash must be lowercase SHA256" } }
+  if !level_matrix_valid(source.group_to_rest)||!valid_vec(source.depth)||source.depth.y-source.depth.x<.001 { return "Invalid nonsingular affine transform or depth interval" }
+  if source.motion!="dynamic"&&source.motion!="fixed"&&source.motion!="anchored" { return "Unknown motion policy" }
+  if source.damage!="destructible"&&source.damage!="indestructible" { return "Unknown damage policy" }
+  if len(source.parts)<1||len(source.parts)>64 { return "A source requires 1..64 physics parts" }
+  anchor_count:=0
+  for part,index in source.parts {
+   count+=1;if count>1024 { return "Maximum 1024 physics parts" }
+   key:=Level_Part_Key{source.identity,part.part_id};if part.part_id==0||part.part_id==max(u64)||parts[key] { return "Part identity is zero, duplicate or exhausted" };parts[key]=true
+   known:=false;for slot in 0..<palette_count(&palette) { if layout_material(&palette,Slot(slot)).name==part.material { known=true;break } };if !known { return "Unknown physics material" }
+   if problem:=level_polygon_problem(part.outline[:],level.simulation_bounds);problem!="" { return problem }
+   for spawn in level.spawns {if level_spawn_overlaps(spawn,part.outline[:]) {return "Player capsule spawn overlaps an opted-in physics proxy"}}
+   lo,hi:=Vec2{1e30,1e30},Vec2{-1e30,-1e30};for p in part.outline { lo={min(lo.x,p.x),min(lo.y,p.y)};hi={max(hi.x,p.x),max(hi.y,p.y)} }
+   construction_budget+=math.ceil(f64(hi.x-lo.x)/.1)*math.ceil(f64(hi.y-lo.y)/.1)*f64(len(part.outline)-2)
+   if construction_budget>LEVEL_CONSTRUCTION_WORK_LIMIT { return "Proxy construction work estimate exceeds 500000 grid-triangle units; split/simplify the authored level" }
+   if len(part.anchors)>128 { return "Too many anchor segments" }
+   for anchor in part.anchors {
+    if !valid_vec(anchor.a)||!valid_vec(anchor.b)||vlen(vsub(anchor.b,anchor.a))<.001 { return "Invalid anchor segment" }
+    overlap:=false
+    for p,i in part.outline { if _,matches:=segment_overlap(anchor,Segment{p,part.outline[(i+1)%len(part.outline)]});matches { overlap=true;break } }
+    if !overlap { return "Anchor segment has no matching proxy boundary interval" }
+   }
+   anchor_count+=len(part.anchors)
+   for earlier in source.parts[:index] { if level_parts_overlap(part.outline[:],earlier.outline[:]) { return "Compound physics parts overlap" } }
+  }
+  if source.motion=="anchored"&&anchor_count==0 { return "Anchored sources require explicit boundary segments" }
+ }
+ if level.next_identity<=maximum||level.next_identity>=SOURCE_RESERVED_START { return "next_identity must exceed every source and avoid the reserved range" }
+ links:=make(map[[2]Level_Part_Key]bool);defer delete(links)
+ for link in level.glue {
+  if link.a==link.b||!parts[link.a]||!parts[link.b] { return "Glue refers to missing or identical parts" }
+  if links[{link.a,link.b}]||links[{link.b,link.a}] { return "Duplicate glue link" };links[{link.a,link.b}]=true
+ }
+ allowed:=make(map[[2]Level_Part_Key]bool);defer delete(allowed)
+ for overlap in level.allowed_overlaps {
+  if overlap.a.source_identity==overlap.b.source_identity||!parts[overlap.a]||!parts[overlap.b]||len(overlap.reason)<1||len(overlap.reason)>512||allowed[{overlap.a,overlap.b}]||allowed[{overlap.b,overlap.a}] {return "Invalid, duplicate or unexplained XY overlap declaration"}
+  allowed[{overlap.a,overlap.b}]=true
+ }
+ for source,i in level.sources {for other in level.sources[:i] {for a in source.parts {for b in other.parts {
+  if !level_parts_overlap(a.outline[:],b.outline[:]) {continue}
+  x,y:=Level_Part_Key{source.identity,a.part_id},Level_Part_Key{other.identity,b.part_id}
+  if !allowed[{x,y}]&&!allowed[{y,x}] {return fmt.tprintf("Overlapping XY proxies require an explicit intended overlap: source %d part %d / source %d part %d",x.source_identity,x.part_id,y.source_identity,y.part_id)}
+ }}}}
+ return ""
+}
+decode_level_layout :: proc(data:[]u8) -> (level:Level_Layout,ok:bool,problem:string) {
+ if len(data)==0||len(data)>NET_APP_MAX_LAYOUT { return {},false,"Version 4 layout exceeds the 200000-byte upload bound" }
+ // Failed and malformed parses share one bounded scratch lifetime, including
+ // partially allocated nested JSON records. Persistent data is allocated only
+ // after every count/geometry/policy check succeeds.
+ storage:=make([]u8,16*1024*1024);defer delete(storage)
+ arena:mem.Arena;mem.arena_init(&arena,storage)
+ wire:Level_Layout
+ if json.unmarshal(data,&wire,allocator=mem.arena_allocator(&arena))!=nil { return {},false,"Invalid version 4 layout JSON" }
+ if wire.gameplay_config.version==0&&wire.gameplay_config_id=="bom-default-v1" { wire.gameplay_config=DEFAULT_GAMEPLAY_CONFIG }
+ if reason:=level_layout_problem(&wire);reason!="" { return {},false,reason }
+ canonical,canonical_ok:=exact_json_encode(wire,false);defer delete(canonical)
+ if !canonical_ok||len(canonical)>NET_APP_MAX_LAYOUT { return {},false,"Canonical level catalog exceeds the 200000-byte upload bound" }
+ if json.unmarshal(data,&level)!=nil { destroy_level_layout(&level);return {},false,"Cannot retain validated level layout" }
+ if level.gameplay_config.version==0 { level.gameplay_config=wire.gameplay_config }
+ return level,true,""
+}
diff --git a/src/shared/level_layout_test.odin b/src/shared/level_layout_test.odin
new file mode 100644
index 0000000..35e259c
--- /dev/null
+++ b/src/shared/level_layout_test.odin
@@ -0,0 +1,63 @@
+package shared
+import t "core:testing"
+import json "core:encoding/json"
+import math "core:math"
+import strings "core:strings"
+
+LEVEL_V4_TEST :: `{"kind":"bom-layout","version":4,"seed":42,"next_identity":9007199254741002,
+"level_id":"unit-level","gameplay_config_id":"bom-default-v1","catalog_id":"unit-catalog",
+"simulation_bounds":{"lo":{"x":-10,"y":-3},"hi":{"x":10,"y":12}},
+"kill_bounds":{"lo":{"x":-11,"y":-4},"hi":{"x":11,"y":13}},
+"camera_bounds":{"lo":{"x":-11,"y":-4},"hi":{"x":11,"y":13}},
+"aim_bounds":{"lo":{"x":-10,"y":-3},"hi":{"x":10,"y":12}},
+"fragment_cull_bounds":{"lo":{"x":-20,"y":-10},"hi":{"x":20,"y":20}},
+"spawns":[{"x":-4,"y":1},{"x":4,"y":1},{"x":-2,"y":1},{"x":6,"y":1}],
+"bombs":{"spawn_x":{"x":-9,"y":9},"spawn_height":9,"cleanup_bounds":{"lo":{"x":-12,"y":-4},"hi":{"x":12,"y":14}}},
+"sources":[{"identity":9007199254741001,"asset_key":"fixture","visual_hash":"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
+"group_to_rest":[-2,0,0,0,0,3,0,0,0,0,0.4,0,7,-2,4,1],"depth":{"x":-0.3,"y":0.3},"cap_key":"stone",
+"motion":"anchored","damage":"indestructible","parts":[{"part_id":9007199254742001,"material":"stone",
+"outline":[{"x":0,"y":0},{"x":3,"y":0},{"x":3,"y":1},{"x":1,"y":1},{"x":1,"y":3},{"x":0,"y":3}],
+"anchors":[{"a":{"x":0,"y":0},"b":{"x":3,"y":0}}]}]}]}`
+
+@(test)
+level_v4_exact_ids_roundtrip_transform_and_concave_coverage :: proc(test:^t.T) {
+ level,ok,reason:=decode_level_layout(transmute([]u8)string(LEVEL_V4_TEST));t.expect(test,ok,reason);if !ok { return };defer destroy_level_layout(&level)
+ t.expect(test,level.sources[0].identity==9007199254741001&&level.sources[0].parts[0].part_id==9007199254742001&&level.next_identity==9007199254741002)
+ p:=level_matrix_point(level.sources[0].group_to_rest,{1,2,3});t.expect(test,p==[3]f32{5,4,5.2})
+ outline:=Polygon{points=level.sources[0].parts[0].outline[:]}
+ pieces:=convex_decomposition(outline);defer { for piece in pieces { delete(piece.points) };delete(pieces) }
+ area:f32;for piece in pieces { area+=polygon_area(piece);t.expect(test,len(piece.points)<=8&&is_convex(piece)) };t.expect(test,math.abs(area-5)<1e-6)
+ encoded,err:=json.marshal(level);t.expect(test,err==nil);defer delete(encoded)
+ copy,valid,problem:=decode_level_layout(encoded);t.expect(test,valid,problem);if valid { defer destroy_level_layout(&copy);t.expect(test,copy.sources[0].identity==level.sources[0].identity&&copy.sources[0].parts[0].part_id==level.sources[0].parts[0].part_id) }
+}
+@(test)
+level_v4_rejects_invalid_bounds_ids_geometry_and_transform :: proc(test:^t.T) {
+ level,ok,reason:=decode_level_layout(transmute([]u8)string(LEVEL_V4_TEST));t.expect(test,ok,reason);if !ok { return };defer destroy_level_layout(&level)
+ source:=&level.sources[0];id:=source.identity;source.identity=0;t.expect(test,level_layout_problem(&level)!="");source.identity=id
+ source.group_to_rest[0]=0;t.expect(test,level_layout_problem(&level)!="");source.group_to_rest[0]=-2
+ next:=level.next_identity;level.next_identity=id;t.expect(test,level_layout_problem(&level)!="");level.next_identity=next
+ spawn:=level.spawns[0];level.spawns[0]={1000,0};t.expect(test,level_layout_problem(&level)!="");level.spawns[0]=spawn
+ part:=&source.parts[0];point:=part.outline[1];part.outline[1]=part.outline[0];t.expect(test,level_layout_problem(&level)!="");part.outline[1]=point
+ anchor:=part.anchors[0];part.anchors[0]={{1,1},{2,2}};t.expect(test,level_layout_problem(&level)!="");part.anchors[0]=anchor
+ for size in ([5]int{0,1,15,100,len(LEVEL_V4_TEST)-1}) { bad,valid,_:=decode_level_layout((transmute([]u8)string(LEVEL_V4_TEST))[:size]);t.expect(test,!valid);if valid { destroy_level_layout(&bad) } }
+ t.expect_value(test,level_layout_problem(&level),"")
+}
+@(test)
+level_v4_compound_hole_stays_empty_and_overlaps_are_detected :: proc(test:^t.T) {
+ bottom:=[4]Vec2{{0,0},{4,0},{4,1},{0,1}};top:=[4]Vec2{{0,3},{4,3},{4,4},{0,4}}
+ left:=[4]Vec2{{0,1},{1,1},{1,3},{0,3}};right:=[4]Vec2{{3,1},{4,1},{4,3},{3,3}}
+ hole:=[4]Vec2{{1,1},{3,1},{3,3},{1,3}};overlap:=[4]Vec2{{.5,.5},{1.5,.5},{1.5,1.5},{.5,1.5}}
+ parts:=[4][]Vec2{bottom[:],top[:],left[:],right[:]};area:f32
+ for part,i in parts { t.expect_value(test,level_polygon_problem(part,Level_Bounds{{-1,-1},{5,5}}),"");area+=polygon_area(Polygon{part});t.expect(test,!level_parts_overlap(part,hole[:]));for other in parts[:i] { t.expect(test,!level_parts_overlap(part,other)) } }
+ t.expect(test,math.abs(area-12)<1e-6&&level_parts_overlap(bottom[:],overlap[:]))
+}
+@(test)
+cross_source_xy_overlap_requires_explicit_intent_and_spawn_capsules_cannot_start_in_solid :: proc(test:^t.T) {
+ level,ok,reason:=decode_level_layout(transmute([]u8)string(LEVEL_V4_TEST));t.expect(test,ok,reason);if !ok {return};defer destroy_level_layout(&level)
+ bytes,err:=json.marshal(level.sources[0]);t.expect(test,err==nil);defer delete(bytes)
+ duplicate:Level_Source;t.expect(test,json.unmarshal(bytes,&duplicate)==nil);duplicate.identity+=1;append(&level.sources,duplicate);level.next_identity+=1
+ t.expect(test,strings.contains(level_layout_problem(&level),"explicit intended overlap"))
+ append(&level.allowed_overlaps,Level_Allowed_Overlap{{level.sources[0].identity,level.sources[0].parts[0].part_id},{duplicate.identity,duplicate.parts[0].part_id},strings.clone("Deliberate coincident proxy test; both remain real XY solids")})
+ t.expect_value(test,level_layout_problem(&level),"")
+ level.spawns[0]={2,1};t.expect(test,strings.contains(level_layout_problem(&level),"capsule spawn overlaps"))
+}
diff --git a/src/shared/level_validate_cli.odin b/src/shared/level_validate_cli.odin
new file mode 100644
index 0000000..36ad860
--- /dev/null
+++ b/src/shared/level_validate_cli.odin
@@ -0,0 +1,34 @@
+package shared
+import os "core:os"
+import fmt "core:fmt"
+
+level_hash_text :: proc(hash:[32]u8) -> string { bytes:=make([]u8,64);digits:="0123456789abcdef";for byte,i in hash {bytes[i*2]=digits[byte>>4];bytes[i*2+1]=digits[byte&15]};return transmute(string)bytes }
+Level_Source_Report :: struct {identity:u64,parts,cells,pinned_cells:int,area:f64,matrix_probe:[3]f32}
+Level_Validation_Report :: struct {
+ status,level_id,gameplay_manifest_hash,gameplay_config_hash,catalog_hash:string,
+ game_protocol:u32,canonical_version:u8,
+ source_count,part_count,cell_count,fixture_count:int,
+ bounds:Resolved_Level_Policy,
+ sources:[dynamic]Level_Source_Report,
+}
+level_validate_cli :: proc(input,report_path:string) -> bool {
+ data,err:=os.read_entire_file(input,context.allocator);if err!=nil {fmt.eprintln("Cannot read layout:",input);return false};defer delete(data)
+ layout,seed,valid,reason:=decode_layout(data);if !valid {fmt.eprintln("Invalid exported layout:",reason);return false};defer destroy_layout(&layout)
+ if layout.level==nil {fmt.eprintln("This export validator requires layout v4; the server still loads legacy layouts normally");return false}
+ w:=World{settings=DEFAULT_SANDBOX_SETTINGS};w.settings.seed=seed;world_rebuild_layout(&w,&layout,false);defer scene_destroy(&w.scene);defer delete(w.bombs)
+ manifest:=level_hash_text(w.scene.gameplay_manifest);config:=level_hash_text(w.scene.config_hash);catalog:=level_hash_text(level_sha256(transmute([]u8)w.scene.level_json));defer delete(manifest);defer delete(config);defer delete(catalog)
+ report:=Level_Validation_Report{status="passed",level_id=layout.level.level_id,gameplay_manifest_hash=manifest,gameplay_config_hash=config,catalog_hash=catalog,game_protocol=GAME_PROTOCOL_VERSION,canonical_version=REPL_CANON_VERSION,source_count=len(layout.level.sources),cell_count=len(w.scene.subdivisions),bounds=w.scene.level_policy};defer delete(report.sources)
+ for source in layout.level.sources {
+  row:=Level_Source_Report{identity=source.identity,parts=len(source.parts),matrix_probe=level_matrix_point(source.group_to_rest,{1,2,3})};report.part_count+=len(source.parts)
+  for sub in w.scene.subdivisions {
+   if sub.provenance.source_identity!=source.identity {continue};row.cells+=1;row.area+=f64(polygon_area(sub.outline));if sub.provenance.pinned {row.pinned_cells+=1}
+   if sub.fixture_count==0 {fmt.eprintln("Source has a cell without collision geometry:",source.identity);return false};report.fixture_count+=sub.fixture_count
+  };append(&report.sources,row)
+ }
+ encoded,encoded_ok:=exact_json_encode(report,true);defer delete(encoded)
+ if !encoded_ok||os.write_entire_file(report_path,encoded)!=nil {fmt.eprintln("Cannot write validation report:",report_path);return false}
+ normalized:=fmt.aprintf("%s.layout.json",report_path);defer delete(normalized)
+ if os.write_entire_file(normalized,transmute([]u8)w.scene.level_json)!=nil {fmt.eprintln("Cannot write normalized catalog:",normalized);return false}
+ fmt.printf("LEVEL PASS sources=%d parts=%d cells=%d fixtures=%d gameplay=%s catalog=%s\n",report.source_count,report.part_count,report.cell_count,report.fixture_count,manifest,catalog)
+ return true
+}
