diff --git a/src/shared/round_rules.odin b/src/shared/round_rules.odin
new file mode 100644
index 0000000..16c9199
--- /dev/null
+++ b/src/shared/round_rules.odin
@@ -0,0 +1,166 @@
+package shared
+
+// Pure server rules. Connection generations are distinct from session identities:
+// resuming a session may recover its totals, but cannot revive its round body.
+Game_Mode :: enum u8 { Sandbox, Elimination }
+Round_State :: enum u8 { Waiting, Countdown, Playing, Finished }
+Round_Death :: enum u8 { None, Blast, Bounds, Disconnect }
+Round_End :: enum u8 { None, Elimination, Forfeit, Mixed }
+ROUND_COUNTDOWN_TICKS :: u64(180)
+ROUND_LETHAL_RADIUS :: f32(2.2)
+ROUND_SESSION_CAPACITY :: 128
+
+Round_Progress :: struct { level, xp_in_level, xp_to_next:u64 }
+Round_Session :: struct {
+ id, total_xp, wins, awarded_round:u64,
+}
+Round_Connection :: struct {
+ session_id, generation:u64,
+ connected, ready, explicit_spectator:bool,
+}
+Round_Player :: struct {
+ session_id, generation:u64,
+ slot:int,
+ alive:bool,
+ death:Round_Death,
+ death_tick, alive_ticks, bombs_faced, xp_gained:u64,
+}
+Round_Controller :: struct {
+ mode:Game_Mode,
+ state:Round_State,
+ id, countdown_tick, start_tick, end_tick, bombs_spawned:u64,
+ winner:u64, // Zero means no winner, including a draw. Session IDs are nonzero.
+ draw:bool,
+ reason:Round_End,
+ lethal_radius:f32,
+ connections:[MAX_PLAYERS]Round_Connection,
+ players:[2]Round_Player,
+ sessions:[ROUND_SESSION_CAPACITY]Round_Session,
+ session_count:int,
+}
+
+round_add_sat :: proc(a,b:u64)->u64 {return max(u64)-a<b?max(u64):a+b}
+round_mul_sat :: proc(a,b:u64)->u64 {return a!=0 && b>max(u64)/a?max(u64):a*b}
+
+// Cost to advance m levels is 25*m*(m+3). Compare by division to avoid
+// overflowing even for the largest possible session XP value.
+round_progress :: proc(xp:u64)->Round_Progress {
+ lo,hi:=u64(0),u64(1)<<30
+ for lo<hi {
+  mid:=(lo+hi+1)/2
+  if mid<=xp/25/(mid+3) {lo=mid}else{hi=mid-1}
+ }
+ spent:=25*lo*(lo+3)
+ return {lo+1,xp-spent,100+50*lo}
+}
+
+round_find_session :: proc(r:^Round_Controller,id:u64)->^Round_Session {
+ if id==0 {return nil}
+ for i in 0..<r.session_count {if r.sessions[i].id==id {return &r.sessions[i]}}
+ return nil
+}
+
+round_connect :: proc(r:^Round_Controller,slot:int,id,generation:u64,spectator:bool=false)->bool {
+ if slot<0 || slot>=MAX_PLAYERS || id==0 || generation==0 {return false}
+ // Server admission validates resume credentials before calling this method.
+ // One session cannot control two simultaneous connections.
+ for c,i in r.connections {if c.connected && c.session_id==id && i!=slot {return false}}
+ if round_find_session(r,id)==nil {
+  if r.session_count==len(r.sessions) {return false}
+  r.sessions[r.session_count]=Round_Session{id=id};r.session_count+=1
+ }
+ r.connections[slot]={session_id=id,generation=generation,connected=true,explicit_spectator=spectator}
+ return true
+}
+
+round_disconnect :: proc(r:^Round_Controller,slot:int) {
+ if slot>=0 && slot<MAX_PLAYERS {r.connections[slot].connected=false;r.connections[slot].ready=false}
+}
+
+round_ready :: proc(r:^Round_Controller,slot:int,generation:u64,ready:bool) {
+ if slot>=0 && slot<MAX_PLAYERS && r.connections[slot].connected && r.connections[slot].generation==generation {r.connections[slot].ready=ready}
+}
+
+// Called only after a successful world rebuild, never directly on restart intent.
+round_begin :: proc(r:^Round_Controller)->bool {
+ if r.id==max(u64) {return false}
+ r.id+=1;r.state=.Waiting;r.players={};r.countdown_tick=0;r.start_tick=0;r.end_tick=0
+ r.winner=0;r.draw=false;r.reason=.None;r.bombs_spawned=0
+ for &c in r.connections {c.ready=false}
+ if r.lethal_radius==0 {r.lethal_radius=ROUND_LETHAL_RADIUS}
+ return true
+}
+
+round_player_connected :: proc(r:^Round_Controller,p:Round_Player)->bool {
+ if p.slot<0 || p.slot>=MAX_PLAYERS || p.session_id==0 {return false}
+ c:=r.connections[p.slot]
+ return c.connected && c.session_id==p.session_id && c.generation==p.generation && !c.explicit_spectator
+}
+
+// Run once before simulation. Winner selection is deliberately separate so a
+// disconnect and an explosion on this tick can produce a simultaneous draw.
+round_prepare_tick :: proc(r:^Round_Controller,tick:u64) {
+ if r.mode!=.Elimination || r.state==.Finished || r.state==.Playing {return}
+ if r.state==.Countdown {
+  valid:=true
+  for p in r.players {if !round_player_connected(r,p) || !r.connections[p.slot].ready {valid=false}}
+  if !valid {r.state=.Waiting;r.players={};r.countdown_tick=0;r.start_tick=0;return}
+  if tick>=r.start_tick {r.state=.Playing;for &p in r.players {p.alive=true}}
+  return
+ }
+ candidates:[2]Round_Player;count:=0
+ for c,i in r.connections {
+  if c.connected && !c.explicit_spectator && count<2 {
+   candidates[count]={session_id=c.session_id,generation=c.generation,slot=i};count+=1
+  }
+ }
+ // Reserve the same first two eligible connections used for Waiting bodies.
+ // A faster-loading extra connection must not steal an occupied player slot.
+ if count==2 && r.connections[candidates[0].slot].ready && r.connections[candidates[1].slot].ready {
+  r.players=candidates;r.state=.Countdown;r.countdown_tick=tick
+  r.start_tick=round_add_sat(tick,ROUND_COUNTDOWN_TICKS)
+ }
+}
+
+round_award :: proc(r:^Round_Controller) {
+ for &p in r.players {
+  s:=round_find_session(r,p.session_id)
+  if s==nil || s.awarded_round==r.id {continue}
+  p.xp_gained=round_add_sat(round_mul_sat(p.bombs_faced,10),p.alive_ticks/60)
+  s.total_xp=round_add_sat(s.total_xp,p.xp_gained)
+  if p.session_id==r.winner {s.wins=round_add_sat(s.wins,1)}
+  s.awarded_round=r.id
+ }
+}
+
+// Deaths are accumulated by World at each actual detonation pose, then combined
+// here with forfeits. The caller removes dead bodies only after this method.
+round_finish_tick :: proc(r:^Round_Controller,tick:u64,deaths:[MAX_PLAYERS]Round_Death,bombs_spawned:u64) {
+ if r.mode!=.Elimination || r.state!=.Playing {return}
+ r.bombs_spawned=round_add_sat(r.bombs_spawned,bombs_spawned)
+ alive:=0;winner:=u64(0)
+ for &p in r.players {
+  if !p.alive {continue}
+  death:=deaths[p.slot]
+  if !round_player_connected(r,p) {death=.Disconnect}else{
+   p.alive_ticks=round_add_sat(p.alive_ticks,1)
+   p.bombs_faced=round_add_sat(p.bombs_faced,bombs_spawned)
+  }
+  if death!=.None {p.alive=false;p.death=death;p.death_tick=tick}else{alive+=1;winner=p.session_id}
+ }
+ if alive>1 {return}
+ r.state=.Finished;r.end_tick=tick;r.winner=winner;r.draw=alive==0;r.reason=.Elimination
+ disconnected,other:=false,false
+ for p in r.players {if p.death==.Disconnect {disconnected=true}else if p.death!=.None {other=true}}
+ if disconnected {r.reason=other?.Mixed:.Forfeit}
+ round_award(r)
+}
+
+// Upright native player capsule: segment +/- PLAYER_SEGMENT plus PLAYER_RADIUS.
+// The expanded-radius distance test includes the boundary and avoids sqrt.
+round_capsule_hit :: proc(center,blast:Vec2,lethal_radius:f32)->bool {
+ if !finite(center.x) || !finite(center.y) || !finite(blast.x) || !finite(blast.y) || !finite(lethal_radius) || lethal_radius<0 {return false}
+ nearest:=Vec2{center.x,clamp(blast.y,center.y-PLAYER_SEGMENT,center.y+PLAYER_SEGMENT)}
+ delta:=vsub(blast,nearest);radius:=lethal_radius+PLAYER_RADIUS
+ return f64(delta.x)*f64(delta.x)+f64(delta.y)*f64(delta.y)<=f64(radius)*f64(radius)
+}
diff --git a/src/shared/round_rules_test.odin b/src/shared/round_rules_test.odin
new file mode 100644
index 0000000..554cb38
--- /dev/null
+++ b/src/shared/round_rules_test.odin
@@ -0,0 +1,129 @@
+package shared
+import t "core:testing"
+
+round_test_waiting :: proc()->Round_Controller {
+ r:=Round_Controller{mode=.Elimination}
+ _=round_begin(&r)
+ _=round_connect(&r,0,100,1);_=round_connect(&r,1,200,2)
+ round_ready(&r,0,1,true);round_ready(&r,1,2,true)
+ return r
+}
+round_test_playing :: proc()->Round_Controller {
+ r:=round_test_waiting();round_prepare_tick(&r,60);round_prepare_tick(&r,240);return r
+}
+
+@(test)
+round_countdown_requires_two_ready_players_for_exactly_180_server_ticks :: proc(test:^t.T) {
+ r:=round_test_waiting();round_ready(&r,1,2,false)
+ round_prepare_tick(&r,10);t.expect(test,r.state==.Waiting)
+ round_ready(&r,1,999,true);round_prepare_tick(&r,11);t.expect(test,r.state==.Waiting)
+ round_ready(&r,1,2,true);round_prepare_tick(&r,12)
+ t.expect(test,r.state==.Countdown && r.countdown_tick==12 && r.start_tick==192)
+ for tick in u64(13)..<192 {round_prepare_tick(&r,tick);t.expect(test,r.state==.Countdown)}
+ round_prepare_tick(&r,192);t.expect(test,r.state==.Playing && r.players[0].alive && r.players[1].alive)
+}
+
+@(test)
+round_countdown_interrupt_and_generation_change_cannot_resume_old_timer :: proc(test:^t.T) {
+ r:=round_test_waiting();round_prepare_tick(&r,10);round_disconnect(&r,1)
+ round_prepare_tick(&r,11);t.expect(test,r.state==.Waiting && r.start_tick==0)
+ _=round_connect(&r,1,200,3);round_ready(&r,1,3,true);round_prepare_tick(&r,50)
+ t.expect(test,r.state==.Countdown && r.start_tick==230)
+ // Replacing a connection while still ready invalidates the captured participant.
+ _=round_connect(&r,1,200,4);round_ready(&r,1,4,true);round_prepare_tick(&r,51)
+ t.expect(test,r.state==.Waiting)
+}
+
+@(test)
+round_simultaneous_deaths_draw_and_awards_are_idempotent :: proc(test:^t.T) {
+ r:=round_test_playing()
+ for tick in u64(240)..<300 {round_finish_tick(&r,tick,{},1)}
+ deaths:[MAX_PLAYERS]Round_Death;deaths[0]=.Blast;deaths[1]=.Bounds
+ round_finish_tick(&r,300,deaths,0)
+ t.expect(test,r.state==.Finished && r.draw && r.winner==0 && r.end_tick==300)
+ t.expect(test,r.players[0].xp_gained==601 && r.players[1].xp_gained==601)
+ for _ in 0..<20 {round_finish_tick(&r,301,deaths,10);round_award(&r)}
+ for s in r.sessions[:2] {t.expect(test,s.total_xp==601 && s.wins==0 && s.awarded_round==1)}
+}
+
+@(test)
+round_disconnect_combines_with_same_tick_blast_and_rejoin_stays_spectator :: proc(test:^t.T) {
+ r:=round_test_playing();round_disconnect(&r,0)
+ _=round_connect(&r,0,100,3);round_ready(&r,0,3,true)
+ deaths:[MAX_PLAYERS]Round_Death;deaths[1]=.Blast
+ round_finish_tick(&r,240,deaths,1)
+ t.expect(test,r.state==.Finished && r.draw && r.reason==.Mixed)
+ t.expect(test,r.players[0].death==.Disconnect && r.players[0].bombs_faced==0)
+ t.expect(test,r.players[1].death==.Blast && r.players[1].bombs_faced==1)
+ t.expect(test,r.players[0].generation==1 && r.connections[0].generation==3)
+}
+
+@(test)
+round_forfeit_winner_and_restart_keep_session_totals_and_reset_transients :: proc(test:^t.T) {
+ r:=round_test_playing();round_finish_tick(&r,240,{},2);round_disconnect(&r,1)
+ round_finish_tick(&r,241,{},0)
+ t.expect(test,r.winner==100 && !r.draw && r.reason==.Forfeit)
+ t.expect(test,r.sessions[0].wins==1 && r.sessions[0].total_xp==20)
+ _=round_connect(&r,2,300,3);round_ready(&r,2,3,true)
+ round_prepare_tick(&r,500);t.expect(test,r.state==.Finished && r.players[1].session_id==200)
+ t.expect(test,round_begin(&r) && r.id==2 && r.state==.Waiting && r.bombs_spawned==0 && r.winner==0)
+ t.expect(test,r.sessions[0].total_xp==20 && r.sessions[0].wins==1 && !r.connections[0].ready)
+ round_ready(&r,0,1,true);round_ready(&r,2,3,true);round_prepare_tick(&r,600);round_prepare_tick(&r,780)
+ deaths:[MAX_PLAYERS]Round_Death;deaths[2]=.Bounds;round_finish_tick(&r,780,deaths,3)
+ t.expect(test,r.winner==100 && r.sessions[0].total_xp==50 && r.sessions[0].wins==2)
+}
+
+@(test)
+round_spectators_do_not_take_participant_slots_and_session_admission_is_bounded :: proc(test:^t.T) {
+ r:=Round_Controller{mode=.Elimination};_=round_begin(&r)
+ _=round_connect(&r,0,100,1,true);_=round_connect(&r,1,200,2);_=round_connect(&r,2,300,3)
+ for i in 0..<3 {round_ready(&r,i,u64(i+1),true)}
+ round_prepare_tick(&r,1);t.expect(test,r.players[0].session_id==200 && r.players[1].session_id==300)
+ t.expect(test,!round_connect(&r,3,200,4))
+ round_disconnect(&r,0)
+ for id in u64(1000)..<1125 {_=round_connect(&r,0,id,id);round_disconnect(&r,0)}
+ t.expect(test,r.session_count==ROUND_SESSION_CAPACITY && !round_connect(&r,0,9999,9999))
+}
+
+@(test)
+round_capsule_uses_capsule_boundary_and_separate_lethal_radius :: proc(test:^t.T) {
+ t.expect(test,round_capsule_hit({0,0},{0,2.7},2.2)) // Center-distance alone would miss.
+ t.expect(test,!round_capsule_hit({0,0},{0,2.8},2.2))
+ t.expect(test,round_capsule_hit({0,0},{2.45,0},2.2))
+ t.expect(test,!round_capsule_hit({0,0},{2.47,0},2.2))
+ t.expect(test,round_capsule_hit({0,0},{0,0.5},0.2))
+ t.expect(test,!round_capsule_hit({0,0},{0,0},-1))
+}
+
+@(test)
+round_xp_thresholds_and_arithmetic_do_not_overflow :: proc(test:^t.T) {
+ cases:=[8]struct{xp,level,inside,next:u64}{
+  {0,1,0,100},{99,1,99,100},{100,2,0,150},{249,2,149,150},
+  {250,3,0,200},{449,3,199,200},{450,4,0,250},{700,5,0,300},
+ }
+ for c in cases {p:=round_progress(c.xp);t.expect(test,p.level==c.level && p.xp_in_level==c.inside && p.xp_to_next==c.next)}
+ p:=round_progress(max(u64));t.expect(test,p.level>1 && p.xp_in_level<p.xp_to_next)
+ t.expect(test,round_add_sat(max(u64)-1,3)==max(u64) && round_mul_sat(max(u64),10)==max(u64))
+ r:=round_test_playing();r.players[0].bombs_faced=max(u64);r.players[0].alive_ticks=max(u64)
+ deaths:[MAX_PLAYERS]Round_Death;deaths[1]=.Blast;round_finish_tick(&r,240,deaths,1)
+ t.expect(test,r.sessions[0].total_xp==max(u64))
+}
+
+@(test)
+round_sandbox_does_not_run_elimination_rules :: proc(test:^t.T) {
+ r:=round_test_waiting();r.mode=.Sandbox
+ round_prepare_tick(&r,10);round_finish_tick(&r,10,{.Blast,.Blast,.None,.None},10)
+ t.expect(test,r.state==.Waiting && r.sessions[0].total_xp==0 && r.bombs_spawned==0)
+}
+
+@(test)
+round_waiting_keeps_the_first_two_player_slots_while_one_baseline_is_loading :: proc(test:^t.T) {
+ r:=round_test_waiting();round_ready(&r,1,2,false)
+ _=round_connect(&r,2,300,3);round_ready(&r,2,3,true)
+ round_prepare_tick(&r,10);t.expect(test,r.state==.Waiting)
+ round_ready(&r,1,2,true);round_prepare_tick(&r,11)
+ t.expect(test,r.state==.Countdown && r.players[0].session_id==100 && r.players[1].session_id==200)
+ round_disconnect(&r,1);round_prepare_tick(&r,12);t.expect(test,r.state==.Waiting)
+ round_prepare_tick(&r,13)
+ t.expect(test,r.state==.Countdown && r.players[0].session_id==100 && r.players[1].session_id==300)
+}
diff --git a/src/shared/round_server.odin b/src/shared/round_server.odin
new file mode 100644
index 0000000..d192ca6
--- /dev/null
+++ b/src/shared/round_server.odin
@@ -0,0 +1,97 @@
+package shared
+import "core:crypto"
+import "core:fmt"
+
+Round_Credentials :: struct { server:[16]u8, session:u64, secret:[16]u8 }
+Round_Admission :: struct { server:[16]u8, secrets:[ROUND_SESSION_CAPACITY][16]u8 }
+
+round_server_identity :: proc(ns:^Net_Server) {
+ if crypto.is_zero_constant_time(ns.round_admission.server[:])==1 {crypto.rand_bytes(ns.round_admission.server[:])}
+}
+round_server_admit :: proc(ns:^Net_Server,slot:int,credential:Round_Credentials,spectator:bool)->string {
+ resume:=credential
+ round_server_identity(ns)
+ session:=u64(0)
+ if credential.session!=0 && credential.server==ns.round_admission.server {
+  found:=false
+  for s,i in ns.rounds.sessions[:ns.rounds.session_count] {
+   if s.id==credential.session {
+    if crypto.compare_constant_time(ns.round_admission.secrets[i][:],resume.secret[:])!=1 {return "invalid session resume credentials"}
+    session=s.id;found=true;break
+   }
+  }
+  if !found {return "session resume identity not found"}
+ }
+ if session==0 {
+  if ns.rounds.session_count==ROUND_SESSION_CAPACITY {return "session capacity reached; restart the local server"}
+  // Monotonic server-local identity; the random per-session secret authorizes resume.
+  session=u64(ns.rounds.session_count+1)
+ }
+ if !round_connect(&ns.rounds,slot,session,ns.clients[slot].incarnation,spectator) {return "session is already connected or capacity reached"}
+ row:=ns.rounds.session_count-1
+ for s,i in ns.rounds.sessions[:ns.rounds.session_count] {if s.id==session {row=i;break}}
+ if crypto.is_zero_constant_time(ns.round_admission.secrets[row][:])==1 {crypto.rand_bytes(ns.round_admission.secrets[row][:])}
+ ns.clients[slot].round_credentials={ns.round_admission.server,session,ns.round_admission.secrets[row]}
+ return ""
+}
+
+round_server_can_play :: proc(ns:^Net_Server,slot:int)->bool {
+ if ns.rounds.mode==.Sandbox {return ns.clients[slot].active && !ns.rounds.connections[slot].explicit_spectator}
+ r:=&ns.rounds
+ if r.state==.Waiting {
+  c:=r.connections[slot]
+  if !c.connected || c.explicit_spectator {return false}
+  count:=0
+  for other,i in r.connections {if other.connected && !other.explicit_spectator {if i==slot {return count<2};count+=1}}
+  return false
+ }
+ for p in r.players {if p.slot==slot && round_player_connected(r,p) {return r.state==.Countdown || p.alive}}
+ return false
+}
+
+round_server_sync_bodies :: proc(ns:^Net_Server) {
+ for i in 0..<MAX_PLAYERS {
+  if round_server_can_play(ns,i) {
+   if !ns.game.world.players[i].active {_=world_add_player(&ns.game.world,i)}
+  }else{_=world_remove_player(&ns.game.world,i)}
+ }
+}
+
+round_server_after_rebuild :: proc(ns:^Net_Server) {
+ if ns.round_mode_pending {ns.rounds.mode=ns.round_next_mode;ns.round_mode_pending=false}
+ if ns.rounds.mode==.Elimination {
+  _=round_begin(&ns.rounds)
+  ns.game.world.settings.blast_mode=.Falling_Bombs
+  // Falling bomb physics, radius, fuse and deterministic stream stay native.
+  bomb_rain_reset(&ns.game.world.rain,ns.game.world.settings.seed,scene_gameplay_config(&ns.game.world.scene))
+ }
+ ns.game.world.elimination_playing=false
+ round_server_sync_bodies(ns)
+ ns.round_dirty=true
+}
+
+round_server_prepare :: proc(ns:^Net_Server) {
+ if ns.rounds.mode!=.Elimination {return}
+ old:=ns.rounds.state
+ round_prepare_tick(&ns.rounds,ns.tick+1)
+ if old!=ns.rounds.state {ns.round_dirty=true}
+ round_server_sync_bodies(ns)
+ ns.game.world.elimination_playing=ns.rounds.state==.Playing
+ ns.game.world.lethal_radius=ns.rounds.lethal_radius
+ // A new schedule fences all held pre-countdown input. It is accepted by the
+ // same native input machinery; Unity does not retarget old movement/jumps.
+ if old!=.Playing && ns.rounds.state==.Playing {
+  for i in 0..<MAX_PLAYERS {if ns.clients[i].active {net_scheduled_server_offer(ns,i)}}
+ }
+}
+
+round_server_finish :: proc(ns:^Net_Server,events:Tick_Events) {
+ if ns.rounds.mode!=.Elimination {return}
+ old:=ns.rounds.state
+ round_finish_tick(&ns.rounds,ns.tick+1,events.deaths,events.bombs_spawned)
+ if old!=ns.rounds.state {
+  ns.round_dirty=true
+  round_server_sync_bodies(ns)
+  if ns.real_logging {fmt.printf("ROUND id=%d state=%v tick=%d winner=%d draw=%t reason=%v\n",ns.rounds.id,ns.rounds.state,ns.tick+1,ns.rounds.winner,ns.rounds.draw,ns.rounds.reason)}
+ }
+}
diff --git a/src/shared/round_wire.odin b/src/shared/round_wire.odin
new file mode 100644
index 0000000..010a622
--- /dev/null
+++ b/src/shared/round_wire.odin
@@ -0,0 +1,120 @@
+package shared
+import nc "../netcode"
+import "core:fmt"
+
+NET_APP_ROUND :: u8(0xCA)
+NET_APP_READY :: u8(0xCB)
+ROUND_RULES_VERSION :: u32(1)
+
+Round_Connection_View :: struct {
+ session_id,generation,total_xp,wins:u64,
+ connected,ready,spectator,restart_allowed:bool,
+ progress:Round_Progress,
+}
+Round_Snapshot :: struct {
+ epoch:u32,
+ rules_version:u32,
+ tick,id,countdown_tick,start_tick,end_tick,bombs_spawned,winner:u64,
+ mode:Game_Mode,
+ state:Round_State,
+ draw:bool,
+ reason:Round_End,
+ lethal_radius:f32,
+ players:[2]Round_Player,
+ connections:[MAX_PLAYERS]Round_Connection_View,
+}
+
+round_snapshot :: proc(ns:^Net_Server)->Round_Snapshot {
+ r:=&ns.rounds
+ result:=Round_Snapshot{epoch=ns.game.world.scene.epoch,rules_version=ROUND_RULES_VERSION,
+  tick=ns.tick,id=r.id,countdown_tick=r.countdown_tick,start_tick=r.start_tick,end_tick=r.end_tick,
+  bombs_spawned=r.bombs_spawned,winner=r.winner,mode=r.mode,state=r.state,draw=r.draw,reason=r.reason,
+  lethal_radius=r.lethal_radius,players=r.players}
+ for c,i in r.connections {
+  v:=&result.connections[i]
+  v.session_id=c.session_id;v.generation=c.generation;v.connected=c.connected;v.ready=c.ready
+  v.spectator=!round_server_can_play(ns,i)
+  v.restart_allowed=ns.clients[i].active && ns.clients[i].is_host && !net_rebuild_pending(ns) && (r.mode==.Sandbox || r.state==.Finished)
+  if s:=round_find_session(r,c.session_id);s!=nil {v.total_xp=s.total_xp;v.wins=s.wins;v.progress=round_progress(s.total_xp)}
+ }
+ return result
+}
+
+round_encode :: proc(w:^nc.Writer,s:Round_Snapshot) {
+ nc.write_u8(w,NET_APP_ROUND);nc.write_u32(w,s.epoch);nc.write_u32(w,s.rules_version)
+ nc.write_u64(w,s.tick);nc.write_u64(w,s.id);nc.write_u64(w,s.countdown_tick);nc.write_u64(w,s.start_tick);nc.write_u64(w,s.end_tick)
+ nc.write_u64(w,s.bombs_spawned);nc.write_u64(w,s.winner)
+ nc.write_u8(w,u8(s.mode));nc.write_u8(w,u8(s.state));nc.write_bool(w,s.draw);nc.write_u8(w,u8(s.reason));nc.write_f32(w,s.lethal_radius)
+ for p in s.players {
+  nc.write_u64(w,p.session_id);nc.write_u64(w,p.generation);nc.write_u8(w,u8(p.slot));nc.write_bool(w,p.alive);nc.write_u8(w,u8(p.death))
+  nc.write_u64(w,p.death_tick);nc.write_u64(w,p.alive_ticks);nc.write_u64(w,p.bombs_faced);nc.write_u64(w,p.xp_gained)
+ }
+ for c in s.connections {
+  nc.write_u64(w,c.session_id);nc.write_u64(w,c.generation);nc.write_u64(w,c.total_xp);nc.write_u64(w,c.wins)
+  nc.write_bool(w,c.connected);nc.write_bool(w,c.ready);nc.write_bool(w,c.spectator);nc.write_bool(w,c.restart_allowed)
+  nc.write_u64(w,c.progress.level);nc.write_u64(w,c.progress.xp_in_level);nc.write_u64(w,c.progress.xp_to_next)
+ }
+}
+
+round_decode :: proc(data:[]u8)->(s:Round_Snapshot,ok:bool) {
+ if len(data)>1000 {return}
+ r:nc.Reader;nc.reader_init(&r,data)
+ if nc.read_u8(&r)!=NET_APP_ROUND {return}
+ s.epoch=nc.read_u32(&r);s.rules_version=nc.read_u32(&r)
+ s.tick=nc.read_u64(&r);s.id=nc.read_u64(&r);s.countdown_tick=nc.read_u64(&r);s.start_tick=nc.read_u64(&r);s.end_tick=nc.read_u64(&r)
+ s.bombs_spawned=nc.read_u64(&r);s.winner=nc.read_u64(&r)
+ mode:=nc.read_u8(&r);state:=nc.read_u8(&r);s.draw=nc.read_bool(&r);reason:=nc.read_u8(&r);s.lethal_radius=nc.read_f32(&r)
+ if mode>u8(Game_Mode.Elimination) || state>u8(Round_State.Finished) || reason>u8(Round_End.Mixed) {return {},false}
+ s.mode=Game_Mode(mode);s.state=Round_State(state);s.reason=Round_End(reason)
+ for &p in s.players {
+  p.session_id=nc.read_u64(&r);p.generation=nc.read_u64(&r);p.slot=int(nc.read_u8(&r));p.alive=nc.read_bool(&r);death:=nc.read_u8(&r)
+  if death>u8(Round_Death.Disconnect) || p.slot>=MAX_PLAYERS {return {},false}
+  p.death=Round_Death(death)
+  p.death_tick=nc.read_u64(&r);p.alive_ticks=nc.read_u64(&r);p.bombs_faced=nc.read_u64(&r);p.xp_gained=nc.read_u64(&r)
+ }
+ for &c in s.connections {
+  c.session_id=nc.read_u64(&r);c.generation=nc.read_u64(&r);c.total_xp=nc.read_u64(&r);c.wins=nc.read_u64(&r)
+  c.connected=nc.read_bool(&r);c.ready=nc.read_bool(&r);c.spectator=nc.read_bool(&r);c.restart_allowed=nc.read_bool(&r)
+  c.progress.level=nc.read_u64(&r);c.progress.xp_in_level=nc.read_u64(&r);c.progress.xp_to_next=nc.read_u64(&r)
+  if c.session_id!=0 && c.progress!=round_progress(c.total_xp) {return {},false}
+ }
+ ok=r.ok && r.pos==len(data) && s.rules_version==ROUND_RULES_VERSION && finite(s.lethal_radius) && s.lethal_radius>=0 && s.lethal_radius<=100
+ return
+}
+
+round_server_broadcast :: proc(ns:^Net_Server) {
+ if !ns.real_gate || (!ns.round_dirty && ns.tick%60!=0) {return}
+ ns.round_dirty=false
+ w:nc.Writer;nc.writer_init(&w,768);defer nc.writer_destroy(&w)
+ round_encode(&w,round_snapshot(ns))
+ for c,i in ns.clients {if c.active {_=nc.server_send_reliable(&ns.srv,i,w.data[:])}}
+}
+
+round_client_accept :: proc(c:^Net_Client,data:[]u8) {
+ s,ok:=round_decode(data);if !ok {return}
+ if c.has_round && (s.id<c.round_snapshot.id || s.epoch<c.round_snapshot.epoch || s.tick<c.round_snapshot.tick) {return}
+ if !c.has_round || s.id!=c.round_snapshot.id || s.state!=c.round_snapshot.state || s.epoch!=c.round_snapshot.epoch {
+  fmt.printf("ROUND SNAPSHOT id=%d epoch=%d state=%v tick=%d winner=%d draw=%t\n",s.id,s.epoch,s.state,s.tick,s.winner,s.draw)
+ }
+ c.round_snapshot=s;c.has_round=true
+}
+
+round_client_ready :: proc(c:^Net_Client) {
+ if !c.real_gate || !c.real_hello_ok || !c.has_epoch || c.real_reason!="" || !c.input_link.has_offer || c.ready_epoch==c.epoch {return}
+ // Shared native code confirms the fully validated baseline/catalog, independent
+ // of whether the frontend requests optional diagnostic hash reports.
+ data:=canonical_encode(&c.received.scene);defer delete(data)
+ w:nc.Writer;nc.writer_init(&w,64);defer nc.writer_destroy(&w)
+ nc.write_u8(&w,NET_APP_READY);nc.write_u64(&w,c.input_link.offer.identity.incarnation)
+ nc.write_u32(&w,c.received.scene.epoch);nc.write_u64(&w,c.received.scene.structure_revision);nc.write_u64(&w,repl_hash(data))
+ if nc.client_send_reliable(&c.nc_client,w.data[:]) {c.ready_epoch=c.epoch}
+}
+
+round_server_ready :: proc(ns:^Net_Server,index:int,data:[]u8) {
+ r:nc.Reader;nc.reader_init(&r,data);_=nc.read_u8(&r)
+ generation:=nc.read_u64(&r);epoch:=nc.read_u32(&r);revision:=nc.read_u64(&r);hash:=nc.read_u64(&r)
+ if !r.ok || r.pos!=len(data) || generation!=ns.clients[index].incarnation || epoch!=ns.game.world.scene.epoch {return}
+ expected,found:=ns.hashes[net_hash_key(epoch,revision)]
+ if !found && revision==ns.game.world.scene.structure_revision {bytes:=canonical_encode(&ns.game.world.scene);expected=repl_hash(bytes);delete(bytes);found=true}
+ if found && hash==expected {round_ready(&ns.rounds,index,generation,true);ns.round_dirty=true}
+}
diff --git a/src/shared/round_world_test.odin b/src/shared/round_world_test.odin
