+  physics_bytes:=b2.GetByteCount();context=runtime.default_context()
+  fmt.printf("BOM CLIENT RESOURCES handles=0 odin_live_bytes=%d box2d_baseline=%d box2d_live_bytes=%d\n",remaining,physics_baseline,physics_bytes)
