diff --git a/src/shared/net_rebuild.odin b/src/shared/net_rebuild.odin
new file mode 100644
index 0000000..bbe83f5
--- /dev/null
+++ b/src/shared/net_rebuild.odin
@@ -0,0 +1,117 @@
+package shared
+
+import "base:runtime"
+import "core:thread"
+import "core:sync"
+import "core:time"
+import "core:fmt"
+
+// Real dedicated servers use the process heap. Each job owns one independent
+// physics world. Layout data is immutable and borrowed until the build joins.
+// Box2D world creation/destruction is serialized by the single build/cleanup
+// pipeline; the active world is only simulated by the server thread.
+// https://box2d.org/documentation/md_foundation.html (Multithreading multiple worlds)
+Net_Rebuild_Job :: struct {
+ worker:^thread.Thread,
+ world:World,
+ layout:Layout,
+ cleanup,success:bool,
+ cancelled:b32,
+ test_gate:^b32,
+ started:time.Tick,
+ request_id,request_incarnation:u64,request_client:int,
+}
+
+net_rebuild_worker :: proc(t:^thread.Thread) {
+ job:=cast(^Net_Rebuild_Job)t.data
+ if job.cleanup {
+  scene_destroy(&job.world.scene);delete(job.world.bombs);job.world={}
+  return
+ }
+ if job.test_gate!=nil {
+  for !sync.atomic_load(job.test_gate) && !sync.atomic_load(&job.cancelled) {time.sleep(time.Millisecond)}
+ }
+ if sync.atomic_load(&job.cancelled) {return}
+ world_rebuild_layout(&job.world,&job.layout,false)
+ job.success=job.world.rebuild_error==""
+}
+
+net_rebuild_free :: proc(job:^Net_Rebuild_Job,destroy_world:bool) {
+ context=runtime.default_context()
+ if job==nil {return}
+ if job.worker!=nil {thread.join(job.worker);thread.destroy(job.worker)}
+ if destroy_world {scene_destroy(&job.world.scene);delete(job.world.bombs)}
+ free(job)
+}
+
+net_rebuild_pending :: proc(ns:^Net_Server) -> bool {return ns.rebuild!=nil || ns.rebuild_cleanup!=nil}
+
+net_rebuild_begin :: proc(ns:^Net_Server) -> string {
+ // This path is enabled only by the real, process-heap dedicated server.
+ context=runtime.default_context()
+ if net_rebuild_pending(ns) {return "world rebuild already in progress"}
+ if ns.game.world.scene.epoch==max(u32) {return "world epoch exhausted"}
+ job:=new(Net_Rebuild_Job)
+ job.layout=ns.game.layout
+ job.world.settings=ns.game.world.settings
+ job.world.scene.epoch=ns.game.world.scene.epoch
+ job.world.scene.revision=ns.game.world.scene.revision
+ job.started=time.tick_now();job.test_gate=ns.rebuild_test_gate
+ job.worker=thread.create(net_rebuild_worker,.Low)
+ if job.worker==nil {free(job);return "cannot start world rebuild"}
+ ns.rebuild=job;job.worker.data=job;thread.start(job.worker)
+ if ns.real_logging {fmt.printf("REBUILD START epoch=%d tick=%d\n",ns.game.world.scene.epoch+1,ns.tick)}
+ return ""
+}
+
+net_rebuild_poll :: proc(ns:^Net_Server) {
+ context=runtime.default_context()
+ if ns.rebuild_cleanup!=nil && thread.is_done(ns.rebuild_cleanup.worker) {
+  net_rebuild_free(ns.rebuild_cleanup,false);ns.rebuild_cleanup=nil
+ }
+ job:=ns.rebuild
+ if job==nil || !thread.is_done(job.worker) {return}
+ thread.join(job.worker)
+ if !job.success {
+  net_rebuild_finish_request(ns,job,false)
+  ns.round_mode_pending=false;ns.round_dirty=true
+  if ns.real_logging {fmt.printf("REBUILD FAILED: %s\n",job.world.rebuild_error)}
+  net_rebuild_free(job,true);ns.rebuild=nil
+  return
+ }
+ // Publish only a completely constructed world. Existing physics/networking
+ // continue on the old epoch during construction. No partial scene is sent.
+ old:=ns.game.world
+ // Synchronous resets retain this session-wide sequence. Include bombs spawned
+ // in the active world while the replacement was being constructed.
+ job.world.next_bomb_id=old.next_bomb_id
+ job.world.scene.revision=old.scene.revision+1
+ ns.game.world=job.world;job.world={};ns.rebuild=nil
+ net_host_trim_players(ns)
+ for i in 0..<len(ns.clients) {if ns.clients[i].active {if !ns.game.world.players[i].active {_=world_add_player(&ns.game.world,i)};ns.game.world.players[i].blast_radius=ns.clients[i].radius}}
+ round_server_after_rebuild(ns)
+ net_rebuild_finish_request(ns,job,true)
+ if ns.real_logging {fmt.printf("REBUILD COMMIT epoch=%d tick=%d build_ms=%.3f\n",ns.game.world.scene.epoch,ns.tick,time.duration_seconds(time.tick_since(job.started))*1000)}
+ net_rebuild_free(job,false)
+ // Destroy the detached old world without blocking transport. Do not accept
+ // another build until this finishes, so world lifecycle calls cannot overlap.
+ cleanup:=new(Net_Rebuild_Job);cleanup.cleanup=true;cleanup.world=old
+ cleanup.worker=thread.create(net_rebuild_worker,.Low)
+ if cleanup.worker==nil {net_rebuild_free(cleanup,true);return}
+ ns.rebuild_cleanup=cleanup;cleanup.worker.data=cleanup;thread.start(cleanup.worker)
+}
+
+net_rebuild_destroy :: proc(ns:^Net_Server) {
+ context=runtime.default_context()
+ if ns.rebuild!=nil {sync.atomic_store(&ns.rebuild.cancelled,true);net_rebuild_free(ns.rebuild,true);ns.rebuild=nil}
+ if ns.rebuild_cleanup!=nil {net_rebuild_free(ns.rebuild_cleanup,false);ns.rebuild_cleanup=nil}
+}
+
+net_rebuild_finish_request :: proc(ns:^Net_Server,job:^Net_Rebuild_Job,accepted:bool) {
+ if job.request_id==0 {return}
+ c:=&ns.clients[job.request_client]
+ if !c.active||c.incarnation!=job.request_incarnation||c.requests==nil {return}
+ result:=Request_Result{request_id=job.request_id,effect_tick=ns.tick+1,status=.Accepted}
+ if !accepted {result.status=.Rejected;result.reason=2}
+ if request_cache_finish(c.requests,result) {net_request_send_result(ns,job.request_client,NET_APP_HOST_COMMAND,result)}
+}
diff --git a/src/shared/net_rebuild_test.odin b/src/shared/net_rebuild_test.odin
new file mode 100644
index 0000000..069592b
--- /dev/null
+++ b/src/shared/net_rebuild_test.odin
@@ -0,0 +1,98 @@
+package shared
+import "base:runtime"
+import t "core:testing"
+import "core:sync"
+import "core:time"
+import b2 "vendor:box2d"
+import nc "../netcode"
+
+net_test_rebuild_server :: proc()->Net_Server {
+ context.allocator=runtime.default_context().allocator
+ game:=Headless_Game{world=World{settings=DEFAULT_SANDBOX_SETTINGS},layout=Layout{next_identity=1}}
+ world_rebuild_layout(&game.world,&game.layout,false)
+ server:Net_Server;net_server_init_world(&server,game,false);server.async_rebuild=true
+ return server
+}
+
+@(test)
+background_reset_keeps_old_world_live_and_publishes_one_complete_epoch :: proc(test:^t.T) {
+ // Real server jobs use the process heap. Verify Box2D's owned byte counter
+ // after joining both workers, in addition to the synchronous allocator suite.
+ context.allocator=runtime.default_context().allocator
+ bytes:=b2.GetByteCount();server:=net_test_rebuild_server();live:=true
+ defer {if live {net_server_destroy(&server)}}
+ gate:b32;server.rebuild_test_gate=&gate
+ net_server_join(&server,1);server.clients[1].is_host=true
+ epoch:=server.game.world.scene.epoch;old:=server.game.world.scene.physics.world
+ command:=[2]u8{NET_APP_HOST_COMMAND,NET_HOST_RESET}
+ t.expect(test,net_host_apply_command(&server,1,command[:])=="")
+ t.expect(test,net_host_apply_command(&server,1,command[:])=="world rebuild already in progress")
+ for i in 0..<12 {net_server_tick(&server,f64(i)/60)}
+ t.expect(test,server.tick==12 && server.game.world.tick==12 && server.game.world.scene.epoch==epoch)
+ t.expect(test,server.game.world.scene.physics.world==old && b2.World_IsValid(old))
+ // Join while the new world is being built: commit uses the current player set.
+ net_server_join(&server,2)
+ server.game.world.next_bomb_id=345
+ sync.atomic_store(&gate,true)
+ start:=time.tick_now()
+ for net_rebuild_pending(&server) && time.duration_seconds(time.tick_since(start))<5 {net_rebuild_poll(&server);time.sleep(time.Millisecond)}
+ t.expect(test,!net_rebuild_pending(&server) && server.game.world.scene.epoch==epoch+1 && server.game.world.tick==0)
+ t.expect(test,server.game.world.next_bomb_id==345)
+ t.expect(test,server.game.world.players[1].active && server.game.world.players[2].active && !server.game.world.players[0].active)
+ t.expect(test,!b2.World_IsValid(old) && b2.World_IsValid(server.game.world.scene.physics.world))
+ net_rebuild_poll(&server);t.expect(test,server.game.world.scene.epoch==epoch+1)
+ net_server_destroy(&server);live=false
+ t.expect(test,b2.GetByteCount()==bytes)
+}
+
+@(test)
+background_reset_shutdown_cancels_held_work_and_joins_without_leaking_worlds :: proc(test:^t.T) {
+ context.allocator=runtime.default_context().allocator
+ bytes:=b2.GetByteCount();server:=net_test_rebuild_server();gate:b32;server.rebuild_test_gate=&gate
+ t.expect(test,net_rebuild_begin(&server)=="")
+ net_server_destroy(&server)
+ t.expect(test,server.rebuild==nil && server.rebuild_cleanup==nil && b2.GetByteCount()==bytes)
+}
+
+@(test)
+background_reset_result_waits_for_publication_and_uses_the_commit_tick :: proc(test:^t.T) {
+ context.allocator=runtime.default_context().allocator
+ server:=net_test_rebuild_server();defer net_server_destroy(&server)
+ gate:b32;server.rebuild_test_gate=&gate
+ net_server_join(&server,1);server.clients[1].is_host=true
+ epoch:=server.game.world.scene.epoch
+ writer:nc.Writer;nc.writer_init(&writer,64);defer nc.writer_destroy(&writer)
+ payload:=[2]u8{NET_APP_HOST_COMMAND,NET_HOST_RESET}
+ test_request_envelope(&writer,server.clients[1].incarnation,epoch,1,NET_APP_HOST_COMMAND,payload[:])
+ net_request_server_dispatch(&server,1,writer.data[:])
+ t.expect(test,server.clients[1].requests.entries[1].result.status==.Pending,"accepted reset must remain pending while the worker is gated")
+ for tick in 0..<12 {net_server_tick(&server,f64(tick)/60)}
+ net_request_server_dispatch(&server,1,writer.data[:])
+ t.expect(test,server.clients[1].requests.entries[1].result.status==.Pending,"duplicate pending request must not finish or start another reset")
+ sync.atomic_store(&gate,true)
+ start:=time.tick_now()
+ for net_rebuild_pending(&server)&&time.duration_seconds(time.tick_since(start))<5 {net_rebuild_poll(&server);time.sleep(time.Millisecond)}
+ result:=server.clients[1].requests.entries[1].result
+ t.expect(test,result.status==.Accepted&&result.effect_tick==13&&server.game.world.scene.epoch==epoch+1,"result must identify the actual publication tick")
+ net_request_server_dispatch(&server,1,writer.data[:])
+ t.expect(test,server.clients[1].requests.entries[1].result==result&&server.rebuild==nil,"terminal duplicate must replay the original result")
+}
+
+@(test)
+background_reset_cannot_complete_a_reused_peer_request_slot :: proc(test:^t.T) {
+ context.allocator=runtime.default_context().allocator
+ server:=net_test_rebuild_server();defer net_server_destroy(&server)
+ gate:b32;server.rebuild_test_gate=&gate
+ net_server_join(&server,1);server.clients[1].is_host=true
+ writer:nc.Writer;nc.writer_init(&writer,64);defer nc.writer_destroy(&writer)
+ payload:=[2]u8{NET_APP_HOST_COMMAND,NET_HOST_RESET}
+ test_request_envelope(&writer,server.clients[1].incarnation,server.game.world.scene.epoch,1,NET_APP_HOST_COMMAND,payload[:])
+ net_request_server_dispatch(&server,1,writer.data[:]);old:=server.clients[1].incarnation
+ net_server_leave(&server,1);net_server_join(&server,1)
+ t.expect(test,server.clients[1].incarnation!=old)
+ state,_:=request_cache_begin(server.clients[1].requests,server.clients[1].incarnation,1,u64(123))
+ t.expect(test,state==.New)
+ sync.atomic_store(&gate,true);start:=time.tick_now()
+ for net_rebuild_pending(&server)&&time.duration_seconds(time.tick_since(start))<5 {net_rebuild_poll(&server);time.sleep(time.Millisecond)}
+ t.expect(test,server.clients[1].requests.entries[1].result.status==.Pending,"old worker must not finish a new peer's equal numeric request ID")
+}
