+package shared
+import t "core:testing"
+
+@(test)
+net_server_timing_is_bounded :: proc(test:^t.T) {
+ samples:[dynamic]f64;defer delete(samples)
+ for tick in 0..<u64(NET_SERVER_TIMING_CAPACITY+7) {net_server_record_timing(&samples,tick,f64(tick))}
+ t.expect(test,len(samples)==NET_SERVER_TIMING_CAPACITY)
+ for i in 0..<NET_SERVER_TIMING_CAPACITY {expected:=u64(i);if i<7 {expected+=NET_SERVER_TIMING_CAPACITY};t.expect(test,samples[i]==f64(expected))}
+}
+
+@(test)
+net_entity_and_delay_diagnostic_samples_are_bounded :: proc(test:^t.T) {
+ staleness:[dynamic]u16;delays:[dynamic]u8;defer delete(staleness);defer delete(delays)
+ for i in 0..<u64(NET_SERVER_TIMING_CAPACITY*3+7) {
+  net_record_bounded_sample(&staleness,i,u16(i%65536));net_record_bounded_sample(&delays,i,u8(i%251))
+ }
+ t.expect(test,len(staleness)==NET_SERVER_TIMING_CAPACITY&&len(delays)==NET_SERVER_TIMING_CAPACITY)
+ last:=u64(NET_SERVER_TIMING_CAPACITY*3+6)
+ t.expect(test,staleness[last%NET_SERVER_TIMING_CAPACITY]==u16(last%65536)&&delays[last%NET_SERVER_TIMING_CAPACITY]==u8(last%251))
+}
+
+@(test)
+explicit_server_bind_keeps_numeric_ipv4_and_requires_nonlocal_host_authorization :: proc(test:^t.T) {
+ valid:=[3]string{"127.0.0.2","0.0.0.0","192.168.1.4"}
+ for text in valid {_,ok:=net_real_cli_bind(text);t.expect(test,ok)}
+ invalid:=[6]string{"","localhost","127.0.0.1:47380","256.0.0.1","127.0.0","127.0.0.1/24"}
+ for text in invalid {_,ok:=net_real_cli_bind(text);t.expect(test,!ok)}
+ ip,ok:=net_real_cli_bind("127.0.0.2");t.expect(test,ok&&ip==[4]u8{127,0,0,2})
+ args:=[4]string{"--bind","0.0.0.0","--seconds","1"};t.expect(test,!net_real_cli_server(args[:]))
+}
diff --git a/src/shared/net_session.odin b/src/shared/net_session.odin
new file mode 100644
index 0000000..d4a4fc3
--- /dev/null
+++ b/src/shared/net_session.odin
@@ -0,0 +1,86 @@
+#+feature dynamic-literals
+package shared
+
+import nc "../netcode"
+import fmt "core:fmt"
+import strings "core:strings"
+
+GAME_PROTOCOL_VERSION :: u32(6)
+
+GAME_BUILD_ID :: "BOM-rounds-2026-11-09"
+
+NET_APP_HELLO :: u8(0xC2)
+
+NET_APP_WELCOME :: u8(0xC3)
+
+NET_APP_REJECT :: u8(0xC4)
+
+NET_APP_HOST_LEFT :: u8(0xC5)
+
+NET_APP_MAX_REASON :: 256
+
+net_app_write_hello :: proc(w: ^nc.Writer, version: u32, build, token: string,expected:[]u8=nil,spectator:bool=false,resume:Round_Credentials={}) {
+ nc.write_u8(w, NET_APP_HELLO)
+ nc.write_u32(w, version)
+ nc.write_string(w, build)
+ nc.write_string(w, token)
+ if version==GAME_PROTOCOL_VERSION { nc.write_bool(w,len(expected)==32);if len(expected)==32 {nc.write_raw(w,expected)} }
+ if version==GAME_PROTOCOL_VERSION {
+  credential:=resume
+  nc.write_bool(w,spectator);nc.write_raw(w,credential.server[:]);nc.write_u64(w,credential.session);nc.write_raw(w,credential.secret[:])
+ }
+}
+
+net_app_client_send_hello :: proc(c: ^Net_Client) {
+ if !c.real_gate || c.real_hello_sent || c.nc_client.state!=.Connected { return }
+ w:nc.Writer;nc.writer_init(&w,64);defer nc.writer_destroy(&w)
+ expected:[]u8;if c.has_expected_manifest {expected=c.expected_manifest[:]}
+ net_app_write_hello(&w,c.real_protocol,c.real_build,c.real_host_token,expected,c.join_spectator,c.round_credentials)
+ if nc.client_send_reliable(&c.nc_client,w.data[:]) { c.real_hello_sent=true }
+}
+
+net_app_client_control :: proc(c: ^Net_Client,data: []u8) -> bool {
+ if !c.real_gate || len(data)==0 { return false }
+ switch data[0] {
+ case NET_APP_ROUND:
+  round_client_accept(c,data);return true
+ case NET_APP_SETTINGS:
+  r:nc.Reader;nc.reader_init(&r,data)
+  _=nc.read_u8(&r);mode:=nc.read_u8(&r);radius:=nc.read_f32(&r)
+  if !r.ok || r.pos!=len(data) || mode>1 || !finite(radius) || radius<0.5 || radius>6 { return true }
+  c.real_settings.blast_mode=Blast_Mode(mode);c.real_settings.blast_radius=radius
+  c.radius_q=radius_quantize(radius);c.real_has_settings=true
+  return true
+ case NET_APP_WELCOME:
+  r:nc.Reader;nc.reader_init(&r,data)
+  _=nc.read_u8(&r);index:=int(nc.read_u8(&r));host:=nc.read_bool(&r)
+  credential:Round_Credentials
+  for &byte in credential.server {byte=nc.read_u8(&r)}
+  credential.session=nc.read_u64(&r)
+  for &byte in credential.secret {byte=nc.read_u8(&r)}
+  if !r.ok || r.pos!=len(data) || index!=c.nc_client.client_index { return true }
+  c.real_is_host=host;c.real_hello_ok=true;c.round_credentials=credential
+  return true
+ case NET_APP_REJECT:
+  r:nc.Reader;nc.reader_init(&r,data)
+  _=nc.read_u8(&r); reason:=nc.read_string(&r)
+  if !r.ok || r.pos!=len(data) || len(reason)==0 || len(reason)>NET_APP_MAX_REASON { return true }
+  delete(c.real_reason);c.real_reason=strings.clone(reason)
+  return true
+ case NET_APP_HOST_LEFT:
+  if len(data)==1 {
+   delete(c.real_reason);c.real_reason=strings.clone("host left")
+   c.real_host_left=true
+  }
+  return true
+ case NET_APP_COMMAND_RESULT:
+  r:nc.Reader;nc.reader_init(&r,data)
+  _=nc.read_u8(&r);kind:=nc.read_u8(&r);ok:=nc.read_bool(&r);reason:=nc.read_string(&r)
+  if !r.ok || r.pos!=len(data) || len(reason)>NET_APP_MAX_REASON { return true }
+  c.control_serial+=1;c.control_kind=kind;c.control_ok=ok
+  delete(c.control_reason);c.control_reason=strings.clone(reason)
+  fmt.printf("APP RESULT kind=%d status=%s reason=%s\n",kind,ok?"OK":"REJECT",reason)
+  return true
+ }
+ return false
+}
diff --git a/src/shared/physics.odin b/src/shared/physics.odin
new file mode 100644
index 0000000..2acdef0
--- /dev/null
+++ b/src/shared/physics.odin
@@ -0,0 +1,38 @@
+#+feature dynamic-literals
+package shared
+
+import b2 "vendor:box2d"
+import math "core:math"
+
+Physics :: struct {
+ world: b2.WorldId,
+ synced_revision: u64,
+ synced: bool,
+ active: bool,
+ mortar_breaking: bool,
+}
+
+piece_anchored :: proc(s: ^Scene,piece_id: u64,anchor_y: f32) -> bool {
+ row,ok:=s.piece_rows[piece_id]; if !ok { return false }
+ for id in s.pieces[row].subdivisions {
+  srow,found:=s.sub_rows[id]; if !found { continue }
+  sub:=s.subdivisions[srow]
+  if !sub.live { continue }
+  if sub.provenance.motion!=.Legacy { if sub.provenance.pinned { return true };continue }
+  if !(anchor_y>-1e30) { continue }
+  for a,i in sub.outline.points {
+   b:=sub.outline.points[(i+1)%len(sub.outline.points)]
+   if math.abs(a.y-anchor_y)<0.00001 && math.abs(b.y-anchor_y)<0.00001 && math.abs(a.x-b.x)>0.00001 { return true }
+  }
+ }
+ return false
+}
+
+physics_destroy :: proc(s: ^Scene) {
+ if !s.physics.active { return }
+ b2.DestroyWorld(s.physics.world)
+ for &sub in s.subdivisions { sub.body={}; sub.fixture_count=0; clear(&sub.shapes) }
+ for &p in s.pieces { p.body={}; p.physics_revision=0; p.has_body_frame=false; p.source_body={} }
+ for &c in s.connections { c.joint={} }
+ s.physics = {}
+}
