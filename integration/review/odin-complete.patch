diff --git a/scripts/build-client.ps1 b/scripts/build-client.ps1
new file mode 100644
index 0000000..6a01d72
--- /dev/null
+++ b/scripts/build-client.ps1
@@ -0,0 +1,40 @@
+[CmdletBinding()]
+param([Parameter(Mandatory=$true)][string]$ConfigPath)
+$ErrorActionPreference='Stop'
+$root=Split-Path -Parent $PSScriptRoot
+$config=Get-Content -LiteralPath $ConfigPath -Raw | ConvertFrom-Json
+$build=Join-Path $root 'build'
+New-Item -ItemType Directory -Path $build -Force | Out-Null
+& python (Join-Path $PSScriptRoot 'generate-client-abi.py')
+if($LASTEXITCODE -ne 0){throw 'ABI generation failed'}
+$hasher=[System.Security.Cryptography.IncrementalHash]::CreateHash([System.Security.Cryptography.HashAlgorithmName]::SHA256)
+try {
+    $paths=@('src/shared','src/netcode','src/ffi','bindings') | ForEach-Object { Get-ChildItem -LiteralPath (Join-Path $root $_) -File -Recurse }
+    foreach($file in ($paths | Sort-Object FullName)) {
+        $relative=[IO.Path]::GetRelativePath($root,$file.FullName).Replace('\','/')
+        $hasher.AppendData([Text.Encoding]::UTF8.GetBytes("$relative`0"))
+        $hasher.AppendData([IO.File]::ReadAllBytes($file.FullName))
+    }
+    $sourceHash=[Convert]::ToHexString($hasher.GetHashAndReset()).ToLowerInvariant()
+} finally {$hasher.Dispose()}
+$tag=[Convert]::ToInt64($sourceHash.Substring(0,15),16)
+$oldPath=$env:PATH;$oldLib=$env:LIB
+try {
+    $env:PATH=$config.LinkerDirectory+';'+$env:PATH
+    $env:LIB=$config.LibraryDirectories -join ';'
+    $dll=Join-Path $build 'bomcore.dll'
+    $arguments=@('build',(Join-Path $root 'src/ffi'),'-build-mode:dll','-o:speed',"-out:$dll","-define:BOM_CORE_BUILD_TAG=$tag")+@($config.CompilerArguments)
+    & $config.OdinCompiler @arguments
+    if($LASTEXITCODE -ne 0){throw "Native client build exited $LASTEXITCODE"}
+    $compiler=(& $config.OdinCompiler version | Out-String).Trim()
+    $schema=Get-Content -LiteralPath (Join-Path $root 'bindings/bom-abi.json') -Raw|ConvertFrom-Json
+    $commit=(& git -C $root rev-parse HEAD 2>$null|Out-String).Trim()
+    $sessionSource=Get-Content -LiteralPath (Join-Path $root 'src/shared/net_session.odin') -Raw
+    $protocol=[int]([regex]::Match($sessionSource,'GAME_PROTOCOL_VERSION\s*::\s*u32\((\d+)\)').Groups[1].Value)
+    $sourceChanges=@(& git -C $root status --porcelain --untracked-files=all -- src bindings scripts tests)
+    $sourceDirty=$sourceChanges.Count -gt 0
+    $replicationSource=Get-Content -LiteralPath (Join-Path $root 'src/shared/replication.odin') -Raw
+    $canonical=[int]([regex]::Match($replicationSource,'REPL_CANON_VERSION\s*::\s*u8\((\d+)\)').Groups[1].Value)
+    [ordered]@{abi_major=$schema.abi_major;abi_minor=$schema.abi_minor;source_commit=$commit;source_dirty=$sourceDirty;source_sha256=$sourceHash;build_tag=$tag;dll_sha256=(Get-FileHash -LiteralPath $dll -Algorithm SHA256).Hash.ToLowerInvariant();compiler=$compiler;compiler_arguments=@($config.CompilerArguments);optimization="speed";source_fingerprint_culture=[Globalization.CultureInfo]::CurrentCulture.Name;game_protocol=$protocol;canonical_version=$canonical;client='shared native client, no managed codec';validation='See integration/tasks.json and integration/evidence for executed gates.'} | ConvertTo-Json | Set-Content -LiteralPath (Join-Path $build 'bomcore.build.json') -Encoding utf8
+    Write-Output "Native client identity: $sourceHash ($tag)"
+} finally {$env:PATH=$oldPath;$env:LIB=$oldLib}
diff --git a/scripts/generate-client-abi.py b/scripts/generate-client-abi.py
new file mode 100644
index 0000000..ff6e5f5
--- /dev/null
+++ b/scripts/generate-client-abi.py
@@ -0,0 +1,29 @@
+"""Generate the native/C/.NET layouts from the single versioned ABI schema."""
+import json,pathlib
+r=pathlib.Path(__file__).resolve().parent.parent
+schema=json.loads((r/'bindings/bom-abi.json').read_text())
+scalar={'u32':('unsigned int','uint'),'u64':('unsigned long long','ulong'),'f32':('float','float'),'f64':('double','double'),'u8':('unsigned char','byte')}
+def odin(t):return '^'+t[1:] if t.startswith('*') else '[^]'+t[2:] if t.startswith('[]') else t
+def c(t):return c(t[1:])+'*' if t.startswith('*') else c(t[2:])+'*' if t.startswith('[]') else scalar.get(t,(t,t))[0]
+def cs(t):return 'ref '+cs(t[1:]) if t.startswith('*') else 'IntPtr' if t.startswith('[]') else scalar.get(t,(t,t))[1]
+native=['// Generated by scripts/generate-client-abi.py; edit bindings/bom-abi.json.','package ffi','',f'BOM_ABI_MAJOR :: u32({schema["abi_major"]})',f'BOM_ABI_MINOR :: u32({schema.get("abi_minor",0)})','']
+header=['/* Generated: Windows x64, natural alignment. */','#ifndef BOM_CLIENT_ABI_H','#define BOM_CLIENT_ABI_H']
+managed=['// Generated from bom-abi.json. No network codec exists in managed code.','using System;','using System.Runtime.InteropServices;','namespace Bom.Native {']
+for name,fields in schema['structs'].items():
+ native+= [name+' :: struct {']+[' '+n+': '+odin(t)+',' for n,t in fields]+['}','']
+ header+=['typedef struct '+name+' {']+[' '+c(t)+' '+n+';' for n,t in fields]+['} '+name+';']
+ managed+=['[StructLayout(LayoutKind.Sequential)] public struct '+name+' {']+[' public '+cs(t)+' '+n+';' for n,t in fields]+['}']
+native+=['@(export)','bom_debug_layout :: proc "c" (type_id,field_id: u32) -> u32 {',' switch type_id {']
+for i,(name,fields) in enumerate(schema['structs'].items()):
+ native+=[' case '+str(i)+':','  switch field_id {','  case 0: return u32(size_of('+name+'))','  case 1: return u32(align_of('+name+'))']+['  case '+str(j+2)+': return u32(offset_of('+name+','+n+'))' for j,(n,_) in enumerate(fields)]+['  }']
+native+=[' }',' return 0xffffffff','}']
+managed+=['public static class BomNative {',f' public const uint AbiVersion = {schema["abi_major"]};',f' public const uint AbiMinorVersion = {schema.get("abi_minor",0)};']
+for name,(ret,args) in schema['functions'].items():
+ header+=['__declspec(dllimport) '+c(ret)+' __cdecl '+name+'('+(', '.join(c(t)+' '+n for n,t in args) or 'void')+');']
+ managed+=[' [DllImport("bomcore", CallingConvention=CallingConvention.Cdecl)] public static extern '+cs(ret)+' '+name+'('+', '.join(cs(t)+' '+n for n,t in args)+');']
+managed+=['}','}'];header+=['#endif']
+(r/'src/ffi').mkdir(exist_ok=True)
+(r/'src/ffi/abi.odin').write_text('\n'.join(native)+'\n',encoding='utf-8')
+(r/'bindings/bom_client.h').write_text('\n'.join(header)+'\n',encoding='utf-8')
+(r/'bindings/BomNative.cs').write_text('\n'.join(managed)+'\n',encoding='utf-8')
+print('Generated ABI: '+str(len(schema['structs']))+' layouts, '+str(len(schema['functions']))+' exports.')
