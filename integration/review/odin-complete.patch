@@ -0,0 +1,57 @@
+package shared
+import t "core:testing"
+import math "core:math"
+
+@(test)
+clock_server_stall_reacquires_fresh_time_and_requires_schedule_reset :: proc(test:^t.T) {
+ c:Input_Clock;nonce,_:=input_clock_probe(&c,0)
+ t.expect(test,input_clock_echo(&c,nonce,{1000,0},.1))
+ nonce,_=input_clock_probe(&c,1)
+ t.expect(test,input_clock_echo(&c,nonce,{1010,0},1.1))
+ t.expect(test,c.resync && c.estimate.tick==1013 && c.raw_error < -40)
+ valid_samples:=0;for sample in c.samples { if sample.valid { valid_samples+=1 } }
+ t.expect_value(test,valid_samples,1)
+ t.expect(test,!input_clock_echo(&c,nonce-1,{2000,0},1.2))
+}
+
+@(test)
+clock_exact_large_ticks_nonce_and_phase :: proc(test: ^t.T) {
+ c:Input_Clock;c.next_nonce=9007199254740993
+ nonce,ok:=input_clock_probe(&c,10);t.expect(test,ok && nonce==9007199254740994)
+ t.expect(test,input_clock_echo(&c,nonce,{9007199254742001,0.25},10.1))
+ stamp,valid:=input_clock_now(&c,10.1)
+ t.expect(test,valid && stamp.tick==9007199254742004 && math.abs(stamp.phase-0.25)<1e-6)
+ target,valid_target:=input_clock_target_origin(&c,10.1)
+ t.expect(test,valid_target && target==9007199254742004+1+u64(c.lead))
+ t.expect(test,!input_clock_echo(&c,nonce,{99,0},10.2))
+ t.expect(test,!input_clock_echo(&c,nonce+1,{99,0},10.2))
+}
+
+@(test)
+clock_bounded_probes_outliers_and_lead :: proc(test: ^t.T) {
+ c:Input_Clock
+ for i in 0..<32 { _,ok:=input_clock_probe(&c,f64(i)*0.001);t.expect(test,ok) }
+ _,overflow:=input_clock_probe(&c,0.05);t.expect(test,!overflow)
+ _,reclaimed:=input_clock_probe(&c,1.1);t.expect(test,reclaimed)
+ c={}
+ for i in 0..<20 {
+  now:=f64(i)*0.25;nonce,_:=input_clock_probe(&c,now)
+  t.expect(test,input_clock_echo(&c,nonce,{u64(i*15+3),0},now+0.1))
+ }
+ t.expect(test,c.lead>=5 && c.lead<=6 && c.accepted==20)
+ nonce,_:=input_clock_probe(&c,6)
+ t.expect(test,!input_clock_echo(&c,nonce,{600,0},6.9))
+ nonce,_=input_clock_probe(&c,7)
+ t.expect(test,!input_clock_echo(&c,nonce,{600,1},7.1))
+}
+
+@(test)
+clock_never_reverses_and_marks_discontinuity :: proc(test: ^t.T) {
+ c:Input_Clock;nonce,_:=input_clock_probe(&c,0)
+ _=input_clock_echo(&c,nonce,{1000,0},0.1)
+ old:=c.estimate
+ nonce,_=input_clock_probe(&c,0.11);_=input_clock_echo(&c,nonce,{1000,0},0.111)
+ t.expect(test,server_stamp_error(c.estimate,old)>=0)
+ _,valid:=input_clock_now(&c,0.05);t.expect(test,!valid && c.resync)
+ c.resync=false;_,valid=input_clock_now(&c,0.5);t.expect(test,valid && c.resync)
+}
diff --git a/src/shared/input_link.odin b/src/shared/input_link.odin
new file mode 100644
index 0000000..fb259db
--- /dev/null
+++ b/src/shared/input_link.odin
@@ -0,0 +1,91 @@
+package shared
+
+// Native schedule handshake state. Both frontends use this; no frontend may
+// invent target ticks or shift already-issued commands after a rejected origin.
+Input_Link :: struct {
+ clock: Input_Clock,
+ history: Command_History,
+ offer,pending: Schedule_Proposal,
+ has_offer,awaiting,active: bool,
+ next_generation,jump_edge_counter: u64,
+ has_owner: bool,
+ owner: Owner_State,
+ resets,rejections,retired_slots: u64,
+}
+
+input_link_offer :: proc(c:^Input_Link,offer:Schedule_Control) -> bool {
+ if offer.kind!=.Offer || offer.proposal.identity.incarnation==0 || offer.proposal.identity.generation==0 { return false }
+ // A stale offer cannot revive the previous epoch or connection.
+ if c.has_offer && offer.proposal.identity.incarnation==c.offer.identity.incarnation && offer.proposal.identity.epoch<c.offer.identity.epoch { return false }
+ c.offer=offer.proposal;c.has_offer=true;c.awaiting=false;c.active=false;c.history={};c.has_owner=false
+ c.next_generation=max(c.next_generation,offer.proposal.identity.generation)
+ c.resets+=1
+ return true
+}
+
+input_link_prepare_reset :: proc(c:^Input_Link,now:f64) -> (request:Schedule_Control,ready:bool) {
+ if !c.has_offer || c.awaiting || c.active || c.next_generation==max(u64) { return }
+ tick,ok:=input_clock_target_origin(&c.clock,now);if !ok { return }
+ // The clock determines the target. The server's offered tick is only a lower
+ // bound; it is not a hidden mapping of the client's sequence onto another slot.
+ tick=max(tick,c.offer.first_tick)
+ c.pending={identity=c.offer.identity,first_tick=tick,first_sequence=c.offer.first_sequence}
+ c.pending.identity.generation=c.next_generation;c.next_generation+=1
+ if c.jump_edge_counter==max(u64) { c.jump_edge_counter=0 }
+ c.awaiting=true;command_history_begin(&c.history,c.pending)
+ return {kind=.Request,proposal=c.pending},true
+}
+
+input_link_control_result :: proc(c:^Input_Link,result:Schedule_Control) -> bool {
+ if !c.awaiting || result.proposal!=c.pending { return false }
+ if result.kind==.Accepted {
+  c.awaiting=false;c.active=true;c.clock.resync=false;c.has_owner=false;return true
+ }
+ if result.kind==.Rejected {
+  c.awaiting=false;c.active=false;c.history={};c.rejections+=1
+  // A rejected proposal's command bytes are terminal, never retargeted. A new
+  // attempt uses a fresh generation and a fresh clock-derived origin.
+  return true
+ }
+ return false
+}
+
+input_link_clear_intent :: proc(c:^Input_Link) {
+ c.active=false;c.awaiting=false;c.history={};c.has_owner=false;c.resets+=1
+}
+
+input_link_command :: proc(c:^Input_Link,move:i8,jump:bool) -> (Scheduled_Command,bool) {
+ if !c.active && !c.awaiting { return {},false }
+ held:=move;press:=jump
+ if !c.active { held=0;press=false }
+ edge:=u64(0)
+ if press {
+  if c.jump_edge_counter==max(u64) { input_link_clear_intent(c);return {},false }
+  c.jump_edge_counter+=1;edge=c.jump_edge_counter
+ }
+ command,ok:=command_history_push(&c.history,held,edge)
+ if !ok { input_link_clear_intent(c) }
+ return command,ok
+}
+
+input_link_packet :: proc(c:^Input_Link,has_ack:bool,ack:u64) -> (packet:Scheduled_Input,ready:bool) {
+ if !c.active { return }
+ packet.identity=c.history.identity;packet.has_ack=has_ack;packet.ack=ack
+ packet.commands,packet.count=command_history_redundancy(&c.history)
+ return packet,true
+}
+
+input_link_owner :: proc(c:^Input_Link,owner:Owner_State) -> bool {
+ if !c.active || owner.identity!=c.history.identity || !owner_state_valid(owner) || (c.has_owner && owner.state_tick<=c.owner.state_tick) { return false }
+ if owner.finalized_through>=c.history.next_tick {
+  // The server advanced past all locally issued targets. Clear and negotiate;
+  // no replay or silently shifted origin can rescue a stalled schedule.
+  input_link_clear_intent(c);return false
+ }
+ previous:=c.history.finalized_through
+ if !command_history_finalize(&c.history,owner.identity,owner.finalized_through) { return false }
+ baseline:=max(previous,c.history.first_tick-1)
+ if owner.finalized_through>baseline { c.retired_slots+=owner.finalized_through-baseline }
+ c.owner=owner;c.has_owner=true
+ return true
+}
diff --git a/src/shared/input_link_test.odin b/src/shared/input_link_test.odin
new file mode 100644
index 0000000..1fe0001
--- /dev/null
+++ b/src/shared/input_link_test.odin
@@ -0,0 +1,48 @@
+package shared
+import t "core:testing"
+
+@(test)
+input_link_waits_for_acceptance_and_rejects_stale_results :: proc(test:^t.T) {
+ c:Input_Link
+ offer:=Schedule_Control{kind=.Offer,proposal={{9007199254740999,4,7},1002,9007199254742001},server={1000,0}}
+ t.expect(test,input_link_offer(&c,offer))
+ _,ready:=input_link_prepare_reset(&c,0);t.expect(test,!ready)
+ nonce,_:=input_clock_probe(&c.clock,0);_=input_clock_echo(&c.clock,nonce,{1000,0},.1)
+ request,ok:=input_link_prepare_reset(&c,.1);t.expect(test,ok && request.kind==.Request)
+ command,ok_command:=input_link_command(&c,127,true)
+ t.expect(test,ok_command && command.move==0 && command.jump_edge==0)
+ _,ready=input_link_packet(&c,false,0);t.expect(test,!ready)
+ accepted:=request;accepted.kind=.Accepted
+ stale:=accepted;stale.proposal.first_tick+=1;t.expect(test,!input_link_control_result(&c,stale))
+ t.expect(test,input_link_control_result(&c,accepted))
+ command,ok_command=input_link_command(&c,127,true)
+ t.expect(test,ok_command && command.move==127 && command.jump_edge==1 && command.target_tick==request.proposal.first_tick+1)
+ packet,ready_packet:=input_link_packet(&c,true,9007199254740997)
+ t.expect(test,ready_packet && packet.count==2 && packet.ack==9007199254740997 && packet.commands[0]==command)
+}
+
+@(test)
+input_link_rejected_origin_is_not_retargeted :: proc(test:^t.T) {
+ c:Input_Link;_=input_link_offer(&c,{kind=.Offer,proposal={{1,1,1},2,1}})
+ nonce,_:=input_clock_probe(&c.clock,0);_=input_clock_echo(&c.clock,nonce,{0,.5},.01)
+ first,ready:=input_link_prepare_reset(&c,.01);t.expect(test,ready)
+ _,_=input_link_command(&c,127,true)
+ rejected:=first;rejected.kind=.Rejected;rejected.reason=.Obsolete
+ t.expect(test,input_link_control_result(&c,rejected) && !c.history.accepted)
+ second,ready_second:=input_link_prepare_reset(&c,.1)
+ t.expect(test,ready_second && second.proposal.identity.generation>first.proposal.identity.generation && second.proposal.first_tick>first.proposal.first_tick)
+ t.expect(test,!input_link_control_result(&c,Schedule_Control{kind=.Accepted,proposal=first.proposal}))
+}
+
+@(test)
+input_link_owner_finalizes_missing_slots_and_stall_resets :: proc(test:^t.T) {
+ c:Input_Link;p:=Schedule_Proposal{{1,1,1},100,9007199254740993}
+ c.active=true;c.has_offer=true;c.offer=p;command_history_begin(&c.history,p)
+ for i in 0..<8 { _,_=input_link_command(&c,127,i==0) }
+ owner:=Owner_State{identity=p.identity,state_tick=105,finalized_through=105,last_applied_sequence=p.first_sequence,teleport_serial=1}
+ t.expect(test,input_link_owner(&c,owner) && c.history.finalized_through==105)
+ packet,ready:=input_link_packet(&c,false,0);t.expect(test,ready && packet.count==2 && packet.commands[1].target_tick==106)
+ t.expect(test,!input_link_owner(&c,owner))
+ owner.state_tick=108;owner.finalized_through=108
+ t.expect(test,!input_link_owner(&c,owner) && !c.active && !c.history.accepted)
+}
diff --git a/src/shared/input_network.odin b/src/shared/input_network.odin
new file mode 100644
index 0000000..a5649fd
--- /dev/null
+++ b/src/shared/input_network.odin
@@ -0,0 +1,127 @@
+package shared
+import nc "../netcode"
+
+net_scheduled_send_control :: proc(ns:^Net_Server,index:int,control:Schedule_Control) {
+ w:nc.Writer;nc.writer_init(&w,80);defer nc.writer_destroy(&w);schedule_control_encode(&w,control)
+ _=nc.server_send_reliable(&ns.srv,index,w.data[:])
+}
+net_scheduled_server_offer :: proc(ns:^Net_Server,index:int) {
+ c:=&ns.clients[index]
+ generation:=max(u64(1),c.schedule.identity.generation+1)
+ c.schedule.synchronized=false;c.schedule.held=0;c.schedule.slots={}
+ request_cache_expire_epoch(c.requests,ns.tick)
+ c.move=0;c.jump_pending=false;clear(&c.blast_queue)
+ net_scheduled_send_control(ns,index,{kind=.Offer,proposal={{c.incarnation,ns.game.world.scene.epoch,generation},ns.tick+2,1},server={ns.tick,0}})
+}
+net_scheduled_server_owner :: proc(ns:^Net_Server,index:int) {
+ c:=&ns.clients[index];p:=&ns.game.world.players[index]
+ if !c.schedule.synchronized || !p.active { return }
+ owner:=owner_state_capture(p,&c.schedule,ns.tick,ns.game.world.scene.structure_revision)
+ w:nc.Writer;nc.writer_init(&w,160);defer nc.writer_destroy(&w);owner_state_encode(&w,owner)
+ _=nc.server_send_unreliable(&ns.srv,index,w.data[:])
+}
+net_scheduled_server_message :: proc(ns:^Net_Server,index:int,channel:u8,data:[]u8) -> bool {
+ if len(data)==0 { return false }
+ c:=&ns.clients[index]
+ switch data[0] {
+ case NET_APP_READY:
+  if channel==nc.CHANNEL_RELIABLE {round_server_ready(ns,index,data)};return true
+ case SCHEDULED_MSG_REQUEST:
+  if channel==nc.CHANNEL_RELIABLE { net_request_server_dispatch(ns,index,data) };return true
+ case SCHEDULED_MSG_CONTROL:
+  if channel!=nc.CHANNEL_RELIABLE { return true }
+  control,ok:=schedule_control_decode(data);if !ok || control.kind!=.Request { return true }
+  result:=input_schedule_reset(&c.schedule,c.incarnation,ns.game.world.scene.epoch,ns.tick,control.proposal)
+  control.kind=result==.Accepted?Schedule_Control_Kind.Accepted:Schedule_Control_Kind.Rejected
+  control.reason=result;control.server={ns.tick,0};net_scheduled_send_control(ns,index,control)
+  return true
+ case SCHEDULED_MSG_INPUT:
+  if channel!=nc.CHANNEL_UNRELIABLE { return true }
+  packet,ok:=scheduled_input_decode(data);if !ok { return true }
+  if packet.identity.incarnation!=c.incarnation || packet.identity.epoch!=ns.game.world.scene.epoch { return true }
+  if packet.has_ack { net_server_ack(ns,c,packet.ack) }
+  for k in 0..<packet.count { _=input_schedule_insert(&c.schedule,packet.identity,ns.tick,packet.commands[k]) }
+  return true
+ case SCHEDULED_MSG_PROBE:
+  if channel==nc.CHANNEL_UNRELIABLE && len(data)==9 { r:nc.Reader;nc.reader_init(&r,data);_=nc.read_u8(&r);c.echo_nonce=nc.read_u64(&r) }
+  return true
+ }
+ return false
+}
+// Called after the real server's fixed-step loop, immediately before producing
+// outgoing datagrams. Phase identifies send time, not receive/processing time.
+net_scheduled_server_echoes :: proc(ns:^Net_Server,phase:f64,now:f64) {
+ sent:=false
+ for &c,i in ns.clients {
+  if !c.active || c.echo_nonce==0 { continue }
+  w:nc.Writer;nc.writer_init(&w,24)
+  nc.write_u8(&w,SCHEDULED_MSG_ECHO);nc.write_u64(&w,c.echo_nonce);nc.write_u64(&w,ns.tick);nc.write_f32(&w,f32(clamp(phase,0,0.999999)))
+  _=nc.server_send_unreliable(&ns.srv,i,w.data[:]);nc.writer_destroy(&w);c.echo_nonce=0;sent=true
+ }
+ if sent { nc.server_update(&ns.srv,now) }
+}
+net_scheduled_client_message :: proc(c:^Net_Client,channel:u8,data:[]u8,now:f64) -> bool {
+ if len(data)==0 { return false }
+ link:=&c.input_link
+ switch data[0] {
+ case SCHEDULED_MSG_RESULT:
+  if channel==nc.CHANNEL_RELIABLE { net_request_client_result(c,data) };return true
+ case SCHEDULED_MSG_ECHO:
+  if channel!=nc.CHANNEL_UNRELIABLE || len(data)!=21 { return true }
+  r:nc.Reader;nc.reader_init(&r,data);_=nc.read_u8(&r);nonce:=nc.read_u64(&r);tick:=nc.read_u64(&r);phase:=nc.read_f32(&r)
+  if r.ok { _=input_clock_echo(&link.clock,nonce,{tick,f64(phase)},now) }
+  return true
+ case SCHEDULED_MSG_CONTROL:
+  if channel!=nc.CHANNEL_RELIABLE { return true }
+  control,ok:=schedule_control_decode(data);if !ok { return true }
+  if control.kind==.Offer { _=input_link_offer(link,control);c.human_move=0;c.human_jump_pending=false;clear(&c.blasts) }
+  else { _=input_link_control_result(link,control) }
+  return true
+ case SCHEDULED_MSG_OWNER:
+  if channel!=nc.CHANNEL_UNRELIABLE { return true }
+  owner,ok:=owner_state_decode(data);if ok { _=input_link_owner(link,owner) };return true
+ }
+ return false
+}
+net_scheduled_client_update :: proc(c:^Net_Client,now:f64) {
+ round_client_ready(c)
+ link:=&c.input_link
+ if now>=c.input_probe_at {
+  nonce,ok:=input_clock_probe(&link.clock,now)
+  if ok {
+   w:nc.Writer;nc.writer_init(&w,16);nc.write_u8(&w,SCHEDULED_MSG_PROBE);nc.write_u64(&w,nonce)
+   _=nc.client_send_unreliable(&c.nc_client,w.data[:]);nc.writer_destroy(&w)
+  }
+  c.input_probe_at=now+.25
+ }
+ if link.clock.valid { _,_=input_clock_now(&link.clock,now) }
+ if link.active && link.clock.valid {
+  stamp:=link.clock.estimate
+  actual:f64
+  if link.history.next_tick>=stamp.tick { actual=f64(min(u64(1000),link.history.next_tick-stamp.tick))-stamp.phase }
+  else { actual=-f64(min(u64(1000),stamp.tick-link.history.next_tick))-stamp.phase }
+  if actual<2-1e-6 || actual>16+1e-6 || actual-f64(link.clock.lead)>3+1e-6 || f64(link.clock.lead)-actual>3+1e-6 {
+   input_link_clear_intent(link);c.human_move=0;c.human_jump_pending=false;clear(&c.blasts)
+  }
+ }
+ if link.clock.resync && link.active { input_link_clear_intent(link);c.human_move=0;c.human_jump_pending=false;clear(&c.blasts) }
+ control,ready:=input_link_prepare_reset(link,now)
+ if ready {
+  w:nc.Writer;nc.writer_init(&w,80);schedule_control_encode(&w,control)
+  if !nc.client_send_reliable(&c.nc_client,w.data[:]) { link.awaiting=false;link.history={} }
+  nc.writer_destroy(&w)
+ }
+}
+net_scheduled_client_input :: proc(c:^Net_Client) {
+ net_request_client_blasts(c)
+ _,created:=input_link_command(&c.input_link,move_quantize(c.human_move),c.human_jump_pending)
+ if c.human_jump_pending { c.jump_counter+=1;c.stats.jumps_pressed+=1;c.human_jump_pending=false }
+ if !created { return }
+ packet,ready:=input_link_packet(&c.input_link,c.has_complete,c.newest_complete);if !ready { return }
+ w:nc.Writer;nc.writer_init(&w,160);defer nc.writer_destroy(&w)
+ if !scheduled_input_encode(&w,packet) { return }
+ if c.stats.input_count==0 { c.stats.input_payload_hash=14695981039346656037 }
+ for byte in w.data { c.stats.input_payload_hash=(c.stats.input_payload_hash~u64(byte))*1099511628211 }
+ c.stats.input_count+=1;c.stats.input_bytes+=len(w.data);c.stats.input_max=max(c.stats.input_max,len(w.data))
+ _=nc.client_send_unreliable(&c.nc_client,w.data[:])
+}
diff --git a/src/shared/input_owner.odin b/src/shared/input_owner.odin
new file mode 100644
index 0000000..294329d
--- /dev/null
+++ b/src/shared/input_owner.odin
@@ -0,0 +1,50 @@
+package shared
+import b2 "vendor:box2d"
+
+Owner_State :: struct {
+ identity: Input_Identity,
+ state_tick,topology_revision,finalized_through,last_applied_sequence,last_jump_edge,teleport_serial: u64,
+ position,velocity,support_velocity: Vec2,
+ coyote,buffered_jump: f32,
+ support_cell: u64,
+ grounded: bool,
+ support_kind: u8,
+ held: i8,
+ missing: u32,
+}
+owner_state_capture :: proc(player: ^Player,schedule: ^Input_Schedule,tick,revision: u64) -> Owner_State {
+ return {
+  identity=schedule.identity,state_tick=tick,topology_revision=revision,
+  finalized_through=schedule.finalized_through,last_applied_sequence=schedule.last_applied_sequence,
+  last_jump_edge=max(schedule.last_jump_edge,schedule.terminal_jump_edge),
+  teleport_serial=player.teleport_serial,
+  position=from_b2(b2.Body_GetPosition(player.body)),velocity=from_b2(b2.Body_GetLinearVelocity(player.body)),
+  support_velocity=player.support_velocity,coyote=player.coyote,buffered_jump=player.buffered_jump,
+  support_cell=player.support_cell,grounded=player.grounded,support_kind=player.support_kind,
+  held=schedule.held,missing=schedule.missing,
+ }
+}
+owner_state_valid :: proc(o: Owner_State) -> bool {
+ return o.identity.incarnation!=0 && o.identity.generation!=0 && o.finalized_through<=o.state_tick &&
+  finite(o.position.x) && finite(o.position.y) && finite(o.velocity.x) && finite(o.velocity.y) &&
+  finite(o.support_velocity.x) && finite(o.support_velocity.y) && finite(o.coyote) && finite(o.buffered_jump) &&
+  o.coyote>=0 && o.coyote<=1.00001 && o.buffered_jump>=0 && o.buffered_jump<=1.00001 &&
+  o.support_kind<=3 && o.held!=min(i8) && o.missing<=INPUT_HELD_GRACE+1 &&
+  (o.support_kind==1 || o.support_cell==0)
+}
+owner_state_restore :: proc(world: b2.WorldId,player: ^Player,o: Owner_State) -> bool {
+ if !owner_state_valid(o) { return false }
+ radius:=player.blast_radius;tuning:=player.tuning
+ // Recreate only the prediction body: stale contact manifolds/warm starts may
+ // not survive an authoritative rewind. The server never calls this helper.
+ if player.active && b2.Body_IsValid(player.body) { b2.DestroyBody(player.body) }
+ player^=player_create(world,radius)
+ player.tuning=tuning
+ b2.Body_SetTransform(player.body,to_b2(o.position),b2.MakeRot(0))
+ b2.Body_SetLinearVelocity(player.body,to_b2(o.velocity))
+ player.grounded=o.grounded;player.coyote=o.coyote;player.buffered_jump=o.buffered_jump
+ player.support_velocity=o.support_velocity;player.support_cell=o.support_cell;player.support_kind=o.support_kind
+ player.teleport_serial=o.teleport_serial
+ player_refresh_pose(player)
+ return true
+}
diff --git a/src/shared/input_request_network.odin b/src/shared/input_request_network.odin
new file mode 100644
index 0000000..d945e61
--- /dev/null
+++ b/src/shared/input_request_network.odin
@@ -0,0 +1,156 @@
+package shared
+import nc "../netcode"
+import sha2 "core:crypto/sha2"
+import strings "core:strings"
+import math "core:math"
+
+REQUEST_BLAST :: u8(1)
+Pending_Request :: struct { active:bool, id:u64, kind:u8 }
+Completed_Request :: struct { kind:u8, result:Request_Result, local:bool }
+Request_Envelope :: struct { incarnation:u64, epoch:u32, id,created,deadline:u64, kind:u8, payload:[]u8 }
+
+request_envelope_decode :: proc(data:[]u8) -> (q:Request_Envelope,ok:bool) {
+ if len(data)<38 || len(data)>NET_APP_MAX_LAYOUT+64 { return }
+ r:nc.Reader;nc.reader_init(&r,data)
+ if nc.read_u8(&r)!=SCHEDULED_MSG_REQUEST { return }
+ q.incarnation=nc.read_u64(&r);q.epoch=nc.read_u32(&r);q.id=nc.read_u64(&r);q.created=nc.read_u64(&r);q.deadline=nc.read_u64(&r);q.kind=nc.read_u8(&r)
+ q.payload=data[r.pos:]
+ return q,r.ok && q.id!=0 && (q.kind==REQUEST_BLAST || q.kind==NET_APP_HOST_COMMAND || q.kind==NET_APP_LAYOUT_UPLOAD)
+}
+request_reason_text :: proc(result:Request_Result) -> string {
+ switch result.status {
+ case .Accepted:return ""
+ case .Expired:return "blast intent expired"
+ case .Wrong_Epoch:return "epoch changed"
+ case .Wrong_Connection:return "connection changed"
+ case .Too_Old:return "request ID is terminal or too old"
+ case .Conflict:return "conflicting request contents"
+ case .Capacity:return "request result window is full"
+ case .Cleared:return "input cleared locally"
+ case .Rejected:
+  switch result.reason { case 1:return "host only";case 3:return "outside world";case 4:return "blast rate exceeded";case 5:return "solid aim";case:return "invalid request" }
+ case .Pending:return "request pending"
+ }
+ return "invalid request result"
+}
+net_request_send_result :: proc(ns:^Net_Server,index:int,kind:u8,result:Request_Result) {
+ w:nc.Writer;nc.writer_init(&w,40);defer nc.writer_destroy(&w)
+ nc.write_u8(&w,SCHEDULED_MSG_RESULT);nc.write_u8(&w,kind);nc.write_u64(&w,result.request_id);nc.write_u8(&w,u8(result.status))
+ nc.write_u64(&w,result.effect_tick);nc.write_u64(&w,result.event_id);nc.write_u16(&w,result.reason)
+ _=nc.server_send_reliable(&ns.srv,index,w.data[:])
+}
+net_request_server_dispatch :: proc(ns:^Net_Server,index:int,data:[]u8) {
+ q,ok:=request_envelope_decode(data);if !ok { return }
+ c:=&ns.clients[index]
+ hash:[32]u8;ctx:sha2.Context_256;sha2.init_256(&ctx);sha2.update(&ctx,data);sha2.final(&ctx,hash[:])
+ begin,previous:=request_cache_begin(c.requests,q.incarnation,q.id,hash)
+ if begin!=.New { net_request_send_result(ns,index,q.kind,previous);return }
+ result:=Request_Result{request_id=q.id,effect_tick=ns.tick+1,status=.Accepted}
+ if q.epoch!=ns.game.world.scene.epoch { result.status=.Wrong_Epoch }
+ else if q.kind==REQUEST_BLAST {
+  result.status=blast_intent_status(c.incarnation,q.incarnation,ns.game.world.scene.epoch,q.epoch,ns.tick+1,q.created,q.deadline)
+  if result.status==.Accepted && ns.rounds.mode==.Elimination {result.status=.Rejected;result.reason=6}
+  if result.status==.Accepted && ns.real_gate && !c.is_host {result.status=.Rejected;result.reason=1}
+  if result.status==.Accepted {
+   r:nc.Reader;nc.reader_init(&r,q.payload);point:=Vec2{nc.read_f32(&r),nc.read_f32(&r)}
+   if !r.ok || r.pos!=len(q.payload) || !finite(point.x) || !finite(point.y) { result.status=.Rejected;result.reason=2 }
+   else {
+    recent:=0;for tick in c.blast_ticks { if ns.tick+1-tick<NET_BLAST_RATE_TICKS { recent+=1 } }
+    outside:=point.x<YARD_LEFT || point.x>YARD_RIGHT || point.y<=YARD_FLOOR_BOTTOM || point.y>NET_YARD_CEILING
+    if ns.game.world.scene.level_policy.active { outside=!level_bounds_contains(ns.game.world.scene.level_policy.aim,point) }
+    if outside { result.status=.Rejected;result.reason=3;c.stats.rejected_outside+=1 }
+    else if recent>=NET_BLAST_RATE_COUNT { result.status=.Rejected;result.reason=4;c.stats.rejected_rate+=1 }
+    else if !sandbox_valid_aim(&ns.game.world.scene,point) { result.status=.Rejected;result.reason=5;c.stats.rejected_solid+=1 }
+    else {
+     world_explode(&ns.game.world,point,c.radius,&ns.pre_events)
+     ns.next_event_id+=1;result.event_id=ns.next_event_id
+     ns.pre_events.explosions[len(ns.pre_events.explosions)-1].event_id=result.event_id
+     c.stats.blasts_applied+=1;append(&c.blast_ticks,ns.tick+1)
+    }
+   }
+  }
+  if result.status!=.Accepted {
+   c.stats.blasts_rejected+=1;ns.next_event_id+=1;result.event_id=ns.next_event_id
+   w:nc.Writer;nc.writer_init(&w,32);event_encode_rejected(&w,ns.tick+1,0,result.event_id)
+   _=nc.server_send_reliable(&ns.srv,index,w.data[:]);nc.writer_destroy(&w)
+  }
+ } else {
+  reason:="invalid request"
+  if len(q.payload)>0 && q.payload[0]==q.kind {
+   if q.kind==NET_APP_HOST_COMMAND { reason=net_host_apply_command(ns,index,q.payload) }
+   else { reason=net_host_apply_layout(ns,index,q.payload) }
+  }
+  if reason!="" { result.status=.Rejected;result.reason=ns.clients[index].is_host?u16(2):u16(1) }
+  else if q.kind==NET_APP_HOST_COMMAND && ns.rebuild!=nil {
+   // The request cache remains pending until the completed world is published.
+   // Duplicates cannot start a second job; Pending replays are ignored by peers
+   // until the existing terminal result message arrives through reliable transport.
+   ns.rebuild.request_id=q.id;ns.rebuild.request_incarnation=c.incarnation;ns.rebuild.request_client=index
+   return
+  }
+ }
+ _=request_cache_finish(c.requests,result);net_request_send_result(ns,index,q.kind,result)
+}
+
+net_request_client_send :: proc(c:^Net_Client,kind:u8,payload:[]u8,created:u64=0,deadline:u64=0) -> bool {
+ if !c.real_hello_ok || !c.input_link.has_offer || !c.has_epoch || c.request_counter==max(u64) { return false }
+ id:=c.request_counter+1;slot:=&c.request_pending[id%u64(len(c.request_pending))]
+ if slot.active { return false }
+ w:nc.Writer;nc.writer_init(&w,len(payload)+48);defer nc.writer_destroy(&w)
+ nc.write_u8(&w,SCHEDULED_MSG_REQUEST);nc.write_u64(&w,c.input_link.offer.identity.incarnation);nc.write_u32(&w,c.epoch)
+ nc.write_u64(&w,id);nc.write_u64(&w,created);nc.write_u64(&w,deadline);nc.write_u8(&w,kind);nc.write_raw(&w,payload)
+ if !nc.client_send_reliable(&c.nc_client,w.data[:]) { return false }
+ if c.stats.request_payload_count==0 { c.stats.request_payload_hash=14695981039346656037 }
+ for byte in w.data { c.stats.request_payload_hash=(c.stats.request_payload_hash~u64(byte))*1099511628211 }
+ c.stats.request_payload_count+=1
+ c.request_counter=id;slot^={true,id,kind}
+ c.last_request_created_tick=created;c.last_request_deadline_tick=deadline
+ if kind!=REQUEST_BLAST { c.host_request_id=id }
+ return true
+}
+net_request_client_result :: proc(c:^Net_Client,data:[]u8) {
+ r:nc.Reader;nc.reader_init(&r,data);_=nc.read_u8(&r);kind:=nc.read_u8(&r)
+ result:Request_Result;result.request_id=nc.read_u64(&r);status:=nc.read_u8(&r)
+ result.effect_tick=nc.read_u64(&r);result.event_id=nc.read_u64(&r);result.reason=nc.read_u16(&r)
+ if !r.ok || r.pos!=len(data) || status==0 || status>u8(Request_Status.Capacity) { return }
+ pending:=&c.request_pending[result.request_id%u64(len(c.request_pending))]
+ if !pending.active || pending.id!=result.request_id || pending.kind!=kind { return }
+ result.status=Request_Status(status);pending^={};c.last_request_result=result
+ c.completed_requests[result.request_id%1024]={kind=kind,result=result};c.highest_completed_request=max(c.highest_completed_request,result.request_id)
+ if kind!=REQUEST_BLAST && result.request_id==c.host_request_id {
+  c.control_serial+=1;c.control_kind=kind;c.control_ok=result.status==.Accepted
+  delete(c.control_reason);c.control_reason=strings.clone(request_reason_text(result))
+ }
+}
+net_request_client_blasts :: proc(c:^Net_Client) {
+ defer c.blast_ages={}
+ if !c.input_link.active || !c.input_link.clock.valid { clear(&c.blasts);return }
+ // The timestamped FFI queue already enforces the local 500ms bound. The
+ // reliable application deadline also prevents intent delayed in transport.
+ for blast,index in c.blasts {
+  age:=max(0.0,c.blast_ages[index])
+  if age>.5 { if !net_request_client_local_result(c,REQUEST_BLAST,.Expired,0) && c.real_reason=="" { c.real_reason=strings.clone("native request result queue full; reconnect required") };c.stats.blasts_dropped+=1;continue }
+  stamp:=c.input_link.clock.estimate
+  whole:=u64(math.ceil(max(0.0,age*60-stamp.phase)))
+  created:=stamp.tick>=whole?stamp.tick-whole:u64(0)
+  if created>max(u64)-30 { continue }
+  w:nc.Writer;nc.writer_init(&w,8)
+  nc.write_f32(&w,nc.dequantize_pos(blast.x));nc.write_f32(&w,nc.dequantize_pos(blast.y))
+  if !net_request_client_send(c,REQUEST_BLAST,w.data[:],created,created+30) {
+   c.stats.blasts_dropped+=1
+   if c.real_reason=="" { c.real_reason=strings.clone("reliable action queue full; reconnect required") }
+  }
+  nc.writer_destroy(&w)
+ }
+ clear(&c.blasts)
+}
+
+net_request_client_local_result :: proc(c:^Net_Client,kind:u8,status:Request_Status,reason:u16) -> bool {
+ if c.request_counter==max(u64) { return false }
+ id:=c.request_counter+1
+ if c.request_pending[id%1024].active { return false }
+ result:=Request_Result{request_id=id,status=status,reason=reason}
+ c.request_counter=id;c.last_request_result=result
+ c.completed_requests[id%1024]={kind=kind,result=result,local=true};c.highest_completed_request=max(c.highest_completed_request,id)
+ return true
+}
