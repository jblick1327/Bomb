+@(test)
+scheduled_commands_actions_and_targets_match_at_30_60_144_fps :: proc(test:^t.T) {
+ count,digest,actions,target:=scheduled_timing_fixture(test,30)
+ t.expect(test,count==180)
+ for fps in ([3]int{60,144,1000}) {
+  n,d,a,last:=scheduled_timing_fixture(test,fps)
+  t.expect(test,n==count && d==digest && a==actions && last==target,"exact scheduled command bytes, reliable action bytes and u64 targets are render-rate independent")
+ }
+}
diff --git a/src/ffi/reconnect_test.odin b/src/ffi/reconnect_test.odin
new file mode 100644
index 0000000..00b4894
--- /dev/null
+++ b/src/ffi/reconnect_test.odin
@@ -0,0 +1,27 @@
+package ffi
+import t "core:testing"
+import nc "../netcode"
+@(test)
+reconnect_reuses_local_port_with_fresh_salt_even_if_disconnect_is_lost :: proc(test:^t.T) {
+ info:=BomCreateInfo{struct_size=u32(size_of(BomCreateInfo)),version=1};handle:u64
+ t.expect(test,bom_client_create(&info,&handle)==OK);defer t.expect(test,bom_client_destroy(handle)==OK)
+ connection:=BomConnectInfo{struct_size=u32(size_of(BomConnectInfo)),version=1,ipv4=0x7f000001,port=32000}
+ t.expect(test,bom_client_connect(handle,&connection)==OK)
+ slot,status:=get_slot(handle);t.expect(test,status==OK);context.allocator=slot.ctx.allocator
+ port,salt:=nc.socket_port(&slot.socket),slot.client.nc_client.salt
+ server:nc.Server;nc.server_init(&server);defer nc.server_destroy(&server)
+ address:=nc.address_loopback(port)
+ // Fill all four real transport slots, then discard every response. The
+ // reconnect must replace the stale address instead of needing a fifth slot.
+ for i in 0..<4 {
+  packet:=nc.build_control_packet(.Connect,i==0?salt:u32(i+100))
+  nc.server_receive(&server,i==0?address:nc.address_loopback(u16(10000+i)),packet,0);delete(packet)
+ }
+ t.expect(test,nc.server_client_count(&server)==4)
+ t.expect(test,bom_client_disconnect(handle)==OK&&bom_client_connect(handle,&connection)==OK)
+ t.expect(test,nc.socket_port(&slot.socket)==port&&slot.client.nc_client.salt!=salt&&slot.connection_generation==2)
+ packet:=nc.build_control_packet(.Connect,slot.client.nc_client.salt);defer delete(packet);nc.server_receive(&server,address,packet,1)
+ t.expect(test,nc.server_client_count(&server)==4&&server.clients[0].salt==slot.client.nc_client.salt)
+ stale:=nc.build_control_packet(.Disconnect,salt);defer delete(stale);nc.server_receive(&server,address,stale,2)
+ t.expect(test,server.clients[0].active,"a delayed old disconnect must not close the new generation")
+}
diff --git a/src/ffi/round.odin b/src/ffi/round.odin
new file mode 100644
index 0000000..45d7f9b
--- /dev/null
+++ b/src/ffi/round.odin
@@ -0,0 +1,36 @@
+package ffi
+import core "../shared"
+
+// Borrowed arrays follow the same acquired-sample lifetime as poses/topology.
+// The managed frontend must copy them before release; no protocol bytes escape.
+@(export)
+bom_client_get_round :: proc "c" (handle,sample_sequence:u64,info:^BomRoundInfo)->u32 {
+ s,status:=get_slot(handle);if status!=OK {return status};context=s.ctx
+ if !s.acquired || sample_sequence!=s.sample_sequence {return BAD_ARGUMENT}
+ if info==nil || info.struct_size<u32(size_of(BomRoundInfo)) || info.version!=1 {return BAD_ARGUMENT}
+ if !s.client.has_round {info^=BomRoundInfo{struct_size=u32(size_of(BomRoundInfo)),version=1};return OK}
+ r:=s.client.round_snapshot
+ for p,i in r.players {
+  s.round_players[i]={session_id=p.session_id,generation=p.generation,slot=u32(p.slot),alive=p.alive?1:0,death=u32(p.death),death_tick=p.death_tick,alive_ticks=p.alive_ticks,bombs_faced=p.bombs_faced,xp_gained=p.xp_gained}
+ }
+ for c,i in r.connections {
+  flags:=u32(0);if c.connected {flags|=1};if c.ready {flags|=2};if c.spectator {flags|=4};if c.restart_allowed {flags|=8}
+  s.round_connections[i]={session_id=c.session_id,generation=c.generation,total_xp=c.total_xp,wins=c.wins,level=c.progress.level,xp_in_level=c.progress.xp_in_level,xp_to_next=c.progress.xp_to_next,flags=flags}
+ }
+ flags:=u32(1);local:=u64(0);index:=s.client.nc_client.client_index
+ if index>=0 && index<core.MAX_PLAYERS {
+  c:=r.connections[index];local=c.session_id
+  if c.restart_allowed {flags|=2};if c.spectator {flags|=4}
+ }
+ info^=BomRoundInfo{struct_size=u32(size_of(BomRoundInfo)),version=1,epoch=r.epoch,rules_version=r.rules_version,tick=r.tick,round_id=r.id,countdown_tick=r.countdown_tick,start_tick=r.start_tick,end_tick=r.end_tick,bombs_spawned=r.bombs_spawned,winner=r.winner,local_session_id=local,mode=u32(r.mode),state=u32(r.state),draw=r.draw?1:0,reason=u32(r.reason),lethal_radius=r.lethal_radius,flags=flags,players=raw_data(s.round_players[:]),player_count=2,connections=raw_data(s.round_connections[:]),connection_count=core.MAX_PLAYERS}
+ return OK
+}
+
+@(export)
+bom_client_set_join_options :: proc "c" (handle:u64,flags:u32)->u32 {
+ s,status:=get_slot(handle);if status!=OK {return status};context=s.ctx
+ if s.acquired || s.live {return BUSY}
+ if flags>1 {return BAD_ARGUMENT}
+ s.join_spectator=flags==1
+ return OK
+}
