<Project Sdk="Microsoft.NET.Sdk">
  <!-- G5 I5 settle check (the C2b harness, kept here so it is reproducible): a spectator native client prints the world
       revision while nothing blasts the level. Run through Run-G5Settle.py, which starts BOM-server with the layout. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../../Assets/BOMIntegration/Runtime/BomNative.cs" Link="BomNative.cs" />
  </ItemGroup>
</Project>
